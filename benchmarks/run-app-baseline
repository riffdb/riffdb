    if not match:
        raise SystemExit(f"unrecognized balanced phase path: {path}")
    family, rep_text = match.groups()
    rep = int(rep_text)
    backend = next(iter(document.get("backends") or []), {}).get("backend_id")
    execution_order.append(backend or family)
