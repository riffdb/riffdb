#!/usr/bin/env bash
# Application-shaped baseline: live PostgreSQL vs live riffdbd (public gRPC).
set -euo pipefail
export LC_ALL=C
export TZ=UTC

usage() {
    printf '%s\n' \
        'usage: benchmarks/run-app-baseline [--self-test]' \
        '         | [--alpha-matrix|--alpha-matrix-smoke]' \
        '         | [--smoke|--full] [--samples N] [--warmup N] [--board-density N]' \
        '         [--organizations N] [--tickets-per-project N] [--comments-per-ticket N]' \
        '         [--labels-per-ticket N] [--payload-bytes N]' \
        '         [--concurrent-clients N] [--concurrent-operations N]' \
        '         [--load read_only|write_only|append_only|interactive|agent|membership_contention] [--load-clients N] [--load-duration-secs N]' \
        '         [--load-warmup-secs N] [--load-zipf-s F] [--load-contended]' \
        '         [--load-open-loop-rate OPS] [--load-open-loop-queue-depth N]' \
        '         [--load-tenants N] [--load-hot-tenant-percent PERCENT]' \
        '         [--load-journeys]' \
        '         [--load-saturate] [--load-saturate-p99-ms N] [--load-concurrency-sweep]' \
        '         [--load-accumulate-history]' \
        '         [--load-riffdb-transport per-session|shared]' \
        '         [--database-root PATH]' \
        '         [--seed-only]' \
        '         [--postgres-comparator minimal|safe-app]' \
        '         [--reps N] [--require-stable]' \
        '         [--output PATH] [--assert-write-parity|--assert-all-parity]' \
        '         [--skip-postgres] [--skip-riffdb]' >&2
    exit 2
}

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"
task_tmp_root="${RIFFDB_TMP_ROOT:-$HOME/tmp}"
mkdir -p "$task_tmp_root"
export TMPDIR="$task_tmp_root"

# --self-test: build riffdbd and run the full app-baseline --workspace suite,
# including the kill -9 dead-peer e2e (RUN_RIFFDB_DEAD_PEER=1).
if [[ "${1:-}" == "--self-test" ]]; then
    if (($# != 1)); then
        printf 'benchmarks/run-app-baseline --self-test takes no other arguments\n' >&2
        exit 2
    fi
    printf 'self-test: building riffdbd (release)\n'
    host_fixture="$(mktemp "$task_tmp_root/riffdb-host-validity.XXXXXX")"
    set +e
    ./scripts/app-baseline-host-validity --interval-ms 50 >"$host_fixture"
    host_fixture_status=$?
    set -e
    [[ "$host_fixture_status" == 0 || "$host_fixture_status" == 3 ]] || exit 1
    jq -e '
      .schema == "riffdb.app-baseline-host-validity/v1"
      and (.valid | type == "boolean")
      and (.active_processes | type == "array")
      and (.interfering_processes | type == "array")
      and .inventory_bounds.process_arguments_included == false
    ' "$host_fixture" >/dev/null
    receipt_fixture="$(mktemp "$task_tmp_root/riffdb-non-evidentiary.XXXXXX")"
    ./scripts/app-baseline-non-evidentiary-receipt \
        --output "$receipt_fixture" \
        --reason backend_execution_failed \
        --mode full \
        --profile interactive \
        --duration-secs 90 \
        --reps 3 \
        --postgres-comparator safe-app \
        --concurrency-sweep 1 \
        --preflight "$host_fixture" \
        --postflight "$host_fixture" \
        --backend riffdb_public_grpc \
        --rep 1 \
        --phase-exit-status 1 \
        --partial-phase-evidence "$host_fixture"
    jq -e '
      .schema == "riffdb.app-baseline-non-evidentiary/v1"
      and .status == "non_evidentiary"
      and .reason.code == "backend_execution_failed"
      and .reason.backend == "riffdb_public_grpc"
      and .reason.rep == 1
      and .reason.phase_exit_status == 1
      and .evidence_eligibility.eligible == false
      and (.partial_phase_evidence.sha256 | test("^[0-9a-f]{64}$"))
    ' "$receipt_fixture" >/dev/null
    ./scripts/app-baseline-performance-sentinel-check --self-test
    bash -n ./scripts/app-baseline-performance-sentinel
    rm -f "$receipt_fixture"
    rm -f "$host_fixture"
    cargo +1.97.0 build --locked --release -p riffdb-server --bin riffdbd
    riffdbd_bin="$repo_root/target/release/riffdbd"
    [[ -x "$riffdbd_bin" ]] || {
        printf 'self-test: riffdbd missing after build: %s\n' "$riffdbd_bin" >&2
        exit 1
    }
    printf 'self-test: cargo test --workspace (dead-peer e2e enforced)\n'
    export RIFFDB_APP_BASELINE_RIFFDBD_BIN="$riffdbd_bin"
    export RUN_RIFFDB_DEAD_PEER=1
    cargo +1.97.0 test --manifest-path examples/app-baseline/Cargo.toml --workspace
    printf 'self-test: ok\n'
    exit 0
fi

if [[ "${1:-}" == "--alpha-matrix" || "${1:-}" == "--alpha-matrix-smoke" ]]; then
    (($# == 1)) || usage
    matrix_mode="${1#--alpha-matrix}"
    matrix_root="$repo_root/target/app-baseline/alpha-matrix"
    mkdir -p "$matrix_root" "$task_tmp_root"
    matrix_results="$(mktemp "$task_tmp_root/riffdb-alpha-matrix.XXXXXX")"
    trap 'rm -f "$matrix_results"' EXIT INT TERM HUP
    if [[ "$matrix_mode" == "-smoke" ]]; then
        scale_args=(--smoke --reps 2)
        load_args=(--load-duration-secs 5 --load-warmup-secs 1)
        wide_labels=4
    else
        scale_args=(--full --reps 3 --require-stable)
        load_args=(--load-duration-secs 90 --load-warmup-secs 15)
        wide_labels=5
    fi

    run_matrix_cell() {
        local name="$1" output_path="$matrix_root/$1.json"
        shift
        local began ended status
        began="$(date +%s%N)"
        if "$@" --output "$output_path"; then
            status=passed
        else
            status=failed
        fi
        ended="$(date +%s%N)"
        local digest=missing
        [[ -f "$output_path" ]] && digest="$(sha256sum "$output_path" | awk '{print $1}')"
        printf '%s\t%s\t%s\t%s\t%s\n' \
            "$name" "$status" "$((ended - began))" "$output_path" "$digest" >>"$matrix_results"
    }

    run_matrix_cell parity_minimal "$0" "${scale_args[@]}" --postgres-comparator minimal
    run_matrix_cell parity_safe_app "$0" "${scale_args[@]}" --postgres-comparator safe-app
    run_matrix_cell closed_interactive "$0" "${scale_args[@]}" \
        --load interactive --load-clients 32 "${load_args[@]}" --load-journeys
    run_matrix_cell open_agent_500 "$0" "${scale_args[@]}" \
        --load agent --load-clients 32 "${load_args[@]}" \
        --load-open-loop-rate 500 --load-open-loop-queue-depth 4096
    run_matrix_cell open_agent_2000 "$0" "${scale_args[@]}" \
        --load agent --load-clients 32 "${load_args[@]}" \
        --load-open-loop-rate 2000 --load-open-loop-queue-depth 4096
    run_matrix_cell open_agent_8000 "$0" "${scale_args[@]}" \
        --load agent --load-clients 32 "${load_args[@]}" \
        --load-open-loop-rate 8000 --load-open-loop-queue-depth 4096
    run_matrix_cell same_ticket_contention "$0" "${scale_args[@]}" \
        --load interactive --load-clients 32 "${load_args[@]}" --load-contended
    run_matrix_cell membership_contention "$0" "${scale_args[@]}" \
        --load membership_contention --load-clients 32 "${load_args[@]}"
    run_matrix_cell tenants_8_uniform "$0" "${scale_args[@]}" \
        --organizations 8 --load interactive --load-clients 32 "${load_args[@]}" --load-tenants 8
    run_matrix_cell tenants_64_hot "$0" "${scale_args[@]}" \
        --organizations 64 --load interactive --load-clients 32 "${load_args[@]}" \
        --load-tenants 64 --load-hot-tenant-percent 70
    run_matrix_cell data_shape_wide "$0" "${scale_args[@]}" \
        --tickets-per-project 200 --comments-per-ticket 20 --labels-per-ticket "$wide_labels" \
        --payload-bytes 200 --board-density 1000
    run_matrix_cell retained_history_curve "$0" "${scale_args[@]}" \
        --load interactive --load-concurrency-sweep "${load_args[@]}" --load-accumulate-history

    run_matrix_cell language_conformance ./scripts/app-baseline-language-conformance
    run_matrix_cell resilience examples/app-baseline/resilience/run

    matrix_manifest="$matrix_root/manifest-v1.json"
    python3 - "$matrix_results" "$matrix_manifest" "$matrix_mode" <<'PY'
import json
import sys

results_path, output_path, matrix_mode = sys.argv[1:4]
cells = []
with open(results_path, encoding="utf-8") as source:
    for line in source:
        name, status, elapsed_ns, path, digest = line.rstrip("\n").split("\t")
        cells.append({
            "cell": name,
            "status": status,
            "elapsed_ns": int(elapsed_ns),
            "evidence": path,
            "sha256": digest,
        })
for cell in cells:
    if cell["status"] != "passed" or cell["sha256"] == "missing":
        continue
    try:
        with open(cell["evidence"], encoding="utf-8") as evidence_source:
            evidence = json.load(evidence_source)
    except (OSError, json.JSONDecodeError):
        cell["status"] = "invalid_evidence"
        continue
    validation_errors = []
    name = cell["cell"]
    schema = evidence.get("schema")
    backend_ids = {
        backend.get("backend_id")
        for backend in evidence.get("backends", [])
        if isinstance(backend, dict)
    }
    if name.startswith("parity_") or name == "data_shape_wide":
        if schema != "riffdb.app-baseline/v1":
            validation_errors.append("wrong parity schema")
        expected_pg = "postgres_safe_app" if name == "parity_safe_app" else "postgres_minimal"
        if not {expected_pg, "riffdb_public_grpc"}.issubset(backend_ids):
            validation_errors.append(f"missing comparator backends: expected {expected_pg} and riffdb_public_grpc")
    if name == "data_shape_wide":
        shape = evidence.get("scale_shape") or {}
        expected_shape = {
            "tickets_per_project": 200,
            "comments_per_ticket": 20,
            "labels_per_ticket": 4 if matrix_mode == "-smoke" else 5,
            "board_dense_open": 1000,
            "comment_payload_bytes": 200,
            "ticket_title_payload_bytes": 128,
        }
        for key, expected in expected_shape.items():
            if shape.get(key) != expected:
                validation_errors.append(f"scale_shape.{key} != {expected}")
    load_cells = {
        "closed_interactive", "open_agent_500", "open_agent_2000", "open_agent_8000",
        "same_ticket_contention", "membership_contention", "tenants_8_uniform",
        "tenants_64_hot", "retained_history_curve",
    }
    if name in load_cells:
        if schema != "riffdb.app-baseline-load-suite/v1":
            validation_errors.append("wrong load-suite schema")
        if not evidence.get("correctness", {}).get("clean", False):
            validation_errors.append("load correctness is not clean")
        if not {"postgres_minimal", "riffdb_public_grpc"}.issubset(backend_ids):
            validation_errors.append("load cell is missing one or both backends")
        if not all(isinstance(backend.get("resource_delta"), dict) for backend in evidence.get("backends", [])):
            validation_errors.append("load cell lacks resource attribution")
    if name == "closed_interactive":
        if not evidence.get("stateful_journeys"):
            validation_errors.append("stateful journeys are absent")
        if any(backend.get("profile") != "interactive" for backend in evidence.get("backends", [])):
            validation_errors.append("closed profile is not interactive")
    if name.startswith("open_agent_"):
        expected_rate = int(name.rsplit("_", 1)[1])
        for backend in evidence.get("backends", []):
            open_loop = backend.get("open_loop") or {}
            if backend.get("mode") != "open_loop_poisson" or open_loop.get("offered_rate_per_sec") != expected_rate:
                validation_errors.append(f"{backend.get('backend_id')} does not carry open-loop rate {expected_rate}")
    if name == "same_ticket_contention" and evidence.get("comparison", {}).get("contended") is not True:
        validation_errors.append("same-ticket contention flag is absent")
    if name == "membership_contention" and any(
        backend.get("profile") != "membership_contention" for backend in evidence.get("backends", [])
    ):
        validation_errors.append("membership contention profile is absent")
    if name == "tenants_8_uniform":
        comparison = evidence.get("comparison") or {}
        if comparison.get("tenant_count") != 8 or comparison.get("hot_tenant_percent") != 0:
            validation_errors.append("8-tenant uniform routing is absent")
    if name == "tenants_64_hot":
        comparison = evidence.get("comparison") or {}
        if comparison.get("tenant_count") != 64 or comparison.get("hot_tenant_percent") != 70:
            validation_errors.append("64-tenant hot routing is absent")
    if name == "retained_history_curve":
        comparison = evidence.get("comparison") or {}
        if comparison.get("concurrency_sweep") is not True or comparison.get("history_mode") != "shared_daemon_accumulated_history":
            validation_errors.append("retained-history sweep identity is absent")
    if name == "language_conformance":
        languages = [item.get("language") for item in evidence.get("manifest", {}).get("languages", [])]
        if schema != "riffdb.app-baseline-language-conformance-result/v1" or languages != ["rust", "typescript", "python_sync_async"]:
            validation_errors.append("Rust/TypeScript/Python conformance identity is incomplete")
        if evidence.get("semantic_observations", {}).get("status") != "canonical_match" or evidence.get("boundary_lint") != "passed":
            validation_errors.append("language semantics or boundary lint did not pass")
    if name == "resilience":
        required_resilience = {
            "build_riffdbd", "kill_under_load", "lost_response_replay",
            "durable_consumer_crash_matrix", "authorization_revoked_mid_wait",
            "successor_role_reconciliation", "retained_history_growth",
        }
        resilience_cells = {item.get("cell") for item in evidence.get("cells", [])}
        if schema != "riffdb.app-baseline-resilience/v1" or not required_resilience.issubset(resilience_cells):
            validation_errors.append("resilience evidence is incomplete")
    if validation_errors:
        cell["status"] = "invalid_dimension"
        cell["validation_errors"] = validation_errors
    if matrix_mode != "-smoke" and "evidence_eligibility" in evidence and not evidence["evidence_eligibility"].get("eligible", False):
        cell["status"] = "not_evidentiary"
    if matrix_mode != "-smoke" and evidence.get("schema") == "riffdb.app-baseline/v1":
        summaries = (evidence.get("comparisons") or {}).get("rep_summaries") or {}
        parity_ok = (
            evidence.get("same_device") is True
            and int(evidence.get("reps") or 0) >= 2
            and bool(evidence.get("environment"))
            and bool(evidence.get("device_baseline"))
            and bool(evidence.get("postgres_durability"))
            and summaries
            and all(summary.get("stability") == "stable" for summary in summaries.values())
        )
        if not parity_ok:
            cell["status"] = "not_evidentiary"
    if "status" in evidence and evidence["status"] != "passed":
        cell["status"] = "failed_evidence"
required = {
    "parity_minimal", "parity_safe_app", "closed_interactive", "open_agent_500",
    "open_agent_2000", "open_agent_8000",
    "same_ticket_contention", "membership_contention", "tenants_8_uniform",
    "tenants_64_hot", "data_shape_wide", "retained_history_curve",
    "language_conformance", "resilience",
}
present = {cell["cell"] for cell in cells}
missing = sorted(required - present)
failed = sorted(cell["cell"] for cell in cells if cell["status"] != "passed")
report = {
    "schema": "riffdb.app-baseline-alpha-matrix/v1",
    "eligible": matrix_mode != "-smoke" and not missing and not failed,
    "validation_passed": not missing and not failed,
    "mode": "smoke" if matrix_mode == "-smoke" else "evidentiary",
    "required_cells": sorted(required),
    "missing_cells": missing,
    "failed_cells": failed,
    "cells": cells,
    "claim_boundary": (
        "Parity, load, and resilience remain separate evidence suites. Eligibility means "
        "no required cell was omitted; it is not a composite performance score."
    ),
}
with open(output_path, "w", encoding="utf-8") as destination:
    json.dump(report, destination, indent=2)
    destination.write("\n")
PY
    printf 'alpha matrix manifest: %s\n' "$matrix_manifest"
    if [[ "$matrix_mode" == "-smoke" ]]; then
        jq -e '.validation_passed == true and .eligible == false' "$matrix_manifest" >/dev/null
    else
        jq -e '.eligible == true' "$matrix_manifest" >/dev/null
    fi
    exit
fi

