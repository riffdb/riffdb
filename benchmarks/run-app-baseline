# Kill-orphaned / prior-run containers. Name prefix covers legacy runs without labels;
# label covers current harness. SIGKILL of the shell skips EXIT traps, so this must
# also run at startup (and can be re-run anytime to reclaim docker-proxy CPU).
sweep_harness_postgres_containers() {
    command -v docker >/dev/null 2>&1 || return 0
    local ids
    ids="$(
        {
            docker ps -aq --filter "label=${postgres_label}" 2>/dev/null || true
            docker ps -aq --filter "name=riffdb-app-baseline-" 2>/dev/null || true
            # Older one-off smoke names used in earlier sessions.
            docker ps -aq --filter "name=riffdb-app-baseline-smoke-" 2>/dev/null || true
        } | awk 'NF' | sort -u
    )"
    if [[ -z "$ids" ]]; then
        return 0
    fi
    local count
    count="$(printf '%s\n' "$ids" | wc -l | tr -d ' ')"
    printf 'sweeping %s leftover app-baseline Postgres container(s)\n' "$count" >&2
    # shellcheck disable=SC2086
    docker rm -f $ids >/dev/null 2>&1 || true
}

# Free TCP port on 127.0.0.1 for host-network Postgres (avoids clashing with a
# system postmaster on :5432 while still keeping the client path proxy-free).
pick_free_loopback_port() {
    python3 - <<'PY'
import socket
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.bind(("127.0.0.1", 0))
print(s.getsockname()[1])
s.close()
PY
}

# Container bridge IPv4 (first attached network). Used only when host network
# is unavailable so we can still skip docker-proxy (no -p publish).
postgres_bridge_ip() {
    docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' \
        "$postgres_container" 2>/dev/null | head -n1 | tr -d '[:space:]'
}

stop_postgres() {
    if ((postgres_started)); then
        printf 'stopping PostgreSQL phase (harness docker container)\n' >&2
        docker exec "$postgres_container" \
            chmod -R a+rwx /var/lib/postgresql >/dev/null 2>&1 || true
        docker rm -f "$postgres_container" >/dev/null 2>&1 || true
        rm -rf "$postgres_database_root" || true
        postgres_started=0
        if ((postgres_url_from_harness)); then
            unset RIFFDB_APP_BASELINE_POSTGRES_URL || true
            # Keep RIFFDB_APP_BASELINE_POSTGRES_CONNECT_PATH / postgres_connect_*
            # so dual-phase merge notes still record the measured client path.
            postgres_url_from_harness=0
        fi
    fi
    # Always sweep: covers trap after partial start, dual-phase handoff, and
    # containers owned by killed sibling harnesses.
    sweep_harness_postgres_containers
}

# docker exec psql/pg_isready against harness PG (must honor custom host-network port).
postgres_exec_sql() {
    local args=(-U riffdb -d riffdb_app_baseline)
    if [[ -n "${postgres_connect_port:-}" ]]; then
        args+=(-p "$postgres_connect_port")
    fi
    if [[ -n "${postgres_connect_host:-}" && "$postgres_connect_path" == "host_network_loopback" ]]; then
        args+=(-h 127.0.0.1)
    fi
    docker exec "$postgres_container" psql "${args[@]}" "$@"
}

cleanup() {
    stop_postgres
    [[ -z "$host_validity_preflight" ]] || rm -f "$host_validity_preflight"
    [[ -z "$host_validity_postflight" ]] || rm -f "$host_validity_postflight"
}
trap cleanup EXIT INT TERM HUP

# Reclaim orphans from prior kills before this run allocates another container.
sweep_harness_postgres_containers

start_postgres() {
    if [[ -n "${RIFFDB_APP_BASELINE_POSTGRES_URL:-}" ]]; then
        # External URL: harness does not own the process; dual-backend runs cannot
        # fully tear it down between phases. Caller is responsible for a proxy-free
        # connect path (host install, host-network container, or bridge IP).
        printf 'using external RIFFDB_APP_BASELINE_POSTGRES_URL (not stopped between phases)\n' >&2
        return 0
    fi
    command -v docker >/dev/null 2>&1 || {
        printf 'docker required when RIFFDB_APP_BASELINE_POSTGRES_URL is unset\n' >&2
        exit 1
    }
    # One more sweep immediately before create — concurrent harnesses / races.
    sweep_harness_postgres_containers
    image='postgres:18.4-bookworm@sha256:d9c83446333daec3f0588cc709adb80c26090b7f9f0f7ec8d43c243385d79818'
    docker pull "$image" >/dev/null
    # Concurrency sweep needs 128 client sessions (+ reserved + harness).
    # Default max_connections=100 is too low for the c=128 point.
    pg_args=()
    if ((load_concurrency_sweep)); then
        pg_args+=(-c max_connections=200)
    fi
    mkdir -p "$postgres_database_root"

    # Measurement integrity: never publish -p HOST:5432. That path runs every
    # benchmark byte through Docker userland docker-proxy (extra copies + cores
    # inside the PG window). Prefer host network + free loopback port; fall
    # back to the container bridge IP with no publish (still proxy-free).
    local run_rc=0 host_port
    host_port="$(pick_free_loopback_port)"
    [[ -n "$host_port" ]] || {
        printf 'failed to allocate free loopback port for harness Postgres\n' >&2
        exit 1
    }

    # Bind-mount PG data onto the same real-disk tree as RiffDB.
    # Label enables reliable orphan sweep after SIGKILL (no EXIT trap).
    set +e
    docker run -d --rm \
        --name "$postgres_container" \
        --label "$postgres_label" \
        --label "riffdb.app-baseline.role=postgres" \
        --label "riffdb.app-baseline.postgres.connect=host_network_loopback" \
        --network=host \
        -e POSTGRES_USER=riffdb \
        -e POSTGRES_PASSWORD=riffdb \
        -e POSTGRES_DB=riffdb_app_baseline \
        --mount "type=bind,source=$postgres_database_root,target=/var/lib/postgresql" \
        "$image" -c "port=${host_port}" "${pg_args[@]}" >/dev/null 2>"$task_tmp_root/riffdb-app-baseline-pg-run.err"
    run_rc=$?
    set -e
    if ((run_rc == 0)); then
        postgres_connect_host="127.0.0.1"
        postgres_connect_port="$host_port"
        postgres_connect_path="host_network_loopback"
        printf 'postgres connect path: host network loopback (no docker-proxy) port=%s\n' \
            "$postgres_connect_port" >&2
    else
        # Rootless / restricted Docker: host network unavailable. Bridge IP with
        # no -p still avoids userland-proxy (clients hit the container veth).
        printf 'host network unavailable; falling back to bridge IP (still no port publish / docker-proxy)\n' >&2
        cat "$task_tmp_root/riffdb-app-baseline-pg-run.err" >&2 || true
        docker run -d --rm \
            --name "$postgres_container" \
            --label "$postgres_label" \
            --label "riffdb.app-baseline.role=postgres" \
            --label "riffdb.app-baseline.postgres.connect=bridge_ip_no_publish" \
            -e POSTGRES_USER=riffdb \
            -e POSTGRES_PASSWORD=riffdb \
            -e POSTGRES_DB=riffdb_app_baseline \
            --mount "type=bind,source=$postgres_database_root,target=/var/lib/postgresql" \
            "$image" "${pg_args[@]}" >/dev/null
        postgres_connect_path="bridge_ip_no_publish"
        postgres_connect_port="5432"
        for _ in $(seq 1 40); do
            postgres_connect_host="$(postgres_bridge_ip)"
            if [[ -n "$postgres_connect_host" ]]; then
                break
            fi
            sleep 0.1
        done
        if [[ -z "$postgres_connect_host" ]]; then
            printf 'failed to resolve Postgres bridge IP\n' >&2
            exit 1
        fi
        printf 'postgres connect path: bridge IP %s:%s (no docker-proxy)\n' \
            "$postgres_connect_host" "$postgres_connect_port" >&2
    fi

    postgres_started=1
    postgres_url_from_harness=1
    export RIFFDB_APP_BASELINE_POSTGRES_CONNECT_PATH="$postgres_connect_path"

    # Container-local readiness (postmaster up on the real listen port). Host-
    # visible TCP is checked separately so we never export a URL that still
    # depends on docker-proxy or an unpublished port we cannot reach.
    tcp_ready() {
        python3 - "$1" "$2" <<'PY'
import socket, sys
host, port = sys.argv[1], int(sys.argv[2])
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.settimeout(0.5)
try:
    s.connect((host, port))
except OSError:
    sys.exit(1)
finally:
    s.close()
sys.exit(0)
PY
    }

    for _ in $(seq 1 90); do
        if [[ "$postgres_connect_path" == "bridge_ip_no_publish" ]]; then
            local ip
            ip="$(postgres_bridge_ip)"
            [[ -n "$ip" ]] && postgres_connect_host="$ip"
        fi
        # Must pass -p: host-network PG listens on a free port, not 5432. Default
        # pg_isready probes the wrong socket and falsely reports not ready.
        if [[ -n "$postgres_connect_host" ]] \
            && docker exec "$postgres_container" \
                pg_isready -h 127.0.0.1 -p "$postgres_connect_port" -U riffdb -d riffdb_app_baseline \
                >/dev/null 2>&1 \
            && tcp_ready "$postgres_connect_host" "$postgres_connect_port"; then
            # pg_isready can race the postmaster still accepting first clients.
            sleep 1
            export RIFFDB_APP_BASELINE_POSTGRES_URL="postgres://riffdb:riffdb@${postgres_connect_host}:${postgres_connect_port}/riffdb_app_baseline"
            return 0
        fi
        sleep 0.25
    done
    printf 'failed to start PostgreSQL for app baseline (connect_path=%s host=%s port=%s)\n' \
        "$postgres_connect_path" "$postgres_connect_host" "$postgres_connect_port" >&2
    docker logs "$postgres_container" 2>&1 | tail -n 40 >&2 || true
    exit 1
}

