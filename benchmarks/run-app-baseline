# Without this boundary `set -e` leaves, at best, a private partial phase file
# and the release gate cannot distinguish a product failure from an omitted
# run. The receipt contains only closed classifications, bounded host
# inventory, and hashes/relative paths to partial evidence; it never copies
# credentials, submitted values, process arguments, or daemon stderr.
write_backend_phase_failure_receipt() {
    local backend="$1" rep_index="$2" phase_status="$3" partial_report="$4"
    local postflight_path="" postflight_status=0
    if [[ -n "$host_validity_preflight" ]]; then
        postflight_path="$(mktemp "$task_tmp_root/riffdb-host-failure-postflight.XXXXXX")"
        set +e
        ./scripts/app-baseline-host-validity >"$postflight_path"
        postflight_status=$?
        set -e
        if ((postflight_status != 0 && postflight_status != 3)); then
            rm -f "$postflight_path"
            postflight_path=""
        fi
    fi
    receipt_args=(
        --output "$report"
        --reason backend_execution_failed
        --mode "$mode"
        --profile "$load_profile"
        --duration-secs "${load_duration_secs:-90}"
        --reps "$balanced_rep_count"
        --postgres-comparator "$postgres_comparator"
        --concurrency-sweep "$load_concurrency_sweep"
        --preflight "$host_validity_preflight"
        --backend "$backend"
        --rep "$rep_index"
        --phase-exit-status "$phase_status"
        --partial-phase-evidence "$partial_report"
    )
    [[ -z "$postflight_path" ]] || receipt_args+=(--postflight "$postflight_path")
    ./scripts/app-baseline-non-evidentiary-receipt "${receipt_args[@]}"
    [[ -z "$postflight_path" ]] || rm -f "$postflight_path"
    printf 'non-evidentiary backend-failure receipt: %s\n' "$report" >&2
}

if ((dual_load_phases)) && ((balanced_rep_count >= 2)); then
    [[ -z "${RIFFDB_APP_BASELINE_POSTGRES_URL:-}" ]] || {
        printf 'balanced dual-backend evidence requires harness-owned PostgreSQL so it can be fully stopped between phases\n' >&2
        exit 2
    }
    phase_args=()
    skip_value=0
    for arg in "${extra_args[@]}"; do
        if ((skip_value)); then
            skip_value=0
            continue
        fi
        if [[ "$arg" == "--reps" ]]; then
            skip_value=1
            continue
        fi
        [[ "$arg" == "--require-stable" ]] && continue
        phase_args+=("$arg")
    done
    phase_reports=()
    for ((rep_index=0; rep_index<balanced_rep_count; rep_index++)); do
        pg_report="$out_dir/.phase-postgres-rep-${rep_index}.json"
        rd_report="$out_dir/.phase-riffdb-rep-${rep_index}.json"
        run_pg_phase() {
            start_postgres
            set +e
            "$runner" "${phase_args[@]}" --reps 1 --skip-riffdb \
                --postgres-url "$RIFFDB_APP_BASELINE_POSTGRES_URL" --output "$pg_report"
            local phase_status=$?
            set -e
            stop_postgres
            if ((phase_status != 0)); then
                ((require_stable)) \
                    && write_backend_phase_failure_receipt \
                        "postgres_${postgres_comparator}" "$rep_index" "$phase_status" "$pg_report"
                return "$phase_status"
            fi
            phase_reports+=("$pg_report")
        }
        run_riffdb_phase() {
            set +e
            "$runner" "${phase_args[@]}" --reps 1 --skip-postgres \
                --riffdbd-bin "$RIFFDB_APP_BASELINE_RIFFDBD_BIN" --output "$rd_report"
            local phase_status=$?
            set -e
            if ((phase_status != 0)); then
                ((require_stable)) \
                    && write_backend_phase_failure_receipt \
                        riffdb_public_grpc "$rep_index" "$phase_status" "$rd_report"
                return "$phase_status"
            fi
            phase_reports+=("$rd_report")
        }
        if ((rep_index % 2 == 0)); then
            run_pg_phase
            run_riffdb_phase
        else
            run_riffdb_phase
            run_pg_phase
        fi
    done
    merge_balanced_load_suite_json "$report" "${phase_reports[@]}"
    rm -f "${phase_reports[@]}"
    if ((require_stable)); then
        jq -e '.evidence_eligibility.stable == true and .reps >= 2' "$report" >/dev/null
    fi
    printf 'merged counterbalanced sequential-phase report: %s\n' "$report"
elif ((dual_load_phases)); then
    printf 'running app baseline (%s) with sequential exclusive backend phases\n' "$mode"
    printf 'phase 1/2: PostgreSQL only (RiffDB not started)\n'
    start_postgres
    pg_report="$out_dir/.phase-postgres-$$.json"
    rd_report="$out_dir/.phase-riffdb-$$.json"
    pg_cmd=("$runner" "${extra_args[@]}" --skip-riffdb --output "$pg_report")
    pg_cmd+=(--postgres-url "$RIFFDB_APP_BASELINE_POSTGRES_URL")
    "${pg_cmd[@]}"
    # Belt-and-suspenders: even if the binary exited cleanly, refuse to tear down
    # (or advance) while the server still shows other client backends.
    if ((postgres_started)); then
        remaining="$(postgres_exec_sql -Atc \
            "SELECT count(*) FROM pg_stat_activity
             WHERE datname = current_database()
               AND pid <> pg_backend_pid()
               AND backend_type = 'client backend'" 2>/dev/null || echo unknown)"
        if [[ "$remaining" != "0" ]]; then
            printf 'measurement-integrity: refusing to stop PostgreSQL: foreign client backends=%s\n' \
                "$remaining" >&2
            postgres_exec_sql -c \
                "SELECT pid, state, left(query, 120) AS query
                 FROM pg_stat_activity
                 WHERE datname = current_database()
                   AND pid <> pg_backend_pid()
                   AND backend_type = 'client backend'
                 ORDER BY pid
                 LIMIT 20" >&2 || true
            exit 1
        fi
        printf 'postgres-quiesce: harness gate ok (foreign client backends=0); stopping Docker PG\n'
    fi
    stop_postgres
    printf 'phase 2/2: RiffDB only (PostgreSQL stopped; exclusive phase)\n'
    rd_cmd=("$runner" "${extra_args[@]}" --skip-postgres --output "$rd_report")
    rd_cmd+=(--riffdbd-bin "$RIFFDB_APP_BASELINE_RIFFDBD_BIN")
    "${rd_cmd[@]}"
    merge_load_suite_json "$pg_report" "$rd_report" "$report"
    rm -f "$pg_report" "$rd_report"
    printf 'merged sequential-phase report: %s\n' "$report"
else
    if ((skip_postgres == 0)); then
        start_postgres
    fi
    printf 'running app baseline (%s)\n' "$mode"
    cmd=("$runner" "${extra_args[@]}" --output "$report")
    ((skip_postgres)) && cmd+=(--skip-postgres)
    ((skip_riffdb)) && cmd+=(--skip-riffdb)
    if ((skip_postgres == 0)); then
        cmd+=(--postgres-url "$RIFFDB_APP_BASELINE_POSTGRES_URL")
    fi
    if ((skip_riffdb == 0)); then
        cmd+=(--riffdbd-bin "$RIFFDB_APP_BASELINE_RIFFDBD_BIN")
    fi
    "${cmd[@]}"
    printf 'report: %s\n' "$report"
fi

if [[ -n "$host_validity_preflight" ]]; then
    host_validity_postflight="$(mktemp "$task_tmp_root/riffdb-host-postflight.XXXXXX")"
    set +e
    ./scripts/app-baseline-host-validity >"$host_validity_postflight"
    host_post_status=$?
    set -e
    [[ "$host_post_status" == 0 || "$host_post_status" == 3 ]] || {
        printf 'postflight host validity inventory failed\n' >&2
        exit 1
    }
    python3 - "$report" "$host_validity_preflight" "$host_validity_postflight" <<'PY'
import json
import sys

report_path, preflight_path, postflight_path = sys.argv[1:]
report = json.load(open(report_path, encoding="utf-8"))
preflight = json.load(open(preflight_path, encoding="utf-8"))
postflight = json.load(open(postflight_path, encoding="utf-8"))
host_idle = bool(preflight.get("valid")) and bool(postflight.get("valid"))
report["host_validity"] = {"preflight": preflight, "postflight": postflight}
eligibility = report.setdefault("evidence_eligibility", {})
eligibility["host_idle"] = host_idle
reasons = list(eligibility.get("reason_codes") or [])
if not host_idle and "host_interference" not in reasons:
    reasons.append("host_interference")
eligibility["reason_codes"] = reasons
eligibility["eligible"] = bool(eligibility.get("eligible")) and host_idle
with open(report_path, "w", encoding="utf-8") as destination:
    json.dump(report, destination, indent=2)
    destination.write("\n")
PY
    if ((require_stable)) && ! jq -e '.evidence_eligibility.host_idle == true' "$report" >/dev/null; then
        printf 'measurement-integrity: host interference invalidated %s\n' "$report" >&2
        exit 1
    fi
fi
