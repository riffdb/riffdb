#!/usr/bin/env bash
# Bank one host column of ADR-0142/0143's frozen unary corpus.
# req: PERF-008, PERF-018
set -euo pipefail
export LC_ALL=C
export TZ=UTC
export PYTHONDONTWRITEBYTECODE=1

usage() {
    printf '%s\n' \
        'usage: benchmarks/run-wp674-unary-profile --profile workstation|n1|e2 --output-dir PATH' >&2
    exit 2
}

profile=
output_dir=
while (($#)); do
    case "$1" in
        --profile)
            (($# >= 2)) || usage
            profile="$2"
            shift 2
            ;;
        --output-dir)
            (($# >= 2)) || usage
            output_dir="$2"
            shift 2
            ;;
        *) usage ;;
    esac
done

[[ "$profile" == workstation || "$profile" == n1 || "$profile" == e2 ]] || usage
[[ -n "$output_dir" ]] || usage
output_requested="$output_dir"
if [[ -n "${RIFFDB_APP_BASELINE_POSTGRES_URL:-}" ]]; then
    printf 'WP-674 requires the harness-owned local PostgreSQL 18 instance; ambient PostgreSQL URL is forbidden\n' >&2
    exit 2
fi
unset RIFFDB_APP_BASELINE_POSTGRES_URL
if ! output_lexical="$(realpath -ms -- "$output_dir")"; then
    printf 'WP-674 output directory could not be normalized\n' >&2
    exit 2
fi
if [[ -L "$output_lexical" ]]; then
    printf 'WP-674 output directory must not be a symbolic link\n' >&2
    exit 2
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

safe_path_components() {
    python3 - "$1" "$2" <<'PY'
from pathlib import Path
import sys
sys.path.insert(0, str(Path.cwd() / "scripts"))
from bounded_evidence_io import reject_symlink_components
reject_symlink_components(Path(sys.argv[1]), allow_missing_leaf=sys.argv[2] == "missing")
PY
}
bounded_jq() {
    local mode="$1" report="$2" filter="$3" scenario="${4:-}"
    python3 - "$mode" "$report" "$filter" "$scenario" <<'PY'
from pathlib import Path
import subprocess
import sys
sys.path.insert(0, str(Path.cwd() / "scripts"))
from bounded_evidence_io import bounded_read
mode, path, filter_text, scenario = sys.argv[1:]
command = ["jq", mode]
if scenario:
    command.extend(["--arg", "scenario", scenario])
command.append(filter_text)
raise SystemExit(subprocess.run(
    command,
    input=bounded_read(Path(path), 32 * 1024 * 1024, "WP-674 generated report"),
).returncode)
PY
}
exclusive_evidence_copy() {
    python3 - "$1" "$2" <<'PY'
from pathlib import Path
import sys
sys.path.insert(0, str(Path.cwd() / "scripts"))
from bounded_evidence_io import exclusive_copy
exclusive_copy(Path(sys.argv[1]), Path(sys.argv[2]), 32 * 1024 * 1024, "WP-674 report copy")
PY
}
bounded_sha256() {
    python3 - "$1" "$2" <<'PY'
from pathlib import Path
import hashlib
import sys
sys.path.insert(0, str(Path.cwd() / "scripts"))
from bounded_evidence_io import bounded_read
print(hashlib.sha256(bounded_read(Path(sys.argv[1]), int(sys.argv[2]), "WP-674 identity input")).hexdigest())
PY
}
append_attempt_status() {
    python3 - "$attempt_statuses" "$1" "$2" <<'PY'
from pathlib import Path
import sys
sys.path.insert(0, str(Path.cwd() / "scripts"))
from bounded_evidence_io import bounded_append
bounded_append(
    Path(sys.argv[1]),
    f"{sys.argv[2]}\t{sys.argv[3]}\n".encode(),
    1024,
    "WP-674 attempt ledger",
)
PY
}
if ! safe_path_components "$output_requested" missing; then
    printf 'WP-674 output path contains a linked or invalid component\n' >&2
    exit 2
fi
safe_path_components Cargo.lock present
safe_path_components benchmarks/run-app-baseline present

# Receipt mode executes each scenario in a fresh run, and every run requires a
# clean source tree. Refuse a stale nested lock before the first measurement:
# allowing Cargo to rewrite it while building the runner would make the second
# scenario fail the clean-tree gate after the first result had already been
# retained.
cargo +1.97.0 metadata --locked --manifest-path examples/app-baseline/Cargo.toml \
    --format-version 1 >/dev/null
if ! git diff --quiet --ignore-submodules -- || \
   ! git diff --cached --quiet --ignore-submodules -- || \
   [[ -n "$(git ls-files --others --exclude-standard)" ]]; then
    printf 'WP-674 profile banking requires an exact clean source tree\n' >&2
    exit 2
fi

if [[ -n "${RIFFDB_APP_BASELINE_RIFFDBD_BIN:-}" && -x "$RIFFDB_APP_BASELINE_RIFFDBD_BIN" ]]; then
    riffdbd_bin="$RIFFDB_APP_BASELINE_RIFFDBD_BIN"
else
    cargo +1.97.0 build --locked --release -p riffdb-server --bin riffdbd
    riffdbd_bin="$(cargo +1.97.0 metadata --locked --format-version 1 \
        | jq -r .target_directory)/release/riffdbd"
fi
if [[ -n "${RIFFDB_APP_BASELINE_RUNNER_BIN:-}" && -x "$RIFFDB_APP_BASELINE_RUNNER_BIN" ]]; then
    app_baseline_runner="$RIFFDB_APP_BASELINE_RUNNER_BIN"
else
    cargo +1.97.0 build --locked --release \
        --manifest-path examples/app-baseline/Cargo.toml -p riffdb-app-baseline
    app_baseline_runner="$(cargo +1.97.0 metadata --locked \
        --manifest-path examples/app-baseline/Cargo.toml --format-version 1 \
        | jq -r .target_directory)/release/riffdb-app-baseline"
fi
[[ -x "$riffdbd_bin" && -x "$app_baseline_runner" ]] || {
    printf 'WP-674 campaign binaries are absent after the exact build\n' >&2
    exit 2
}
safe_path_components "$riffdbd_bin" present
safe_path_components "$app_baseline_runner" present
export RIFFDB_APP_BASELINE_RIFFDBD_BIN="$riffdbd_bin"
export RIFFDB_APP_BASELINE_RUNNER_BIN="$app_baseline_runner"

# The output directory cannot live inside the repository. Every measured run
# re-checks the clean tree, and creating an untracked directory here makes the
# very first scenario fail with "--require-stable requires an exact clean source
# tree" -- after the profile has already declared itself clean, which reads like
# a contradiction. Write outside the tree and copy the fragment in afterwards,
# which is what assembling the manifest expects anyway.
# `realpath -m` resolves `..` without requiring the path to exist, so a path
# that leaves the tree is not refused for merely starting inside it.
candidate="$(realpath -m -- "$output_dir")"
repo_real="$(realpath -m -- "$repo_root")"
if [[ "$candidate" == "$repo_real" || "$candidate" == "$repo_real"/* ]]; then
    printf 'WP-674 --output-dir must be outside the repository (%s is inside %s).\n' \
        "$candidate" "$repo_real" >&2
    printf 'Each measured run re-checks the clean tree, so an untracked output\n' >&2
    printf 'directory here fails every scenario. Write to e.g. $HOME/tmp/wp674/%s\n' \
        "$profile" >&2
    printf 'and copy profile-fragment.json under release/evidence/wp-674/ after.\n' >&2
    exit 2
fi

case "$profile" in
    workstation) hardware_class=workstation_nvme ;;
    n1) hardware_class=gcp_n1_persistent_disk ;;
    e2) hardware_class=gcp_e2_persistent_disk ;;
esac

mkdir -p "$candidate"
output_dir="$candidate"
if [[ ! -d "$output_dir" || -L "$output_dir" ]]; then
    printf 'WP-674 output custody is not an owned directory\n' >&2
    exit 2
fi
if ! output_inventory="$(find "$output_dir" -mindepth 1 -print -quit)"; then
    printf 'WP-674 %s: output directory inventory failed\n' "$profile" >&2
    exit 2
fi
if [[ -n "$output_inventory" ]]; then
    printf 'WP-674 %s: output directory must be empty for one exact-artifact run\n' \
        "$profile" >&2
    exit 2
fi
attempts_dir="$output_dir/attempts"
mkdir "$attempts_dir"
attempt_statuses="$attempts_dir/status.tsv"
python3 - "$attempt_statuses" <<'PY'
from pathlib import Path
import sys
sys.path.insert(0, str(Path.cwd() / "scripts"))
from bounded_evidence_io import exclusive_empty
exclusive_empty(Path(sys.argv[1]), "WP-674 attempt ledger")
PY
task_tmp_root="${RIFFDB_TMP_ROOT:-$HOME/tmp}"
if ! safe_path_components "$task_tmp_root" missing; then
    printf 'WP-674 temporary root contains a linked or invalid component\n' >&2
    exit 2
fi
mkdir -p "$task_tmp_root"
export TMPDIR="$task_tmp_root"

scenarios=(
    point_get_ticket
    point_get_user
    list_tickets_by_project_status
    list_open_tickets_for_assignee
    list_comments_for_ticket
    list_project_members
    ticket_detail_page
    board_page_50
    board_page_200
    board_page_450
    create_comment
    close_ticket_with_comment
    swap_member_roles
    open_ticket_with_labels
)

campaign_identity="$attempts_dir/campaign-identity.json"
source_revision="$(git rev-parse --verify HEAD)"
cargo_lock_sha256="$(bounded_sha256 Cargo.lock $((2 * 1024 * 1024)))"
harness_sha256="$(bounded_sha256 benchmarks/run-app-baseline $((1024 * 1024)))"
runner_sha256="$(bounded_sha256 "$app_baseline_runner" $((256 * 1024 * 1024)))"
riffdbd_sha256="$(bounded_sha256 "$riffdbd_bin" $((256 * 1024 * 1024)))"
python3 - "$campaign_identity" "$profile" "$source_revision" \
    "$cargo_lock_sha256" "$harness_sha256" "$runner_sha256" \
    "$riffdbd_sha256" <<'PY'
import copy
import json
from pathlib import Path
import sys

path, profile, revision, cargo_lock, harness, runner, riffdbd = sys.argv[1:]
sys.path.insert(0, str(Path.cwd() / "scripts"))
from wp674_host_policy import CAMPAIGN_METHOD, CAMPAIGN_SCHEMA

identity = {
    "schema": CAMPAIGN_SCHEMA,
    "profile": profile,
    "source_revision": revision,
    "cargo_lock_sha256": cargo_lock,
    "harness_sha256": harness,
    "runner_sha256": runner,
    "riffdbd_sha256": riffdbd,
    "method": copy.deepcopy(CAMPAIGN_METHOD),
}
from bounded_evidence_io import exclusive_write
exclusive_write(
    Path(path),
    (json.dumps(identity, indent=2) + "\n").encode(),
    16 * 1024,
    "WP-674 campaign identity",
)
PY

campaign_identity_is_exact() {
    git diff --quiet --ignore-submodules -- \
        && git diff --cached --quiet --ignore-submodules -- \
        && [[ -z "$(git ls-files --others --exclude-standard)" ]] \
        && python3 - "$campaign_identity" "$profile" \
            "$(git rev-parse --verify HEAD)" \
            "$(bounded_sha256 Cargo.lock $((2 * 1024 * 1024)))" \
            "$(bounded_sha256 benchmarks/run-app-baseline $((1024 * 1024)))" \
            "$(bounded_sha256 "$app_baseline_runner" $((256 * 1024 * 1024)))" \
            "$(bounded_sha256 "$riffdbd_bin" $((256 * 1024 * 1024)))" <<'PY'
import json
from pathlib import Path
import sys

path, profile, revision, cargo_lock, harness, runner, riffdbd = sys.argv[1:]
sys.path.insert(0, str(Path.cwd() / "scripts"))
from bounded_evidence_io import bounded_read
from wp674_host_policy import validate_campaign_identity_value

actual = json.loads(bounded_read(Path(path), 16 * 1024, "WP-674 campaign identity").decode())
validate_campaign_identity_value(actual, profile, {
    "source_revision": revision,
    "cargo_lock_sha256": cargo_lock,
    "harness_sha256": harness,
    "runner_sha256": runner,
    "riffdbd_sha256": riffdbd,
})
PY
}

require_campaign_identity() {
    if ! campaign_identity_is_exact; then
        printf 'WP-674 %s: campaign source/artifact/method identity drifted\n' \
            "$profile" >&2
        return 1
    fi
}

host_invalid_attempt() {
    local report="$1" comparator="$2" scenario="${3:-}"
    local command=(
        ./scripts/check-wp674-unary-baseline
        --validate-host-invalid-receipt "$report"
        --profile "$profile"
        --comparator "$comparator"
    )
    [[ -z "$scenario" ]] || command+=(--scenario "$scenario")
    "${command[@]}" >/dev/null 2>&1
}

safe_app_attempt_shape_is_exact() {
    local report="$1" scenario="$2"
    bounded_jq -e "$report" '
      .schema == "riffdb.app-baseline/v1"
      and .evidence_eligibility.host_idle == true
      and .host_validity.preflight.schema == "riffdb.app-baseline-host-validity/v2"
      and .host_validity.postflight.schema == "riffdb.app-baseline-host-validity/v2"
      and .host_validity.postflight.whole_cell.valid == true
      and .host_validity.postflight.whole_cell.maximum_steal_percent == 1
      and .evidence_eligibility.correctness_clean == true
      and .evidence_eligibility.same_device_comparable == true
      and .evidence_eligibility.comparison_complete == true
      and .qualification_candidate.schema == "riffdb.app-baseline-qualified-candidate/v1"
      and .unary_qualification.scenario == $scenario
      and .unary_qualification.process_generations == 5
      and .unary_qualification.same_scenario_warmups_after_restart == 20
      and .unary_qualification.measured_operations_per_generation == 1000
      and (.comparisons.unary_rep_summaries[$scenario] != null)
    ' "$scenario" >/dev/null
}

# ADR-0171: the central-three spread rule binds the gated backend. RiffDB's
# values gate the release, so an unstable RiffDB cell is a completed unstable
# cell and the retry prohibition applies. PostgreSQL still runs in every
# generation and its five-value summary is still required and retained, but its
# spread is published as disclosure rather than aborting the profile -- the
# comparator's measurement stability is not a property RiffDB can influence and
# its ratios are not a gate.
#
# The comparator's shape is still checked here. Only the 1.20 bound is lifted,
# so a missing or malformed PostgreSQL summary still fails.
safe_app_attempt_spread_is_valid() {
    local report="$1" scenario="$2"
    bounded_jq -e "$report" '
      def five_positive_generations:
        (.values | sort) as $values |
        .reps == 5
        and ($values | length) == 5
        and ($values | all(type == "number" and . > 0));
      def central_three_stable:
        five_positive_generations
        and ((.values | sort)[3] / (.values | sort)[1]) <= 1.20;
      .comparisons.unary_rep_summaries[$scenario] as $summary |
      ([$summary.postgres.p50_ns, $summary.postgres.p95_ns]
        | all(five_positive_generations))
      and ([$summary.riffdb.p50_ns, $summary.riffdb.p95_ns]
        | all(central_three_stable))
    ' "$scenario" >/dev/null
}

# Names the comparator statistics whose spread exceeded the bound, so the
# profile can carry ADR-0171's required disclosure instead of discarding the
# attempt. Prints nothing when the comparator was stable.
safe_app_comparator_disclosure() {
    local report="$1" scenario="$2"
    bounded_jq -r "$report" '
      .comparisons.unary_rep_summaries[$scenario] as $summary |
      [$summary.postgres | to_entries[]
        | select(.key == "p50_ns" or .key == "p95_ns")
        | (.value.values | sort) as $values
        | select(($values[3] / $values[1]) > 1.20)
        | {statistic: .key, central_three_spread: ($values[3] / $values[1])}
      ] | if length == 0 then empty else tojson end
    ' "$scenario"
}

minimal_attempt_shape_is_exact() {
    local report="$1"
    bounded_jq -e "$report" '
      .schema == "riffdb.app-baseline/v1"
      and .evidence_eligibility.host_idle == true
      and .host_validity.preflight.schema == "riffdb.app-baseline-host-validity/v2"
      and .host_validity.postflight.schema == "riffdb.app-baseline-host-validity/v2"
      and .host_validity.postflight.whole_cell.valid == true
      and .host_validity.postflight.whole_cell.maximum_steal_percent == 1
      and .evidence_eligibility.correctness_clean == true
      and .evidence_eligibility.same_device_comparable == true
      and .evidence_eligibility.comparison_complete == true
      and .qualification_candidate.schema == "riffdb.app-baseline-qualified-candidate/v1"
      and .reps == 5
      and ((.comparisons.unary_rep_summaries | length) == 14)
    ' >/dev/null
}

# ADR-0171, as above: RiffDB's spread gates, the comparator's is disclosed.
minimal_attempt_spread_is_valid() {
    local report="$1"
    bounded_jq -e "$report" '
      def five_positive_generations:
        (.values | sort) as $values |
        .reps == 5
        and ($values | length) == 5
        and ($values | all(type == "number" and . > 0));
      ([.comparisons.unary_rep_summaries[] |
        .postgres.p50_ns, .postgres.p95_ns,
        .riffdb.p50_ns, .riffdb.p95_ns] | all(five_positive_generations))
    ' >/dev/null
}

run_host_attempt() {
    local attempt="$1" attempt_root="$attempts_dir/host-attempt-$1"
    local scenario attempt_report attempt_status comparator_disclosure
    require_campaign_identity
    mkdir -p "$attempt_root"
    for scenario in "${scenarios[@]}"; do
        attempt_report="$attempt_root/safe-app-$scenario.json"
        printf 'WP-674 %s: host attempt %s/2, safe-app %s\n' \
            "$profile" "$attempt" "$scenario"
        require_campaign_identity
        set +e
        RIFFDB_APP_BASELINE_UNARY_QUALIFICATION_SCENARIO="$scenario" \
        RIFFDB_APP_BASELINE_DEFER_UNARY_STABILITY=1 \
        RIFFDB_APP_BASELINE_WP674_RECEIPT=1 \
            ./benchmarks/run-app-baseline \
                --full --samples 1000 --warmup 20 --reps 5 --require-stable \
                --postgres-comparator safe-app --output "$attempt_report"
        attempt_status=$?
        set -e
        require_campaign_identity
        if ((attempt_status != 0)); then
            if host_invalid_attempt "$attempt_report" safe-app "$scenario"; then
                return 10
            fi
            printf 'WP-674 %s: non-retryable failure for %s in host attempt %s\n' \
                "$profile" "$scenario" "$attempt" >&2
            return 1
        fi
        if ! safe_app_attempt_shape_is_exact "$attempt_report" "$scenario"; then
            printf 'WP-674 %s: non-retryable evidence drift for %s in host attempt %s\n' \
                "$profile" "$scenario" "$attempt" >&2
            return 1
        fi
        if ! safe_app_attempt_spread_is_valid "$attempt_report" "$scenario"; then
            printf 'WP-674 %s: unstable completed RiffDB cell retained; retry prohibited: %s\n' \
                "$profile" "$scenario" >&2
            return 1
        fi
        # ADR-0171: the comparator's instability is disclosed, not fatal. Print
        # it as the profile runs so an operator sees it while the evidence is
        # being produced, rather than only in the assembled receipt.
        comparator_disclosure="$(safe_app_comparator_disclosure "$attempt_report" "$scenario")"
        if [[ -n "$comparator_disclosure" ]]; then
            printf 'WP-674 %s: comparator spread disclosed for %s: %s\n' \
                "$profile" "$scenario" "$comparator_disclosure"
        fi
        if ! bounded_jq -e "$attempt_report" \
            '.evidence_eligibility.eligible == true' >/dev/null; then
            printf 'WP-674 %s: non-retryable eligibility drift for %s\n' \
                "$profile" "$scenario" >&2
            return 1
        fi
    done

    attempt_report="$attempt_root/minimal.json"
    printf 'WP-674 %s: host attempt %s/2, complete minimal disclosure\n' \
        "$profile" "$attempt"
    require_campaign_identity
    set +e
    RIFFDB_APP_BASELINE_DEFER_UNARY_STABILITY=1 \
    RIFFDB_APP_BASELINE_WP674_RECEIPT=1 \
        ./benchmarks/run-app-baseline \
            --full --samples 1000 --warmup 20 --reps 5 --require-stable \
            --postgres-comparator minimal --output "$attempt_report"
    attempt_status=$?
    set -e
    require_campaign_identity
    if ((attempt_status != 0)); then
        if host_invalid_attempt "$attempt_report" minimal; then
            return 10
        fi
        printf 'WP-674 %s: non-retryable minimal failure at attempt %s\n' \
            "$profile" "$attempt" >&2
        return 1
    fi
    if ! minimal_attempt_shape_is_exact "$attempt_report"; then
        printf 'WP-674 %s: non-retryable minimal evidence drift at attempt %s\n' \
            "$profile" "$attempt" >&2
        return 1
    fi
    if ! minimal_attempt_spread_is_valid "$attempt_report"; then
        printf 'WP-674 %s: unstable completed minimal cell retained; retry prohibited\n' \
            "$profile" >&2
        return 1
    fi
    if ! bounded_jq -e "$attempt_report" \
        '.evidence_eligibility.eligible == true' >/dev/null; then
        printf 'WP-674 %s: non-retryable minimal eligibility drift\n' "$profile" >&2
        return 1
    fi
    return 0
}

accepted_attempt=0
for attempt in 1 2; do
    # The parent must capture the typed attempt status without disabling
    # errexit inside the attempt. A function invoked as an `if` condition runs
    # with Bash's errexit semantics suppressed throughout its body, which can
    # turn an unexpected evidence-custody failure into continued measurement.
    set +e
    (
        set -e
        run_host_attempt "$attempt"
    )
    status=$?
    set -e
    if ((status == 0)); then
        append_attempt_status "$attempt" accepted
        accepted_attempt="$attempt"
        break
    fi
    if ((status == 10)); then
        append_attempt_status "$attempt" host_invalid
        printf 'WP-674 %s: retaining host-invalid attempt %s\n' \
            "$profile" "$attempt" >&2
        if ((attempt == 1)); then
            continue
        fi
    fi
    exit 1
done
if ((accepted_attempt == 0)); then
    printf 'WP-674 %s: no accepted host attempt\n' "$profile" >&2
    exit 1
fi

require_campaign_identity

accepted_root="$attempts_dir/host-attempt-$accepted_attempt"
for scenario in "${scenarios[@]}"; do
    exclusive_evidence_copy \
        "$accepted_root/safe-app-$scenario.json" "$output_dir/safe-app-$scenario.json"
done
minimal="$output_dir/minimal.json"
exclusive_evidence_copy "$accepted_root/minimal.json" "$minimal"

source_revision="$(git rev-parse --verify HEAD)"
cargo_lock_sha256="$(bounded_sha256 Cargo.lock $((2 * 1024 * 1024)))"
harness_sha256="$(bounded_sha256 benchmarks/run-app-baseline $((1024 * 1024)))"
governance_predecessor_sha256="$(bounded_sha256 \
    release/evidence/wp-674/adr0143-failed-attempts-v1.json $((64 * 1024)))"
fragment="$output_dir/profile-fragment.json"
python3 - "$fragment" "$profile" "$hardware_class" "$source_revision" \
    "$cargo_lock_sha256" "$harness_sha256" "$governance_predecessor_sha256" \
    "$minimal" "$attempt_statuses" "$campaign_identity" \
    "${scenarios[@]}" <<'PY'
import hashlib
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path.cwd() / "scripts"))
from bounded_evidence_io import bounded_read, exclusive_write

(
    fragment_path,
    profile,
    hardware_class,
    source_revision,
    cargo_lock_sha256,
    harness_sha256,
    governance_predecessor_sha256,
    minimal_path,
    attempt_statuses_path,
    campaign_identity_path,
    *scenarios,
) = sys.argv[1:]
root = Path(fragment_path).parent

def reference(path: Path, maximum: int = 32 * 1024 * 1024) -> dict[str, str]:
    encoded = bounded_read(path, maximum, "WP-674 fragment reference")
    return {
        "path": path.relative_to(root).as_posix(),
        "sha256": hashlib.sha256(encoded).hexdigest(),
    }

reports = []
for scenario in scenarios:
    path = root / f"safe-app-{scenario}.json"
    reports.append({"scenario": scenario, **reference(path)})
host_attempts = []
for line in bounded_read(
    Path(attempt_statuses_path), 1024, "WP-674 attempt ledger"
).decode().splitlines():
    attempt_text, status = line.split("\t")
    attempt = int(attempt_text)
    attempt_root = root / "attempts" / f"host-attempt-{attempt}"
    attempt_reports = []
    for scenario in scenarios:
        path = attempt_root / f"safe-app-{scenario}.json"
        if path.is_file():
            attempt_reports.append({"scenario": scenario, **reference(path)})
    minimal_attempt = attempt_root / "minimal.json"
    host_attempts.append({
        "attempt": attempt,
        "status": status,
        "reports": attempt_reports,
        "minimal_report": reference(minimal_attempt) if minimal_attempt.is_file() else None,
    })
fragment = {
    "schema": "riffdb.wp-674-unary-profile/v2",
    "source_revision": source_revision,
    "cargo_lock_sha256": cargo_lock_sha256,
    "harness_sha256": harness_sha256,
    "governance_predecessor_sha256": governance_predecessor_sha256,
    "profile": {
        "id": profile,
        "hardware_class": hardware_class,
