contract ClinicScheduling version 1 {
  entity Patient {
    key (clinic_id: uuid, patient_id: uuid)
    field name: string<128>
    field created_at: timestamp
    delete_policy cascade {
      relationship Appointment.patient using Appointment.by_patient maximum 64
    }
  }

  entity Appointment {
    key (clinic_id: uuid, patient_id: uuid, appointment_id: uuid)
    field scheduled_at: timestamp
    field purpose: string<256>
    field created_at: timestamp
    index by_patient (clinic_id, patient_id, appointment_id)
    index by_upcoming (clinic_id, scheduled_at, appointment_id, patient_id)
    reference patient (clinic_id, patient_id) -> Patient(clinic_id, patient_id)
    delete_policy no_inbound
  }

  aggregate PatientRoot {
    root Patient
    child Appointment
    partition_by clinic_id
    conflict_key (clinic_id, patient_id)
  }

  command CreatePatient {
    input idempotency_key: string<128>
    input clinic_id: uuid
    input patient_id: uuid
    input name: string<128>
    idempotency_key idempotency_key
    create Patient(clinic_id, patient_id) as patient
      else PatientExists { patient_id: patient_id }
    set patient.name = name
    set patient.created_at = tx.time
    return Created { patient: patient }
  }

  command ScheduleAppointment {
    input idempotency_key: string<128>
    input clinic_id: uuid
    input patient_id: uuid
    input appointment_id: uuid
    input scheduled_at: timestamp
    input purpose: string<256>
    idempotency_key idempotency_key
    read Patient(clinic_id, patient_id) as patient
      else PatientMissing { patient_id: patient_id }
    create Appointment(clinic_id, patient_id, appointment_id) as appointment
      else AppointmentExists { appointment_id: appointment_id }
    set appointment.scheduled_at = scheduled_at
    set appointment.purpose = purpose
    set appointment.created_at = tx.time
    return Scheduled { appointment: appointment }
  }
}
