// Performance-surface contract.
//
// The ticketdesk benchmark contract declares no projection, no text index and
// no tokenized index, so the projection evaluator, the exact byte-prefix text
// path and the tokenized provider have never been measured. This contract
// exists only to give those subsystems benchmark coverage. It is deliberately
// small: one entity per covered mechanism, one command that feeds them, and
// nothing else, so that a measurement attributes to the mechanism rather than
// to incidental work.
//
// It is a separate contract rather than an addition to ticketdesk so the
// banked ticketdesk baselines stay comparable.
contract PerfSurface version 1 {
  enum DocumentState { Draft, Published, Archived }

  entity Workspace {
    key (workspace_id: uuid)
    field name: string<64>
    field created_at: timestamp
  }

  entity Document {
    key (workspace_id: uuid, document_id: uuid)
    field title: string<200>
    field body: string<4096>
    field state: DocumentState
    field size_bytes: i64
    field created_at: timestamp

    index by_workspace (workspace_id, document_id)
    // Exact byte-prefix text ordering: executable today through named reads.
    index by_title (workspace_id, title, document_id)
      text_key(title, binary_utf8_v1)
    // Declaration-only tokenized index: maintains durable provider state on
    // every write, which is the part that is measurable now.
    text_index search((title weight 4, body weight 1),
      analyzer standard_v1,
      staleness_slo 60,
      replay_age_seconds 86400,
      replay_bytes 1073741824,
      replay_backlog 100000,
      result boolean_v1,
      max_terms 16,
      max_candidates 10000,
      max_results 1000)
  }

  aggregate Documents {
    root Document
    partition_by workspace_id
    conflict_key (workspace_id)
  }

  aggregate Workspaces {
    root Workspace
    partition_by workspace_id
    conflict_key (workspace_id)
  }

  event DocumentPublished {
    partition_by (workspace_id)
    workspace_id: uuid
    document_id: uuid
    state: DocumentState
    size_bytes: i64
  }

  command CreateWorkspace {
    input idempotency_key: string<128>
    input workspace_id: uuid
    input name: string<64>
    idempotency_key idempotency_key
    create Workspace(workspace_id) as workspace
      else WorkspaceExists { workspace_id: workspace_id }
    set workspace.name = name
    set workspace.created_at = tx.time
    return Created { workspace: workspace }
  }

  command PublishDocument {
    input idempotency_key: string<128>
    input workspace_id: uuid
    input document_id: uuid
    input title: string<200>
    input body: string<4096>
    input size_bytes: i64
    idempotency_key idempotency_key
    read Workspace(workspace_id) as workspace
      else WorkspaceMissing { workspace_id: workspace_id }
    create Document(workspace_id, document_id) as document
      else DocumentExists { document_id: document_id }
    set document.title = title
    set document.body = body
    set document.state = DocumentState.Published
    set document.size_bytes = size_bytes
    set document.created_at = tx.time
    emit DocumentPublished {
      workspace_id: workspace_id,
      document_id: document_id,
      state: DocumentState.Published,
      size_bytes: size_bytes
    }
    return Published { document: document }
  }

  projection PublishedBytesDaily {
    source event DocumentPublished
    key (workspace_id, tx.date)
    measure published_bytes = sum(size_bytes)
    frontier transactionally_ordered
  }
}
