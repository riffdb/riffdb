#!/usr/bin/env bash
set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"
if [[ "${1:-}" == "--output" ]]; then
    [[ $# == 2 ]] || { echo "usage: $0 [--output PATH]" >&2; exit 2; }
    output="$2"
elif [[ $# == 0 ]]; then
    output="target/app-baseline/resilience-v1.json"
else
    echo "usage: $0 [--output PATH]" >&2
    exit 2
fi
log_root="${RIFFDB_APP_BASELINE_RESILIENCE_LOG_ROOT:-target/app-baseline/resilience-logs}"
task_tmp_root="${RIFFDB_TMP_ROOT:-$HOME/tmp}"
mkdir -p "$(dirname "$output")" "$log_root" "$task_tmp_root"
export TMPDIR="$task_tmp_root"

results="$(mktemp "$task_tmp_root/riffdb-resilience-results.XXXXXX")"
trap 'rm -f "$results"' EXIT INT TERM HUP

run_cell() {
    local cell="$1"
    shift
    local log="$log_root/$cell.log"
    local began ended status
    began="$(date +%s%N)"
    if "$@" >"$log" 2>&1; then
        status=passed
    else
        status=failed
    fi
    ended="$(date +%s%N)"
    printf '%s\t%s\t%s\t%s\t%s\n' \
        "$cell" "$status" "$((ended - began))" "$log" "$(sha256sum "$log" | awk '{print $1}')" \
        >>"$results"
}

run_cell build_riffdbd cargo +1.97.0 build --locked -p riffdb-server --bin riffdbd
export RIFFDB_APP_BASELINE_RIFFDBD_BIN="$repo_root/target/debug/riffdbd"
run_cell kill_under_load env RUN_RIFFDB_DEAD_PEER=1 \
    cargo +1.97.0 test --manifest-path examples/app-baseline/Cargo.toml \
    --test dead_peer_abort kill_daemon_mid_load_aborts_within_two_seconds -- --exact
run_cell lost_response_replay cargo +1.97.0 test -p riffdb-commit \
    --test lost_response_replay committed_unknown_response_replays_exactly_after_reopen -- --exact
run_cell durable_consumer_crash_matrix cargo +1.97.0 test -p riffdb-testkit \
    --test durable_event_consumers process_crash_matrix_preserves_every_consumer_transition -- --exact
run_cell authorization_revoked_mid_wait cargo +1.97.0 test -p riffdb-service \
    --test projected_read_acceptance revocation_mid_wait_denies_at_the_post_wake_safe_point -- --exact
run_cell successor_role_reconciliation cargo +1.97.0 test -p riffdb-cli \
    widened_successor_role_compiles_from_the_pinned_parent_aware_bundle
run_cell retained_history_growth ./scripts/benchmark-command-growth --smoke

python3 - "$results" "$output" <<'PY'
import json
import sys

results_path, output_path = sys.argv[1:3]
cells = []
with open(results_path, encoding="utf-8") as source:
    for line in source:
        cell, status, elapsed_ns, log, digest = line.rstrip("\n").split("\t")
        cells.append({
            "cell": cell,
            "status": status,
            "elapsed_ns": int(elapsed_ns),
            "log": log,
            "sha256": digest,
        })
failed = [cell["cell"] for cell in cells if cell["status"] != "passed"]
report = {
    "schema": "riffdb.app-baseline-resilience/v1",
    "status": "passed" if not failed else "failed",
    "cells": cells,
    "failed_cells": failed,
    "guarantees": {
        "kill_under_load_is_process_real": True,
        "lost_response_replay_is_exact": True,
        "durable_consumer_crash_matrix": True,
        "authorization_revalidation_mid_wait": True,
        "retained_history_growth_gate": True,
    },
    "claim_boundary": (
        "This suite combines process-real application-load death with focused deterministic "
        "recovery/evolution tests. It does not turn focused test latency into application throughput."
    ),
}
with open(output_path, "w", encoding="utf-8") as destination:
    json.dump(report, destination, indent=2)
    destination.write("\n")
PY

if jq -e '.status == "passed"' "$output" >/dev/null; then
    printf 'resilience report: %s\n' "$output"
else
    printf 'resilience suite failed; report: %s\n' "$output" >&2
    exit 1
fi
