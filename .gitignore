/target/
/xtask/target/
/examples/app-baseline/target/
/examples/**/target/

# Rebuildable local exact-query provider checkpoints. The daemon resolves its
# projections root against the current directory when none is configured, so a
# tool run from a subdirectory drops one there too.
/projections/
projections/

# Public marketing website
/website/node_modules/
/website/dist/
/website/.astro/
/website/test-results/
/website/playwright-report/

# Nested crate unit-test target (CARGO_MANIFEST_DIR/target fallback)
/crates/riffdb-bench-root/target/

# Python bytecode caches
__pycache__/
*.py[cod]
*.egg-info/

# Local maturin develop copies of the Python native extension
/clients/python/runtime/src/riffdb_application/_native*.so

# TypeScript app-baseline diagnostic (lock/generated artifacts are rebuilt by the launcher)
/examples/app-baseline/typescript/node_modules/
/examples/app-baseline/typescript/dist/
/examples/app-baseline/typescript/generated/
/examples/app-baseline/typescript/riffdb.application.lock.json

# Go app-baseline lock/generated artifacts are rebuilt by the launcher
/examples/app-baseline/golang/generated/
/examples/app-baseline/golang/riffdb.application.lock.json

# AI coding tools
.serena

# Compiled Go harness binary (built by benchmarks/run-app-baseline-golang).
/examples/app-baseline/golang/app-baseline-golang

# Build artifacts, anywhere in the tree. The anchored rules above missed nested
# crates (benchmarks/*/target, examples/*/postgres/target), and compiled output
# was committed into history as a result. It carried absolute developer paths
# into a public repo and more than doubled the repository size. These unanchored
# rules match a target directory at any depth; do not replace them with anchored
# ones.
target/
build/
*.rlib
*.rmeta
*.rcgu.o
*.pdb
*.pyc
*.pyo

# Compiled binaries produced by the benchmark launchers.
/examples/app-baseline/golang/app-baseline-golang

# Secrets and local environment. Never commit a real value for any of these.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*.keytab
.netrc
credentials.json
service-account*.json

# cowboy: agent.yaml and security.yaml are checked in; everything else is
# per-session local state and may contain transcripts, host paths and addresses.
.cowboy/*
!.cowboy/agent.yaml
!.cowboy/security.yaml
