---
import markUrl from "../../../assets/riffdb-mark.svg?url";

interface Props {
  href?: string;
  footer?: boolean;
}

const { href = "/", footer = false } = Astro.props;
---

<a class:list={["logo", { "logo--footer": footer }]} href={href} aria-label="RiffDB home">
  <img class="logo-mark" src={markUrl} alt="" aria-hidden="true" data-riffdb-mark />
  <span>RiffDB</span>
</a>
