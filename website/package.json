{
  "name": "riffdb-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.3.0",
    "npm": "11.16.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "check": "prettier --check . && astro check && tsc --noEmit -p tsconfig.functions.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "astro": "7.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.12.1",
    "@cloudflare/workers-types": "5.20260809.1",
    "@playwright/test": "1.62.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.120.0"
  }
}
