#!/usr/bin/env bash
set -euo pipefail

crate_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
grammar="$crate_root/src/grammar.lalrpop"
reference="$crate_root/LANGUAGE.md"
public_reference="$crate_root/../../docs/contracts/LANGUAGE.md"
temporary="$(mktemp)"
trap 'rm -f "$temporary"' EXIT

{
    cat <<'EOF'
# RiffDB Contract Language Reference v14

<!-- Generated by generate-language-reference. Do not edit by hand. -->

This is the complete grammar-version-14 parser source. Grammar v14 retains the
complete prior language and adds an explicit ordered `cover (...)` clause on
new index identities.
Normative semantics, bounds, compatibility gates, and the prohibition on
general loops and raw transactions are defined by ADR-0002 as amended by
ADR-0015, ADR-0107, ADR-0109, and ADR-0133. Semantic actions below construct only the
source-oriented AST; they are not typed IR, an executable plan, or a durable
encoding.

## Complete Grammar

```lalrpop
EOF
    cat "$grammar"
    printf '%s\n' '```'
} >"$temporary"

case "${1:-}" in
    "")
        cp "$temporary" "$reference"
        mv "$temporary" "$public_reference"
        ;;
    --check)
        if ! cmp -s "$temporary" "$reference"; then
            diff -u "$reference" "$temporary" || true
            echo "contract language reference is stale" >&2
            exit 1
        fi
        if ! cmp -s "$temporary" "$public_reference"; then
            diff -u "$public_reference" "$temporary" || true
            echo "public contract language reference is stale" >&2
            exit 1
        fi
        ;;
    *)
        echo "usage: $0 [--check]" >&2
        exit 2
        ;;
esac
