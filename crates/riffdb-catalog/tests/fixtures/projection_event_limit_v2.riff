contract ProjectionEventLimit version 2 {
  entity Row {
    key (id: uuid)
    field value: i64
  }

  event Huge {
    bucket: i64
    data: bytes<1048546>
    present: optional<bool>
  }

  aggregate Rows {
    root Row
    partition_by id
    conflict_key (id)
  }

  command Record {
    input idempotency_key: string<128>
    input id: uuid
    input bucket: i64
    input data: bytes<1048546>
    idempotency_key idempotency_key
    mutate Row(id) as changed_row else Missing { id: id }
    set changed_row.value = 1
    emit Huge { bucket: bucket, data: data }
    return Recorded { row: changed_row }
  }

  projection HugeCount {
    source event Huge
    key (bucket)
    measure item_count = count()
    frontier transactionally_ordered
  }
}
