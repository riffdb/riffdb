digraph G {
  graph [rankdir=TB, bgcolor="white", pad="0.22", nodesep="0.28", ranksep="0.40", fontname="Liberation Sans", fontsize=18, label="Command execution and uncertain-response recovery", labelloc="t", labeljust="l"];
  node [shape=box, style="rounded,filled", fontname="Liberation Sans", fontsize=10, margin="0.14,0.08", color="#18324A", fillcolor="#F5F8FA", fontcolor="#152536"];
  edge [color="#45677E", penwidth=1.25, arrowsize=0.68, fontname="Liberation Sans", fontsize=8.5, fontcolor="#35566D"];

  client [label="1  Client / MCP sends typed command\nwith fresh request ID + caller idempotency key", fillcolor="#EAF3F6"];
  admit [label="2  Authenticate • bounded decode\nconstruct checked RequestContext"];
  authorize [label="3  Resolve and classify exact plan\nderive exact facts • initial authorization", shape=diamond, fillcolor="#F7FAFB"];
  prestart_failed [label="Append one standalone durable Failed audit\nfor an intrinsically audited pre-start failure\nno admission • no application sequence", fillcolor="#FFF2DC", color="#A26A21"];
  prestart_return [label="Audit durable: return original safe failure", fillcolor="#FFF2DC", color="#A26A21"];
  audit_start [label="4  Append durable Started audit\nusing AdministrationClock", fillcolor="#FFF7E8"];
  denied [label="Append one standalone durable Denied audit\nreturn AuthorizationDenied\nno admission • no application sequence", fillcolor="#FFF2DC", color="#A26A21"];
  denied_return [label="Always return AuthorizationDenied\naudit failure marks unhealthy; unknown also fences writes", fillcolor="#FFF2DC", color="#A26A21"];
  audit_outage [label="Standalone / Started append not proven durable\nno business work • StorageUnavailable\nunknown status also fences writes", fillcolor="#FFF2DC", color="#A26A21"];
  permit [label="5  Wait for bounded executor-capacity permit\nStarted is already durable"];
  final_auth [label="6  Derive fresh exact facts\nand authorize again", shape=diamond, fillcolor="#F7FAFB"];
  poststart_terminal [label="Append the one terminal audit\nDenied • Failed • Cancelled\nno business admission", fillcolor="#FFF2DC", color="#A26A21"];
  poststart_return [label="Audit durable: return selected safe denial / failure / cancellation", fillcolor="#FFF2DC", color="#A26A21"];
  poststart_outage [label="Terminal append abort / unknown before admission\nStorageUnavailable • no protected output", fillcolor="#FFF2DC", color="#A26A21"];
  lookup [label="7  Synchronously consume permit as admission\nthen recheck idempotency identity", shape=diamond, fillcolor="#F7FAFB"];
  stored [label="Load persisted committed outcome\nreplayed=true • original CommitSequence\nno duplicate mutation/event", fillcolor="#CFE6E8", penwidth=1.7];
  stored_failed [label="Load terminal ExecutionFailed\nno CommittedOutcome • no application CommitSequence", fillcolor="#FFF2DC", color="#A26A21"];
  mismatch [label="Produce IdempotencyKeyReuse\nno evaluation • no application CommitSequence", fillcolor="#FFF2DC", color="#A26A21"];
  reserve [label="8  Create or resume durable Pending reservation\nfixed tx.time • input hash • admission request ID • plan\nno CommitSequence or ProvenanceId", fillcolor="#FFF7E8"];
  lock [label="9  Derive and acquire canonical conflict keys"];
  snapshot [label="10  Materialize bounded snapshot\nand observed dependencies outside runtime"];
  run [label="11  Deterministic runtime evaluates owned values\nand exact plan, then returns EvaluatedCommand\nor Arithmetic / ResourceLimit fault"];
  fault_validate [label="12F  Coordinator revalidates every\ninfluential entity/range dependency", shape=diamond, fillcolor="#F7FAFB"];
  failed_terminal [label="Atomically terminalize admission as ExecutionFailed\nno CommitIntent • outcome • event • provenance\nor application CommitSequence", fillcolor="#FFF2DC", color="#A26A21"];
  provenance [label="12  For a successfully evaluated new attempt only:\nobtain one ProvenanceId before opening write transaction"];
  coord [label="13  Assemble CommitIntent from exact stored admission/claims\n+ ProvenanceId + plan evidence + unchanged EvaluatedCommand\nthen recheck reservation, dependencies, predicates, capability"];
  durable [label="14  Assign CommitSequence and atomically persist terminal set\nadmission • entities • indexes • outcome • event + intent\nprovenance • commit record (no initial outbox status)", fillcolor="#DCEFF0", penwidth=2.0];
  shape [label="15  Fully filter, redact, and bound the semantic result\nbefore recording Succeeded"];
  audit_terminal [label="16  Attempt the selected terminal audit once\nSucceeded • Denied • Cancelled • Failed • OutcomeUncertain", fillcolor="#FFF7E8"];
  audit_failure [label="Terminal append failure withholds output\nknown command / ExecutionFailed: OutcomeUnknown\nknown precommit-only result: StorageUnavailable", fillcolor="#FFF2DC", color="#A26A21"];
  delivered [label="17  Terminal audit durable and\nresponse reaches client?", shape=diamond, fillcolor="#FFF2DC", color="#A26A21"];
  normal [label="Return safe typed result\ncommit sequence only when the stored outcome has one", fillcolor="#CFE6E8"];
  retry [label="18  Client retries same idempotency key\nwith a fresh RequestId, or calls GetOutcome", fillcolor="#EAF3F6"];
  projection [label="Projection applies commit N to one identity/generation\nthen atomically persists rows • marker N • frontier N", fillcolor="#FFF7E8"];

  client -> admit -> authorize;
  authorize -> audit_start [label="allow"];
  authorize -> denied [label="deny"];
  authorize -> prestart_failed [label="classified failure"];
  denied -> denied_return [label="durable / abort / unknown"];
  prestart_failed -> prestart_return [label="durable"];
  prestart_failed -> audit_outage [label="abort / unknown"];
  audit_start -> permit [label="durable"];
  audit_start -> audit_outage [label="abort / unknown"];
  permit -> final_auth;
  final_auth -> lookup [label="allow • synchronous submit"];
  final_auth -> poststart_terminal [label="deny / failure / cancel"];
  poststart_terminal -> poststart_return [label="durable"];
  poststart_terminal -> poststart_outage [label="abort / unknown"];
  lookup -> stored [label="committed terminal + equal input"];
  lookup -> stored_failed [label="ExecutionFailed terminal + equal input"];
  lookup -> mismatch [label="same identity + different input"];
  lookup -> reserve [label="new or pending + equal input"];
  reserve -> lock -> snapshot -> run;
  run -> provenance [label="EvaluatedCommand"];
  provenance -> coord;
  run -> fault_validate [label="Arithmetic / ResourceLimit"];
  fault_validate -> failed_terminal [label="all equal"];
  fault_validate -> lock [label="changed: release / reacquire\nthen bounded full reevaluation", constraint=false];
  coord -> durable -> shape -> audit_terminal;
  audit_terminal -> delivered [label="append durable"];
  audit_terminal -> audit_failure [label="abort / unknown"];
  failed_terminal -> audit_terminal [label="failed"];
  stored -> audit_terminal [label="replay succeeded"];
  stored_failed -> audit_terminal [label="replay failed"];
  mismatch -> audit_terminal [label="terminal failure"];
  delivered -> normal [label="yes"];
  delivered -> retry [label="no / unknown"];
  audit_failure -> retry [label="same-key resolution when OutcomeUnknown"];
  retry -> admit [label="same key • new audited invocation"];
  durable -> projection [label="ordered commit log", constraint=false];
}
