query GetAuthSession(
    $organization_id: AuthSession.organization_id,
    $user_id: AuthSession.user_id,
    $session_id: AuthSession.session_id,
) {
    one session from AuthSession
        where organization_id == $organization_id
          && user_id == $user_id
          && session_id == $session_id
        else Missing

    return Found {
        session: session {
            organization_id
            user_id
            session_id
            state
            expires_at
        }
    }

    outcomes Found | Missing
}
