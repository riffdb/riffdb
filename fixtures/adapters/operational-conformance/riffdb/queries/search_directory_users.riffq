query SearchDirectoryUsers(
    $organization_id: DirectoryUser.organization_id,
    $needle: DirectoryUser.email,
    $excluded_states: Set<DirectoryUser.state>,
    $maximum_created_at: DirectoryUser.created_at?,
    $limit: Limit<499> = 25,
    $offset: u64 = 0
) {
    many users from DirectoryUser
        where organization_id == $organization_id
          && email contains $needle
          && state not_in $excluded_states
          && when $maximum_created_at { created_at <= $maximum_created_at }
        order by created_at desc, user_id asc
        take $limit offset $offset

    aggregate total from users { exact_count() as value }

    return Found {
        users: users { organization_id user_id email state created_at reviewed_at }
        total: total { value }
    }
    outcomes Found
}
