contract AdapterOperationalConformance version 1 {
  enum AuthSessionState { AuthActive, AuthRevoked }

  entity FgaTuple {
    key (store_id: uuid, tuple_id: uuid)
    field object: string<256>
    field relation: string<64>
    field subject: string<256>
    index all_tuples (store_id, tuple_id)
    index by_relation (store_id, relation, tuple_id)
  }

  entity Metric {
    key (experiment_id: uuid, metric_id: uuid)
    field name: string<128>
    field value_micros: i64
    field step: i64
    index all_metrics (experiment_id, metric_id)
  }

  entity Document {
    key (site_id: uuid, document_id: uuid)
    field title: string<256>
    field published_at: optional<timestamp>
    index by_title (site_id, title, document_id) text_key(title, binary_utf8_v1)
    index by_published (site_id, published_at, document_id) presence(published_at)
  }

  entity DirectoryUser {
    key (organization_id: uuid, user_id: uuid)
    field email: string<320>
    field state: string<32>
    field created_at: u64
    field reviewed_at: optional<timestamp>
    index directory_by_email (organization_id, email, user_id) text_key(email, binary_utf8_v1)
    index directory_by_state (organization_id, state, user_id)
    index directory_by_created (organization_id, created_at, user_id)
    index directory_by_reviewed (organization_id, reviewed_at, user_id) presence(reviewed_at)
  }

  entity InventoryRecord {
    key (organization_id: uuid, record_id: uuid)
    field subtitle: optional<string<128>>
    field observed_at: optional<timestamp>
    field tie_rank: u64
    index inventory_by_subtitle (organization_id, subtitle, tie_rank, record_id) presence(subtitle)
    index inventory_by_observed (organization_id, observed_at, tie_rank, record_id) presence(observed_at)
  }

  entity Pipeline {
    key (organization_id: uuid, pipeline_id: uuid)
    field name: string<128>
    field state: string<32>
    index all_pipelines (organization_id, pipeline_id)
    index by_state (organization_id, state, pipeline_id)
  }

  entity AuthUser {
    key (organization_id: uuid, user_id: uuid)
    field email: string<320>
    unique auth_user_email (organization_id, email)
  }

  entity AuthSession {
    key (organization_id: uuid, user_id: uuid, session_id: uuid)
    field state: AuthSessionState
    field secret token_digest: string<128>
    field expires_at: timestamp
    unique auth_session_token (organization_id, token_digest)
    reference auth_session_user (organization_id, user_id) -> AuthUser(organization_id, user_id)
  }

  entity AuthSignupInput {
    key (organization_id: uuid, user_id: uuid, session_id: uuid)
    field email: string<320>
    field secret token_digest: string<128>
    field expires_at: timestamp
  }

  entity Ticket {
    key (organization_id: uuid, ticket_id: uuid)
    field state: string<32>
    field title: string<128>
    index by_state (organization_id, state, ticket_id)
  }

  entity TicketComment {
    key (organization_id: uuid, ticket_id: uuid, comment_id: uuid)
    field body: string<256>
    field created_at: u64
    index by_ticket (organization_id, ticket_id, created_at, comment_id)
    reference ticket (organization_id, ticket_id) -> Ticket(organization_id, ticket_id)
  }

  entity MlflowRun {
    key (experiment_id: uuid, run_id: uuid)
    field lifecycle: string<32>
    index by_lifecycle (experiment_id, lifecycle, run_id)
  }

  entity MlflowRunTag {
    key (experiment_id: uuid, run_id: uuid, tag_id: uuid)
    field name: string<128>
    field value: string<256>
    index by_run (experiment_id, run_id, tag_id)
    reference run (experiment_id, run_id) -> MlflowRun(experiment_id, run_id)
  }

  entity FgaObject {
    key (store_id: uuid, object_id: uuid)
    field kind: string<64>
    index by_kind (store_id, kind, object_id)
  }

  entity FgaRelation {
    key (store_id: uuid, object_id: uuid, relation_id: uuid)
    field relation: string<64>
    field subject: string<256>
    index by_object (store_id, object_id, relation_id)
    reference object (store_id, object_id) -> FgaObject(store_id, object_id)
  }

  aggregate FgaTuples {
    root FgaTuple
    partition_by store_id
    conflict_key (store_id, tuple_id)
  }

  aggregate Metrics {
    root Metric
    partition_by experiment_id
    conflict_key (experiment_id, metric_id)
  }

  aggregate Documents {
    root Document
    partition_by site_id
    conflict_key (site_id, document_id)
  }

  aggregate DirectoryUsers {
    root DirectoryUser
    partition_by organization_id
    conflict_key (organization_id, user_id)
  }

  aggregate InventoryRecords {
    root InventoryRecord
    partition_by organization_id
    conflict_key (organization_id, record_id)
  }

  aggregate Pipelines {
    root Pipeline
    partition_by organization_id
    conflict_key (organization_id, pipeline_id)
  }

  aggregate AuthSessions {
    root AuthUser
    child AuthSession
    child AuthSignupInput
    partition_by organization_id
    conflict_key (organization_id, user_id)
  }

  aggregate Tickets {
    root Ticket
    child TicketComment
    partition_by organization_id
    conflict_key (organization_id, ticket_id)
  }

  aggregate MlflowRuns {
    root MlflowRun
    child MlflowRunTag
    partition_by experiment_id
    conflict_key (experiment_id, run_id)
  }

  aggregate FgaObjects {
    root FgaObject
    child FgaRelation
    partition_by store_id
    conflict_key (store_id, object_id)
  }

  workflow AuthSessionLifecycle {
    entity AuthSession
    state state
    initial AuthActive
    transition AuthRevoke from (AuthActive) to AuthRevoked
  }

  bulk command WriteTuples {
    input request_id: uuid
    input tuples: list<FgaTuple, 1..32>
    idempotency_key request_id
    for tuple in tuples {
      create FgaTuple(tuple.store_id, tuple.tuple_id) as stored else TupleAlreadyExists {}
      set stored.object = tuple.object
      set stored.relation = tuple.relation
      set stored.subject = tuple.subject
    }
    return TuplesWritten {}
  }

  bulk command LogMetrics {
    input request_id: uuid
    input metrics: list<Metric, 1..32>
    idempotency_key request_id
    for metric in metrics {
      create Metric(metric.experiment_id, metric.metric_id) as stored else MetricAlreadyExists {}
      set stored.name = metric.name
      set stored.value_micros = metric.value_micros
      set stored.step = metric.step
    }
    return MetricsLogged {}
  }

  bulk command CreateDocuments {
    input request_id: uuid
    input documents: list<Document, 1..32>
    idempotency_key request_id
    for document in documents {
      create Document(document.site_id, document.document_id) as stored else DocumentAlreadyExists {}
      set stored.title = document.title
      set stored.published_at = document.published_at
    }
    return DocumentsCreated {}
  }

  bulk command CreateDirectoryUsers {
    input request_id: uuid
    input users: list<DirectoryUser, 1..32>
    idempotency_key request_id
    for candidate in users {
      create DirectoryUser(candidate.organization_id, candidate.user_id) as stored else DirectoryUserAlreadyExists {}
      set stored.email = candidate.email
      set stored.state = candidate.state
      set stored.created_at = candidate.created_at
      set stored.reviewed_at = candidate.reviewed_at
    }
    return DirectoryUsersCreated {}
  }

  command CreateInventoryRecordMissing {
    input request_id: uuid
    input organization_id: uuid
    input record_id: uuid
    input tie_rank: u64
    idempotency_key request_id
    create InventoryRecord(organization_id, record_id) as record else InventoryRecordAlreadyExists {}
    set record.tie_rank = tie_rank
    return InventoryRecordMissingCreated {}
  }

  bulk command CreateInventoryRecords {
    input request_id: uuid
    input records: list<InventoryRecord, 1..32>
    idempotency_key request_id
    for candidate in records {
      create InventoryRecord(candidate.organization_id, candidate.record_id) as record else InventoryRecordBatchAlreadyExists {}
      set record.subtitle = candidate.subtitle
      set record.observed_at = candidate.observed_at
      set record.tie_rank = candidate.tie_rank
    }
    return InventoryRecordsCreated {}
  }

  command ChangeInventoryRecordState {
    input request_id: uuid
    input organization_id: uuid
    input record_id: uuid
    input subtitle: optional<string<128>>
    input observed_at: optional<timestamp>
    input tie_rank: u64
    idempotency_key request_id
    mutate InventoryRecord(organization_id, record_id) as record else InventoryRecordMissing {}
    set record.subtitle = subtitle
    set record.observed_at = observed_at
    set record.tie_rank = tie_rank
    return InventoryRecordStateChanged { record: record }
  }

  bulk command CreatePipelines {
    input request_id: uuid
    input pipelines: list<Pipeline, 1..32>
    idempotency_key request_id
    for pipeline in pipelines {
      create Pipeline(pipeline.organization_id, pipeline.pipeline_id) as stored else PipelineAlreadyExists {}
      set stored.name = pipeline.name
      set stored.state = pipeline.state
    }
    return PipelinesCreated {}
  }

  bulk command CreateAuthSessions {
    input request_id: uuid
    input signups: list<AuthSignupInput, 1..8>
    idempotency_key request_id
    for signup in signups {
      create AuthUser(signup.organization_id, signup.user_id) as user else UserAlreadyExists {}
      create AuthSession(signup.organization_id, signup.user_id, signup.session_id) as session else SessionAlreadyExists {}
      set user.email = signup.email
      set session.token_digest = signup.token_digest
      set session.expires_at = signup.expires_at
    }
    return SessionsCreated {}
  }

  bulk command SeedTickets {
    input request_id: uuid
    input tickets: list<Ticket, 1..8>
    idempotency_key request_id
    for candidate in tickets {
      create Ticket(candidate.organization_id, candidate.ticket_id) as stored else TicketAlreadyExists {}
      set stored.state = candidate.state
      set stored.title = candidate.title
    }
    return TicketsSeeded {}
  }

  bulk command SeedTicketComments {
    input request_id: uuid
    input comments: list<TicketComment, 1..32>
    idempotency_key request_id
    for candidate in comments {
      read Ticket(candidate.organization_id, candidate.ticket_id) as ticket else TicketMissing {}
      create TicketComment(candidate.organization_id, candidate.ticket_id, candidate.comment_id) as stored else TicketCommentAlreadyExists {}
      set stored.body = candidate.body
      set stored.created_at = candidate.created_at
    }
    return TicketCommentsSeeded {}
  }

  bulk command SeedRuns {
    input request_id: uuid
    input runs: list<MlflowRun, 1..8>
    idempotency_key request_id
    for candidate in runs {
      create MlflowRun(candidate.experiment_id, candidate.run_id) as stored else MlflowRunAlreadyExists {}
      set stored.lifecycle = candidate.lifecycle
    }
    return RunsSeeded {}
  }

  bulk command SeedRunTags {
    input request_id: uuid
    input tags: list<MlflowRunTag, 1..32>
    idempotency_key request_id
    for candidate in tags {
      read MlflowRun(candidate.experiment_id, candidate.run_id) as run else MlflowRunMissing {}
      create MlflowRunTag(candidate.experiment_id, candidate.run_id, candidate.tag_id) as stored else MlflowRunTagAlreadyExists {}
      set stored.name = candidate.name
      set stored.value = candidate.value
    }
    return RunTagsSeeded {}
  }

  bulk command SeedObjects {
    input request_id: uuid
    input objects: list<FgaObject, 1..8>
    idempotency_key request_id
    for candidate in objects {
      create FgaObject(candidate.store_id, candidate.object_id) as stored else FgaObjectAlreadyExists {}
      set stored.kind = candidate.kind
    }
    return ObjectsSeeded {}
  }

  bulk command SeedObjectRelations {
    input request_id: uuid
    input relations: list<FgaRelation, 1..32>
    idempotency_key request_id
    for candidate in relations {
      read FgaObject(candidate.store_id, candidate.object_id) as object else FgaObjectMissing {}
      create FgaRelation(candidate.store_id, candidate.object_id, candidate.relation_id) as stored else FgaRelationAlreadyExists {}
      set stored.relation = candidate.relation
      set stored.subject = candidate.subject
    }
    return ObjectRelationsSeeded {}
  }

  reimport command ReconstituteFgaTuples {
    input records: list<FgaTuple, 1..32>
    reconstitute FgaTuple from records else TupleAlreadyExists {}
    return FgaTuplesReconstituted {}
  }

  reimport command ReconstituteDocuments {
    input records: list<Document, 1..32>
    reconstitute Document from records else DocumentAlreadyExists {}
    return DocumentsReconstituted {}
  }

}
