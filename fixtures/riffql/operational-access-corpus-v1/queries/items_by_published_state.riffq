query ItemsByPublishedState(
    $workspace_id: CatalogItem.workspace_id,
    $after: Cursor?,
) {
    many items from CatalogItem
        where workspace_id == $workspace_id && published_at is not null
        order by published_at asc nulls last, item_id asc
        take 16 after $after
    return Found { items: items { item_id code kind score published_at } }
    outcomes Found
}
