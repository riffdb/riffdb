query ItemsInScoreWindow(
    $workspace_id: CatalogItem.workspace_id,
    $minimum: CatalogItem.score,
    $maximum: CatalogItem.score,
    $after: Cursor?,
) {
    many items from CatalogItem
        where workspace_id == $workspace_id
          && score >= $minimum
          && score < $maximum
        order by score asc, item_id asc
        take 16 after $after
    return Found { items: items { item_id code kind score published_at } }
    outcomes Found
}
