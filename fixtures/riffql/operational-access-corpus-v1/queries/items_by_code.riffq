query ItemsByCode(
    $workspace_id: CatalogItem.workspace_id,
    $code: CatalogItem.code,
    $after: Cursor?,
) {
    many items from CatalogItem
        where workspace_id == $workspace_id && code == $code
        order by item_id asc
        take 16 after $after
    return Found { items: items { item_id code kind score published_at } }
    outcomes Found
}
