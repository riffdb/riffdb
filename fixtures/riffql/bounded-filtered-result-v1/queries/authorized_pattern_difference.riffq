query ExperimentsWithoutNamePattern(
    $scope: Experiment.scope,
    $name_pattern: string<500>,
    $limit: Limit<50000> = 1000,
    $after: Cursor?,
) {
    candidates matching_experiments: Experiment.experiment_id
        from difference {
            Experiment.experiment_id using by_updated
                where scope == $scope;
            Experiment.experiment_id using by_name_pattern
                where scope == $scope
                    && name like $name_pattern,
        }
        within 65535
        else IntegrityFailure

    many experiments from Experiment
        where scope == $scope
            && experiment_id in matching_experiments
        order by creation_time desc, experiment_id asc
        take $limit after $after
        else IntegrityFailure

    return Found {
        experiments: experiments { experiment_id, name, creation_time }
    }
    outcomes Found | IntegrityFailure
}
