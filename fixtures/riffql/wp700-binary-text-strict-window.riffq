query ItemsInCodeWindow(
    $organization_id: Item.organization_id,
    $lower: Item.code,
    $upper: Item.code,
    $after: Cursor?,
) {
    many items from Item
        where organization_id == $organization_id && code > $lower && code < $upper
        order by code asc, item_id asc
        take 1 after $after
    return Found { items: items { item_id code } }
    outcomes Found
}
