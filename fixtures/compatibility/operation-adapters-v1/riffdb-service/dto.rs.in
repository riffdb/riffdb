    pub const fn sequence(self) -> CommitSequence {
        self.sequence
    }
    /// Returns the caller's optional observed history incarnation.
    #[must_use]
    pub const fn observed_history_incarnation(self) -> Option<u64> {
        self.observed_history_incarnation
    }
}

