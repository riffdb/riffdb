contract CrossPartitionReference version 1 {
  entity Tenant { key (tenant_id: uuid) }
  entity Parent { key (tenant_id: uuid, parent_id: uuid) }
  entity Child {
    key (tenant_id: uuid, child_id: uuid)
    field parent_id: uuid
    reference parent (tenant_id, parent_id) -> Parent(tenant_id, parent_id)
  }
  aggregate ParentFamily {
    root Parent
    partition_by parent_id
    conflict_key (tenant_id, parent_id)
  }
  aggregate ChildFamily {
    root Tenant
    child Child
    partition_by tenant_id
    conflict_key (tenant_id)
  }
}
