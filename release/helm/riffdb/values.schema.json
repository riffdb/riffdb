{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "RiffDB bounded Helm values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nameOverride",
    "fullnameOverride",
    "namespace",
    "image",
    "server",
    "proxy",
    "acceptanceJobs",
    "podSecurityContext",
    "nodeSelector",
    "tolerations",
    "affinity"
  ],
  "properties": {
    "nameOverride": { "$ref": "#/definitions/optionalDnsLabel" },
    "fullnameOverride": { "$ref": "#/definitions/optionalDnsLabel" },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "$ref": "#/definitions/dnsLabel" }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy", "pullSecrets"],
      "properties": {
        "repository": { "$ref": "#/definitions/nonemptyBoundedString" },
        "tag": { "type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9_.-]*$" },
        "pullPolicy": { "$ref": "#/definitions/pullPolicy" },
        "pullSecrets": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": { "name": { "$ref": "#/definitions/dnsLabel" } }
          }
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "environment",
        "audience",
        "terminationGracePeriodSeconds",
        "listener",
        "resources",
        "probes",
        "secretName",
        "tlsTrustRootFile",
        "persistence"
      ],
      "properties": {
        "replicas": { "type": "integer", "const": 1 },
        "environment": { "$ref": "#/definitions/nonemptyBoundedString" },
        "audience": { "$ref": "#/definitions/nonemptyBoundedString" },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 2, "maximum": 600 },
        "listener": {
          "type": "object",
          "additionalProperties": false,
          "required": ["port", "bounds"],
          "properties": {
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "bounds": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "maxConnections",
                "maxStreamsPerConnection",
                "handshakeTimeoutSeconds",
                "idleTimeoutSeconds",
                "keepaliveIntervalSeconds",
                "drainTimeoutSeconds"
              ],
              "properties": {
                "maxConnections": { "type": "integer", "minimum": 1, "maximum": 4096 },
                "maxStreamsPerConnection": { "type": "integer", "minimum": 1, "maximum": 1024 },
                "handshakeTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 30 },
                "idleTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
                "keepaliveIntervalSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
                "drainTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 300 }
              }
            }
          }
        },
        "resources": { "$ref": "#/definitions/serverResources" },
        "probes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["liveness", "readiness"],
          "properties": {
            "liveness": { "$ref": "#/definitions/probe" },
            "readiness": { "$ref": "#/definitions/probe" }
          }
        },
        "secretName": { "$ref": "#/definitions/dnsLabel" },
        "tlsTrustRootFile": { "$ref": "#/definitions/secretKey" },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["data", "backups"],
          "properties": {
            "data": { "$ref": "#/definitions/dataVolume" },
            "backups": { "$ref": "#/definitions/backupVolume" }
          }
        }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "replicas", "port", "resources"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag", "digest", "pullPolicy"],
          "properties": {
            "repository": { "$ref": "#/definitions/nonemptyBoundedString" },
            "tag": { "$ref": "#/definitions/nonemptyBoundedString" },
            "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "pullPolicy": { "$ref": "#/definitions/pullPolicy" }
          }
        },
        "replicas": { "type": "integer", "minimum": 1, "maximum": 16 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "resources": { "$ref": "#/definitions/containerResources" }
      }
    },
    "acceptanceJobs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "applicationSecretName",
        "operatorSecretName",
        "activeDeadlineSeconds",
        "backoffLimit",
        "resources"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "applicationSecretName": { "$ref": "#/definitions/dnsLabel" },
        "operatorSecretName": { "$ref": "#/definitions/dnsLabel" },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "backoffLimit": { "type": "integer", "const": 0 },
        "resources": { "$ref": "#/definitions/containerResources" }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runAsNonRoot", "runAsUser", "runAsGroup"],
      "properties": {
        "runAsNonRoot": { "type": "boolean", "const": true },
        "runAsUser": { "type": "integer", "const": 65532 },
        "runAsGroup": { "type": "integer", "const": 65532 }
      }
    },
    "nodeSelector": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": { "type": "string", "maxLength": 63 }
    },
    "tolerations": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "object", "maxProperties": 8 }
    },
    "affinity": { "type": "object", "maxProperties": 32 }
  },
  "definitions": {
    "nonemptyBoundedString": { "type": "string", "minLength": 1, "maxLength": 253 },
    "dnsLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "optionalDnsLabel": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "secretKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]{0,252}$"
    },
    "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
    "quantity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16,
      "pattern": "^[1-9][0-9]*(m|Ki|Mi|Gi)?$"
    },
    "resourcePair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": { "$ref": "#/definitions/quantity" },
        "memory": { "$ref": "#/definitions/quantity" }
      }
    },
    "serverResources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "$ref": "#/definitions/resourcePair" },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["memory"],
          "properties": {
            "cpu": { "$ref": "#/definitions/quantity" },
            "memory": { "$ref": "#/definitions/quantity" }
          }
        }
      }
    },
    "containerResources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "$ref": "#/definitions/resourcePair" },
        "limits": { "$ref": "#/definitions/resourcePair" }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["periodSeconds", "timeoutSeconds", "failureThreshold"],
      "properties": {
        "periodSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 30 },
        "failureThreshold": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "storageClass": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
    },
    "volumeSize": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16,
      "pattern": "^[1-9][0-9]*(Mi|Gi)$"
    },
    "accessModes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["ReadWriteOnce", "ReadWriteOncePod", "ReadWriteMany"] }
    },
    "dataVolume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "storageClassName", "accessModes"],
      "properties": {
        "size": { "$ref": "#/definitions/volumeSize" },
        "storageClassName": { "$ref": "#/definitions/storageClass" },
        "accessModes": { "$ref": "#/definitions/accessModes" }
      }
    },
    "backupVolume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "size", "storageClassName", "accessModes"],
      "properties": {
        "enabled": { "type": "boolean", "const": true },
        "size": { "$ref": "#/definitions/volumeSize" },
        "storageClassName": { "$ref": "#/definitions/storageClass" },
        "accessModes": { "$ref": "#/definitions/accessModes" }
      }
    }
  }
}
