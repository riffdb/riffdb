    "board_limit_mode": "static_compiled",
    "board_limit_note": "RiffDB BoardPage50/200/450 use static take N \u2264 450 so take+continuation-probe stays within MAX_QUERY_SCANNED_ROWS=500. take 500 fails (RDB-INTERNAL-0001). PostgreSQL keeps LIMIT $4.",
    "board_marginal_formula": "(p50_450 \u2212 p50_50) / 400",
