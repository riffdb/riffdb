 //! ADR-0182 bounded dirty startup proofs over the shared recovery fixtures.
 use super::*;

+// req: STO-001, REC-001, REC-004, PERF-018
+/// One pinned admission batch proves every absent key from the same bounded
+/// suffix walk. The proof expires with that call and never warms the population
+/// index or hides a subsequently published outcome.
+#[test]
+fn cold_admission_batch_scans_its_pinned_suffix_once() {
+    let path = TestDatabasePath::new("cold-admission-batch-suffix");
+    prepare_command_database(&path.0);
+    let controller = RedbTestController::observe_index_migration();
+    let store =
+        RedbStore::open_with_test_controller(&path.0, controller.clone()).expect("dirty reopen");
+    let session = store
+        .begin_structural_evidence(startup_inputs())
+        .expect("begin bounded evidence");
+    assert!(session.bounded_dirty_startup_path());
+    let ports = complete_structural_open_from(session)
+        .into_parts()
+        .3
+        .into_operational_after_catalog_validation()
+        .expect("activate cold ports");
+    let fixtures: Vec<_> = (1..=10).map(two_phase_command_fixture_at).collect();
+    for fixture in &fixtures[..2] {
+        let request = AdmissionRequestV1::new(fixture.candidates.clone(), &fixture.context)
+            .expect("admission request");
+        assert_eq!(
+            ports.admit_or_resolve(request).expect("admit fixture"),
+            AdmissionResultV1::Created(fixture.pending.clone())
+        );
+    }
+    let publish = |fixture| {
+        let epoch = ports.begin_deferred_command_epoch().expect("begin epoch");
+        DeferredCommandEpoch::seal(apply_unpublished_command_fixture(epoch, fixture))
+            .expect("seal command")
+            .wait()
+            .expect("publish command");
+    };
+    publish(&fixtures[0]);
+    let before = controller.fresh_locator_history_fallback_scans();
+    let rows_before = controller.fresh_locator_history_fallback_rows();
+    let mut candidates: Vec<_> = fixtures.iter().map(|f| f.candidates.clone()).collect();
+    candidates.push(fixtures[0].candidates.clone());
+    candidates.push(
+        IdempotencyLookupCandidatesV1::new(
+            fixtures[..2]
+                .iter()
+                .flat_map(|f| f.candidates.as_slice().iter().cloned())
+                .collect(),
+        )
+        .expect("multiple matching identities"),
+    );
+    let results = ports
+        .lookup_admission_group(candidates)
+        .expect("mixed cold batch");
+    assert!(matches!(
+        &results[0],
+        AdmissionLookupResultV1::Found(value)
+            if matches!(value.as_ref(), StoredAdmissionStateV1::StoredOutcome(_))
+    ));
+    assert_eq!(
+        results[1],
+        AdmissionLookupResultV1::Found(Box::new(StoredAdmissionStateV1::Pending(
+            fixtures[1].pending.clone()
+        )))
+    );
+    assert!(
+        results[2..10]
+            .iter()
+            .all(|value| *value == AdmissionLookupResultV1::NotFound)
+    );
+    assert_eq!(
+        results[10], results[0],
+        "a prior miss cannot mask a locator"
+    );
+    assert_eq!(results[11], AdmissionLookupResultV1::MultipleMatches);
+    assert_eq!(
+        controller.fresh_locator_history_fallback_scans() - before,
+        1,
+        "the batch must validate its pinned suffix once, not once per missing terminal"
+    );
+    assert_eq!(
+        controller.fresh_locator_history_fallback_rows() - rows_before,
+        1
+    );
+    assert_eq!(ports.transient_index_rebuilds(), 0);
+
+    let before = controller.fresh_locator_history_fallback_scans();
+    assert_eq!(
+        ports
+            .lookup_admission(fixtures[2].candidates.clone())
+            .expect("independent batch"),
+        AdmissionLookupResultV1::NotFound
+    );
+    assert_eq!(
+        controller.fresh_locator_history_fallback_scans() - before,
+        1
+    );
+
+    publish(&fixtures[1]);
+    assert!(matches!(
+        ports.lookup_admission(fixtures[1].candidates.clone()).expect("new snapshot"),
+        AdmissionLookupResultV1::Found(value)
+            if matches!(value.as_ref(), StoredAdmissionStateV1::StoredOutcome(_))
+    ));
+    let request = AdmissionRequestV1::new(fixtures[2].candidates.clone(), &fixtures[2].context)
+        .expect("previously absent identity");
+    ports.admit_or_resolve(request).expect("admit new identity");
+    publish(&fixtures[2]);
+    assert!(matches!(
+        ports.lookup_admission(fixtures[2].candidates.clone()).expect("later publication"),
+        AdmissionLookupResultV1::Found(value)
+            if matches!(value.as_ref(), StoredAdmissionStateV1::StoredOutcome(_))
+    ));
+    assert_eq!(ports.transient_index_rebuilds(), 0);
+}
+
 // req: REC-001, REC-002, REC-004, REC-005, PERF-019
 /// OBL-0182-1 proof (ADR-0182 Decision 1). A startup without a valid
 /// clean-close certificate reaches readiness through journal-suffix recovery
