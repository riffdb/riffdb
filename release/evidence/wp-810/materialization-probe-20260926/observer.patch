+    #[test]
+    fn raw_values_and_worker_order_survive_even_in_one_histogram_bucket() {
+        let mut a = Capture::new();
+        let mut b = Capture::new();
+        for ns in [71_303_168, 75_497_471, 73_000_003] {
+            a.record(ns, Some(ns));
+        }
+        for ns in [72_000_019, 74_999_997] {
+            b.record(ns, Some(ns));
+        }
+        let value = report(&[a, b], 5).unwrap();
+        assert_eq!(value["valid"], true);
+        assert_eq!(
+            value["workers"][0]["samples_ns"],
+            serde_json::json!([71_303_168, 75_497_471, 73_000_003])
+        );
+        assert_eq!(
+            value["workers"][1]["samples_ns"],
+            serde_json::json!([72_000_019, 74_999_997])
+        );
+        let top: Vec<_> = value["slowest_20"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .map(|v| v["elapsed_ns"].as_u64().unwrap())
+            .collect();
+        assert_eq!(
+            top,
+            vec![75_497_471, 74_999_997, 73_000_003, 72_000_019, 71_303_168]
+        );
+    }
+
+    // req: PERF-018
+    #[test]
+    fn slowest_twenty_are_exact_across_workers_and_ties_keep_identity() {
+        let mut a = Capture::new();
+        let mut b = Capture::new();
+        for ns in 1..=30 {
+            a.record(ns, Some(ns));
+            b.record(ns, Some(ns + 30));
+        }
+        let value = report(&[a, b], 60).unwrap();
+        let top = value["slowest_20"].as_array().unwrap();
+        assert_eq!(top.len(), 20);
+        assert_eq!(top[0]["elapsed_ns"], 30);
+        assert_eq!(top[0]["worker"], 0);
+        assert_eq!(top[1]["elapsed_ns"], 30);
+        assert_eq!(top[1]["worker"], 1);
+        assert_eq!(top[19]["elapsed_ns"], 21);
+        assert_eq!(value["sample_count"], 60);
+    }
+
+    // req: PERF-018
+    #[test]
+    fn overflow_and_wrong_population_invalidate_instead_of_silently_truncating() {
+        let mut a = Capture::new();
+        for _ in 0..LIMIT + 3 {
+            a.record(5, Some(1));
+        }
+        let value = report(&[a], (LIMIT + 3) as u64).unwrap();
+        assert_eq!(value["valid"], false);
+        assert_eq!(value["dropped_samples"], 3);
+        assert_eq!(
+            value["workers"][0]["samples_ns"].as_array().unwrap().len(),
+            LIMIT
+        );
+        let mut b = Capture::new();
+        b.record(10, Some(1));
+        assert_eq!(report(&[b], 2).unwrap()["valid"], false);
+    }
+
+    // req: REP-007
+    #[test]
+    fn commit_sequence_is_retained_with_its_duration_and_missing_is_invalid() {
+        let mut capture = Capture::new();
+        capture.record(25, Some(901));
+        capture.record(45, Some(902));
+        let value = report(&[capture], 2).unwrap();
+        assert_eq!(value["valid"], true);
+        assert_eq!(
+            value["workers"][0]["commit_sequences"],
+            serde_json::json!([901, 902])
+        );
+        assert_eq!(value["slowest_20"][0]["commit_sequence"], 902);
+        let mut missing = Capture::new();
+        missing.record(25, None);
+        assert_eq!(report(&[missing], 1).unwrap()["valid"], false);
+    }
+}
