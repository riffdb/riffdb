--- /dev/null
+++ b/crates/riffdb-storage-redb/src/store_command_fence.rs
@@ -0,0 +1,65 @@
+//! Command completion with optional bounded diagnostic correlation.
+
+use super::*;
+
+impl DeferredCommandFence for RedbSubmittedCommandFence {
+    fn requires_pipeline_drain(&self) -> bool {
+        let required =
+            command_fence_requires_pipeline_drain(self.journaled, self.pipeline_drain_required);
+        if let Some(group) = self
+            .receipt
+            .as_ref()
+            .and_then(crate::journal::JournalFenceReceipt::correlation)
+        {
+            group.drain(required);
+        }
+        required
+    }
+
+    fn try_wait(
+        &mut self,
+    ) -> Result<Option<Vec<riffdb_storage_api::AuditedCommittedBatchV1>>, StorageError> {
+        (|| {
+            if !self.journaled {
+                return self.publish_direct().map(Some);
+            }
+            let fenced = self
+                .receipt
+                .as_ref()
+                .ok_or_else(|| storage_error(StorageErrorKind::InvariantViolation))?
+                .try_wait()
+                .map_err(journal_io_error)?;
+            let Some(fenced) = fenced else {
+                return Ok(None);
+            };
+            let group = self
+                .receipt
+                .take()
+                .and_then(|receipt| receipt.correlation());
+            let begin = group.map(|_| Instant::now());
+            let result = self.publish_fenced(fenced).map(Some);
+            if let Some((group, begin)) = group.zip(begin) {
+                group.published(begin, Instant::now(), result.is_err());
+            }
+            result
+        })()
+    }
+
+    fn wait(mut self) -> Result<Vec<riffdb_storage_api::AuditedCommittedBatchV1>, StorageError> {
+        if !self.journaled {
+            return self.publish_direct();
+        }
+        let receipt = self
+            .receipt
+            .take()
+            .ok_or_else(|| storage_error(StorageErrorKind::InvariantViolation))?;
+        let group = receipt.correlation();
+        let fenced = receipt.wait().map_err(journal_io_error)?;
+        let begin = group.map(|_| Instant::now());
+        let result = self.publish_fenced(fenced);
+        if let Some((group, begin)) = group.zip(begin) {
+            group.published(begin, Instant::now(), result.is_err());
+        }
+        result
+    }
+}
diff --git a/crates/riffdb-storage-redb/src/writer_correlation.rs b/crates/riffdb-storage-redb/src/writer_correlation.rs
new file mode 100644
index 000000000..16ea43f73
--- /dev/null
+++ b/crates/riffdb-storage-redb/src/writer_correlation.rs
@@ -0,0 +1,580 @@
+//! Temporary WP-810 observation build: no values, keys, paths or durable bytes.
+//! Atomics on the write path; completed rows are drained by the supervisor.
+
+use std::cell::Cell;
+use std::io::Write;
+use std::sync::atomic::{AtomicBool, AtomicU64, AtomicUsize, Ordering};
+use std::sync::{Mutex, OnceLock};
+use std::time::Instant;
+
+const GROUP_LIMIT: usize = 65_536;
+const CHECKPOINT_LIMIT: usize = 512;
+const PAGE_LIMIT: usize = 32_768;
+const IO_LIMIT: usize = 4_194_304;
+
+struct Row<const N: usize> {
+    values: [AtomicU64; N],
+    ready: AtomicBool,
+}
+
+impl<const N: usize> Default for Row<N> {
+    fn default() -> Self {
+        Self {
+            values: std::array::from_fn(|_| AtomicU64::new(0)),
+            ready: AtomicBool::new(false),
+        }
+    }
+}
+
+impl<const N: usize> Row<N> {
+    fn set(&self, index: usize, value: u64) {
+        self.values[index].store(value, Ordering::Relaxed);
+    }
+
+    fn snapshot(&self) -> Option<[u64; N]> {
+        self.ready
+            .load(Ordering::Acquire)
+            .then(|| std::array::from_fn(|index| self.values[index].load(Ordering::Relaxed)))
+    }
+}
+
+struct Trace {
+    origin: Instant,
+    groups: Box<[Row<20>]>,
+    checkpoints: Box<[Row<12>]>,
+    used_groups: AtomicUsize,
+    used_checkpoints: AtomicUsize,
+    active_checkpoint: AtomicU64,
+    flushes: AtomicU64,
+    dropped: [AtomicU64; 3],
+    io: Box<[Row<9>]>,
+    used_io: AtomicUsize,
+    emitted: Mutex<[usize; 3]>,
+    emission_started: AtomicBool,
+}
+
+impl Trace {
+    fn new(groups: usize, checkpoints: usize, io: usize) -> Self {
+        Self {
+            origin: Instant::now(),
+            groups: (0..groups).map(|_| Row::default()).collect(),
+            checkpoints: (0..checkpoints).map(|_| Row::default()).collect(),
+            io: (0..io).map(|_| Row::default()).collect(),
+            used_io: AtomicUsize::new(0),
+            emitted: Mutex::new([0; 3]),
+            emission_started: AtomicBool::new(false),
+            used_groups: AtomicUsize::new(0),
+            used_checkpoints: AtomicUsize::new(0),
+            active_checkpoint: AtomicU64::new(0),
+            flushes: AtomicU64::new(0),
+            dropped: std::array::from_fn(|_| AtomicU64::new(0)),
+        }
+    }
+
+    fn time(&self, at: Instant) -> u64 {
+        u64::try_from(at.saturating_duration_since(self.origin).as_nanos())
+            .unwrap_or(u64::MAX)
+            .max(1)
+    }
+
+    fn reserve(&self, counter: &AtomicUsize, limit: usize, kind: usize) -> Option<usize> {
+        match counter.fetch_update(Ordering::Relaxed, Ordering::Relaxed, |old| {
+            (old < limit).then_some(old + 1)
+        }) {
+            Ok(index) => Some(index),
+            Err(_) => {
+                self.dropped[kind].fetch_add(1, Ordering::Relaxed);
+                None
+            }
+        }
+    }
+}
+
+fn trace() -> Option<&'static Trace> {
+    static TRACE: OnceLock<Option<Trace>> = OnceLock::new();
+    TRACE
+        .get_or_init(|| {
+            std::env::var_os("RIFFDB_WRITER_CORRELATION")
+                .is_some_and(|value| value == "1")
+                .then(|| Trace::new(GROUP_LIMIT, CHECKPOINT_LIMIT, IO_LIMIT))
+        })
+        .as_ref()
+}
+
+pub(crate) fn enabled() -> bool {
+    trace().is_some()
+}
+
+thread_local! {
+    // A checkpoint transaction runs on one materializer thread. This identity
+    // only labels observations; it cannot confer storage authority.
+    static PHASE: Cell<(u64, u64)> = const { Cell::new((0, 0)) };
+}
+
+pub(crate) struct CheckpointPhase(Option<(u64, u64)>);
+
+impl CheckpointPhase {
+    pub(crate) fn begin() -> Self {
+        let previous = trace().map(|trace| {
+            let id = trace.active_checkpoint.load(Ordering::Relaxed);
+            let previous = PHASE.replace((id, 1));
+            if id > 0 {
+                trace.checkpoints[id as usize - 1].set(9, trace.time(Instant::now()));
+            }
+            previous
+        });
+        Self(previous)
+    }
+
+    fn stage(&self, phase: u64, slot: usize) {
+        if self.0.is_some()
+            && let Some(trace) = trace()
+        {
+            let (id, _) = PHASE.get();
+            PHASE.set((id, phase));
+            if id > 0 {
+                trace.checkpoints[id as usize - 1].set(slot, trace.time(Instant::now()));
+            }
+        }
+    }
+
+    pub(crate) fn replay(&self) {
+        self.stage(2, 10);
+    }
+
+    pub(crate) fn commit(&self) {
+        self.stage(3, 11);
+    }
+}
+
+impl Drop for CheckpointPhase {
+    fn drop(&mut self) {
+        if let Some(previous) = self.0 {
+            PHASE.set(previous);
+        }
+    }
+}
+
+impl Trace {
+    fn observe_io<T>(
+        &self,
+        kind: u64,
+        bytes: u64,
+        operation: impl FnOnce() -> std::io::Result<T>,
+    ) -> std::io::Result<T> {
+        let slot = self.reserve(&self.used_io, self.io.len(), 2);
+        let context = PHASE.get();
+        let active = self.active_checkpoint.load(Ordering::Relaxed);
+        let start = Instant::now();
+        let result = operation();
+        let end = Instant::now();
+        if let Some(slot) = slot {
+            let row = &self.io[slot];
+            for (index, value) in [
+                slot as u64 + 1,
+                context.0,
+                context.1,
+                kind,
+                self.time(start),
+                self.time(end),
+                bytes,
+                u64::from(result.is_err()),
+                active,
+            ]
+            .into_iter()
+            .enumerate()
+            {
+                row.set(index, value);
+            }
+            row.ready.store(true, Ordering::Release);
+        }
+        result
+    }
+}
+
+pub(crate) fn observe_io<T>(
+    kind: u64,
+    bytes: u64,
+    operation: impl FnOnce() -> std::io::Result<T>,
+) -> std::io::Result<T> {
+    match trace() {
+        Some(trace) => trace.observe_io(kind, bytes, operation),
+        None => operation(),
+    }
+}
+
+/// Called only from existing supervisor census reads and backend close. Never
+/// called by command apply, the journal worker or checkpoint I/O operations.
+pub(crate) fn emit(final_snapshot: bool) {
+    let Some(trace) = trace() else { return };
+    // The app-baseline stdout consumer starts retaining diagnostic lines only
+    // after READY. Its periodic census is the first post-readiness caller.
+    // An initialization-time temporary backend close must not discard rows.
+    if final_snapshot && !trace.emission_started.load(Ordering::Acquire) {
+        return;
+    }
+    trace.emission_started.store(true, Ordering::Release);
+    let Ok(mut cursors) = trace.emitted.lock() else {
+        return;
+    };
+    let mut output = std::io::stdout().lock();
+    let pages = if final_snapshot {
+        IO_LIMIT / PAGE_LIMIT + 1
+    } else {
+        1
+    };
+    for _ in 0..pages {
+        let previous = *cursors;
+        let Some(snapshot) = writer_correlation_snapshot_v1([cursors[0], cursors[1]]) else {
+            return;
+        };
+        for row in &snapshot.groups {
+            let values = row.map(|value| value.to_string()).join(",");
+            let _ = writeln!(
+                output,
+                "riffdb-wp810-group-v1\tpid={}\t{values}",
+                std::process::id()
+            );
+        }
+        for row in &snapshot.checkpoints {
+            let values = row.map(|value| value.to_string()).join(",");
+            let _ = writeln!(
+                output,
+                "riffdb-wp810-checkpoint-v1\tpid={}\t{values}",
+                std::process::id()
+            );
+        }
+        let mut io_count = 0;
+        for row in trace
+            .io
+            .iter()
+            .skip(cursors[2])
+            .take(PAGE_LIMIT)
+            .map_while(Row::snapshot)
+        {
+            let values = row.map(|value| value.to_string()).join(",");
+            let _ = writeln!(
+                output,
+                "riffdb-wp810-io-v1\tpid={}\t{values}",
+                std::process::id()
+            );
+            io_count += 1;
+        }
+        *cursors = [snapshot.next[0], snapshot.next[1], cursors[2] + io_count];
+        if previous == *cursors || !final_snapshot {
+            let _ = writeln!(
+                output,
+                "riffdb-wp810-coverage-v1\tpid={}\tfinal={}\tgroups={}\tcheckpoints={}\tio={}\treserved_groups={}\treserved_checkpoints={}\treserved_io={}\tdropped_groups={}\tdropped_checkpoints={}\tdropped_io={}",
+                std::process::id(),
+                u8::from(final_snapshot),
+                cursors[0],
+                cursors[1],
+                cursors[2],
+                snapshot.reserved[0],
+                snapshot.reserved[1],
+                trace.used_io.load(Ordering::Relaxed),
+                snapshot.dropped[0],
+                snapshot.dropped[1],
+                snapshot.dropped[2]
+            );
+            break;
+        }
+    }
+    let _ = output.flush();
+}
+
+#[derive(Clone, Copy)]
+pub(crate) struct Group(usize);
+
+pub(crate) fn submitted(last: u64, commands: u16, at: Instant) -> Option<Group> {
+    let trace = trace()?;
+    if commands == 0 {
+        return None;
+    }
+    let first = last.checked_sub(u64::from(commands) - 1)?;
+    let index = trace.reserve(&trace.used_groups, trace.groups.len(), 0)?;
+    let row = &trace.groups[index];
+    for (slot, value) in [
+        (0, index as u64 + 1),
+        (1, first),
+        (2, last),
+        (3, u64::from(commands)),
+        (4, trace.time(at)),
+        (16, trace.active_checkpoint.load(Ordering::Relaxed)),
+    ] {
+        row.set(slot, value);
+    }
+    Some(Group(index))
+}
+
+impl Group {
+    pub(crate) fn io_phases(self, encode: Instant, write: Instant, write_end: Instant) {
+        if let Some(trace) = trace() {
+            let row = &trace.groups[self.0];
+            row.set(17, trace.time(encode));
+            row.set(18, trace.time(write));
+            row.set(19, trace.time(write_end));
+        }
+    }
+    pub(crate) fn sync(self, begin: Instant, end: Instant, flush: u64, failed: bool) {
+        if let Some(trace) = trace() {
+            let row = &trace.groups[self.0];
+            row.set(5, trace.time(begin));
+            row.set(6, trace.time(end));
+            row.set(7, flush);
+            if failed {
+                row.set(15, 1);
+            }
+        }
+    }
+
+    pub(crate) fn wait_begin(self, at: Instant) -> bool {
+        trace().is_some_and(|trace| {
+            let row = &trace.groups[self.0];
+            row.values[14].fetch_add(1, Ordering::Relaxed);
+            row.values[8]
+                .compare_exchange(0, trace.time(at), Ordering::Relaxed, Ordering::Relaxed)
+                .is_ok()
+        })
+    }
+
+    pub(crate) fn wait_end(self, at: Instant, first: bool, failed: bool) {
+        if let Some(trace) = trace() {
+            let row = &trace.groups[self.0];
+            if first {
+                row.set(9, trace.time(at));
+            }
+            if failed {
+                row.set(15, 1);
+                row.ready.store(true, Ordering::Release);
+            }
+        }
+    }
+
+    pub(crate) fn drain(self, required: bool) {
+        if let Some(trace) = trace() {
+            let row = &trace.groups[self.0];
+            row.set(12, if required { 1 } else { 2 });
+            row.set(13, trace.active_checkpoint.load(Ordering::Relaxed));
+        }
+    }
+
+    pub(crate) fn published(self, begin: Instant, end: Instant, failed: bool) {
+        if let Some(trace) = trace() {
+            let row = &trace.groups[self.0];
+            row.set(10, trace.time(begin));
+            row.set(11, trace.time(end));
+            if failed {
+                row.set(15, 1);
+            }
+            row.ready.store(true, Ordering::Release);
+        }
+    }
+}
+
+pub(crate) fn next_flush() -> u64 {
+    trace().map_or(0, |trace| trace.flushes.fetch_add(1, Ordering::Relaxed) + 1)
+}
+
+pub(crate) fn checkpoint_started(transitions: u64, commands: u64, bytes: u64, triggers: [bool; 4]) {
+    if let Some(trace) = trace() {
+        let Some(index) = trace.reserve(&trace.used_checkpoints, trace.checkpoints.len(), 1) else {
+            return;
+        };
+        let id = index as u64 + 1;
+        let row = &trace.checkpoints[index];
+        for (slot, value) in [
+            (0, id),
+            (1, trace.time(Instant::now())),
+            (4, transitions),
+            (5, commands),
+            (6, bytes),
+        ] {
+            row.set(slot, value);
+        }
+        row.set(
+            7,
+            triggers
+                .into_iter()
+                .enumerate()
+                .fold(0, |bits, (i, yes)| bits | (u64::from(yes) << i)),
+        );
+        trace.active_checkpoint.store(id, Ordering::Relaxed);
+    }
+}
+
+pub(crate) fn checkpoint_finished(stage: usize) {
+    if let Some(trace) = trace() {
+        let id = if stage == 2 {
+            trace.active_checkpoint.load(Ordering::Relaxed)
+        } else {
+            trace.active_checkpoint.swap(0, Ordering::Relaxed)
+        };
+        if id == 0 {
+            return;
+        }
+        let row = &trace.checkpoints[id as usize - 1];
+        row.set(
+            stage,
+            if stage == 8 {
+                1
+            } else {
+                trace.time(Instant::now())
+            },
+        );
+        if stage != 2 {
+            row.ready.store(true, Ordering::Release);
+        }
+    }
+}
+
+/// Completed diagnostic rows; numeric sequence identities only. Not durable evidence.
+#[doc(hidden)]
+struct WriterCorrelationSnapshotV1 {
+    /// Resume cursors for the next bounded page.
+    pub next: [usize; 2],
+    /// id, first/last sequence, commands, submit, sync begin/end, flush id,
+    /// first wait begin/end, publication begin/end, drain flag (1=yes, 2=no),
+    /// checkpoint at drain, wait calls, failed, checkpoint at submission,
+    /// encoding begin, positional write begin/end.
+    /// All times are nanoseconds on one process-local monotonic clock.
+    pub groups: Vec<[u64; 20]>,
+    /// id, start/materialized/installed ns, transitions, commands, bytes,
+    /// crossed-limit bits (transition/byte/physical/reanchor), failed,
+    /// materializer entry, transaction ready, durable commit begin.
+    pub checkpoints: Vec<[u64; 12]>,
+    /// Group/checkpoint/I/O overflows; nonzero invalidates correlation coverage.
+    pub dropped: [u64; 3],
+    /// Reserved rows; compare against emitted rows after clean shutdown.
+    pub reserved: [usize; 2],
+}
+
+/// Bounded observer page. No authority, state mutation or disk I/O.
+#[doc(hidden)]
+fn writer_correlation_snapshot_v1(start: [usize; 2]) -> Option<WriterCorrelationSnapshotV1> {
+    let trace = trace()?;
+    fn page<const N: usize>(rows: &[Row<N>], start: usize) -> Vec<[u64; N]> {
+        rows.iter()
+            .skip(start)
+            .take(PAGE_LIMIT)
+            .map_while(Row::snapshot)
+            .collect()
+    }
+    let groups = page(&trace.groups, start[0]);
+    let checkpoints = page(&trace.checkpoints, start[1]);
+    Some(WriterCorrelationSnapshotV1 {
+        next: [start[0] + groups.len(), start[1] + checkpoints.len()],
+        groups,
+        checkpoints,
+        dropped: std::array::from_fn(|i| trace.dropped[i].load(Ordering::Relaxed)),
+        reserved: [
+            trace.used_groups.load(Ordering::Relaxed),
+            trace.used_checkpoints.load(Ordering::Relaxed),
+        ],
+    })
+}
+
