+        assert_eq!(error.kind(), std::io::ErrorKind::StorageFull);
+        let first = trace.io[0].snapshot().unwrap();
+        assert_eq!((first[3], first[6], first[7]), (2, 0, 1));
+        assert!(first[4] <= first[5]);
