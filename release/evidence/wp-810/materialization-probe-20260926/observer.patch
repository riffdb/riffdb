+    fn correlation_bounds_fail_observability_without_overwriting_rows() {
+        let trace = Trace::new(1, 1, 1);
+        assert_eq!(trace.reserve(&trace.used_groups, 1, 0), Some(0));
+        trace.groups[0].set(2, 42);
+        assert_eq!(trace.groups[0].snapshot(), None);
+        trace.groups[0].ready.store(true, Ordering::Release);
+        assert_eq!(trace.reserve(&trace.used_groups, 1, 0), None);
+        assert_eq!(trace.used_groups.load(Ordering::Relaxed), 1);
+        assert_eq!(trace.dropped[0].load(Ordering::Relaxed), 1);
+        assert_eq!(trace.groups[0].snapshot().expect("published row")[2], 42);
+    }
+
+    // req: REP-007
+    #[test]
+    fn completed_row_acquire_observes_cross_thread_evidence() {
+        let row = Row::<20>::default();
+        let partial = std::sync::Barrier::new(2);
+        let finish = std::sync::Barrier::new(2);
+        std::thread::scope(|scope| {
+            let writer = scope.spawn(|| {
+                for slot in 0..8 {
+                    row.set(slot, slot as u64 + 1);
+                }
+                partial.wait();
+                finish.wait();
+                for slot in 8..20 {
+                    row.set(slot, slot as u64 + 1);
+                }
+                row.ready.store(true, Ordering::Release);
+            });
+            partial.wait();
+            assert_eq!(row.snapshot(), None, "partial evidence is never emitted");
+            finish.wait();
+            while !row.ready.load(Ordering::Acquire) {
+                std::thread::yield_now();
+            }
+            assert_eq!(row.snapshot(), Some(std::array::from_fn(|i| i as u64 + 1)));
+            writer.join().expect("writer");
+        });
+    }
