+                    trace.io[0].snapshot().unwrap()
+                })
+                .join()
+                .unwrap()
+        });
+        assert_eq!((row[1], row[2]), (0, 0));
+        let guard = CheckpointPhase(Some(previous));
+        trace
+            .observe_io(2, 0, || Err::<(), _>(std::io::Error::other("test")))
+            .unwrap_err();
+        assert_eq!(
+            (
+                trace.io[1].snapshot().unwrap()[1],
+                trace.io[1].snapshot().unwrap()[2]
