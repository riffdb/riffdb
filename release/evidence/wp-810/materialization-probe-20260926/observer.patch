+++ b/crates/riffdb-storage-redb/src/checkpoint_io_probe.rs
@@ -0,0 +1,137 @@
+//! Observation-only wrapper around the exact production redb file backend.
+
+use std::io;
+use std::path::Path;
+
+#[derive(Debug)]
+pub(crate) struct ObservedFileBackend<T = redb::backends::FileBackend> {
+    inner: T,
+}
+
+impl ObservedFileBackend {
+    pub(crate) fn open(path: &Path) -> Result<Self, redb::DatabaseError> {
+        // Exactly redb 4.2.0 Builder::create's flags and FileBackend lock.
+        let file = std::fs::OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create(true)
+            .truncate(false)
+            .open(path)?;
+        Ok(Self {
+            inner: redb::backends::FileBackend::new(file)?,
+        })
+    }
+}
+
+impl<T: redb::StorageBackend> redb::StorageBackend for ObservedFileBackend<T> {
+    fn len(&self) -> io::Result<u64> {
+        self.inner.len()
+    }
+
+    fn read(&self, offset: u64, out: &mut [u8]) -> io::Result<()> {
+        crate::writer_correlation::observe_io(4, out.len() as u64, || self.inner.read(offset, out))
+    }
+
+    fn set_len(&self, len: u64) -> io::Result<()> {
+        crate::writer_correlation::observe_io(3, len, || self.inner.set_len(len))
+    }
+
+    fn sync_data(&self) -> io::Result<()> {
+        crate::writer_correlation::observe_io(2, 0, || self.inner.sync_data())
+    }
+
+    fn write(&self, offset: u64, data: &[u8]) -> io::Result<()> {
+        crate::writer_correlation::observe_io(1, data.len() as u64, || {
+            self.inner.write(offset, data)
+        })
+    }
+
+    fn close(&self) -> io::Result<()> {
+        let result = self.inner.close();
+        // Final drain supplements the periodic observer. Coverage must still
+        // match all reserved rows after the daemon has actually exited.
+        crate::writer_correlation::emit(true);
+        result
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use redb::StorageBackend;
+    use std::sync::Mutex;
+
+    // req: STO-001, REC-001
+    #[test]
+    fn checkpoint_observer_uses_real_file_lock_and_never_truncates_existing_bytes() {
+        let directory = crate::test_path::ScopedDirectory::new("checkpoint-observer-backend");
+        let path = directory.join("backend");
+        let first = ObservedFileBackend::open(&path).unwrap();
+        first.set_len(4096).unwrap();
+        first.write(128, b"checked").unwrap();
+        first.sync_data().unwrap();
+        assert!(ObservedFileBackend::open(&path).is_err());
+        drop(first);
+        let second = ObservedFileBackend::open(&path).unwrap();
+        assert_eq!(second.len().unwrap(), 4096);
+        let mut bytes = [0; 7];
+        second.read(128, &mut bytes).unwrap();
+        assert_eq!(&bytes, b"checked");
+    }
+
+    #[derive(Debug, Default)]
+    struct Backend {
+        calls: Mutex<Vec<u8>>,
+    }
+
+    impl redb::StorageBackend for Backend {
+        fn len(&self) -> io::Result<u64> {
+            self.calls.lock().unwrap().push(0);
+            Ok(17)
+        }
+        fn read(&self, offset: u64, out: &mut [u8]) -> io::Result<()> {
+            assert_eq!(offset, 8);
+            self.calls.lock().unwrap().push(4);
+            out.copy_from_slice(b"read");
+            Ok(())
+        }
+        fn set_len(&self, len: u64) -> io::Result<()> {
+            assert_eq!(len, 23);
+            self.calls.lock().unwrap().push(3);
+            Ok(())
+        }
+        fn sync_data(&self) -> io::Result<()> {
+            self.calls.lock().unwrap().push(2);
+            Err(io::Error::from(io::ErrorKind::PermissionDenied))
+        }
+        fn write(&self, offset: u64, data: &[u8]) -> io::Result<()> {
+            assert_eq!((offset, data), (11, b"write".as_slice()));
+            self.calls.lock().unwrap().push(1);
+            Ok(())
+        }
+        fn close(&self) -> io::Result<()> {
+            self.calls.lock().unwrap().push(5);
+            Ok(())
+        }
+    }
+
+    // req: STO-001, REC-001
+    #[test]
+    fn checkpoint_observer_preserves_backend_calls_bytes_errors_and_order() {
+        let backend = ObservedFileBackend {
+            inner: Backend::default(),
+        };
+        assert_eq!(backend.len().unwrap(), 17);
+        let mut bytes = [0; 4];
+        backend.read(8, &mut bytes).unwrap();
+        assert_eq!(&bytes, b"read");
+        backend.set_len(23).unwrap();
+        backend.write(11, b"write").unwrap();
+        assert_eq!(
+            backend.sync_data().unwrap_err().kind(),
+            io::ErrorKind::PermissionDenied
+        );
+        backend.close().unwrap();
+        assert_eq!(*backend.inner.calls.lock().unwrap(), [0, 4, 3, 1, 2, 5]);
+    }
+}
