+//! Private bounded diagnostic: measured latency samples, emitted only after join.
+use std::io::Write;
+use std::path::Path;
+
+pub(crate) const LIMIT: usize = 32_768;
+pub(crate) const MAX_WORKERS: usize = 32;
+
+pub(crate) struct Capture {
+    values: Vec<u64>,
+    sequences: Vec<u64>,
+    retained: usize,
+    dropped: u64,
+}
+
+impl Capture {
+    pub(crate) fn new() -> Self {
+        Self {
+            values: vec![0; LIMIT],
+            sequences: vec![0; LIMIT],
+            retained: 0,
+            dropped: 0,
+        }
+    }
+
+    pub(crate) fn record(&mut self, elapsed_ns: u64, commit_sequence: Option<u64>) {
+        if self.retained < LIMIT {
+            self.values[self.retained] = elapsed_ns.max(1);
+            self.sequences[self.retained] = commit_sequence.unwrap_or(0);
+            self.retained += 1;
+        } else {
+            self.dropped = self.dropped.saturating_add(1);
+        }
+    }
+
+    fn samples(&self) -> &[u64] {
+        &self.values[..self.retained]
+    }
+}
+
+fn report(captures: &[Capture], expected: u64) -> Result<serde_json::Value, String> {
+    if captures.is_empty() || captures.len() > MAX_WORKERS {
+        return Err("raw-tail worker bound violated".to_owned());
+    }
+    let count = captures.iter().map(|c| c.retained as u64).sum::<u64>();
+    let dropped = captures.iter().map(|c| c.dropped).sum::<u64>();
+    let missing = captures
+        .iter()
+        .map(|c| {
+            c.sequences[..c.retained]
+                .iter()
+                .filter(|sequence| **sequence == 0)
+                .count()
+        })
+        .sum::<usize>();
+    let mut slowest = captures
+        .iter()
+        .enumerate()
+        .flat_map(|(worker, capture)| {
+            capture
+                .samples()
+                .iter()
+                .enumerate()
+                .map(move |(ordinal, value)| (*value, worker, ordinal))
+        })
+        .collect::<Vec<_>>();
+    slowest.sort_unstable_by(|a, b| b.0.cmp(&a.0).then(a.1.cmp(&b.1)).then(a.2.cmp(&b.2)));
+    slowest.truncate(20);
+    Ok(serde_json::json!({
+        "schema": "private.wp810-request-tail/v2",
+        "scope": "measured requests only; all outcomes; per-worker completion order; no global chronological ordering claim",
+        "valid": dropped == 0 && count == expected && missing == 0,
+        "missing_commit_sequences": missing,
+        "sample_count": count,
+        "expected_sample_count": expected,
+        "dropped_samples": dropped,
+        "maximum_workers": MAX_WORKERS,
+        "maximum_samples_per_worker": LIMIT,
+        "workers": captures.iter().enumerate().map(|(id, c)| serde_json::json!({
+            "worker": id, "dropped_samples": c.dropped, "samples_ns": c.samples(),
+            "commit_sequences": &c.sequences[..c.retained],
+        })).collect::<Vec<_>>(),
+        "slowest_20": slowest.iter().map(|(ns, worker, ordinal)| serde_json::json!({
+            "elapsed_ns": ns, "worker": worker, "worker_ordinal": ordinal,
+            "commit_sequence": captures[*worker].sequences[*ordinal],
+        })).collect::<Vec<_>>(),
+    }))
+}
+
+pub(crate) fn write_report(
+    directory: &Path,
+    captures: &[Capture],
+    expected: u64,
+) -> Result<(), String> {
+    let value = report(captures, expected)?;
+    let path = directory.join("raw-request-tail.json");
+    let mut file = std::fs::OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .open(path)
+        .map_err(|_| "raw-tail output unavailable or already exists".to_owned())?;
+    serde_json::to_writer(&mut file, &value)
+        .map_err(|_| "raw-tail serialization failed".to_owned())?;
+    file.write_all(b"\n")
+        .and_then(|()| file.sync_all())
+        .map_err(|_| "raw-tail output write failed".to_owned())?;
+    if value["valid"] != true {
+        return Err(
+            "raw-tail overflow or sample-count mismatch; partial evidence retained".to_owned(),
+        );
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
