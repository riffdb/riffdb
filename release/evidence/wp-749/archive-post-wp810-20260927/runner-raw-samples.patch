@@ -0,0 +1,118 @@
+//! Private bounded sample retention, identical in both WP-810 timing arms.
+use std::io::Write;
+use std::path::Path;
+
+pub(crate) const MAX_WORKERS: usize = 32;
+const LIMIT: usize = 32_768;
+
+pub(crate) struct Capture {
+    samples: Vec<u64>,
+    retained: usize,
+    dropped: u64,
+}
+
+impl Capture {
+    pub(crate) fn new() -> Self {
+        Self {
+            samples: vec![0; LIMIT],
+            retained: 0,
+            dropped: 0,
+        }
+    }
+    pub(crate) fn record(&mut self, ns: u64) {
+        if self.retained == LIMIT {
+            self.dropped = self.dropped.saturating_add(1);
+        } else {
+            self.samples[self.retained] = ns.max(1);
+            self.retained += 1;
+        }
+    }
+}
+
+fn report(captures: &[Capture], expected: u64) -> Result<serde_json::Value, String> {
+    if captures.is_empty() || captures.len() > MAX_WORKERS {
+        return Err("raw-tail worker bound violated".to_owned());
+    }
+    let count = captures.iter().map(|c| c.retained as u64).sum::<u64>();
+    let dropped = captures.iter().map(|c| c.dropped).sum::<u64>();
+    let mut top = captures
+        .iter()
+        .enumerate()
+        .flat_map(|(worker, capture)| {
+            capture.samples[..capture.retained]
+                .iter()
+                .enumerate()
+                .map(move |(ordinal, value)| (*value, worker, ordinal))
+        })
+        .collect::<Vec<_>>();
+    top.sort_unstable_by(|a, b| b.0.cmp(&a.0).then(a.1.cmp(&b.1)).then(a.2.cmp(&b.2)));
+    top.truncate(20);
+    Ok(serde_json::json!({
+        "schema": "private.wp810-request-tail/v1",
+        "scope": "measured requests; all outcomes; worker-local completion order",
+        "valid": dropped == 0 && count == expected,
+        "sample_count": count, "expected_sample_count": expected, "dropped_samples": dropped,
+        "maximum_workers": MAX_WORKERS, "maximum_samples_per_worker": LIMIT,
+        "workers": captures.iter().enumerate().map(|(id,c)| serde_json::json!({
+            "worker": id, "dropped_samples": c.dropped, "samples_ns": &c.samples[..c.retained],
+        })).collect::<Vec<_>>(),
+        "slowest_20": top.iter().map(|(ns, worker, ordinal)| serde_json::json!({
+            "elapsed_ns": ns, "worker": worker, "worker_ordinal": ordinal,
+        })).collect::<Vec<_>>(),
+    }))
+}
+
+pub(crate) fn write_report(
+    directory: &Path,
+    captures: &[Capture],
+    expected: u64,
+) -> Result<(), String> {
+    let value = report(captures, expected)?;
+    let mut file = std::fs::OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .open(directory.join("raw-request-tail.json"))
+        .map_err(|_| "raw-tail output exists or unavailable")?;
+    serde_json::to_writer(&mut file, &value).map_err(|_| "raw-tail serialization failed")?;
+    file.write_all(b"\n")
+        .and_then(|()| file.sync_all())
+        .map_err(|_| "raw-tail write failed")?;
+    if value["valid"] != true {
+        return Err("raw-tail overflow/count mismatch; partial evidence retained".to_owned());
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    // req: PERF-018
+    #[test]
+    fn raw_samples_preserve_order_and_resolve_histogram_bucket_collisions() {
+        let mut capture = Capture::new();
+        for ns in [71_303_168, 75_497_471, 73_000_003] {
+            capture.record(ns);
+        }
+        let value = report(&[capture], 3).unwrap();
+        assert_eq!(value["valid"], true);
+        assert_eq!(
+            value["workers"][0]["samples_ns"],
+            serde_json::json!([71_303_168, 75_497_471, 73_000_003])
+        );
+        assert_eq!(value["slowest_20"][0]["worker_ordinal"], 1);
+    }
+    // req: PERF-018
+    #[test]
+    fn overflow_and_population_mismatch_refuse_qualification() {
+        let mut capture = Capture::new();
+        for _ in 0..LIMIT + 3 {
+            capture.record(5);
+        }
+        let value = report(&[capture], (LIMIT + 3) as u64).unwrap();
+        assert_eq!(value["valid"], false);
+        assert_eq!(value["dropped_samples"], 3);
+        let mut capture = Capture::new();
+        capture.record(10);
+        assert_eq!(report(&[capture], 2).unwrap()["valid"], false);
+    }
+}
