[Unit]
Description=RiffDB standalone database
Documentation=file:/usr/share/doc/riffdb/docs/installation.md
After=local-fs.target
StartLimitIntervalSec=30s
StartLimitBurst=3

[Service]
Type=exec
User=riffdb
Group=riffdb
ExecStart=/usr/bin/riffdbd --config /etc/riffdb/riffdbd.toml
WorkingDirectory=/var/lib/riffdb
StateDirectory=riffdb
StateDirectoryMode=0700
UMask=0077

StandardInput=null
StandardOutput=journal
StandardError=journal
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=80s
SendSIGKILL=yes
Restart=on-failure
RestartSec=2s
OOMPolicy=stop
LimitNOFILE=65536

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadOnlyPaths=/etc/riffdb
ReadWritePaths=/var/lib/riffdb
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
