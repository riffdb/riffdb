#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ "$#" -ne 1 || "$1" != "--all-languages" ]]; then
    echo "usage: ./scripts/adapter-bulk-command-acceptance --all-languages" >&2
    exit 2
fi

task_tmp_root="${RIFFDB_TMP_ROOT:-$HOME/tmp}"
mkdir -p "$task_tmp_root"
export TMPDIR="$task_tmp_root"
export GOCACHE="${RIFFDB_GO_CACHE:-$task_tmp_root/riffdb-go-cache}"
export GOPATH="${RIFFDB_GO_PATH:-$task_tmp_root/riffdb-go-path}"
export GOPROXY=off
export UV_CACHE_DIR="${UV_CACHE_DIR:-$task_tmp_root/riffdb-uv-cache}"
mkdir -p "$GOCACHE" "$GOPATH" "$UV_CACHE_DIR"

for tool in cargo go jq mkfifo mktemp node npm python3 sha256sum uv; do
    command -v "$tool" >/dev/null 2>&1 || {
        echo "required adapter-bulk tool is missing: $tool" >&2
        exit 1
    }
done

work_root="$(mktemp -d "$task_tmp_root/riffdb-adapter-bulk.XXXXXX")"
server_pid=
driver_pid=
cleanup() {
    if [[ -n "$driver_pid" ]] && kill -0 "$driver_pid" 2>/dev/null; then
        kill -TERM "$driver_pid" 2>/dev/null || true
        wait "$driver_pid" 2>/dev/null || true
    fi
    if [[ -n "$server_pid" ]] && kill -0 "$server_pid" 2>/dev/null; then
        printf 'shutdown\n' >&"$server_input_fd" 2>/dev/null || true
        wait "$server_pid" 2>/dev/null || true
    fi
    if [[ "${RIFFDB_KEEP_CONFORMANCE:-0}" == "1" ]]; then
        echo "retained adapter-bulk work root: $work_root" >&2
    else
        rm -rf "$work_root"
    fi
}
trap cleanup EXIT INT TERM

cd "$repo_root"
cargo +1.97.0 build --quiet \
    -p riffdb-server --bin riffdbd \
    -p riffdb-cli --bin riffdb \
    -p riffdb-driver-host --bin riffdb-driverd
npm --prefix clients/typescript/runtime run build >/dev/null
(
    cd clients/python/runtime
    python3 -m maturin build --quiet --interpreter python3 \
        --compatibility linux --out "$work_root/dist"
)
python_wheel="$(find "$work_root/dist" -maxdepth 1 -type f -name '*.whl' -print -quit)"
[[ -n "$python_wheel" ]] || { echo "Python adapter wheel was not built" >&2; exit 1; }
uv venv "$work_root/python-venv" >/dev/null
uv pip install --offline --python "$work_root/python-venv/bin/python" "$python_wheel" >/dev/null

port="$($work_root/python-venv/bin/python - <<'PY'
import socket
with socket.socket() as listener:
    listener.bind(("127.0.0.1", 0))
    print(listener.getsockname()[1])
PY
)"
cp crates/riffdb-server/tests/fixtures/localhost-cert.pem "$work_root/server.pem"
cp crates/riffdb-server/tests/fixtures/localhost-key.pem "$work_root/server.key"
cp crates/riffdb-server/tests/fixtures/test-ca.pem "$work_root/ca.pem"
chmod 0444 "$work_root/server.pem" "$work_root/ca.pem"
chmod 0600 "$work_root/server.key"
printf '%s' 'riffdb-capability-digest-keys-v1
1:000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
' >"$work_root/capability.keys"
printf '%s' 'riffdb-idempotency-digest-keys-v1
1:202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f
' >"$work_root/idempotency.keys"
chmod 0600 "$work_root/capability.keys" "$work_root/idempotency.keys"
mkdir -m 0700 "$work_root/backups"

cat >"$work_root/riffdbd.toml" <<EOF
[server]
database = "$work_root/riffdb.redb"
environment = "development"
audience = "riffdb-adapter-bulk"
capability_keys = "$work_root/capability.keys"
idempotency_keys = "$work_root/idempotency.keys"

[server.application_listener]
mode = "direct_tls"
listen = "127.0.0.1:$port"
public_endpoint = "https://127.0.0.1:$port"
certificate_chain = "$work_root/server.pem"
private_key = "$work_root/server.key"

[server.application_listener.bounds]
max_connections = 64
max_streams_per_connection = 128
handshake_timeout_seconds = 5
drain_timeout_seconds = 5

[maintenance]
backup_root = "$work_root/backups"
EOF

mkfifo "$work_root/server.input" "$work_root/server.output"
exec {server_input_fd}<>"$work_root/server.input"
exec {server_output_fd}<>"$work_root/server.output"
target/debug/riffdbd --config "$work_root/riffdbd.toml" \
    <&"$server_input_fd" >"$work_root/server.output" 2>"$work_root/server.stderr" &
server_pid=$!
ready=
while IFS= read -r -t 60 line <&"$server_output_fd"; do
    if [[ "$line" == riffdbd-ready-v1$'\t'* ]]; then ready="$line"; break; fi
done
[[ "$ready" == "riffdbd-ready-v1"$'\t'"127.0.0.1:$port" ]] || {
    sed -n '1,200p' "$work_root/server.stderr" >&2
    echo "adapter-bulk RiffDB did not become ready" >&2
    exit 1
}

cat >"$work_root/bootstrap.json" <<'EOF'
{"principal_id":"adapter-bulk-operator","actor_kind":"human","requested_lifetime_seconds":86400,"audiences":["riffdb-adapter-bulk"],"grant":{"tenant_scope":{"type":"global"},"partition_scope":{"type":"all"},"permissions":[{"type":"validate_contract"},{"type":"read_contract"},{"type":"deploy_contract"},{"type":"read_health"},{"type":"create_capability"},{"type":"revoke_capability"},{"type":"administer_capabilities"}],"field_visibility":[],"max_scan_rows":50,"approval_required":[]}}
EOF
cat >"$work_root/bootstrap-client.toml" <<EOF
[client]
endpoint = "https://127.0.0.1:$port"
database = "default"
output = "json"
max_attempts = 3
tls_trust_root = "$work_root/ca.pem"
tls_server_name = "127.0.0.1"
EOF
target/debug/riffdb --config "$work_root/bootstrap-client.toml" capability bootstrap \
    --request "$work_root/bootstrap.json" --generate "$work_root/bootstrap.credential" \
    --bearer-output "$work_root/operator.credential" >/dev/null
cat >"$work_root/operator-client.toml" <<EOF
[client]
endpoint = "https://127.0.0.1:$port"
database = "default"
output = "json"
max_attempts = 3
credential_file = "$work_root/operator.credential"
tls_trust_root = "$work_root/ca.pem"
tls_server_name = "127.0.0.1"
EOF

cp -R fixtures/adapters/bulk-conformance "$work_root/application"
(
    cd "$work_root/application"
    "$repo_root/target/debug/riffdb" --config "$work_root/operator-client.toml" application deploy \
        riffdb.application.json --lock riffdb.application.lock.json \
        --provision-role AdapterBulkApplication --lifetime-seconds 3600 >/dev/null
)
deployment_root="$work_root/application/.riffdb/deployments/default"
credential_file="$(jq -r 'if (.role.credential_file // "") == "" then "application.credential" else .role.credential_file end' "$deployment_root/deployment-state.json")"
if [[ "$credential_file" == /* ]]; then credential="$credential_file"; else credential="$deployment_root/$credential_file"; fi
[[ -f "$credential" ]] || { echo "adapter application credential was not provisioned" >&2; exit 1; }

export RIFFDB_CONFORMANCE_ENDPOINT="https://127.0.0.1:$port"
export RIFFDB_CONFORMANCE_TRUST_ROOT="$work_root/ca.pem"
export RIFFDB_CONFORMANCE_CREDENTIAL="$credential"
cargo +1.97.0 run --quiet -p riffdb-testkit --example adapter_bulk_remote_client -- >"$work_root/rust.json"

socket="$work_root/riffdb-driver.sock"
cat >"$work_root/driver.toml" <<EOF
[driver]
socket = "$socket"

[application]
lock_file = "$work_root/application/riffdb.application.lock.json"
manifest_file = "$work_root/application/generated/riffdb.application.exact.json"
operation_catalog_file = "$work_root/application/generated/mcp/tools.json"
database = "default"
role = "AdapterBulkApplication"

[remote]
endpoint = "https://127.0.0.1:$port"
tls_trust_root = "$work_root/ca.pem"
tls_server_name = "127.0.0.1"
credential_file = "$credential"
pool_connections = 4
streams_per_connection = 64
EOF
chmod 0600 "$work_root/driver.toml"
target/debug/riffdb-driverd "$work_root/driver.toml" >"$work_root/driver.stdout" 2>"$work_root/driver.stderr" &
driver_pid=$!
deadline=$((SECONDS + 30))
while [[ ! -S "$socket" && "$SECONDS" -lt "$deadline" ]]; do
    kill -0 "$driver_pid" 2>/dev/null || break
done
[[ -S "$socket" ]] || {
    sed -n '1,200p' "$work_root/driver.stderr" >&2
    echo "adapter Rust driver host did not become ready" >&2
    exit 1
}

manifest_hash="$(jq -r '.exact_manifest_hash' "$work_root/application/riffdb.application.lock.json")"
catalog_hash="$(jq -r '.artifacts[] | select(.kind == "mcp") | .content_hash' "$work_root/application/riffdb.application.lock.json")"
bundle_hash="$(jq -r '.contract.bundle_hash' "$work_root/application/riffdb.application.lock.json")"
role_hash="$(jq -r '.roles[] | select(.definition.name == "AdapterBulkApplication") | .definition_hash' "$work_root/application/riffdb.application.lock.json")"
remote_hash="$(printf 'https://127.0.0.1:%s|127.0.0.1' "$port" | sha256sum | cut -d' ' -f1)"
jq -n \
    --arg applicationManifestHash "$manifest_hash" \
    --arg operationCatalogHash "$catalog_hash" \
    --arg contractLineage AdapterBulkConformance \
    --argjson contractVersion 1 \
    --arg contractBundleHash "$bundle_hash" \
    --arg database default \
    --arg role AdapterBulkApplication \
    --arg roleDefinitionHash "$role_hash" \
    --arg remoteIdentityHash "$remote_hash" \
    '{applicationManifestHash:$applicationManifestHash,operationCatalogHash:$operationCatalogHash,contractLineage:$contractLineage,contractVersion:$contractVersion,contractBundleHash:$contractBundleHash,database:$database,role:$role,roleDefinitionHash:$roleDefinitionHash,remoteIdentityHash:$remoteIdentityHash}' \
    >"$work_root/identity.json"

export RIFFDB_CONFORMANCE_SOCKET="$socket"
export RIFFDB_CONFORMANCE_IDENTITY="$work_root/identity.json"
GOCACHE="$GOCACHE" GOPATH="$GOPATH" GOPROXY=off \
    go -C fixtures/adapters/bulk-conformance run ./runner/go >"$work_root/go.json"

clients/typescript/runtime/node_modules/.bin/tsc \
    "$work_root/application/generated/typescript/client.ts" \
    --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --skipLibCheck \
    --outDir "$work_root/typescript"
export RIFFDB_CONFORMANCE_TYPESCRIPT_RUNTIME="$repo_root/clients/typescript/runtime/dist/index.js"
export RIFFDB_CONFORMANCE_TYPESCRIPT_GENERATED="$work_root/typescript/client.js"
node fixtures/adapters/bulk-conformance/runner/typescript.mjs >"$work_root/typescript.json"

PYTHONPATH="$work_root/application/generated/python" \
    "$work_root/python-venv/bin/python" fixtures/adapters/bulk-conformance/runner/python.py \
    >"$work_root/python.json"

expected='{"adapters":["mlflow","openfga","payload","woodpecker"],"bounded_preflight":true,"replayed":true,"schema":"riffdb.adapter-bulk-observation/v1"}'
for language in rust go typescript python; do
    observed="$(jq -cS 'del(.language, .atomic_conflict, .delete_restrict)' "$work_root/$language.json")"
    [[ "$observed" == "$expected" ]] || {
        echo "$language produced a divergent adapter observation: $observed" >&2
        exit 1
    }
done
jq -e '.atomic_conflict == true and .delete_restrict == true' "$work_root/rust.json" >/dev/null

jq -e '.commands[] | select(.name | endswith("write_tuples"))
       | .input_schema.properties.tuples.minItems == 1
         and .input_schema.properties.tuples.maxItems == 128' \
    fixtures/adapters/bulk-conformance/generated/mcp/tools.json >/dev/null

if rg -n 'riffdb[_-](kernel|storage)|GetEntity|ScanIndex|raw[_ -]?(mutation|transaction)|entity_type_id|field_id|index_id' \
    fixtures/adapters/bulk-conformance/runner tests/adapter_bulk_remote_client.rs; then
    echo "adapter corpus crossed the application boundary" >&2
    exit 1
fi

echo "Rust, Go, TypeScript, Python, CLI, and MCP passed the bounded adapter command corpus."
