#!/bin/sh
set -eu

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repository_root"

cargo test -p riffdb-testkit -p riffdb-testkit-server
cargo test -p riffdb-testkit-server --test full_recovery_matrix -- --ignored
cargo test -p riffdb-testkit-server --test offline_maintenance_matrix -- --ignored
(
    cd tests/recovery/fixtures
    sha256sum --check wp190-report-v1.sha256
)
