#!/usr/bin/env bash
# req: NET-010, NET-012, APE-002
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

fail() {
    printf 'check-helm-upgrade-rehearsal: %s\n' "$1" >&2
    exit 1
}

command -v helm >/dev/null 2>&1 || fail "helm is required"
command -v ruby >/dev/null 2>&1 || fail "ruby is required for parsed manifest checks"

chart="release/helm/riffdb"
source_values="release/helm/rehearsal/wp727-local-source-values.yaml"
target_values="release/helm/rehearsal/wp727-local-target-values.yaml"
source_version="0.0.0-wp727.local-source"
target_version="0.0.0-wp727.local-target"
scratch="$(mktemp -d "${TMPDIR:-/tmp}/riffdb-wp727-rehearsal.XXXXXX")"
cleanup() {
    rm -rf -- "$scratch"
}
trap cleanup EXIT INT TERM

[[ -f "$source_values" && -f "$target_values" ]] || fail "frozen local values are absent"
mkdir -p "$scratch/charts" "$scratch/packages" "$scratch/renders"
cp -R "$chart" "$scratch/charts/source"
cp -R "$chart" "$scratch/charts/target"
sed -i -E "s/^version: .*/version: ${source_version}/; s/^appVersion: .*/appVersion: \"${source_version}\"/" "$scratch/charts/source/Chart.yaml"
sed -i -E "s/^version: .*/version: ${target_version}/; s/^appVersion: .*/appVersion: \"${target_version}\"/" "$scratch/charts/target/Chart.yaml"

helm lint "$scratch/charts/source" >/dev/null
helm lint "$scratch/charts/target" >/dev/null
helm package "$scratch/charts/source" --destination "$scratch/packages" >/dev/null
helm package "$scratch/charts/target" --destination "$scratch/packages" >/dev/null

source_archive="$scratch/packages/riffdb-${source_version}.tgz"
target_archive="$scratch/packages/riffdb-${target_version}.tgz"
[[ -f "$source_archive" && -f "$target_archive" ]] || fail "reserved local chart archives were not produced"

render() {
    local archive="$1"
    local values="$2"
    local output="$3"
    helm template riffdb "$archive" \
        --namespace wp727-local \
        --kube-version 1.29.0 \
        --api-versions v1 \
        --api-versions apps/v1 \
        --api-versions batch/v1 \
        --values "$values" >"$output"
}

render "$source_archive" "$source_values" "$scratch/renders/install.yaml"
render "$target_archive" "$target_values" "$scratch/renders/upgrade.yaml"
render "$source_archive" "$source_values" "$scratch/renders/rollback.yaml"

ruby - \
    "$scratch/renders/install.yaml" \
    "$scratch/renders/upgrade.yaml" \
    "$scratch/renders/rollback.yaml" \
    "$source_version" "$target_version" <<'RUBY'
require "yaml"

def fail(message)
  warn "check-helm-upgrade-rehearsal: #{message}"
  exit 1
end

def documents(path)
  YAML.safe_load_stream(File.read(path), permitted_classes: [], aliases: false).compact
rescue Psych::Exception => error
  fail("cannot parse #{path}: #{error.message}")
end

def object_key(object)
  [object["apiVersion"], object["kind"], object.dig("metadata", "namespace"), object.dig("metadata", "name")]
end

def object(documents, kind, name)
  documents.find { |entry| entry["kind"] == kind && entry.dig("metadata", "name") == name }
end

def walk(value, &block)
  block.call(value)
  case value
  when Hash
    value.each_value { |child| walk(child, &block) }
  when Array
    value.each { |child| walk(child, &block) }
  end
end

def riffdb_images(documents)
  images = []
  walk(documents) do |value|
    value.each { |key, child| images << child if key == "image" && child.is_a?(String) } if value.is_a?(Hash)
  end
  images.select { |image| image.start_with?("wp727.invalid/riffdb:") }
end

def secret_references(documents)
  names = []
  walk(documents) do |value|
    names << value.dig("secret", "secretName") if value.is_a?(Hash) && value.dig("secret", "secretName")
  end
  names.sort.uniq
end

def normalized(documents, version)
  copy = Marshal.load(Marshal.dump(documents))
  walk(copy) do |value|
    next unless value.is_a?(Hash)
    if value.key?("image") && value["image"] == "wp727.invalid/riffdb:#{version}"
      value["image"] = "<chart-appVersion-image>"
    end
    labels = value["labels"]
    if labels.is_a?(Hash)
      labels.delete("helm.sh/chart")
      labels.delete("app.kubernetes.io/version")
    end
    annotations = value["annotations"]
    annotations.delete("riffdb.dev/config-checksum") if annotations.is_a?(Hash)
  end
  stateful_set = object(copy, "StatefulSet", "riffdb")
  server = stateful_set&.dig("spec", "template", "spec", "containers")&.find { |container| container["name"] == "riffdbd" }
  server["resources"]["requests"]["cpu"] = "<declared-server-cpu>"
  object(copy, "Deployment", "riffdb-proxy")["spec"]["replicas"] = "<declared-proxy-replicas>"
  copy.sort_by { |entry| object_key(entry) }
end

def first_difference(left, right, path = "$render")
  return [path, left, right] unless left.class == right.class
  case left
  when Hash
    keys = (left.keys + right.keys).uniq.sort
    keys.each do |key|
      return ["#{path}.#{key}", left[key], right[key]] unless left.key?(key) && right.key?(key)
      difference = first_difference(left[key], right[key], "#{path}.#{key}")
      return difference if difference
    end
    nil
  when Array
    return ["#{path}.length", left.length, right.length] unless left.length == right.length
    left.each_index do |index|
      difference = first_difference(left[index], right[index], "#{path}[#{index}]")
      return difference if difference
    end
    nil
  else
    left == right ? nil : [path, left, right]
  end
end

install = documents(ARGV.fetch(0))
upgrade = documents(ARGV.fetch(1))
rollback = documents(ARGV.fetch(2))
source_version = ARGV.fetch(3)
target_version = ARGV.fetch(4)

install_keys = install.map { |entry| object_key(entry) }.sort
fail("upgrade changes Kubernetes object identity") unless upgrade.map { |entry| object_key(entry) }.sort == install_keys
fail("rollback changes Kubernetes object identity") unless rollback.map { |entry| object_key(entry) }.sort == install_keys
fail("rendered rollback does not exactly restore the install objects") unless rollback == install

[install, upgrade, rollback].each do |render|
  fail("render creates a Secret") if render.any? { |entry| entry["kind"] == "Secret" }
  fail("external Secret identity moved") unless secret_references(render) == ["wp727-external-server"]
  backup = object(render, "PersistentVolumeClaim", "riffdb-backups")
  fail("retained backup PVC identity or keep policy moved") unless backup&.dig("metadata", "namespace") == "wp727-local" && backup&.dig("metadata", "annotations", "helm.sh/resource-policy") == "keep"
  stateful_set = object(render, "StatefulSet", "riffdb")
  templates = stateful_set&.dig("spec", "volumeClaimTemplates") || []
  fail("data PVC template identity moved") unless templates.map { |template| template.dig("metadata", "name") } == ["data"]
end

fail("install image does not default to source appVersion") unless riffdb_images(install) == Array.new(2, "wp727.invalid/riffdb:#{source_version}")
fail("upgrade image does not default to target appVersion") unless riffdb_images(upgrade) == Array.new(2, "wp727.invalid/riffdb:#{target_version}")
fail("rollback image does not restore source appVersion") unless riffdb_images(rollback) == Array.new(2, "wp727.invalid/riffdb:#{source_version}")

install_cpu = object(install, "StatefulSet", "riffdb").dig("spec", "template", "spec", "containers").find { |container| container["name"] == "riffdbd" }.dig("resources", "requests", "cpu")
upgrade_cpu = object(upgrade, "StatefulSet", "riffdb").dig("spec", "template", "spec", "containers").find { |container| container["name"] == "riffdbd" }.dig("resources", "requests", "cpu")
fail("declared server CPU movement is absent") unless [install_cpu, upgrade_cpu] == ["500m", "750m"]
fail("declared proxy replica movement is absent") unless [object(install, "Deployment", "riffdb-proxy").dig("spec", "replicas"), object(upgrade, "Deployment", "riffdb-proxy").dig("spec", "replicas")] == [1, 2]
normalized_install = normalized(install, source_version)
normalized_upgrade = normalized(upgrade, target_version)
if (difference = first_difference(normalized_install, normalized_upgrade))
  path, source_value, target_value = difference
  fail("undeclared rendered field moved at #{path}: #{source_value.inspect} -> #{target_value.inspect}")
end
RUBY

echo "check-helm-upgrade-rehearsal-v1 local install, upgrade, and rollback renders passed"
