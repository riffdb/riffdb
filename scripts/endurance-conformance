#!/usr/bin/env python3
"""Run one bounded periodic alpha-endurance conformance checkpoint."""

from __future__ import annotations

import asyncio
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import time
from typing import Any
from uuid import UUID


RESULT_SCHEMA = "riffdb.alpha-endurance-conformance-result/v2"
WORKER_SCHEMA = "riffdb.alpha-endurance-worker/v1"
DOMAINS = ("better-auth", "mlflow", "openfga", "woodpecker")
LANGUAGES = ("go", "python", "rust", "typescript")
TENANTS = ("tenant_alpha", "tenant_beta", "tenant_gamma", "tenant_delta")
WORKLOADS = ("events", "live_queries", "reads", "workflows", "writes")
APPLICATION_NAMESPACES = (1001, 2003, 3005, 4007)
MAX_BYTES = 1024 * 1024
MAX_PROBE_FILES = 256
MAX_PROBE_FILE_BYTES = 512 * 1024 * 1024
MAX_PROBE_TOTAL_BYTES = 1024 * 1024 * 1024
PROBE_BUNDLE_SCHEMA = "riffdb.alpha-endurance-conformance-probes/v1"
PROBE_MANIFEST = "probe-manifest-v1.json"
REQUIRED_PROBE_PATHS = {
    "bin/adapter_conformance",
    "bin/row_policy_conformance",
    "runner",
}


def fail(message: str) -> "None":
    raise ValueError(message)


def artifact_root() -> Path:
    raw = os.environ.get("RIFFDB_ENDURANCE_ARTIFACT_ROOT", "")
    candidate = Path(raw)
    if not raw or not candidate.is_absolute() or candidate.is_symlink() or not candidate.is_dir():
        fail("RIFFDB_ENDURANCE_ARTIFACT_ROOT must be an absolute non-symlink directory")
    return candidate


def read_object(path: Path) -> dict[str, Any]:
    if path.is_symlink() or not path.is_file():
        fail(f"endurance conformance input is absent: {path.name}")
    encoded = path.read_bytes()
    if not 0 < len(encoded) <= MAX_BYTES:
        fail(f"endurance conformance input exceeds its byte bound: {path.name}")
    value = json.loads(encoded)
    if not isinstance(value, dict):
        fail(f"endurance conformance input is not an object: {path.name}")
    return value


def integer(value: Any, name: str) -> int:
    if type(value) is not int or value < 0:
        fail(f"endurance conformance {name} is invalid")
    return value


def sha256_file(path: Path) -> str:
    if path.is_symlink() or not path.is_file():
        fail("endurance conformance artifact is not a regular file")
    digest = hashlib.sha256()
    with path.open("rb") as source:
        while chunk := source.read(64 * 1024):
            digest.update(chunk)
    return digest.hexdigest()


def probe_bundle_root(raw: str | Path) -> Path:
    candidate = Path(raw)
    if not candidate.is_absolute() or candidate.is_symlink() or not candidate.is_dir():
        fail("endurance conformance probe bundle must be an absolute non-symlink directory")
    return candidate


def probe_inventory(root: Path) -> list[dict[str, Any]]:
    entries: list[dict[str, Any]] = []
    total_bytes = 0
    for candidate in sorted(root.rglob("*")):
        if candidate == root / PROBE_MANIFEST:
            continue
        if candidate.is_symlink():
            fail("endurance conformance probe bundle contains a symlink")
        if candidate.is_dir():
            continue
        if not candidate.is_file():
            fail("endurance conformance probe bundle contains a non-regular entry")
        relative = candidate.relative_to(root).as_posix()
        size = candidate.stat().st_size
        if size <= 0 or size > MAX_PROBE_FILE_BYTES:
            fail("endurance conformance probe file exceeds its byte bound")
        total_bytes += size
        if total_bytes > MAX_PROBE_TOTAL_BYTES:
            fail("endurance conformance probe bundle exceeds its byte bound")
        entries.append({"path": relative, "sha256": sha256_file(candidate), "size": size})
        if len(entries) > MAX_PROBE_FILES:
            fail("endurance conformance probe bundle exceeds its file bound")
    paths = {entry["path"] for entry in entries}
    if not REQUIRED_PROBE_PATHS <= paths:
        fail("endurance conformance probe bundle omits a required executable")
    if not any(path.startswith("fixtures/adapters/conformance/") for path in paths):
        fail("endurance conformance probe bundle omits its adapter fixtures")
    if any(not os.access(root / path, os.X_OK) for path in REQUIRED_PROBE_PATHS):
        fail("endurance conformance probe executable is not executable")
    return entries


def seal_probe_bundle(root: Path, release_artifact_sha256: str, source_revision: str) -> str:
    if len(release_artifact_sha256) != 64 or any(
        character not in "0123456789abcdef" for character in release_artifact_sha256
    ):
        fail("endurance conformance release artifact digest is invalid")
    if len(source_revision) != 40 or any(
        character not in "0123456789abcdef" for character in source_revision
    ):
        fail("endurance conformance source revision is invalid")
    manifest = root / PROBE_MANIFEST
    if manifest.exists() or manifest.is_symlink():
        fail("endurance conformance probe manifest already exists")
    value = {
        "schema": PROBE_BUNDLE_SCHEMA,
        "release_artifact_sha256": release_artifact_sha256,
        "source_revision": source_revision,
        "files": probe_inventory(root),
    }
    return atomic_write(manifest, value)


def verify_probe_bundle(root: Path) -> tuple[dict[str, Any], str]:
    manifest_path = root / PROBE_MANIFEST
    manifest = read_object(manifest_path)
    if set(manifest) != {
        "schema",
        "release_artifact_sha256",
        "source_revision",
        "files",
    } or manifest.get("schema") != PROBE_BUNDLE_SCHEMA:
        fail("endurance conformance probe manifest has an invalid shape")
    release_artifact_sha256 = manifest.get("release_artifact_sha256")
    source_revision = manifest.get("source_revision")
    if not isinstance(release_artifact_sha256, str) or len(release_artifact_sha256) != 64 or any(
        character not in "0123456789abcdef" for character in release_artifact_sha256
    ):
        fail("endurance conformance probe manifest has an invalid release identity")
    if not isinstance(source_revision, str) or len(source_revision) != 40 or any(
        character not in "0123456789abcdef" for character in source_revision
    ):
        fail("endurance conformance probe manifest has an invalid source identity")
    expected = manifest.get("files")
    if not isinstance(expected, list) or not 1 <= len(expected) <= MAX_PROBE_FILES:
        fail("endurance conformance probe manifest has an invalid inventory")
    if expected != probe_inventory(root):
        fail("endurance conformance probe bundle differs from its sealed inventory")
    return manifest, sha256_file(manifest_path)


def atomic_write(path: Path, value: dict[str, Any]) -> str:
    pending = path.with_name(f".{path.name}.{os.getpid()}.pending")
    encoded = (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()
    try:
        with pending.open("xb") as destination:
            os.chmod(pending, 0o600)
            destination.write(encoded)
            destination.flush()
            os.fsync(destination.fileno())
        pending.replace(path)
    finally:
        if pending.exists():
            pending.unlink()
    return hashlib.sha256(encoded).hexdigest()


def self_test() -> None:
    task_tmp_root = Path(os.environ.get("RIFFDB_TMP_ROOT", Path.home() / "tmp"))
    task_tmp_root.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(
        prefix="riffdb-endurance-conformance-", dir=task_tmp_root
    ) as temporary:
        root = Path(temporary).resolve()
        (root / "bin").mkdir()
        fixture = root / "fixtures/adapters/conformance/example/fixture.json"
        fixture.parent.mkdir(parents=True)
        fixture.write_text("{}\n", encoding="utf-8")
        runner = root / "runner"
        runner.write_bytes(Path(__file__).read_bytes())
        runner.chmod(0o700)
        for name in ("adapter_conformance", "row_policy_conformance"):
            executable = root / "bin" / name
            executable.write_text("#!/bin/sh\nexit 0\n", encoding="utf-8")
            executable.chmod(0o700)
        sealed = seal_probe_bundle(root, "a" * 64, "b" * 40)
        _, verified = verify_probe_bundle(root)
        if sealed != verified:
            fail("endurance conformance probe manifest digest is unstable")

        # A live-checkout mutation is deliberately outside the sealed bundle and
        # therefore cannot alter the probe identity used by a running soak.
        live_source = task_tmp_root / f"riffdb-live-source-{os.getpid()}"
        try:
            live_source.write_text("before\n", encoding="utf-8")
            live_source.write_text("after\n", encoding="utf-8")
            _, after_live_change = verify_probe_bundle(root)
            if after_live_change != sealed:
                fail("live source changed the sealed endurance conformance identity")
        finally:
            if live_source.exists():
                live_source.unlink()

        with (root / "bin/adapter_conformance").open("ab") as destination:
            destination.write(b"tampered")
        try:
            verify_probe_bundle(root)
        except ValueError:
            pass
        else:
            fail("tampered endurance conformance probe bundle passed")
    print("immutable_probe_bundle: passed")


def reexecute_installed_python(environment: Path) -> None:
    state = read_object(environment / "state.json")
    configured = Path(str(state.get("python", "")))
    if not configured.is_absolute() or not configured.is_file():
        fail("endurance conformance Python installation is invalid")
    if os.environ.get("RIFFDB_ENDURANCE_CONFORMANCE_REEXEC") == "1":
        if Path(sys.executable).resolve() != configured.resolve():
            fail("endurance conformance re-executed with the wrong Python installation")
        return
    next_environment = os.environ.copy()
    next_environment["RIFFDB_ENDURANCE_CONFORMANCE_REEXEC"] = "1"
    os.execve(str(configured), [str(configured), str(Path(__file__).resolve())], next_environment)


def bounded_command(argv: list[str], cwd: Path, environment: dict[str, str]) -> str:
    result = subprocess.run(
        argv,
        cwd=cwd,
        env=environment,
        stdin=subprocess.DEVNULL,
        capture_output=True,
        text=True,
        timeout=300,
        check=False,
    )
    if result.returncode != 0:
        fail("endurance conformance semantic suite failed")
    encoded = result.stdout.encode()
    if len(encoded) > MAX_BYTES:
        fail("endurance conformance semantic suite output exceeds its byte bound")
    return hashlib.sha256(encoded).hexdigest()


def serving_frontier(environment: Path) -> tuple[int, str]:
    result = subprocess.run(
        [
            str(environment / "bin" / "riffdb"),
            "--config",
            str(environment / "bootstrap-client.toml"),
            "server",
            "health",
            "--output",
            "json",
        ],
        stdin=subprocess.DEVNULL,
        capture_output=True,
        text=True,
        timeout=30,
        check=False,
    )
    if result.returncode != 0 or len(result.stdout.encode()) > MAX_BYTES:
        fail("endurance conformance authenticated health failed")
    value = json.loads(result.stdout)
    payload = value.get("result") if isinstance(value, dict) else None
    components = payload.get("components") if isinstance(payload, dict) else None
    statuses: dict[str, str] = {}
    if isinstance(components, list):
        for component in components:
            if not isinstance(component, dict):
                fail("endurance conformance health component is invalid")
            name = component.get("component")
            status = component.get("status")
            if not isinstance(name, str) or not isinstance(status, str) or name in statuses:
                fail("endurance conformance health component is invalid")
            statuses[name] = status
    if (
        not isinstance(payload, dict)
        or value.get("schema") != "riffdb.cli.output/v1"
        or value.get("ok") is not True
        or payload.get("status") not in ("ready", "degraded")
        or payload.get("database") != "default"
        or any(
            statuses.get(name) != "healthy"
            for name in ("authoritative_storage", "catalog", "commit_coordinator")
        )
    ):
        fail("endurance conformance health is not an authenticated serving frontier")
    raw_frontier = payload.get("last_commit_sequence")
    if not isinstance(raw_frontier, str) or not raw_frontier.isascii() or not raw_frontier.isdigit():
        fail("endurance conformance health frontier is invalid")
    return int(raw_frontier), hashlib.sha256(result.stdout.encode()).hexdigest()


def worker_observations(environment: Path) -> tuple[list[dict[str, Any]], dict[str, str]]:
    deadline = time.monotonic() + 90
    while True:
        observations: list[dict[str, Any]] = []
        try:
            for language in LANGUAGES:
                value = read_object(environment / "metrics" / f"{language}.json")
                if value.get("schema") != WORKER_SCHEMA or value.get("language") != language:
                    fail("endurance conformance worker identity is invalid")
                logical = integer(value.get("logical_operations"), f"{language}.logical_operations")
                attempts = integer(value.get("transport_attempts"), f"{language}.transport_attempts")
                retries = integer(value.get("declared_retries"), f"{language}.declared_retries")
                if integer(value.get("error_count"), f"{language}.error_count") != 0:
                    fail("endurance conformance worker reports an error")
                workloads = value.get("workloads")
                tenants = value.get("tenants")
                if not isinstance(workloads, dict) or set(workloads) != set(WORKLOADS):
                    fail("endurance conformance worker workload inventory is invalid")
                if not isinstance(tenants, dict) or set(tenants) != set(TENANTS):
                    fail("endurance conformance worker tenant inventory is invalid")
                workload_total = sum(integer(workloads[name], f"{language}.{name}") for name in WORKLOADS)
                tenant_total = sum(integer(tenants[name], f"{language}.{name}") for name in TENANTS)
                if logical == 0 or attempts != logical + retries or workload_total != logical or tenant_total != logical:
                    fail("endurance conformance worker accounting is not exact")
                if any(integer(workloads[name], f"{language}.{name}") == 0 for name in WORKLOADS):
                    fail("endurance conformance worker has incomplete workload progress")
                if any(integer(tenants[name], f"{language}.{name}") == 0 for name in TENANTS):
                    fail("endurance conformance worker has incomplete tenant progress")
                observations.append(value)
        except (FileNotFoundError, json.JSONDecodeError, ValueError):
            if time.monotonic() >= deadline:
                raise
            time.sleep(0.25)
            continue
        digests = {
            language: sha256_file(environment / "metrics" / f"{language}.json")
            for language in LANGUAGES
        }
        return observations, digests


def identifier(namespace: int, value: int) -> UUID:
    return UUID(f"{namespace & 0xffff_ffff:08x}-0000-8000-8000-{value & 0xffff_ffff_ffff:012x}")


async def application_probes(environment: Path) -> int:
    sys.path.insert(0, str(environment / "application" / "generated" / "python"))
    from riffdb_application import (
        ApplicationErrorCode,
        AsyncApplicationTransport,
        AttemptBudget,
        BearerCredential,
        CallMetadata,
        DatabaseAlias,
        RiffDbApplicationError,
        VerifiedTlsConfig,
    )
    from client import AsyncTicketDeskClient, TicketPageFound, TicketPageParams

    state = read_object(environment / "state.json")
    endpoint = state.get("endpoint")
    if not isinstance(endpoint, str):
        fail("endurance conformance endpoint is invalid")

    async def connect(credential_name: str) -> AsyncApplicationTransport:
        metadata = CallMetadata.authenticated(
            BearerCredential.from_protected_file(str(environment / credential_name))
        ).with_database(DatabaseAlias("default"))
        return await AsyncApplicationTransport.connect_verified_tls(
            VerifiedTlsConfig(
                endpoint=endpoint,
                trust_root=str(environment / "ca.pem"),
                server_name="127.0.0.1",
                pool_connections=1,
                streams_per_connection=16,
            ),
            metadata,
        )

    application_transport = await connect("application.credential")
    seeder_transport = await connect("seeder.credential")
    application = AsyncTicketDeskClient(application_transport, AttemptBudget(1))
    seeder = AsyncTicketDeskClient(seeder_transport, AttemptBudget(1))
    verified = 0
    try:
        for namespace in APPLICATION_NAMESPACES:
            for client_index in range(4):
                page = await application.ticket_page(
                    TicketPageParams(
                        organization_id=identifier(namespace, client_index),
                        ticket_id=identifier(namespace, 300 + client_index),
                    )
                )
                if not isinstance(page.value, TicketPageFound):
                    fail("endurance conformance hot-ticket reconciliation failed")
                verified += 1
        try:
            await seeder.ticket_page(
                TicketPageParams(
                    organization_id=identifier(APPLICATION_NAMESPACES[0], 0),
                    ticket_id=identifier(APPLICATION_NAMESPACES[0], 300),
                )
            )
        except RiffDbApplicationError as error:
            if error.details.code != ApplicationErrorCode.AUTHORIZATION_DENIED:
                raise
        else:
            fail("endurance conformance least-authority policy probe unexpectedly succeeded")
    finally:
        await asyncio.gather(application_transport.close(), seeder_transport.close())
    return verified


def main() -> int:
    if sys.argv[1:] == ["--self-test"]:
        self_test()
        return 0
    if len(sys.argv) == 5 and sys.argv[1] == "--seal-probe-bundle":
        root = probe_bundle_root(sys.argv[2])
        print(seal_probe_bundle(root, sys.argv[3], sys.argv[4]))
        return 0
    if len(sys.argv) == 3 and sys.argv[1] == "--verify-probe-bundle":
        _, digest = verify_probe_bundle(probe_bundle_root(sys.argv[2]))
        print(digest)
        return 0
    if len(sys.argv) != 1:
        fail("usage: endurance-conformance [--self-test|--verify-probe-bundle ROOT]")
    root = artifact_root()
    environment = root / "environment-v1"
    if not environment.is_dir() or environment.is_symlink():
        fail("endurance conformance environment is invalid")
    reexecute_installed_python(environment)

    frontier, health_sha256 = serving_frontier(environment)
    observations, worker_sha256 = worker_observations(environment)
    verified_hot_tickets = asyncio.run(application_probes(environment))

    probe_root = probe_bundle_root(environment / "conformance")
    probe_manifest, probe_bundle_sha256 = verify_probe_bundle(probe_root)
    command_environment = os.environ.copy()
    scratch = environment / "conformance-tmp"
    scratch.mkdir(mode=0o700, exist_ok=True)
    command_environment["RIFFDB_TMP_ROOT"] = str(scratch)
    command_environment["TMPDIR"] = str(scratch)
    command_environment["RIFFDB_TEST_TMP_ROOT"] = str(scratch)
    command_environment["RIFFDB_ADAPTER_CONFORMANCE_FIXTURE_ROOT"] = str(
        probe_root / "fixtures/adapters/conformance"
    )
    adapter_suite_sha256 = bounded_command(
        [str(probe_root / "bin/adapter_conformance"), "--quiet"],
        scratch,
        command_environment,
    )
    row_policy_suite_sha256 = bounded_command(
        [str(probe_root / "bin/row_policy_conformance"), "--quiet"],
        scratch,
        command_environment,
    )

    evidence = {
        "schema": "riffdb.alpha-endurance-conformance-evidence/v1",
        "frontier": frontier,
        "health_sha256": health_sha256,
        "application_lock_sha256": sha256_file(
            environment / "application" / "riffdb.application.lock.json"
        ),
        "worker_sha256": worker_sha256,
        "logical_operations": sum(
            integer(item["logical_operations"], "logical_operations") for item in observations
        ),
        "verified_hot_tickets": verified_hot_tickets,
        "least_authority_policy_probe": "authorization_denied",
        "adapter_suite_sha256": adapter_suite_sha256,
        "row_policy_suite_sha256": row_policy_suite_sha256,
        "probe_bundle_sha256": probe_bundle_sha256,
        "probe_source_revision": probe_manifest["source_revision"],
        "release_artifact_sha256": probe_manifest["release_artifact_sha256"],
        "domains": list(DOMAINS),
    }
    evidence_root = environment / "conformance-evidence"
    evidence_root.mkdir(mode=0o700, exist_ok=True)
    evidence_sha256 = hashlib.sha256(
        (json.dumps(evidence, sort_keys=True, separators=(",", ":")) + "\n").encode()
    ).hexdigest()
    evidence_path = evidence_root / f"{evidence_sha256}.json"
    retained_digest = atomic_write(evidence_path, evidence)
    if retained_digest != evidence_sha256:
        fail("endurance conformance evidence digest is unstable")
    result = {
        "schema": RESULT_SCHEMA,
        "status": "passed",
        "domains": list(DOMAINS),
        "policy_probes_passed": True,
        "data_reconciliation_passed": True,
        "silent_loss": 0,
        "evidence_sha256": evidence_sha256,
        "probe_bundle_sha256": probe_bundle_sha256,
        "release_artifact_sha256": probe_manifest["release_artifact_sha256"],
    }
    print(json.dumps(result, sort_keys=True, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (json.JSONDecodeError, OSError, subprocess.SubprocessError, ValueError) as error:
        print(f"endurance_conformance_invalid: {error}", file=sys.stderr)
        raise SystemExit(3) from error
