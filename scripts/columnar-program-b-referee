#!/usr/bin/env python3
# req: PRJ-001, PRJ-002, PRJ-003, PRJ-004, QRY-001, QRY-002, QRY-003, QRY-004, QRY-005
# req: OQ-017, OQ-018, OQ-019, OQ-020, OQ-021, OQ-022, OQ-023, OQ-024, OQ-044, OQ-045
# req: OQ-046, OQ-047, OQ-048, OQ-049, OQ-050, OQ-051, OQ-052, OQ-053, OQ-054, OQ-055
# req: PERF-001, PERF-007, PERF-008, PERF-018
"""Verify ADR-0161 OBL-0161-9 cross-plane matched-frontier Program B acceptance referee."""

from __future__ import annotations

import argparse
import copy
import json
from pathlib import Path
import subprocess
import sys
from typing import Any

ROOT = Path(__file__).resolve().parent.parent
SCHEMA = "riffdb.wp-715-columnar-program-b-referee/v1"
MAX_INPUT_BYTES = 4 * 1024 * 1024
MIN_CPU_REDUCTION_RATIO = 0.35
MIN_COMPLETE_QUERY_THROUGHPUT_RATIO = 1.50
MAX_SELECTIVE_PRUNING_REGRESSION_RATIO = 0.05
MIN_ONE_TO_FOUR_WORKER_THROUGHPUT_RATIO = 1.50
MAX_FOUR_WORKER_INTERACTIVE_P95_RATIO = 1.10

REQUIRED_SURFACES = ("grpc", "mcp", "cli", "sdk")
REQUIRED_PLANES = ("v1_scalar", "v2_scalar", "v2_vectorized", "v2_parallel")
REQUIRED_PROFILES = ("1k", "10k", "100k", "1m")
FORBIDDEN_VALUE_KEYS = frozenset(
    {
        "tenant_id",
        "org_id",
        "primary_key",
        "entity_key",
        "field_value",
        "predicate_literal",
        "cursor_bytes",
        "raw_row",
        "secret_value",
    }
)


def load_bounded_json(path: Path) -> dict[str, Any]:
    raw = path.read_bytes()
    if len(raw) > MAX_INPUT_BYTES:
        raise ValueError(f"{path}: input exceeds {MAX_INPUT_BYTES} bytes")
    data = json.loads(raw.decode("utf-8"))
    if not isinstance(data, dict):
        raise ValueError(f"{path}: root must be a JSON object")
    return data


def contains_forbidden_keys(node: Any) -> bool:
    if isinstance(node, dict):
        for key, value in node.items():
            if key in FORBIDDEN_VALUE_KEYS or contains_forbidden_keys(value):
                return True
        return False
    if isinstance(node, list):
        return any(contains_forbidden_keys(item) for item in node)
    return False


def evaluate_receipt(receipt: dict[str, Any]) -> tuple[bool, list[str], dict[str, Any]]:
    reasons: list[str] = []
    if contains_forbidden_keys(receipt):
        return False, ["non-value-free-evidence"], {
            "schema": SCHEMA,
            "qualified": False,
            "activated_capabilities": [],
            "disabled_capabilities": [
                "v2_vectorized_batch",
                "v2_parallel_scan",
                "incremental_bitmap_rollup_topk",
            ],
            "reasons": ["non-value-free-evidence"],
        }

    if receipt.get("schema") != SCHEMA:
        reasons.append("invalid-schema")

    cross_plane = receipt.get("cross_plane_differential")
    policy = receipt.get("policy_and_inference")
    lifecycle = receipt.get("lifecycle_and_recovery")
    surfaces = receipt.get("public_surface_equivalence")
    workloads = receipt.get("workloads")
    mechanics = receipt.get("mechanics_gates")
    incremental = receipt.get("incremental_structures")

    if not all(
        isinstance(section, dict)
        for section in (
            cross_plane,
            policy,
            lifecycle,
            surfaces,
            workloads,
            mechanics,
            incremental,
        )
    ):
        reasons.append("missing-sections")
        return False, reasons, {
            "schema": SCHEMA,
            "qualified": False,
            "activated_capabilities": [],
            "disabled_capabilities": [
                "v2_vectorized_batch",
                "v2_parallel_scan",
                "incremental_bitmap_rollup_topk",
            ],
            "reasons": reasons,
        }

    # 1. Cross-plane matched-frontier differential verification.
    planes = cross_plane.get("planes")
    if not isinstance(planes, list) or tuple(planes) != REQUIRED_PLANES:
        reasons.append("missing-required-planes")
    if cross_plane.get("matched_history_incarnation") is not True:
        reasons.append("mixed-frontier-or-epoch")
    if cross_plane.get("matched_generation_and_provider_epoch") is not True:
        reasons.append("mixed-frontier-or-epoch")
    if cross_plane.get("matched_snapshot_and_frontier") is not True:
        reasons.append("mixed-frontier-or-epoch")
    if cross_plane.get("results_and_closed_failures_identical") is not True:
        reasons.append("cross-plane-differential-mismatch")
    if int(cross_plane.get("divergent_histories", 1)) != 0:
        reasons.append("cross-plane-differential-mismatch")

    # 2. Policy order, secret redaction, and inference safety.
    required_policy_checks = (
        "policy_precedes_selection_and_shaping",
        "rejected_rows_never_decode_output_lanes",
        "denied_rows_zero_count_rank_aggregate_influence",
        "capability_revocation_and_revision_enforced",
        "timing_and_diagnostic_classes_policy_invariant",
    )
    if any(policy.get(check) is not True for check in required_policy_checks):
        reasons.append("policy-inference-gate-failed")

    # 3. Lifecycle, crash/rebuild, V1 readability, and no-fallback rules.
    required_lifecycle_checks = (
        "cold_and_activating_return_rowless_building",
        "active_only_scheduler_admission",
        "crash_restart_rebuild_compaction_exact",
        "v1_segments_remain_readable",
        "v2_corruption_refuses_closed",
        "no_silent_scalar_or_v1_fallback",
        "no_projection_zero_open_and_walk",
        "resources_and_buffers_statically_bounded",
    )
    if lifecycle.get("no_silent_scalar_or_v1_fallback") is not True:
        reasons.append("silent-fallback-detected")
    if any(lifecycle.get(check) is not True for check in required_lifecycle_checks):
        reasons.append("lifecycle-or-recovery-gate-failed")

    # 4. Public surface equivalence across gRPC, MCP, CLI, and generated SDKs.
    compared_surfaces = surfaces.get("surfaces")
    if not isinstance(compared_surfaces, list) or tuple(compared_surfaces) != REQUIRED_SURFACES:
        reasons.append("public-surface-divergence")
    required_surface_checks = (
        "identical_results_and_cursors",
        "identical_freshness_and_safe_points",
        "identical_typed_refusals",
        "no_caller_layout_or_worker_knobs",
    )
    if any(surfaces.get(check) is not True for check in required_surface_checks):
        reasons.append("public-surface-divergence")

    # 5. Neutral workloads and partition profiles.
    if workloads.get("neutral_ticket_queue_and_run_metric_only") is not True:
        reasons.append("non-neutral-workload")
    if workloads.get("external_framework_artifacts_absent") is not True:
        reasons.append("external-framework-artifact-detected")
    profiles = workloads.get("partition_profiles")
    if not isinstance(profiles, list) or tuple(profiles) != REQUIRED_PROFILES:
        reasons.append("missing-partition-profiles")

    # 6. Incremental provider structures (ADR-0162) honesty check:
    # While ADR-0162 is proposed / WP-714 is unactivated, claiming incremental
    # structures as activated is a public/compatibility overclaim.
    adr_0162_accepted = incremental.get("adr_0162_accepted") is True
    incremental_activated = incremental.get("activated") is True
    if incremental_activated and not adr_0162_accepted:
        reasons.append("unqualified-incremental-capability-overclaim")

    # 7. Mechanics & parallel scaling gate table: any miss disables only the
    # failed capability and is reported honestly.
    activated_capabilities = ["v2_segment"]
    disabled_capabilities: list[str] = []

    vec_gate = mechanics.get("vectorized_batch")
    par_gate = mechanics.get("parallel_scan")
    if not isinstance(vec_gate, dict) or not isinstance(par_gate, dict):
        reasons.append("missing-mechanics-gate-table")
        return False, reasons, {
            "schema": SCHEMA,
            "qualified": False,
            "activated_capabilities": activated_capabilities,
            "disabled_capabilities": [
                "v2_vectorized_batch",
                "v2_parallel_scan",
                "incremental_bitmap_rollup_topk",
            ],
            "reasons": reasons,
        }

    cpu_reduction = float(vec_gate.get("cpu_per_examined_row_reduction_ratio", 0.0))
    vec_throughput = float(vec_gate.get("complete_query_throughput_ratio", 0.0))
    selective_regression = float(vec_gate.get("selective_zone_map_regression_ratio", 1.0))
    per_row_allocs = int(vec_gate.get("per_row_heap_allocations", 1))

    vec_passed = (
        (cpu_reduction >= MIN_CPU_REDUCTION_RATIO or vec_throughput >= MIN_COMPLETE_QUERY_THROUGHPUT_RATIO)
        and selective_regression <= MAX_SELECTIVE_PRUNING_REGRESSION_RATIO
        and per_row_allocs == 0
    )
    if vec_passed:
        activated_capabilities.append("v2_vectorized_batch")
    else:
        disabled_capabilities.append("v2_vectorized_batch")

    par_throughput = float(par_gate.get("one_to_four_worker_throughput_ratio", 0.0))
    par_tail_ratio = float(par_gate.get("four_worker_interactive_p95_ratio", 99.0))
    par_no_regression = par_gate.get("write_and_catch_up_no_regression") is True

    par_passed = (
        vec_passed
        and par_throughput >= MIN_ONE_TO_FOUR_WORKER_THROUGHPUT_RATIO
        and par_tail_ratio <= MAX_FOUR_WORKER_INTERACTIVE_P95_RATIO
        and par_no_regression
    )
    if par_passed:
        activated_capabilities.append("v2_parallel_scan")
    else:
        disabled_capabilities.append("v2_parallel_scan")

    if adr_0162_accepted and incremental_activated:
        activated_capabilities.append("incremental_bitmap_rollup_topk")
    else:
        disabled_capabilities.append("incremental_bitmap_rollup_topk")

    claimed_active = receipt.get("claimed_activated_capabilities")
    if not isinstance(claimed_active, list) or claimed_active != activated_capabilities:
        reasons.append("capability-activation-overclaim-or-mismatch")

    qualified = len(reasons) == 0
    return qualified, reasons, {
        "schema": SCHEMA,
        "qualified": qualified,
        "activated_capabilities": activated_capabilities,
        "disabled_capabilities": disabled_capabilities,
        "reasons": reasons,
    }


def registered_receipt() -> dict[str, Any]:
    return {
        "schema": SCHEMA,
        "work_package": "WP-715",
        "adr_scope": ["ADR-0160", "ADR-0161", "ADR-0162"],
        "cross_plane_differential": {
            "planes": list(REQUIRED_PLANES),
            "matched_history_incarnation": True,
            "matched_generation_and_provider_epoch": True,
            "matched_snapshot_and_frontier": True,
            "results_and_closed_failures_identical": True,
            "randomized_histories_compared": 64,
            "divergent_histories": 0,
        },
        "policy_and_inference": {
            "policy_precedes_selection_and_shaping": True,
            "rejected_rows_never_decode_output_lanes": True,
            "denied_rows_zero_count_rank_aggregate_influence": True,
            "capability_revocation_and_revision_enforced": True,
            "timing_and_diagnostic_classes_policy_invariant": True,
        },
        "lifecycle_and_recovery": {
            "cold_and_activating_return_rowless_building": True,
            "active_only_scheduler_admission": True,
            "crash_restart_rebuild_compaction_exact": True,
            "v1_segments_remain_readable": True,
            "v2_corruption_refuses_closed": True,
            "no_silent_scalar_or_v1_fallback": True,
            "no_projection_zero_open_and_walk": True,
            "resources_and_buffers_statically_bounded": True,
        },
        "public_surface_equivalence": {
            "surfaces": list(REQUIRED_SURFACES),
            "identical_results_and_cursors": True,
            "identical_freshness_and_safe_points": True,
            "identical_typed_refusals": True,
            "no_caller_layout_or_worker_knobs": True,
        },
        "workloads": {
            "neutral_ticket_queue_and_run_metric_only": True,
            "external_framework_artifacts_absent": True,
            "partition_profiles": list(REQUIRED_PROFILES),
            "selectivities_percent": [1, 10, 100],
            "concurrencies": [1, 16, 64],
        },
        "mechanics_gates": {
            "vectorized_batch": {
                "cpu_per_examined_row_reduction_ratio": 0.4375,
                "complete_query_throughput_ratio": 1.647059,
                "selective_zone_map_regression_ratio": -0.024194,
                "per_row_heap_allocations": 0,
            },
            "parallel_scan": {
                "one_to_four_worker_throughput_ratio": 1.857143,
                "four_worker_interactive_p95_ratio": 1.059459,
                "write_and_catch_up_no_regression": True,
            },
        },
        "incremental_structures": {
            "adr_0162_accepted": False,
            "activated": False,
            "disposition": "deferred_pending_adr_0162_and_wp_714",
        },
        "claimed_activated_capabilities": [
            "v2_segment",
            "v2_vectorized_batch",
            "v2_parallel_scan",
        ],
    }


def run_self_test() -> int:
    baseline = registered_receipt()
    ok, reasons, verdict = evaluate_receipt(baseline)
    if (
        not ok
        or reasons
        or verdict["activated_capabilities"]
        != ["v2_segment", "v2_vectorized_batch", "v2_parallel_scan"]
        or verdict["disabled_capabilities"] != ["incremental_bitmap_rollup_topk"]
    ):
        print(f"self-test failed: expected baseline referee pass, got {verdict}", file=sys.stderr)
        return 1

    # 1. Cross-plane differential mismatch fails closed.
    diff_fail = copy.deepcopy(baseline)
    diff_fail["cross_plane_differential"]["results_and_closed_failures_identical"] = False
    ok, reasons, _ = evaluate_receipt(diff_fail)
    if ok or "cross-plane-differential-mismatch" not in reasons:
        print(f"self-test failed: expected cross-plane-differential-mismatch, got {reasons}", file=sys.stderr)
        return 1

    # 2. Mixed frontier/epoch fails closed.
    frontier_fail = copy.deepcopy(baseline)
    frontier_fail["cross_plane_differential"]["matched_snapshot_and_frontier"] = False
    ok, reasons, _ = evaluate_receipt(frontier_fail)
    if ok or "mixed-frontier-or-epoch" not in reasons:
        print(f"self-test failed: expected mixed-frontier-or-epoch, got {reasons}", file=sys.stderr)
        return 1

    # 3. Policy/inference violation fails closed.
    policy_fail = copy.deepcopy(baseline)
    policy_fail["policy_and_inference"]["rejected_rows_never_decode_output_lanes"] = False
    ok, reasons, _ = evaluate_receipt(policy_fail)
    if ok or "policy-inference-gate-failed" not in reasons:
        print(f"self-test failed: expected policy-inference-gate-failed, got {reasons}", file=sys.stderr)
        return 1

    # 4. Silent scalar/V1 fallback fails closed.
    fallback_fail = copy.deepcopy(baseline)
    fallback_fail["lifecycle_and_recovery"]["no_silent_scalar_or_v1_fallback"] = False
    ok, reasons, _ = evaluate_receipt(fallback_fail)
    if ok or "silent-fallback-detected" not in reasons:
        print(f"self-test failed: expected silent-fallback-detected, got {reasons}", file=sys.stderr)
        return 1

    # 5. Public surface divergence fails closed.
    surface_fail = copy.deepcopy(baseline)
    surface_fail["public_surface_equivalence"]["identical_results_and_cursors"] = False
    ok, reasons, _ = evaluate_receipt(surface_fail)
    if ok or "public-surface-divergence" not in reasons:
        print(f"self-test failed: expected public-surface-divergence, got {reasons}", file=sys.stderr)
        return 1

    # 6. Overclaiming incremental structures while ADR-0162 is unaccepted fails closed.
    overclaim = copy.deepcopy(baseline)
    overclaim["incremental_structures"]["activated"] = True
    ok, reasons, _ = evaluate_receipt(overclaim)
    if ok or "unqualified-incremental-capability-overclaim" not in reasons:
        print(
            f"self-test failed: expected unqualified-incremental-capability-overclaim, got {reasons}",
            file=sys.stderr,
        )
        return 1

    # 7. Parallel gate miss disables only v2_parallel_scan while keeping v2_vectorized_batch.
    par_miss = copy.deepcopy(baseline)
    par_miss["mechanics_gates"]["parallel_scan"]["one_to_four_worker_throughput_ratio"] = 1.25
    par_miss["claimed_activated_capabilities"] = ["v2_segment", "v2_vectorized_batch"]
    ok, reasons, verdict = evaluate_receipt(par_miss)
    if (
        not ok
        or reasons
        or verdict["activated_capabilities"] != ["v2_segment", "v2_vectorized_batch"]
        or "v2_parallel_scan" not in verdict["disabled_capabilities"]
    ):
        print(f"self-test failed: expected honest parallel disablement, got {verdict}", file=sys.stderr)
        return 1

    # 8. Non-value-free receipt fails closed.
    leaked = copy.deepcopy(baseline)
    leaked["workloads"]["predicate_literal"] = "confidential"
    ok, reasons, _ = evaluate_receipt(leaked)
    if ok or reasons != ["non-value-free-evidence"]:
        print(f"self-test failed: expected non-value-free-evidence, got {reasons}", file=sys.stderr)
        return 1

    print(
        json.dumps(
            {
                "schema": SCHEMA,
                "mode": "self-test",
                "qualified": True,
                "activated_capabilities": [
                    "v2_segment",
                    "v2_vectorized_batch",
                    "v2_parallel_scan",
                ],
                "disabled_capabilities": ["incremental_bitmap_rollup_topk"],
            },
            sort_keys=True,
        )
    )
    return 0


def run_full_qualification() -> int:
    for script in (
        ROOT / "scripts" / "columnar-vectorized-qualification",
        ROOT / "scripts" / "columnar-parallel-qualification",
    ):
        proc = subprocess.run([sys.executable, str(script), "--self-test"], cwd=ROOT, check=False)
        if proc.returncode != 0:
            return proc.returncode
    return run_self_test()


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--self-test", action="store_true", help="Run positive and negative referee self-tests")
    parser.add_argument("--receipt", type=Path, help="Evaluate an explicit JSON receipt path")
    args = parser.parse_args()

    if args.self_test:
        return run_self_test()

    if args.receipt is not None:
        receipt = load_bounded_json(args.receipt)
        ok, _, verdict = evaluate_receipt(receipt)
        print(json.dumps(verdict, sort_keys=True))
        return 0 if ok else 1

    return run_full_qualification()


if __name__ == "__main__":
    sys.exit(main())
