#!/usr/bin/env python3
"""Drive one closed endurance action manifest and emit an untrusted raw receipt."""

from __future__ import annotations

import json
import hashlib
import os
from pathlib import Path
import subprocess
import sys
import threading
import time
from typing import Any


SCHEMA = "riffdb.alpha-endurance-actions/v1"
MAX_MANIFEST_BYTES = 1024 * 1024
MAX_ACTIONS = 32
MAX_ARGUMENTS = 64
MAX_SAMPLES = 10000
MAX_ACTION_RESULT_BYTES = 64 * 1024
MAX_FAILURE_DIAGNOSTIC_BYTES = 4 * 1024
CONFORMANCE_INITIAL_DELAY_SECONDS = 900
ACTION_RESULT_SCHEMA = "riffdb.alpha-endurance-action-result/v1"
CONFORMANCE_RESULT_SCHEMA = "riffdb.alpha-endurance-conformance-result/v1"
REQUIRED_LANGUAGES = {"rust", "go", "typescript", "python"}
REQUIRED_DOMAINS = {"openfga", "mlflow", "better-auth", "woodpecker"}
REQUIRED_LIFECYCLES = {
    "journal_recycle",
    "checkpoint",
    "recovery",
    "retention",
    "backup",
    "capability_rotation",
    "certificate_rotation",
    "deploy_under_load",
    "restart",
    "reactive_consumer",
}
REQUIRED_FAULTS = {
    "checkpoint_crash",
    "consumer_after_command_before_ack",
    "journal_recycle_crash",
    "network_interrupt",
    "process_kill",
}


def fail(message: str) -> "None":
    raise ValueError(message)


def command(value: Any, name: str) -> list[str]:
    if not isinstance(value, list) or not value or len(value) > MAX_ARGUMENTS:
        fail(f"{name} must be a bounded nonempty argv array")
    if not all(isinstance(part, str) and part and "\x00" not in part for part in value):
        fail(f"{name} contains an invalid argument")
    return value


def exact_names(value: Any, expected: set[str]) -> bool:
    return isinstance(value, list) and len(value) == len(expected) and all(isinstance(item, str) for item in value) and set(value) == expected


def bounded_failure_diagnostic(value: str) -> str:
    """Keep harness failures useful without allowing unbounded subprocess output."""
    encoded = value.encode(errors="replace")[:MAX_FAILURE_DIAGNOSTIC_BYTES]
    return encoded.decode(errors="replace").strip() or "subprocess emitted no diagnostic"


def report_subprocess_failure(label: str, result: subprocess.CompletedProcess[str]) -> None:
    print(f"{label}: {bounded_failure_diagnostic(result.stderr)}", file=sys.stderr)


class BoundedStderrCapture:
    """Drain a worker pipe continuously while retaining only a bounded prefix."""

    def __init__(self, stream: Any) -> None:
        self._stream = stream
        self._buffer = bytearray()
        self._thread = threading.Thread(target=self._drain, daemon=True)
        self._thread.start()

    def _drain(self) -> None:
        while True:
            chunk = self._stream.read(4096)
            if not chunk:
                return
            remaining = MAX_FAILURE_DIAGNOSTIC_BYTES - len(self._buffer)
            if remaining > 0:
                self._buffer.extend(chunk[:remaining])

    def finish(self) -> str:
        self._thread.join(timeout=5)
        return bytes(self._buffer).decode(errors="replace")


def load_actions(candidate: Path) -> dict[str, Any]:
    if not candidate.is_file() or not 0 < candidate.stat().st_size <= MAX_MANIFEST_BYTES:
        fail("action manifest is absent or exceeds its byte bound")
    with candidate.open(encoding="utf-8") as source:
        value = json.load(source)
    if not isinstance(value, dict) or value.get("schema") != SCHEMA:
        fail("action manifest has the wrong schema")
    environment = value.get("environment")
    if not isinstance(environment, dict) or set(environment) != {"setup", "teardown"}:
        fail("action manifest must declare environment setup and teardown")
    command(environment.get("setup"), "environment setup")
    command(environment.get("teardown"), "environment teardown")
    workers = value.get("workers")
    if not isinstance(workers, list) or len(workers) != 4:
        fail("action manifest must declare four language workers")
    languages = set()
    for worker in workers:
        if not isinstance(worker, dict):
            fail("worker entry must be an object")
        languages.add(worker.get("language"))
        command(worker.get("command"), "worker command")
        if type(worker.get("seed")) is not int or worker["seed"] < 0:
            fail("worker seed is invalid")
        if type(worker.get("clients")) is not int or not 1 <= worker["clients"] <= 128:
            fail("worker client count is invalid")
        if type(worker.get("maximum_operations_per_second")) is not int or not 1 <= worker["maximum_operations_per_second"] <= 100_000:
            fail("worker operation rate is invalid")
        if worker.get("modeled_durable_operation_bytes") != 32 * 1024:
            fail("worker durable-operation growth charge is invalid")
        if not isinstance(worker.get("tenants"), list) or not 2 <= len(worker["tenants"]) <= 32:
            fail("worker tenant inventory is invalid")
        if not isinstance(worker.get("coverage"), list):
            fail("worker workload coverage is absent")
    if languages != REQUIRED_LANGUAGES:
        fail("action manifest must declare Rust, Go, TypeScript, and Python")
    lifecycles = value.get("lifecycles")
    if not isinstance(lifecycles, list) or not 1 <= len(lifecycles) <= MAX_ACTIONS:
        fail("lifecycle actions are absent or unbounded")
    if {item.get("name") for item in lifecycles if isinstance(item, dict)} != REQUIRED_LIFECYCLES:
        fail("lifecycle action inventory is incomplete")
    for item in lifecycles:
        command(item.get("command"), "lifecycle command")
        if type(item.get("interval_seconds")) is not int or not 1 <= item["interval_seconds"] <= 86400:
            fail("lifecycle interval is invalid")
        if type(item.get("initial_delay_seconds")) is not int or not 0 <= item["initial_delay_seconds"] <= 86400:
            fail("lifecycle initial delay is invalid")
    command(value.get("sampler", {}).get("command"), "sampler command")
    command(value.get("conformance", {}).get("command"), "conformance command")
    faults = value.get("faults")
    if not isinstance(faults, list) or len(faults) != len(REQUIRED_FAULTS):
        fail("fault actions are absent or unbounded")
    if {item.get("name") for item in faults if isinstance(item, dict)} != REQUIRED_FAULTS:
        fail("fault action inventory is incomplete")
    for item in faults:
        command(item.get("command"), "fault command")
        if type(item.get("interval_seconds")) is not int or not 1 <= item["interval_seconds"] <= 86400:
            fail("fault interval is invalid")
        if type(item.get("initial_delay_seconds")) is not int or not 0 <= item["initial_delay_seconds"] <= 86400:
            fail("fault initial delay is invalid")
    for section in ("sampler", "conformance"):
        interval = value[section].get("interval_seconds")
        if type(interval) is not int or not 1 <= interval <= 86400:
            fail(f"{section} interval is invalid")
    if value["conformance"].get("initial_delay_seconds") != CONFORMANCE_INITIAL_DELAY_SECONDS:
        fail("conformance initial delay differs from the closed workload warmup")
    return value


def canonical_digest(value: dict[str, Any]) -> str:
    encoded = json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
    return hashlib.sha256(encoded).hexdigest()


def run_checked(argv: list[str], root: Path, environment: dict[str, str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        argv,
        cwd=root,
        env=environment,
        stdin=subprocess.DEVNULL,
        capture_output=True,
        text=True,
        timeout=600,
        check=False,
    )


def parse_action_result(output: str, kind: str, name: str) -> dict[str, Any]:
    if not 0 < len(output.encode()) <= MAX_ACTION_RESULT_BYTES:
        fail(f"{kind} {name} result is absent or exceeds its byte bound")
    try:
        value = json.loads(output)
    except json.JSONDecodeError as error:
        fail(f"{kind} {name} result is not JSON: {error}")
    expected = {
        "schema",
        "kind",
        "name",
        "status",
        "evidence_sha256",
        "frontier_before",
        "frontier_after",
        "recovered",
    }
    if not isinstance(value, dict) or set(value) != expected:
        fail(f"{kind} {name} result has an invalid shape")
    digest = value.get("evidence_sha256")
    try:
        valid_digest = isinstance(digest, str) and len(digest) == 64 and int(digest, 16) >= 0
    except ValueError:
        valid_digest = False
    if not valid_digest:
        fail(f"{kind} {name} result has an invalid evidence digest")
    before = value.get("frontier_before")
    after = value.get("frontier_after")
    if (
        value.get("schema") != ACTION_RESULT_SCHEMA
        or value.get("kind") != kind
        or value.get("name") != name
        or value.get("status") != "passed"
        or type(before) is not int
        or type(after) is not int
        or before < 0
        or after < before
        or value.get("recovered") is not True
        or (kind == "lifecycle" and after == before)
        or kind not in {"environment", "lifecycle", "fault"}
    ):
        fail(f"{kind} {name} did not prove advancement and recovery")
    return value


def parse_conformance_result(output: str) -> dict[str, Any]:
    if not 0 < len(output.encode()) <= MAX_ACTION_RESULT_BYTES:
        fail("conformance result is absent or exceeds its byte bound")
    try:
        value = json.loads(output)
    except json.JSONDecodeError as error:
        fail(f"conformance result is not JSON: {error}")
    expected = {
        "schema",
        "status",
        "domains",
        "policy_probes_passed",
        "data_reconciliation_passed",
        "silent_loss",
        "evidence_sha256",
    }
    if not isinstance(value, dict) or set(value) != expected:
        fail("conformance result has an invalid shape")
    digest = value.get("evidence_sha256")
    try:
        valid_digest = isinstance(digest, str) and len(digest) == 64 and int(digest, 16) >= 0
    except ValueError:
        valid_digest = False
    if (
        value.get("schema") != CONFORMANCE_RESULT_SCHEMA
        or value.get("status") != "passed"
        or not exact_names(value.get("domains"), REQUIRED_DOMAINS)
        or value.get("policy_probes_passed") is not True
        or value.get("data_reconciliation_passed") is not True
        or value.get("silent_loss") != 0
        or not valid_digest
    ):
        fail("conformance result did not prove domain, policy, and data parity")
    return value


def self_test() -> None:
    diagnostic = bounded_failure_diagnostic("sampler reason\n" + "x" * MAX_FAILURE_DIAGNOSTIC_BYTES)
    if not diagnostic.startswith("sampler reason\n") or len(diagnostic.encode()) > MAX_FAILURE_DIAGNOSTIC_BYTES:
        fail("failure diagnostic is not bounded")
    print("bounded_failure_diagnostic: passed")
    valid = json.dumps(
        {
            "schema": ACTION_RESULT_SCHEMA,
            "kind": "lifecycle",
            "name": "checkpoint",
            "status": "passed",
            "evidence_sha256": "a" * 64,
            "frontier_before": 7,
            "frontier_after": 8,
            "recovered": True,
        }
    )
    parse_action_result(valid, "lifecycle", "checkpoint")
    environment = json.loads(valid)
    environment.update(kind="environment", name="setup", frontier_after=7)
    parse_action_result(json.dumps(environment), "environment", "setup")
    invalid = json.loads(valid)
    invalid["frontier_after"] = invalid["frontier_before"]
    try:
        parse_action_result(json.dumps(invalid), "lifecycle", "checkpoint")
    except ValueError:
        print("nonadvancing_lifecycle_result: rejected")
    else:
        fail("nonadvancing lifecycle result passed")
    print("bounded_action_result: passed")
    print("bounded_environment_result: passed")
    conformance = json.dumps(
        {
            "schema": CONFORMANCE_RESULT_SCHEMA,
            "status": "passed",
            "domains": sorted(REQUIRED_DOMAINS),
            "policy_probes_passed": True,
            "data_reconciliation_passed": True,
            "silent_loss": 0,
            "evidence_sha256": "b" * 64,
        }
    )
    parse_conformance_result(conformance)
    invalid_conformance = json.loads(conformance)
    invalid_conformance["silent_loss"] = 1
    try:
        parse_conformance_result(json.dumps(invalid_conformance))
    except ValueError:
        print("silent_loss_conformance: rejected")
    else:
        fail("silent-loss conformance result passed")
    print("bounded_conformance_result: passed")


def main() -> int:
    if sys.argv[1:] == ["--self-test"]:
        self_test()
        return 0
    if len(sys.argv) != 1:
        fail("usage: alpha-endurance-controller [--self-test]")
    action_path = os.environ.get("RIFFDB_ENDURANCE_ACTION_MANIFEST")
    if not action_path:
        fail("RIFFDB_ENDURANCE_ACTION_MANIFEST must select a reviewed closed action manifest")
    duration = int(os.environ["RIFFDB_ENDURANCE_DURATION_SECONDS"])
    if not 3600 <= duration <= 168 * 3600:
        fail("controller duration is outside the closed 1..168 hour range")
    raw_receipt = Path(os.environ["RIFFDB_ENDURANCE_RAW_RECEIPT"]).resolve()
    action_manifest = load_actions(Path(action_path).resolve())
    expected_action_digest = os.environ.get("RIFFDB_ENDURANCE_ACTION_MANIFEST_SHA256")
    if expected_action_digest != canonical_digest(action_manifest):
        fail("action manifest differs from the outer validator identity")
    root = Path(__file__).resolve().parent.parent
    environment = os.environ.copy()
    environment_results: list[dict[str, Any]] = []
    setup = run_checked(
        command(action_manifest["environment"]["setup"], "environment setup"),
        root,
        environment,
    )
    if setup.returncode != 0:
        report_subprocess_failure("environment_setup_failed", setup)
        run_checked(
            command(action_manifest["environment"]["teardown"], "environment teardown"),
            root,
            environment,
        )
        fail(f"environment setup failed with status {setup.returncode}")
    try:
        environment_results.append(parse_action_result(setup.stdout, "environment", "setup"))
    except ValueError:
        run_checked(
            command(action_manifest["environment"]["teardown"], "environment teardown"),
            root,
            environment,
        )
        raise

    started = time.monotonic()
    deadline = started + duration
    workers: list[tuple[str, subprocess.Popen[bytes], BoundedStderrCapture]] = []
    early_worker_languages: set[str] = set()
    lifecycle_counts = {name: 0 for name in sorted(REQUIRED_LIFECYCLES)}
    fault_counts = {name: 0 for name in sorted(REQUIRED_FAULTS)}
    errors: list[dict[str, Any]] = []
    observations: list[dict[str, Any]] = []
    action_results: list[dict[str, Any]] = []
    conformance_checkpoints = 0
    conformance_results: list[dict[str, Any]] = []

    try:
        for worker in action_manifest["workers"]:
            worker_environment = environment.copy()
            worker_environment.update(
                {
                    "RIFFDB_ENDURANCE_LANGUAGE": worker["language"],
                    "RIFFDB_ENDURANCE_SEED": str(worker["seed"]),
                    "RIFFDB_ENDURANCE_CLIENTS": str(worker["clients"]),
                    "RIFFDB_ENDURANCE_MAXIMUM_OPERATIONS_PER_SECOND": str(worker["maximum_operations_per_second"]),
                    "RIFFDB_ENDURANCE_MODELED_DURABLE_OPERATION_BYTES": str(worker["modeled_durable_operation_bytes"]),
                    "RIFFDB_ENDURANCE_TENANTS_JSON": json.dumps(worker["tenants"], separators=(",", ":")),
                    "RIFFDB_ENDURANCE_WORKLOAD_COVERAGE_JSON": json.dumps(worker["coverage"], separators=(",", ":")),
                }
            )
            process = subprocess.Popen(
                command(worker["command"], "worker command"),
                cwd=root,
                env=worker_environment,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.PIPE,
            )
            if process.stderr is None:
                fail("worker stderr capture was not created")
            workers.append((worker["language"], process, BoundedStderrCapture(process.stderr)))

        next_sample = started
        # The sampler proves immediate process and resource readiness. Give the
        # mixed workers one complete declared interval to reach every workload
        # class before the first periodic semantic reconciliation.
        next_conformance = started + action_manifest["conformance"]["initial_delay_seconds"]
        lifecycle_due = {item["name"]: started + item["initial_delay_seconds"] for item in action_manifest["lifecycles"]}
        fault_due = {item["name"]: started + item["initial_delay_seconds"] for item in action_manifest["faults"]}
        while time.monotonic() < deadline:
            now = time.monotonic()
            worker_exited = False
            for language, process, capture in workers:
                status = process.poll()
                if status is not None:
                    diagnostic = bounded_failure_diagnostic(capture.finish())
                    print(f"worker_exited_early[{language}]: {diagnostic}", file=sys.stderr)
                    errors.append({"code": "worker_exited_early", "language": language, "status": status})
                    early_worker_languages.add(language)
                    deadline = now
                    worker_exited = True
                    break
            if worker_exited:
                break
            if now >= next_sample:
                result = run_checked(command(action_manifest["sampler"]["command"], "sampler command"), root, environment)
                if result.returncode != 0:
                    report_subprocess_failure("sampler_failed", result)
                    errors.append({"code": "sampler_failed", "status": result.returncode})
                    break
                try:
                    sample = json.loads(result.stdout)
                except json.JSONDecodeError:
                    errors.append({"code": "sampler_invalid_json"})
                    break
                if not isinstance(sample, dict) or len(observations) >= MAX_SAMPLES:
                    errors.append({"code": "sampler_invalid_or_unbounded"})
                    break
                sample["elapsed_seconds"] = int(now - started)
                observations.append(sample)
                next_sample = now + action_manifest["sampler"]["interval_seconds"]
            if now >= next_conformance:
                result = run_checked(command(action_manifest["conformance"]["command"], "conformance command"), root, environment)
                if result.returncode != 0:
                    report_subprocess_failure("conformance_failed", result)
                    errors.append({"code": "conformance_failed", "status": result.returncode})
                    break
                conformance_results.append(parse_conformance_result(result.stdout))
                conformance_checkpoints += 1
                next_conformance = now + action_manifest["conformance"]["interval_seconds"]
            for item in action_manifest["lifecycles"]:
                if now < lifecycle_due[item["name"]]:
                    continue
                result = run_checked(command(item["command"], "lifecycle command"), root, environment)
                if result.returncode != 0:
                    report_subprocess_failure(f"lifecycle_failed[{item['name']}]", result)
                    errors.append({"code": "lifecycle_failed", "lifecycle": item["name"], "status": result.returncode})
                    deadline = now
                    break
                action_results.append(parse_action_result(result.stdout, "lifecycle", item["name"]))
                lifecycle_counts[item["name"]] += 1
                lifecycle_due[item["name"]] = now + item["interval_seconds"]
            for item in action_manifest["faults"]:
                if now < fault_due[item["name"]]:
                    continue
                result = run_checked(command(item["command"], "fault command"), root, environment)
                if result.returncode != 0:
                    report_subprocess_failure(f"fault_failed[{item['name']}]", result)
                    errors.append({"code": "fault_failed", "fault": item["name"], "status": result.returncode})
                    deadline = now
                    break
                action_results.append(parse_action_result(result.stdout, "fault", item["name"]))
                fault_counts[item["name"]] += 1
                fault_due[item["name"]] = now + item["interval_seconds"]
            time.sleep(min(1.0, max(0.01, deadline - time.monotonic())))
    finally:
        for _, process, _ in workers:
            if process.poll() is None:
                process.terminate()
        for language, process, capture in workers:
            try:
                status = process.wait(timeout=30)
            except subprocess.TimeoutExpired:
                process.kill()
                status = process.wait(timeout=10)
            diagnostic = bounded_failure_diagnostic(capture.finish())
            if status not in (0, -15) and language not in early_worker_languages:
                print(f"worker_shutdown_failed[{language}]: {diagnostic}", file=sys.stderr)
                errors.append({"code": "worker_shutdown_failed", "language": language, "status": status})
        teardown = run_checked(
            command(action_manifest["environment"]["teardown"], "environment teardown"),
            root,
            environment,
        )
        if teardown.returncode != 0:
            report_subprocess_failure("environment_teardown_failed", teardown)
            errors.append({"code": "environment_teardown_failed", "status": teardown.returncode})
        else:
            try:
                environment_results.append(
                    parse_action_result(teardown.stdout, "environment", "teardown")
                )
            except ValueError:
                errors.append({"code": "environment_teardown_invalid"})

    measured = int(time.monotonic() - started)
    receipt = {
        "schema": "riffdb.alpha-endurance-receipt/v1",
        "status": "passed" if not errors and measured >= duration else "failed",
        "requested_duration_seconds": duration,
        "measured_duration_seconds": measured,
        "manifest_sha256": os.environ["RIFFDB_ENDURANCE_MANIFEST_SHA256"],
        "action_manifest_sha256": canonical_digest(action_manifest),
        "release_artifact_sha256": os.environ.get("RIFFDB_ENDURANCE_RELEASE_ARTIFACT_SHA256", ""),
        "languages_completed": sorted(REQUIRED_LANGUAGES) if not errors else [],
        "workload_coverage": action_manifest.get("workload_coverage", []),
        "environment_results": environment_results,
        "fault_counts": fault_counts,
        "lifecycle_counts": lifecycle_counts,
        "action_results": action_results,
        "conformance": {
            "all_passed": not any(item["code"] == "conformance_failed" for item in errors),
            "checkpoints": conformance_checkpoints,
            "results": conformance_results,
        },
        "domains_completed": sorted(REQUIRED_DOMAINS) if conformance_results and not errors else [],
        "policy_probes": {"all_passed": bool(conformance_results) and not errors},
        "data_reconciliation": {
            "all_passed": bool(conformance_results) and not errors,
            "silent_loss": 0,
        },
        "unsupported_storage_unavailable": sum(1 for item in errors if item["code"] == "storage_unavailable"),
        "errors": errors,
        "process_inventory": {
            "arguments_included": False,
            "maximum_processes": max((int(item.get("process_count", 0)) for item in observations), default=0),
        },
        "observations": observations,
    }
    raw_receipt.parent.mkdir(parents=True, exist_ok=True)
    with raw_receipt.open("w", encoding="utf-8") as destination:
        json.dump(receipt, destination, sort_keys=True, indent=2)
        destination.write("\n")
    return 0 if receipt["status"] == "passed" else 3


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (KeyError, OSError, ValueError, subprocess.SubprocessError) as error:
        print(f"endurance_controller_invalid: {error}", file=sys.stderr)
        raise SystemExit(3) from error
