#!/usr/bin/env python3
"""Assemble three bounded WP-674 profile fragments into one verifier manifest."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import re
import sys
from typing import Any

from bounded_evidence_io import bounded_read, exclusive_write
from wp674_host_policy import validate_campaign_identity_value


SCHEMA = "riffdb.wp-674-unary-profile/v2"
MANIFEST_SCHEMA = "riffdb.wp-674-unary-manifest/v2"
PROFILE_CLASSES = {
    "workstation": "workstation_nvme",
    "n1": "gcp_n1_persistent_disk",
    "e2": "gcp_e2_persistent_disk",
}
REQUIREMENTS = ["END-007", "END-008", "PERF-005", "PERF-008", "PERF-018"]
SHA256 = re.compile(r"^[0-9a-f]{64}$")
REVISION = re.compile(r"^[0-9a-f]{40}$")
MAX_FRAGMENT_BYTES = 128 * 1024
MAX_CAMPAIGN_BYTES = 16 * 1024
MAX_REPORT_BYTES = 32 * 1024 * 1024
MAX_MANIFEST_BYTES = 256 * 1024


def fail(message: str) -> "None":
    raise ValueError(message)


def read_fragment(path: Path) -> dict[str, Any]:
    encoded = bounded_read(path, MAX_FRAGMENT_BYTES, "profile fragment")
    value = json.loads(encoded.decode("utf-8"))
    if not isinstance(value, dict) or value.get("schema") != SCHEMA:
        fail(f"profile fragment schema is invalid: {path}")
    return value


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--workstation", type=Path, required=False)
    parser.add_argument("--n1", type=Path, required=True)
    parser.add_argument("--e2", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument(
        "--require-both-profiles",
        action="store_true",
        help="ADR-0183 bank: both inventoried cloud profiles (N1 and E2) are mandatory, the "
        "workstation column is optional, and every campaign must record the ADR-0171 "
        "gated-backend stability rule",
    )
    args = parser.parse_args()
    if args.workstation is None and not args.require_both_profiles:
        parser.error("--workstation is required unless --require-both-profiles is given")
    output = args.output.absolute()
    common: tuple[str, str, str, str] | None = None
    common_binaries: tuple[str, str] | None = None
    profiles = []
    selected = []
    if args.workstation is not None:
        selected.append(("workstation", args.workstation.absolute()))
    selected.append(("n1", args.n1.absolute()))
    selected.append(("e2", args.e2.absolute()))
    for expected, path in (
        *selected,
        ("e2", args.e2.absolute()),
    ):
        fragment = read_fragment(path)
        identity = (
            fragment.get("source_revision"),
            fragment.get("cargo_lock_sha256"),
            fragment.get("harness_sha256"),
            fragment.get("governance_predecessor_sha256"),
        )
        if REVISION.fullmatch(str(identity[0])) is None or any(
            SHA256.fullmatch(str(value)) is None for value in identity[1:]
        ):
            fail(f"{expected}: source or harness identity is invalid")
        if common is None:
            common = identity  # type: ignore[assignment]
        elif identity != common:
            fail(f"{expected}: source, lock, or harness differs")
        profile = fragment.get("profile")
        if not isinstance(profile, dict) or profile.get("id") != expected:
            fail(f"{expected}: profile identity differs")
        if profile.get("hardware_class") != PROFILE_CLASSES[expected]:
            fail(f"{expected}: hardware class differs")

        def remap(reference: Any, maximum: int = MAX_REPORT_BYTES) -> dict[str, str]:
            if not isinstance(reference, dict) or set(reference) != {"path", "sha256"}:
                fail(f"{expected}: evidence reference is invalid")
            relative = reference.get("path")
            digest = reference.get("sha256")
            if not isinstance(relative, str) or SHA256.fullmatch(str(digest)) is None:
                fail(f"{expected}: evidence path or digest is invalid")
            source = path.parent / relative
            encoded = bounded_read(source, maximum, f"{expected} evidence file")
            actual = hashlib.sha256(encoded).hexdigest()
            if actual != digest:
                fail(f"{expected}: evidence digest differs: {source}")
            return {
                "path": str(source.relative_to(output.parent)),
                "sha256": digest,
            }

        campaign_reference = profile.get("campaign_identity")
        campaign_remapped = remap(campaign_reference, MAX_CAMPAIGN_BYTES)
        campaign_path = path.parent / campaign_reference["path"]
        campaign = json.loads(
            bounded_read(campaign_path, MAX_CAMPAIGN_BYTES, "campaign identity").decode()
        )
        if args.require_both_profiles and (
            (campaign.get("method") or {}).get("stability_rule_binds") != "gated_backend"
        ):
            fail(f"{expected}: campaign stability rule is not bound to the gated backend")
        validate_campaign_identity_value(
            campaign,
            expected,
            {
                "source_revision": identity[0],
                "cargo_lock_sha256": identity[1],
                "harness_sha256": identity[2],
                "runner_sha256": campaign.get("runner_sha256"),
                "riffdbd_sha256": campaign.get("riffdbd_sha256"),
            },
        )
        binaries = (
            campaign.get("runner_sha256"),
            campaign.get("riffdbd_sha256"),
        )
        if any(SHA256.fullmatch(str(value)) is None for value in binaries):
            fail(f"{expected}: campaign binary identity is invalid")
        if common_binaries is None:
            common_binaries = binaries  # type: ignore[assignment]
        elif binaries != common_binaries:
            fail(f"{expected}: campaign binaries differ")

        reports = profile.get("reports")
        if not isinstance(reports, list):
            fail(f"{expected}: reports are absent")
        host_attempts = profile.get("host_attempts")
        if not isinstance(host_attempts, list) or not host_attempts:
            fail(f"{expected}: bounded host-attempt inventory is absent")

        def remap_host_attempt(attempt: Any) -> dict[str, Any]:
            if not isinstance(attempt, dict) or set(attempt) != {
                "attempt", "status", "reports", "minimal_report"
            }:
                fail(f"{expected}: host-attempt shape is invalid")
            reports = attempt.get("reports")
            if not isinstance(reports, list):
                fail(f"{expected}: host-attempt reports are invalid")
            minimal = attempt.get("minimal_report")
            return {
                "attempt": attempt.get("attempt"),
                "status": attempt.get("status"),
                "reports": [
                    {
                        "scenario": row.get("scenario"),
                        **remap({"path": row.get("path"), "sha256": row.get("sha256")}),
                    }
                    for row in reports
                    if isinstance(row, dict)
                ],
                "minimal_report": None if minimal is None else remap(minimal),
            }
        profiles.append(
            {
                "id": expected,
                "hardware_class": PROFILE_CLASSES[expected],
                "reports": [
                    {
                        "scenario": row.get("scenario"),
                        **remap({"path": row.get("path"), "sha256": row.get("sha256")}),
                    }
                    for row in reports
                    if isinstance(row, dict)
                ],
                "minimal_report": remap(profile.get("minimal_report")),
                "host_attempts": [remap_host_attempt(attempt) for attempt in host_attempts],
                "campaign_identity": campaign_remapped,
            }
        )
    assert common is not None
    assert common_binaries is not None
    if args.require_both_profiles and not {"n1", "e2"} <= {profile["id"] for profile in profiles}:
        fail("--require-both-profiles: both N1 and E2 columns are mandatory")
    manifest = {
        "schema": MANIFEST_SCHEMA,
        "source_revision": common[0],
        "cargo_lock_sha256": common[1],
        "harness_sha256": common[2],
        "runner_sha256": common_binaries[0],
        "riffdbd_sha256": common_binaries[1],
        "governance_predecessor_sha256": common[3],
        "requirements": REQUIREMENTS,
        "stability_rule_binds": "gated_backend",
        "profiles": profiles,
    }
    exclusive_write(
        output,
        (json.dumps(manifest, indent=2) + "\n").encode(),
        MAX_MANIFEST_BYTES,
        "WP-674 manifest output",
    )
    print(output)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, UnicodeError, json.JSONDecodeError, ValueError) as error:
        print(f"wp674_manifest_invalid: {error}", file=sys.stderr)
        raise SystemExit(3) from error
