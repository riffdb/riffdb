#!/usr/bin/env ruby
# frozen_string_literal: true
# req: GOV-004
# Every deferred prose obligation has an exact source identity and a declaration
# or a reviewed strike. Existing OBL proofs retain their owner-package checks.
# The retired outstanding ledger cannot be reintroduced, even empty.
require "fileutils"
require "json"
require "digest"
require "open3"
require "set"
require "tmpdir"
require "yaml"
require_relative "lib/riffdb_adr"

ROOT = RiffdbAdr.root
# WP-758 cutover: historical open-package declarations stay visible, while
# newly accepted records must carry an existing proof or use package requirements.
PROOF_AT_ACCEPTANCE_SINCE = Date.new(2026, 9, 21)

# A record whose front matter does not parse is corrupt, not legacy. Report it
# the way a check reports a finding rather than as an interpreter backtrace.
def guard_malformed_records
  yield
rescue RiffdbAdr::MalformedFrontMatter => error
  warn error.message
  exit 1
end


# A deferred obligation names a work package and says it must do something.
# Deliberately narrow: it looks for an imperative on a work package, not for
# every occurrence of the word "must".
OBLIGATION = /[^.\n]*\bWP-\d{3,}\b[^.]*?\bmust\b[^.]*\./i
DECLARED = /`(OBL-\d{4}-\d+)`.*?Proof:\s*`([^`]+)`/m

# Prose cannot discharge either legacy or v2 obligations.
STRICT_EXCLUDES = %w[:!adr :!docs :!work_packages.yaml :!SPEC.md :!governance].freeze

USAGE = "usage: check-adr-obligations [--report] [--json] [--self-test] [--help]"

# git refuses an exclude pathspec naming a path that is not in the working tree,
# and a refused grep would silently read as "proof missing". Drop the pathspecs
# that do not apply to this tree instead.
def excludes_for(root, pathspecs)
  pathspecs.select { |pathspec| File.exist?(File.join(root, pathspec.delete_prefix(":!"))) }
end

# Every `fn <name>` and `def <name>` in the tree, outside the prose that must
# not be able to discharge an obligation. One scan answers every strict lookup;
# a grep per proof costs seconds once a migration lands dozens of them.
DEFINITION = /(?:\A|[^A-Za-z0-9_])(?:fn|def)[ \t]+([A-Za-z_][A-Za-z0-9_]*)/
def definitions(root)
  @definitions ||= {}
  @definitions[root] ||= begin
    stdout, _stderr, status = Open3.capture3(
      "git", "-C", root, "grep", "--untracked", "-h", "-oE",
      '^[ \t]*(pub(\([^)]*\))?[ \t]+)?(async[ \t]+)?(const[ \t]+)?(unsafe[ \t]+)?(fn|def)[ \t]+[A-Za-z_][A-Za-z0-9_]*', "--",
      *excludes_for(root, STRICT_EXCLUDES)
    )
    # git grep exits 1 when nothing matched; anything else is a real failure.
    raise "git grep failed in #{root}" unless [0, 1].include?(status.exitstatus)

    stdout.lines.filter_map { |line| line[DEFINITION, 1] }.to_set
  end
end

# A script is a proof only when CI runs it: it must be named by scripts/ci-all,
# governance/tiers.yaml, or a workflow. A tree without any of those (a fixture)
# keeps the plain file rule. A wrapper script that merely invokes a test is not
# a proof; the test's own name is.
WIRING_FILES = %w[scripts/ci-all governance/tiers.yaml .github/workflows].freeze
def wired_scripts(root)
  @wired_scripts ||= {}
  return @wired_scripts[root] if @wired_scripts.key?(root)

  names = Set.new
  present = false
  WIRING_FILES.each do |entry|
    path = File.join(root, entry)
    files = File.directory?(path) ? Dir.glob(File.join(path, "*.yml")) : [path]
    files.each do |file|
      next unless File.file?(file)

      present = true
      # The required full-battery entry point is itself a proof (ADR-0226).
      # It need not recursively invoke itself to qualify as a wired script.
      names << "ci-all" if entry == "scripts/ci-all"
      File.read(file, encoding: "UTF-8").scan(%r{(?:\./)?scripts/([A-Za-z0-9_.-]+)}) { |(name)| names << name }
    end
  end
  @wired_scripts[root] = present ? names : nil
end

def script_proof?(root, token)
  name = token.delete_prefix("scripts/")
  return false unless File.file?(File.join(root, "scripts", name))

  wiring = wired_scripts(root)
  wiring.nil? || wiring.include?(name)
end

# The strict rule. A script proof may carry a flag suffix ("check-x --self-test");
# only the script path is matched, and it must be wired into CI.
def strict_proof_exists?(root, proof)
  token = proof.to_s.strip.split(/\s+/).first.to_s
  return false if token.empty?

  return true if script_proof?(root, token)

  names = definitions(root)
  names.include?(token) || names.include?("test_#{token}")
end

def source_id(sentence)
  Digest::SHA256.hexdigest(sentence.gsub(/\s+/, " ").strip)
end

# Source fingerprints bind a declaration to its actual normative sentence, so
# adding a different imperative beside an existing OBL does not pass silently.
LEGACY_SOURCE = /^  - `(OBL-\d{4}-\d+)` Source: `([a-f0-9]{64})`\. Proof: (.+)\.$/
LEGACY_STRIKE = /^  - Source: `([a-f0-9]{64})`\. Reason: (.+)$/

def reject_ledgers(root, records, errors)
  Dir.glob(File.join(root, "adr", "obligations-outstanding{,.*}"), File::FNM_EXTGLOB).each do |path|
    errors << "#{File.basename(path)}: the obligations ledger is retired; even an empty ledger is forbidden"
  end
  Dir.glob(File.join(root, "adr", "*.{yaml,yml}"), File::FNM_EXTGLOB).each do |path|
    data = YAML.safe_load_file(path)
    errors << "#{File.basename(path)}: an outstanding ledger entry is forbidden" if data.is_a?(Hash) && data.key?("outstanding")
  end
  records.each do |record|
    if record.front&.key?("outstanding")
      errors << "#{record.basename}: an outstanding ledger entry is forbidden"
    end
  end
end

def legacy_header(record)
  record.text.split(/^## /, 2).first
end

def checked_mapping(value, record, label, errors)
  return {} if value.nil?
  return value if value.is_a?(Hash)

  errors << "#{record.basename}: #{label} must be a mapping"
  {}
end

def check(root)
  result = {"deferred" => 0, "acknowledged" => 0, "undeclared" => 0,
            "declared_v2" => 0, "proven_v2" => 0, "outstanding" => [],
            "errors" => [], "dispositions" => []}
  errors = result["errors"]
  records = RiffdbAdr.records(root)
  packages = RiffdbAdr.packages_by_id(root)
  declared_ids = records.select(&:accepted?).flat_map do |record|
    record.v2? ? record.obligations.map { |o| o["id"] } : legacy_header(record).scan(DECLARED).map(&:first)
  end.to_set
  reject_ledgers(root, records, errors)
  records.select(&:accepted?).each do |record|
    sources = {}
    strikes = {}
    if record.v2?
      check_v2(root, record, packages, result)
      record.obligations.each do |obligation|
        Array(obligation["sources"]).each { |source| (sources[source] ||= []) << obligation["id"] }
      end
      checked_mapping(record.front["obligation_sources"], record, "obligation_sources", errors).each do |source, ids|
        sources[source] = Array(ids)
      end
      strikes = checked_mapping(record.front["struck_obligations"], record, "struck_obligations", errors)
    else
      legacy_header(record).scan(DECLARED).each do |id, proof|
        errors << "#{record.basename}: #{id} proof #{proof.inspect} has no code definition or wired script" unless strict_proof_exists?(root, proof)
      end
      legacy_header(record).scan(LEGACY_SOURCE).each do |id, source, proofs|
        (sources[source] ||= []) << id
        names = proofs.scan(/`([^`]+)`/).flatten
        errors << "#{record.basename}: #{id} source declaration needs a proof" if names.empty?
        names.each do |proof|
          errors << "#{record.basename}: #{id} proof #{proof.inspect} has no code definition or wired script" unless strict_proof_exists?(root, proof)
        end
      end
      strikes = legacy_header(record).scan(LEGACY_STRIKE).to_h
    end
    sentences = record.body.scan(OBLIGATION).to_h { |sentence| [source_id(sentence), sentence] }
    result["deferred"] += sentences.size
    sources.each do |source, ids|
      errors << "#{record.basename}: stale obligation source #{source}" unless sentences.key?(source)
      if !source.is_a?(String) || !source.match?(/\A[a-f0-9]{64}\z/) || ids.empty? || ids.any? { |id| !declared_ids.include?(id) }
        errors << "#{record.basename}: source #{source} does not name a declared OBL"
      end
    end
    strikes.each do |source, reason|
      errors << "#{record.basename}: stale struck source #{source}" unless sentences.key?(source)
      errors << "#{record.basename}: struck source #{source} needs a one-line reason" if !reason.is_a?(String) || reason.strip.empty? || reason.include?("\n")
      errors << "#{record.basename}: source #{source} is both declared and struck" if sources.key?(source)
    end
    sentences.each do |source, sentence|
      if sources.key?(source) || strikes.key?(source)
        result["dispositions"] << {"adr" => record.basename, "source" => source,
          "sentence" => sentence.gsub(/\s+/, " ").strip, "obligations" => sources[source],
          "strike_reason" => strikes[source]}
        next
      end

      result["undeclared"] += 1
      errors << "#{record.basename}: undeclared deferred obligation #{source}: #{sentence.gsub(/\s+/, ' ').strip[0, 160]}"
    end
  end
  result
rescue Psych::Exception => error
  result["errors"] << "invalid governance YAML: #{error.message}"
  result
end

# Accepting a record is a human act. A v2 record accepted on or after the date
# configured under acceptance.reference_required_since in governance/tiers.yaml
# must name that act in a non-empty `acceptance:` front-matter value.
def acceptance_reference_since(root)
  @acceptance_reference_since ||= {}
  return @acceptance_reference_since[root] if @acceptance_reference_since.key?(root)

  @acceptance_reference_since[root] = begin
    path = File.join(root, "governance", "tiers.yaml")
    value = File.file?(path) ? (YAML.safe_load(File.read(path, encoding: "UTF-8")) || {}).dig("acceptance", "reference_required_since") : nil
    value.nil? ? nil : Date.parse(value.to_s)
  rescue StandardError
    nil
  end
end

def check_acceptance_reference(root, record, result)
  since = acceptance_reference_since(root)
  return unless since

  accepted_on = begin
    value = record.front["accepted"]
    value.nil? ? nil : Date.parse(value.to_s)
  rescue StandardError
    nil
  end
  return if accepted_on && accepted_on < since
  return unless record.front["acceptance"].to_s.strip.empty?

  result["errors"] << "#{record.basename}: accepted#{accepted_on ? " on #{accepted_on}" : ''} without an " \
                      "`acceptance:` reference naming the human act (required since #{since})."
end

def check_v2(root, record, packages, result)
  return unless record.accepted?

  check_acceptance_reference(root, record, result)

  record.obligations.each_with_index do |obligation, position|
    id = obligation["id"].to_s.strip
    id = "#{record.id}-obligation-#{position + 1}" if id.empty?
    package_id = obligation["package"].to_s.strip
    proof = obligation["proof"].to_s.strip
    says = obligation["says"].to_s.strip
    result["declared_v2"] += 1

    if package_id.empty?
      result["errors"] << "#{record.basename}: obligation #{id} names no owning package"
      next
    end
    if proof.empty?
      result["errors"] << "#{record.basename}: obligation #{id} names no proof"
      next
    end

    package = packages[package_id]
    if package.nil?
      result["errors"] <<
        "#{record.basename}: obligation #{id} names unknown work package #{package_id}"
      next
    end

    if strict_proof_exists?(root, proof)
      result["proven_v2"] += 1
      next
    end

    accepted_on = begin
      Date.parse(record.front["accepted"].to_s)
    rescue ArgumentError
      nil
    end
    if accepted_on.nil? || accepted_on >= PROOF_AT_ACCEPTANCE_SINCE
      result["errors"] << "#{record.basename}: #{id} proof #{proof.inspect} is missing at acceptance " \
                          "under the #{PROOF_AT_ACCEPTANCE_SINCE} cutover; register a package-owned requirement until the proof lands"
    elsif RiffdbAdr.complete?(package)
      result["errors"] << <<~MESSAGE.strip
        #{record.basename}: obligation #{id} is undischarged but #{package_id} is closed as #{package.dig('closure', 'status').inspect}.
          proof: #{proof.inspect} (no `fn`/`def`/`test_` definition and no scripts/#{proof.split(/\s+/).first.delete_prefix("scripts/")} wired into ci-all, governance/tiers.yaml, or a workflow)
          says: #{says[0, 140]}
        Either land the proof or reopen #{package_id}.
      MESSAGE
    else
      result["outstanding"] << {
        "id" => id, "adr" => record.basename, "package" => package_id,
        "proof" => proof, "says" => says, "source" => "front-matter"
      }
    end
  end
end


# req: GEN-006
def full_battery_root_proof_preserves_script_wiring(failures)
  Dir.mktmpdir("riffdb-adr-script-proofs-") do |directory|
    FileUtils.mkdir_p(File.join(directory, "scripts"))
    FileUtils.mkdir_p(File.join(directory, "governance"))
    File.write(File.join(directory, "governance", "tiers.yaml"), "version: 1\n")
    root_script = File.join(directory, "scripts", "ci-all")
    File.write(root_script, "#!/usr/bin/env bash\n./scripts/check-wired\n")
    %w[check-wired check-unwired ci-all-copy].each do |name|
      File.write(File.join(directory, "scripts", name), "#!/usr/bin/env bash\nexit 0\n")
    end
    %w[ci-all scripts/ci-all].each do |proof|
      failures << "the existing full-battery root must prove #{proof}" unless script_proof?(directory, proof)
    end
    failures << "a directly wired script must remain a proof" unless script_proof?(directory, "scripts/check-wired")
    %w[scripts/check-unwired scripts/ci-all-copy scripts/missing scripts/scripts/ci-all].each do |proof|
      failures << "the root exception must not discharge #{proof}" if script_proof?(directory, proof)
    end
    File.unlink(root_script)
    failures << "a missing full-battery root must not discharge its proof" if script_proof?(directory, "scripts/ci-all")
  end
end

# req: GOV-004
def self_test
  script = File.expand_path(__FILE__)
  failures = []
  full_battery_root_proof_preserves_script_wiring(failures)
  raise failures.join("\n") unless failures.empty?
  Dir.mktmpdir("riffdb-obligations-") do |root|
    FileUtils.mkdir_p(File.join(root, "adr"))
    FileUtils.mkdir_p(File.join(root, "src"))
    File.write(File.join(root, "work_packages.yaml"), "work_packages:\n- id: WP-900\n")
    File.write(File.join(root, "src/proof.rs"), "#[test]\nfn semantic_proof() {}\n")
    system("git", "-C", root, "init", "--quiet", exception: true)
    sentence = "WP-900 must preserve the semantic boundary."
    record = "# ADR-0900: Fixture\n\n- **Status:** Accepted\n" +
             "- **Obligations:**\n  - `OBL-0900-1` Source: `#{source_id(sentence)}`. Proof: `semantic_proof`.\n\n## Decision\n\n#{sentence}\n"
    path = File.join(root, "adr/0900-fixture.md")
    File.write(path, record)
    run = lambda do
      out, err, status = Open3.capture3({"RIFFDB_GOVERNANCE_ROOT" => root}, script, "--json")
      [out.empty? ? {} : JSON.parse(out), status.success?, err]
    end
    assert = ->(condition, message) { raise message unless condition }
    assert.call(run.call[1], "a source-bound real proof must pass")
    ledger = File.join(root, "adr/obligations-outstanding.yaml")
    ["outstanding: []\n", "outstanding:\n- key: old\n"].each do |text|
      File.write(ledger, text)
      assert.call(!run.call[1], "any ledger file, even empty, must fail")
    end
    File.unlink(ledger)
    other = File.join(root, "adr/another-ledger.yaml")
    File.write(other, "outstanding: []\n")
    assert.call(!run.call[1], "an entry under another ledger filename must fail")
    File.unlink(other)
    File.write(path, record.sub("preserve the semantic", "preserve\n  the semantic"))
    assert.call(run.call[1], "whitespace-only rewrapping must preserve a source binding")
    File.write(path, record + "\nWP-900 must prove a different condition.\n")
    result, passed = run.call
    assert.call(!passed && result["undeclared"] == 1, "an existing OBL must not hide a new obligation")
    File.write(path, record + "\nWP-1000 must also prove its boundary.\n")
    assert.call(!run.call[1], "four-digit package numbers cannot escape discovery")
    File.write(path, record.gsub("preserve the semantic boundary", "weaken the semantic boundary"))
    assert.call(!run.call[1], "a changed normative sentence must invalidate its source binding")
    File.write(path, record)
    File.write(File.join(root, "src/proof.rs"), "// fn semantic_proof() {} is a comment, not a definition\n")
    assert.call(!run.call[1], "a prose mention cannot replace a code proof")
    File.write(File.join(root, "src/proof.rs"), "#[test]\nfn semantic_proof() {}\n")
    File.write(path, record.sub(/- \*\*Obligations:.*?\n\n/m,
      "- **Struck obligations:**\n  - Source: `#{source_id(sentence)}`. Reason: Superseded by a reviewed successor.\n\n"))
    assert.call(run.call[1], "a reviewed source-bound strike must pass")
    File.write(path, File.read(path).sub("Superseded by a reviewed successor.", ""))
    assert.call(!run.call[1], "an unexplained strike must fail")
    front = {"adr" => "0900", "title" => "Fixture", "status" => "accepted", "accepted" => "2026-09-01", "tier" => "surface", "packages" => ["WP-900"],
             "obligations" => [{"id" => "OBL-0900-1", "package" => "WP-900", "proof" => "semantic_proof", "says" => "Boundary", "sources" => [source_id(sentence)]},
                               {"id" => "OBL-0900-2", "package" => "WP-900", "proof" => "future_proof", "says" => "Pending package"}]}
    v2 = front.to_yaml + "---\n# ADR-0900: Fixture\n## Decision\n#{sentence}\n"
    File.write(path, v2)
    result, passed = run.call
    assert.call(passed && result["outstanding"].map { |entry| entry["id"] } == ["OBL-0900-2"], "v2 open-package missing proof remains visible")
    File.write(path, v2.sub("2026-09-01", "2026-09-21"))
    result, passed = run.call
    assert.call(!passed && result["errors"].any? { |e| e.include?("missing at acceptance") }, "new acceptance cannot defer a nonexistent proof")
    File.write(path, v2)
    File.write(File.join(root, "work_packages.yaml"), "work_packages:\n- id: WP-900\n  closure:\n    status: complete\n")
    assert.call(!run.call[1], "closing a package without its proof must fail")
    File.write(File.join(root, "work_packages.yaml"), "work_packages:\n- id: WP-900\n")
    File.write(path, v2 + "WP-900 must prove another condition.\n")
    assert.call(!run.call[1], "a v2 declaration must not hide another prose obligation")
    File.write(path, v2.sub("obligations:", "struck_obligations: []\nobligations:"))
    result, passed = run.call
    assert.call(!passed && result["errors"].any? { |e| e.include?("must be a mapping") }, "malformed source metadata must produce a finding")
    FileUtils.mkdir_p(File.join(root, "governance"))
    File.write(File.join(root, "governance/tiers.yaml"), "acceptance:\n  reference_required_since: '2026-09-01'\n")
    File.write(path, v2)
    result, passed = run.call
    assert.call(!passed && result["errors"].any? { |e| e.include?("acceptance:") }, "acceptance reference remains mandatory")
    File.write(path, v2.sub("status: accepted", "status: accepted\nacceptance: 'Explicit delegation in the fixture.'"))
    assert.call(run.call[1], "a dated acceptance reference must pass")
    File.write(path, "---\nadr: '0900'\nstatus: accepted\nobligations: broken: yaml\n---\n")
    assert.call(!run.call[1], "malformed front matter cannot hide obligations")
  end
  puts "ADR obligation self-test passed."
end

if ARGV == ["--self-test"]
  self_test
  exit 0
end
unless (ARGV - %w[--report --json --help -h]).empty?
  abort USAGE
end
if ARGV.include?("--help") || ARGV.include?("-h")
  puts USAGE
  exit 0
end
result = guard_malformed_records { check(ROOT) }
if ARGV.include?("--json")
  puts JSON.pretty_generate(result)
else
  puts "ADR obligations: #{result['deferred']} deferred obligation(s); 0 acknowledged outstanding, #{result['undeclared']} undeclared."
  puts "ADR v2 obligations: #{result['declared_v2']} declared; #{result['proven_v2']} proven, #{result['outstanding'].length} outstanding."
  if ARGV.include?("--report")
    result["outstanding"].each { |entry| puts "#{entry['package']}: #{entry['id']} proof #{entry['proof']}" }
  end
  result["errors"].each { |error| warn error }
end
exit(result["errors"].empty? ? 0 : 1)
