#!/usr/bin/env ruby
# frozen_string_literal: true

# Requirement coverage: every normative SPEC requirement is accounted for, and
# nothing claims a requirement that does not exist.
#
# Historically this script answered one question -- is every requirement CLAIMED
# by a work package -- which is why WP-704 could report coverage complete while
# the obligation it claimed went undischarged. Governance v2 adds the other half:
# a requirement can also be PROVEN, by a tag on the test that holds it.
#
#   // req: REP-002, REP-003        Rust, Go, TypeScript
#   # req: REP-002                  Python, Ruby, bash, YAML
#
# A tag sits immediately above a test function, or at the top of a test file, in
# which case it covers every test in that file. Tags are read under crates/,
# tests/, clients/, examples/, evaluations/, and scripts/.
#
# Three rules:
#
#   1. Every active requirement is claimed by a package or proven by a tag.
#   2. A tag naming an identifier SPEC does not define is an error.
#   3. A package closed on or after work_packages.yaml `governance.cutover` must
#      have a tag for every requirement it lists. Packages that closed before the
#      cutover are exempt: they were accepted under the claim-only rule.
#
# Rule 3 is what makes the paper trail derived rather than asserted. Until the
# manifest carries a `governance:` block there is no cutover and the rule sleeps.

require "json"
require "open3"
require "set"
require "yaml"
require_relative "lib/riffdb_adr"

ROOT = RiffdbAdr.root
SPEC_PATH = File.join(ROOT, "SPEC.md")
MANIFEST_PATH = File.join(ROOT, "work_packages.yaml")

# Tag scanning stays inside the repository and inside the directories that hold
# tests. `target` and `node_modules` are build output, never evidence.
TAG_ROOTS = %w[crates tests clients examples evaluations scripts].freeze
TAG_EXCLUDES = %w[:!target :!**/target/** :!**/node_modules/**].freeze
TAG_LINE = /\A[ \t]*(?:\/\/|\#)[ \t]*req:[ \t]*(.+)\z/

USAGE = <<~TEXT
  usage: check-requirement-coverage [--report] [--json] [--help]

    (no flags)  check coverage and exit nonzero on a problem
    --report    list the unproven requirements of each open work package
    --json      emit the whole result as JSON on stdout
    --help      this message
TEXT

report = false
json = false
ARGV.each do |argument|
  case argument
  when "--help", "-h"
    puts USAGE
    exit 0
  when "--report" then report = true
  when "--json" then json = true
  else
    warn "unknown option #{argument.inspect}"
    warn USAGE
    exit 2
  end
end

# A tag counts only where a test can live: under a tests/ directory, in a file
# that defines tests, or in a check script that CI actually runs. A tag on a
# library file or on an ad hoc wrapper script is reported and ignored.
TEST_MARKER = /#\[(?:tokio::)?test\b|#\[cfg\(test\)\]|^\s*def test_|\bproptest!|^\s*(?:it|test)\(/
WIRING_FILES = %w[scripts/ci-all governance/tiers.yaml .github/workflows].freeze
IGNORED_TAGS = []

def wired_scripts(root)
  @wired_scripts ||= {}
  @wired_scripts[root] ||= begin
    names = Set.new
    WIRING_FILES.each do |entry|
      path = File.join(root, entry)
      files = File.directory?(path) ? Dir.glob(File.join(path, "*.yml")) : [path]
      files.each do |file|
        next unless File.file?(file)

        File.read(file, encoding: "UTF-8").scan(%r{(?:\./)?scripts/([A-Za-z0-9_.-]+)}) { |(name)| names << name }
      end
    end
    names
  end
end

def evidence_file?(root, path)
  return true if path.match?(%r{(?:\A|/)tests?/})
  return wired_scripts(root).include?(File.basename(path)) if path.start_with?("scripts/")

  file = File.join(root, path)
  File.file?(file) && File.read(file, encoding: "UTF-8").match?(TEST_MARKER)
end

# Requirement tags, one git grep over the directories that can hold evidence.
# Returns { "REP-002" => ["crates/x/tests/replication.rs:41", ...] }.
def requirement_tags(root)
  roots = TAG_ROOTS.select { |name| File.exist?(File.join(root, name)) }
  return {} if roots.empty?

  stdout, _stderr, status = Open3.capture3(
    "git", "-C", root, "grep", "--untracked", "-n", "-E", '^[[:space:]]*(//|#)[[:space:]]*req:',
    "--", *roots, *TAG_EXCLUDES
  )
  # 1 means "no tags in the tree", which is the state before the cutover.
  raise "git grep failed in #{root}" unless [0, 1].include?(status.exitstatus)

  tags = Hash.new { |hash, key| hash[key] = [] }
  stdout.each_line do |line|
    path, number, text = line.chomp.split(":", 3)
    next unless text

    unless evidence_file?(root, path)
      IGNORED_TAGS << "#{path}:#{number}"
      next
    end

    body = text[TAG_LINE, 1]
    next unless body

    body.scan(/[A-Z]{2,5}-\d{3}/).uniq.each { |id| tags[id] << "#{path}:#{number}" }
  end
  tags
end

spec = File.read(SPEC_PATH, encoding: "UTF-8")
manifest = YAML.safe_load(File.read(MANIFEST_PATH, encoding: "UTF-8"), aliases: true)
errors = []

spec_version = spec[/\*\*Version:\*\*\s+([^\s]+)/, 1]
errors << "SPEC.md has no document version" unless spec_version
if manifest["spec_version"].to_s != spec_version.to_s
  errors << "manifest spec_version #{manifest['spec_version'].inspect} does not match SPEC #{spec_version.inspect}"
end
errors << "manifest source_spec must be SPEC.md" unless manifest["source_spec"] == "SPEC.md"

prefixes = spec.scan(/`([A-Z]{2,4})-\*`/).flatten.to_set
errors << "SPEC.md Appendix E defines no requirement prefixes" if prefixes.empty?
id_pattern = /\b(?:#{prefixes.to_a.sort.join('|')})-\d{3}\b/
defined_ids = spec.scan(id_pattern).to_set

packages = manifest.fetch("work_packages", [])
package_ids = packages.map { |package| package["id"] }
package_ids.tally.each do |id, count|
  errors << "duplicate work-package ID #{id}" if count > 1
end
known_packages = package_ids.to_set

assigned_ids = Set.new
packages.each do |package|
  id = package["id"] || "<missing-id>"
  requirements = package.fetch("requirements", [])
  requirements.tally.each do |requirement, count|
    errors << "#{id} lists requirement #{requirement} #{count} times" if count > 1
  end
  assigned_ids.merge(requirements)
  package.fetch("depends_on", []).each do |dependency|
    errors << "#{id} has unknown dependency #{dependency}" unless known_packages.include?(dependency)
  end
end

exclusions = manifest.dig("requirement_coverage", "excluded_ids") || []
excluded_ids = Set.new
exclusions.each do |entry|
  id = entry["id"]
  reason = entry["reason"].to_s.strip
  errors << "duplicate exclusion #{id}" if excluded_ids.include?(id)
  errors << "exclusion #{id.inspect} has no reason" if reason.empty?
  excluded_ids << id
end

tags = requirement_tags(ROOT)
tagged_ids = tags.keys.to_set
proven_ids = tagged_ids & defined_ids

(assigned_ids - defined_ids).sort.each do |id|
  errors << "work packages reference unknown requirement #{id}"
end
(excluded_ids - defined_ids).sort.each do |id|
  errors << "stale exclusion for unknown requirement #{id}"
end
(assigned_ids & excluded_ids).sort.each do |id|
  errors << "requirement #{id} is both assigned and excluded"
end
# Rule 2: an unknown identifier in a tag is a typo or a deleted requirement, and
# either way it is silently proving nothing.
(tagged_ids - defined_ids).sort.each do |id|
  errors << "requirement tag names unknown requirement #{id} (#{tags[id].first(3).join(', ')})"
end

active_ids = defined_ids - excluded_ids
# Rule 1: claimed by a package, or proven by a tag.
(active_ids - assigned_ids - proven_ids).sort.each do |id|
  errors << "uncovered normative requirement #{id}"
end

manifest.fetch("gates", []).each do |gate|
  gate.fetch("requires", []).each do |work_package|
    errors << "gate #{gate['id']} references unknown work package #{work_package}" unless known_packages.include?(work_package)
  end
end

# Rule 3: post-cutover completed packages owe a tag per listed requirement.
cutover = RiffdbAdr.to_date(manifest.dig("governance", "cutover"))
unproven_by_package = {}
open_unproven = {}
packages.each do |package|
  id = package["id"] || "<missing-id>"
  requirements = package.fetch("requirements", []).select { |requirement| active_ids.include?(requirement) }
  unproven = requirements.reject { |requirement| proven_ids.include?(requirement) }
  next if unproven.empty?

  completed = RiffdbAdr.completed_on(package)
  if cutover && completed && completed >= cutover
    unproven_by_package[id] = unproven
    errors << "#{id} completed #{completed} on or after the #{cutover} cutover but has no " \
              "requirement tag for #{unproven.sort.join(', ')}"
  elsif !RiffdbAdr.complete?(package)
    open_unproven[id] = unproven
  end
end

summary = "coverage: #{active_ids.length} requirements, claimed #{(active_ids & assigned_ids).length}, " \
          "proven #{proven_ids.length}, both #{(active_ids & assigned_ids & proven_ids).length}; " \
          "packages #{packages.length}"

if json
  puts JSON.pretty_generate(
    "requirements" => active_ids.length,
    "claimed" => (active_ids & assigned_ids).length,
    "proven" => proven_ids.length,
    "both" => (active_ids & assigned_ids & proven_ids).length,
    "packages" => packages.length,
    "exclusions" => excluded_ids.length,
    "cutover" => cutover&.to_s,
    "tags" => tags.transform_values(&:length),
    "unproven_completed_packages" => unproven_by_package,
    "unproven_open_packages" => open_unproven,
    "errors" => errors.sort
  )
  exit(errors.empty? ? 0 : 1)
end

unless errors.empty?
  warn errors.sort.join("\n")
  exit 1
end

puts "Requirement coverage is complete: #{active_ids.length} active requirements, " \
     "#{excluded_ids.length} documented exclusion(s), #{packages.length} work packages."
puts summary
unless IGNORED_TAGS.empty?
  shown = IGNORED_TAGS.first(6).join(", ")
  more = IGNORED_TAGS.length > 6 ? ", ..." : ""
  puts "tags ignored outside evidence files: #{IGNORED_TAGS.length} (#{shown}#{more})"
end

if report
  if open_unproven.empty?
    puts "Every open package's requirements carry a tag."
  else
    puts "Unproven requirements by open package:"
    open_unproven.keys.sort.each do |id|
      puts "  #{id}: #{open_unproven[id].sort.join(', ')}"
    end
  end
end
