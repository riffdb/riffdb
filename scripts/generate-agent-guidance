#!/usr/bin/env python3
"""Generate repository-local agent rails and public teaching artifacts."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys


ROOT = Path(__file__).resolve().parent.parent
SOURCE = ROOT / "fixtures/agent-guidance/v1.json"


def numbered(values: list[str]) -> str:
    return "\n".join(f"{index}. {value}" for index, value in enumerate(values, 1))


def bullets(values: list[str]) -> str:
    return "\n".join(f"- {value}" for value in values)


def outputs(source: dict[str, object]) -> dict[Path, str]:
    title = str(source["title"])
    principles = list(source["principles"])
    loop = list(source["loop"])
    commands = list(source["commands"])
    limitations = str(source["limitations"])
    skill = f"""---
name: riffdb
description: Safely author and operate the RiffDB project in this repository.
---

# {title}

## Safety rails

{bullets(principles)}

## Working loop

{numbered(loop)}

## Commands

```text
{chr(10).join(commands)}
```

{limitations}
"""
    agents = f"""<!-- riffdb-agent:start -->
## RiffDB project workflow

{bullets(principles)}

{numbered(loop)}

Rerun `riffdb agent init` to verify these exact generated rails.
<!-- riffdb-agent:end -->
"""
    llms = f"""# RiffDB

> Contract-first operational database for agent-built applications.

## Project workflow

{numbered(loop)}

## Safety invariants

{bullets(principles)}

## Public documentation

- [Database workflow](getting-started/DATABASE-WORKFLOW.md)
- [Agent database quickstart](getting-started/AGENT-DATABASE-QUICKSTART.md)
- [MCP agent cookbook](mcp/agent-cookbook.md)
- [Consistency and uncertainty recovery](concepts/CONSISTENCY.md)

{limitations}
"""
    quickstart = f"""# Agent Database Quickstart

This page is generated from the same bounded source as the repository skill,
managed AGENTS section, and `llms.txt` distillation.

## Install the project rails

From a project containing `riffdb.toml`:

```bash
riffdb agent init
```

The command installs `.agents/skills/riffdb/SKILL.md`, appends one managed
section to root `AGENTS.md`, and merges `mcpServers.riffdb` into root
`.mcp.json`. It retains unrelated configuration, is byte-idempotent, and fails
before writing when a managed target conflicts. It never embeds a credential.

## Safe working loop

{numbered(loop)}

## Core rules

{bullets(principles)}

The application-specific MCP guide is `riffdb://application/guide`. Its content
is generated at read time from the current, authorization-filtered deployed
catalog, so it does not teach hidden operations or stale contract identities.

## POC limitations

{limitations}
"""
    return {
        ROOT / "crates/riffdb-cli/assets/agent/SKILL.md": skill,
        ROOT / "crates/riffdb-cli/assets/agent/AGENTS.block.md": agents,
        ROOT / "docs/llms.txt": llms,
        ROOT / "docs/getting-started/AGENT-DATABASE-QUICKSTART.md": quickstart,
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--check", action="store_true")
    args = parser.parse_args()
    source = json.loads(SOURCE.read_text(encoding="utf-8"))
    if source.get("schema") != "riffdb.agent-guidance/v1":
        raise SystemExit("unsupported agent guidance source")
    generated = outputs(source)
    stale: list[str] = []
    for path, content in generated.items():
        if not content.endswith("\n"):
            content += "\n"
        if args.check:
            if not path.is_file() or path.read_text(encoding="utf-8") != content:
                stale.append(str(path.relative_to(ROOT)))
        else:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(content, encoding="utf-8", newline="\n")
    if stale:
        print("stale generated agent guidance: " + ", ".join(stale), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
