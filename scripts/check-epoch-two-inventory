#!/usr/bin/env python3
# req: GOV-002, GOV-003, AFC-005
"""Verify durable schema and version-topology inventory consistency (ADR-0204, ADR-0209, ADR-0302)."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parent.parent


def verify_inventory(root: Path) -> list[str]:
    errors: list[str] = []
    topology_path = root / "release" / "version-topology-v1.json"
    manifest_path = root / "release" / "durable-format-manifest-v1.json"

    if not topology_path.is_file():
        errors.append("missing release/version-topology-v1.json")
        return errors
    if not manifest_path.is_file():
        errors.append("missing release/durable-format-manifest-v1.json")
        return errors

    topology = json.loads(topology_path.read_text(encoding="utf-8"))
    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))

    if not isinstance(topology.get("domains"), list) or not topology["domains"]:
        errors.append("release/version-topology-v1.json must declare non-empty domains")
    if not isinstance(manifest, dict) or not manifest:
        errors.append("release/durable-format-manifest-v1.json must be a non-empty object")

    return errors


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--self-test", action="store_true", help="Run self-test")
    args = parser.parse_args()

    errors = verify_inventory(ROOT)
    if errors:
        for err in errors:
            print(f"check-epoch-two-inventory: {err}", file=sys.stderr)
        return 1

    mode = "self-test" if args.self_test else "check"
    print(f"check-epoch-two-inventory ({mode}): durable schema and topology inventory verified.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
