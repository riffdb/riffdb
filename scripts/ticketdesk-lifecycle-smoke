#!/usr/bin/env python3
# req: END-001, END-002, END-003, END-004, END-007, END-008
"""Run the generated lifecycle client in an owned TLS preparation database.

This is a semantic smoke test, not a campaign receipt or host qualification.
Artifacts, credentials and diagnostic logs remain in the private supplied root.
"""

import argparse
from contextlib import contextmanager
import hashlib
import json
import os
from pathlib import Path
import queue
import shutil
import socket
import subprocess
import sys
import threading
import time

from lib.ticketdesk_lifecycle_transient_usage import run_transient_observed
from lib.ticketdesk_lifecycle_persistent_usage import ObservedProcess
from lib.ticketdesk_lifecycle_inventory import InventoryError, InventoryMonitor
from lib.ticketdesk_lifecycle_faults import FaultError, LocalArchiveOutage
from lib.ticketdesk_lifecycle_observations import ObservationError, health_head, projection_backlog
from lib.ticketdesk_lifecycle_provider_budget import ProviderBudgetError, ProviderLog
from lib.ticketdesk_lifecycle_source_bytes import SourceBytesLog
from lib.ticketdesk_lifecycle_logical_bytes import LogicalBytesLog
from lib.ticketdesk_lifecycle_physical_bytes import PhysicalBytesLog
from lib.ticketdesk_lifecycle_native_observer import NativeObserverProcess, NativeObservationError
from lib.ticketdesk_lifecycle_resources import (
    MAX_PREPARATION_SAMPLE_SECONDS, ResourceError, PreparationMemorySamples,
)


class SmokeError(ValueError):
    """Closed diagnostic; input paths and child output stay in private files."""


def require(condition, code):
    if not condition:
        raise SmokeError(code)


def write(root, name, value):
    path = root / name
    with path.open("x") as output:
        os.chmod(path, 0o600)
        output.write(value)
    return path


def read_json(path, maximum=1048576):
    require(path.is_file() and not path.is_symlink() and 0 < path.stat().st_size <= maximum,
            "observation_bound")
    with path.open("rb") as source:
        encoded = source.read(maximum + 1)
    require(len(encoded) <= maximum, "observation_bound")
    return json.loads(encoded)


def outbox_drained(health):
    require(type(health) is dict and health.get("schema") == "riffdb.cli.output/v1"
            and health.get("command") == "server.health" and health.get("ok") is True,
            "archive_health")
    require(type(health.get("result")) is dict, "archive_health")
    components = health["result"]["components"]
    require(type(components) is list and 0 < len(components) <= 16
            and all(type(value) is dict for value in components), "archive_health")
    outbox = [value for value in components if value.get("component") == "outbox"]
    require(len(outbox) == 1 and outbox[0].get("status") in {"healthy", "degraded", "unavailable"},
            "archive_health")
    return outbox[0]["status"] == "healthy"


def drain_archive(root, stage, base, server, observer=None, maximum=900):
    """Preparation only: observe public delivery readiness with writes stopped."""
    started = time.monotonic()
    for index in range(maximum + 1):
        require(server.poll() is None and (observer is None or observer.poll() is None),
                "archive_drain_liveness")
        require(time.monotonic() - started < maximum, "archive_drain_bound")
        name = stage + "-archive-health-" + str(index)
        invoke(root, name, base + ["server", "health"], timeout=10)
        require(time.monotonic() - started < maximum, "archive_drain_bound")
        if outbox_drained(read_json(root / (name + ".stdout"))):
            elapsed_ns = int((time.monotonic() - started) * 1000000000)
            write(root, stage + "-archive-drain.json", json.dumps({
                "schema": "riffdb.ticketdesk-lifecycle-archive-drain-preparation/v1",
                "elapsed_ns": elapsed_ns, "observed_ready": True}) + "\n")
            return
        threading.Event().wait(1)
    raise SmokeError("archive_drain_bound")


def invoke(root, name, arguments, *, environment=None, timeout=60):
    with (root / (name + ".stdout")).open("xb") as output, \
            (root / (name + ".stderr")).open("xb") as errors:
        status = run_transient_observed(arguments, output=output, errors=errors,
            environment=environment, timeout=timeout,
            observation=root / (name + ".process-usage.json"))
    require(status == 0, name)


def pump_ready(server, root, ready):
    sent = False
    with (root / "server.stdout").open("xb") as output:
        while line := server.stdout.readline(4097):
            output.write(line)
            output.flush()
            if not sent and line.startswith(b"riffdbd-ready-v1"):
                ready.put_nowait(True)
                sent = True
            if len(line) > 4096:
                if not sent:
                    ready.put_nowait(False)
                return
        if not sent:
            ready.put_nowait(False)


def pump_observer(observer, root, ready, latest):
    sent = False
    with (root / "observer.stdout").open("xb") as output:
        while line := observer.stdout.readline(4097):
            output.write(line)
            output.flush()
            if len(line) > 4096:
                break
            try:
                value = json.loads(line)
            except (ValueError, TypeError):
                break
            if not sent and value.get("schema") == "riffdb.ticketdesk-lifecycle-observer-ready/v1":
                ready.put_nowait(True)
                sent = True
            elif value.get("schema") == "riffdb.ticketdesk-lifecycle-observation/v1":
                try:
                    latest.get_nowait()
                except queue.Empty:
                    pass
                latest.put_nowait(value)
            else:
                break
        if not sent:
            ready.put_nowait(False)


def interrupted_update(root, kind, worker, environment, server, pump, server_binary, config):
    """Interrupt an admitted generated client and resolve its original update."""
    write(root, "load.recover", kind + " 1\n")
    environment = dict(environment, RIFFDB_LIFECYCLE_LOAD_CONTROL=str(root))
    messages = queue.Queue(maxsize=256)
    with (root / "recovery.stdout").open("xb") as output, (root / "recovery.stderr").open("xb") as errors:
        process = ObservedProcess([worker, "recovery-smoke"], env=environment,
                                   observation=root / "recovery.process-usage.json",
                                   stdout=subprocess.PIPE, stderr=errors)
        reader = threading.Thread(target=pump_load, args=(process, output, messages), daemon=True)
        reader.start()
        try:
            require(messages.get(timeout=30) == {
                "schema": "riffdb.ticketdesk-lifecycle-recovery-ready/v1"}, "recovery_admission")
            started = time.monotonic()
            if kind == "process_kill":
                server.kill()
            else:
                server.terminate()
            server.wait(timeout=30)
            server.stdin.close()
            pump.join(timeout=5)
            require(not pump.is_alive() and server.returncode == (-9 if kind == "process_kill" else 0),
                    "recovery_shutdown")
            write(root, "recovery.start", "start\n")
            failed = messages.get(timeout=15)
            require(failed == {"schema": "riffdb.ticketdesk-lifecycle-recovery-retry/v1", "retry": 1},
                    "recovery_requires_actual_failed_submission")
            restarted = root / "restarted"
            restarted.mkdir(mode=0o700)
            ready = queue.Queue(maxsize=1)
            with (restarted / "server.stderr").open("xb") as errors:
                server = ObservedProcess([server_binary, "--config", str(config)],
                    observation=restarted / "server.process-usage.json",
                    stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=errors)
            pump = threading.Thread(target=pump_ready, args=(server, restarted, ready), daemon=True)
            pump.start()
            require(ready.get(timeout=30) is True, "recovery_readiness")
            # The native initializing route is Health-only. Resume the same
            # input only after actual activation, retaining the prior failed
            # transport submission and the original interruption deadline.
            write(root, "recovery.resume", "ready\n")
            retries = 1
            while True:
                require(time.monotonic() - started < 60 and process.poll() in (None, 0),
                        "recovery_first_write_bound")
                observed = messages.get(timeout=max(0.01, 60 - (time.monotonic() - started)))
                if observed.get("schema") == "riffdb.ticketdesk-lifecycle-recovery-retry/v1":
                    retries += 1
                    require(observed == {"schema": "riffdb.ticketdesk-lifecycle-recovery-retry/v1",
                                         "retry": retries} and retries < 240, "recovery_retry_accounting")
                else:
                    require(observed == {"schema": "riffdb.ticketdesk-lifecycle-recovery-smoke/v1",
                        "retries": retries, "original_identity": True, "state_reconciled": True},
                        "recovery_reconciliation")
                    break
            elapsed = time.monotonic() - started
            process.wait(timeout=5)
            reader.join(timeout=5)
            require(process.returncode == 0 and not reader.is_alive() and elapsed <= 60,
                    "recovery_worker_completion")
            write(root, "recovery-observation.json", json.dumps({
                "schema": "riffdb.ticketdesk-lifecycle-interruption-preparation/v1",
                "kind": kind, "recovery_elapsed_ns": int(elapsed * 1000000000),
                "settled_submission_retries": retries, "original_identity": True,
                "state_reconciled": True}) + "\n")
            (root / "load.recover").unlink()
            return server, pump
        except BaseException:
            if server.poll() is None:
                server.terminate()
                try:
                    server.wait(timeout=30)
                except subprocess.TimeoutExpired:
                    server.kill()
                    server.wait(timeout=5)
            raise
        finally:
            if process.poll() is None:
                process.kill()
            process.wait(timeout=5)
            reader.join(timeout=5)


class ConsumerOutageOracle:
    """Compare measured observations; a pause marker alone proves nothing."""

    def __init__(self):
        self.first = None
        self.last = None
        self.samples = 0

    def observe(self, value, *, paused):
        require(value["consumer_paused"] is paused and value["duplicates"] == 0
                and value["auxiliary_slots"] == 2 and value["history_incarnation"] > 0,
                "consumer_outage_observation")
        if self.first is None:
            self.first = dict(value)
        if self.last is not None:
            require(value["history_incarnation"] == self.first["history_incarnation"]
                    and value["live_head"] >= self.last["live_head"]
                    and value["live_updates"] >= self.last["live_updates"]
                    and value["events_checked"] >= self.last["events_checked"]
                    and value["consumer_checkpoint"] >= self.last["consumer_checkpoint"],
                    "consumer_outage_continuity")
        if paused:
            require(value["events_checked"] == self.first["events_checked"]
                    and value["consumer_checkpoint"] == self.first["consumer_checkpoint"],
                    "consumer_outage_not_paused")
        self.last = dict(value)
        self.samples += 1

    def finish_pause(self):
        require(self.samples >= 2 and self.last["live_head"] > self.first["live_head"]
                and self.last["live_updates"] > self.first["live_updates"],
                "consumer_outage_live_inactive")

    def recovered(self, value, expected):
        self.observe(value, paused=False)
        require(self.first["events_checked"] < expected
                and self.first["events_checked"] <= value["events_checked"] <= expected
                and value["consumer_checkpoint"] >= self.first["consumer_checkpoint"],
                "consumer_outage_backlog")
        return value["events_checked"] == expected


class SinkOutageOracle:
    """Native degraded delivery plus independently observed writes and watch."""
    def __init__(self):
        self.first = None
        self.last = None
        self.samples = 0

    def observe(self, health, live):
        require(not outbox_drained(health), "sink_outage_not_observed")
        try:
            frontier = health_head(health)
        except ObservationError as error:
            raise SmokeError("sink_outage_observation") from error
        require(type(frontier) is int and 0 < frontier <= 2**64 - 1
                and type(live) is dict and live.get("auxiliary_slots") == 2
                and live.get("observer_quiesced") is False, "sink_outage_observation")
        values = (frontier, live.get("live_head"), live.get("live_updates"),
                  live.get("history_incarnation"))
        require(all(type(value) is int and 0 < value <= 2**64 - 1 for value in values),
                "sink_outage_observation")
        if self.last is not None:
            require(values[3] == self.last[3]
                    and all(value >= previous for value, previous in zip(values[:3], self.last[:3])),
                    "sink_outage_continuity")
        else:
            self.first = values
        self.last = values
        self.samples += 1

    def finish_pause(self):
        require(self.samples >= 2
                and all(last > first for last, first in zip(self.last[:3], self.first[:3])),
                "sink_outage_load_inactive")

    def recovered(self, health):
        ready = outbox_drained(health)
        try:
            frontier = health_head(health)
        except ObservationError as error:
            raise SmokeError("sink_outage_continuity") from error
        require(self.last is not None and type(frontier) is int
                and self.last[0] <= frontier <= 2**64 - 1, "sink_outage_continuity")
        return ready


class SinkOutagePreparation:
    def __init__(self, root, base, custody):
        self.root, self.base, self.custody = root, base, custody
        self.oracle = SinkOutageOracle()
        self.requested = self.resumed = self.recovered = None
        self.next_sample = 0
        self.sample = 0
        self.live = None

    def poll(self, started, latest):
        now = time.monotonic()
        if self.requested is None:
            if now - started < 5:
                return
            self.custody.pause()
            self.requested = time.monotonic()
        if self.resumed is None and now - self.requested >= 300:
            self.oracle.finish_pause()
            self.custody.resume()
            self.resumed = time.monotonic()
        try:
            self.live = latest.get_nowait()
        except queue.Empty:
            pass
        if self.recovered is not None or now < self.next_sample:
            return
        name = "sink-health-" + str(self.sample)
        self.sample += 1
        require(self.sample <= 1000, "sink_outage_sample_bound")
        invoke(self.root, name, self.base + ["server", "health"], timeout=5)
        health = read_json(self.root / (name + ".stdout"))
        now = time.monotonic()
        self.next_sample = now + 1
        if self.resumed is None:
            if not outbox_drained(health):
                self.oracle.observe(health, self.live)
            else:
                require(self.oracle.samples == 0 and now - self.requested <= 10,
                        "sink_outage_not_observed")
            require(self.oracle.samples > 0 or now - self.requested <= 10,
                    "sink_outage_not_observed")
        else:
            require(now - self.resumed <= 600, "sink_outage_recovery")
            if self.oracle.recovered(health):
                self.recovered = now

    def finish(self, started):
        require(self.requested is not None and self.resumed is not None
                and self.recovered is not None, "sink_outage_incomplete")
        pause_ns = int((self.resumed - self.requested) * 1000000000)
        recovery_ns = int((self.recovered - self.resumed) * 1000000000)
        require(300000000000 <= pause_ns <= 302000000000
                and 0 <= recovery_ns <= 600000000000, "sink_outage_timing")
        write(self.root, "sink-outage.json", json.dumps({
            "schema": "riffdb.ticketdesk-lifecycle-sink-outage-preparation/v1",
            "start_elapsed_ns": int((self.requested - started) * 1000000000),
            "pause_elapsed_ns": pause_ns, "recovery_elapsed_ns": recovery_ns,
            "observed_samples": self.oracle.samples, "same_archive_custody": True,
            "public_write_progress": self.oracle.last[0] - self.oracle.first[0],
            "live_progress_during_pause": True, "delivery_drained_under_load": True}))


def outage_window(start, end, outage):
    low, pause, recovery = (outage[key] for key in
                           ("start_elapsed_ns", "pause_elapsed_ns", "recovery_elapsed_ns"))
    require(all(type(value) is int for value in (low, pause, recovery))
            and 0 < low < 900000000000 and 300000000000 <= pause <= 302000000000
            and 0 <= recovery <= 600000000000, "consumer_outage_timing")
    return start * 1000000000 < low + pause + recovery and end * 1000000000 > low


def pump_load(process, output, messages):
    total = 0
    try:
        while line := process.stdout.readline(4097):
            total += len(line)
            require(len(line) <= 4096 and total <= 65536, "probe_observation")
            value = json.loads(line)
            output.write(line)
            output.flush()
            messages.put_nowait(value)
    except (SmokeError, ValueError, queue.Full):
        messages.put({"schema": "invalid"}, timeout=1)
    finally:
        process.stdout.close()


class ProjectionSampler:
    """One auxiliary call at a time, with actual plan-bound native fences."""

    def __init__(self, root, base, identity, duration):
        require(type(duration) is int and 1 <= duration <= 86400, "projection_sample_bound")
        self.root, self.base, self.identity, self.duration = root, base, identity, duration
        self.input = write(root, "projection-sample-input.json", json.dumps({"leading_components": [
            {"type": "uuid", "value": "01900000-0000-7000-8001-000000000000"}]}))
        self.coverage = [0] * ((duration + 299) // 300)
        self.stopped = threading.Event()
        self.errors = queue.Queue(maxsize=1)
        self.thread = None

    def sample(self, index, elapsed_ns):
        require(type(index) is int and 0 <= index <= (self.duration + 4) // 5,
                "projection_sample_bound")
        require(type(elapsed_ns) is int and 0 <= elapsed_ns < self.duration * 1000000000,
                "projection_sample_clock")
        prefix = "projection-sample-" + str(index)
        invoke(self.root, prefix + "-health", self.base + ["server", "health"], timeout=5)
        health = read_json(self.root / (prefix + "-health.stdout"))
        invoke(self.root, prefix + "-query", self.base + ["projection", "query",
            str(self.identity["projection_id"]), "--contract-lineage", "TicketDeskLifecycle",
            "--contract-version", "1", "--input", str(self.input), "--limit", "1"], timeout=5)
        projection = read_json(self.root / (prefix + "-query.stdout"))
        backlog = projection_backlog(health, projection, self.identity)
        fence = projection["result"]["observed_fence"]
        return {"schema": "riffdb.ticketdesk-lifecycle-projection-sample/v1",
                "elapsed_ns": elapsed_ns, "sampled_head": health_head(health),
                "applied_through": int(fence["frontier"]["sequence"]),
                "generation": int(fence["generation"]), "identity": self.identity,
                "projection_backlog": backlog, "auxiliary_slots": 1}

    def start(self, started):
        require(self.thread is None, "projection_sample_owner")
        self.thread = threading.Thread(target=self.run, args=(started,), daemon=True)
        self.thread.start()

    def run(self, started):
        try:
            with (self.root / "projection-samples.jsonl").open("x") as output:
                os.chmod(self.root / "projection-samples.jsonl", 0o600)
                index, previous_head, previous_applied = 0, 0, 0
                while not self.stopped.is_set():
                    elapsed_ns = int((time.monotonic() - started) * 1000000000)
                    if elapsed_ns >= self.duration * 1000000000:
                        break
                    sample = self.sample(index, elapsed_ns)
                    completed = int((time.monotonic() - started) * 1000000000)
                    require(sample["sampled_head"] >= previous_head
                            and sample["applied_through"] >= previous_applied,
                            "projection_sample_regression")
                    previous_head, previous_applied = sample["sampled_head"], sample["applied_through"]
                    sample["completed_elapsed_ns"] = completed
                    encoded = json.dumps(sample, separators=(",", ":")) + "\n"
                    require(len(encoded) <= 2048, "projection_sample_bound")
                    output.write(encoded)
                    output.flush()
                    if completed < self.duration * 1000000000:
                        self.coverage[elapsed_ns // 300000000000] += 1
                    index += 1
                    self.stopped.wait(5)
        except (SmokeError, NativeObservationError, ObservationError, OSError, ValueError, TypeError, KeyError,
                subprocess.SubprocessError):
            self.errors.put_nowait("projection_sample_failed")

    def poll(self):
        require(self.errors.empty(), "projection_sample_failed")

    def stop(self):
        self.stopped.set()
        if self.thread is not None:
            self.thread.join(timeout=12)
            require(not self.thread.is_alive(), "projection_sample_shutdown")
        self.poll()

    def validate_coverage(self):
        require(all(count > 0 for count in self.coverage), "projection_sample_coverage")



class NativeProjectionSampler(ProjectionSampler):
    """Same reserved slot, with a persistent native child instead of query CLI children."""

    def __init__(self, root, worker, environment, identity, duration):
        require(type(duration) is int and 1 <= duration <= 86400, "projection_sample_bound")
        self.root, self.identity, self.duration = root, identity, duration
        self.coverage = [0] * ((duration + 299) // 300)
        self.stopped = threading.Event()
        self.errors = queue.Queue(maxsize=1)
        self.thread = None
        self.native = NativeObserverProcess(root, [worker, "native-observer"], environment,
            {"projection_id": identity["projection_id"], "projection_plan_hash": identity["projection_plan_hash"]})

    def sample(self, index, elapsed_ns):
        value = self.native.sample(elapsed_ns)
        require(value["index"] == index, "native_sample_continuity")
        return value

    def stop(self):
        try:
            super().stop()
        finally:
            self.native.close(failed=not self.errors.empty())


def observed_load(root, worker, environment, duration, observer, latest, consumer_outage, *, sink=None,
                  projection=None, server=None, collect_source_bytes=False):
    """Monitor child liveness and time a real outage against the offered clock."""
    messages = queue.Queue(maxsize=256)
    oracle = ConsumerOutageOracle()
    started = None
    requested_at = None
    paused_at = None
    resumed_at = None
    recovered_at = None
    pause_finished = False
    memory = None
    providers = None
    source_bytes = None
    logical_bytes = None
    physical_bytes = None
    deadline = time.monotonic() + duration + 120
    with (root / "load.stdout").open("xb") as output, (root / "load.stderr").open("xb") as errors:
        process = ObservedProcess([worker, "probe"], env=environment,
                                   observation=root / "load.process-usage.json",
                                   stdout=subprocess.PIPE, stderr=errors)
        pump = threading.Thread(target=pump_load, args=(process, output, messages), daemon=True)
        pump.start()
        try:
            while process.poll() is None or pump.is_alive() or not messages.empty():
                now = time.monotonic()
                require(now < deadline, "probe_deadline")
                require(observer is None or observer.poll() is None, "observer_ended_during_load")
                require(server is None or server.poll() is None, "server_ended_during_load")
                try:
                    message = messages.get(timeout=0.05)
                    schema = message.get("schema")
                    require(schema in {"riffdb.ticketdesk-lifecycle-load-ready/v1",
                        "riffdb.ticketdesk-lifecycle-load-probe/v1",
                        "riffdb.ticketdesk-lifecycle-load-stopped/v1"}, "probe_observation")
                    if schema == "riffdb.ticketdesk-lifecycle-load-ready/v1":
                        require(started is None, "probe_clock")
                        started = time.monotonic()
                        if server is not None:
                            require(observer is not None, "resource_process_inventory")
                            owners = {"controller": os.getpid(), "server": server.pid,
                                      "load": process.pid, "observer": observer.pid}
                            if isinstance(projection, NativeProjectionSampler):
                                owners["native_sampler"] = projection.native.process.pid
                            memory = PreparationMemorySamples(root, owners, duration)
                            memory.__enter__()
                            providers = ProviderLog(root, duration)
                            providers.__enter__()
                            if collect_source_bytes:
                                require(isinstance(projection, NativeProjectionSampler),
                                        "source_bytes_sampler")
                                def incarnation():
                                    sample = projection.native.samples.last
                                    return None if sample is None else sample["history_incarnation"]
                                source_bytes = SourceBytesLog(root, duration, incarnation)
                                source_bytes.__enter__()
                                logical_bytes = LogicalBytesLog(root, duration, incarnation)
                                logical_bytes.__enter__()
                                physical_bytes = PhysicalBytesLog(root, duration, incarnation)
                                physical_bytes.__enter__()
                        if projection is not None:
                            projection.start(started)
                except queue.Empty:
                    pass
                now = time.monotonic()
                if memory is not None:
                    memory.poll(int((now - started) * 1000000000))
                if providers is not None:
                    providers.poll(int((now - started) * 1000000000))
                if source_bytes is not None:
                    source_bytes.poll(int((now - started) * 1000000000))
                if logical_bytes is not None:
                    logical_bytes.poll(int((now - started) * 1000000000))
                if projection is not None:
                    projection.poll()
                if physical_bytes is not None:
                    physical_bytes.poll(int((now - started) * 1000000000))
                if sink is not None and started is not None:
                    sink.poll(started, latest)
                if not consumer_outage or started is None:
                    continue
                if requested_at is None and now - started >= 5:
                    write(root, "consumer.pause", "pause\n")
                    requested_at = time.monotonic()
                if paused_at is not None and resumed_at is None and now - paused_at >= 300:
                    oracle.finish_pause()
                    pause_finished = True
                    (root / "consumer.pause").unlink()
                    resumed_at = time.monotonic()
                try:
                    value = latest.get_nowait()
                except queue.Empty:
                    continue
                if requested_at is not None and resumed_at is None and value["consumer_paused"]:
                    oracle.observe(value, paused=True)
                    if paused_at is None:
                        paused_at = time.monotonic()
                elif resumed_at is not None and not value["consumer_paused"] and recovered_at is None:
                    if oracle.recovered(value, 2048):
                        recovered_at = time.monotonic()
                    require(now - resumed_at <= 600, "consumer_outage_recovery")
            process.wait(timeout=5)
            pump.join(timeout=5)
            require(process.returncode == 0 and not pump.is_alive(), "load")
            if providers is not None:
                summary = providers.finish(int((time.monotonic() - started) * 1000000000))
                write(root, "provider-budget-observation.json", json.dumps(summary, sort_keys=True) + "\n")
            if source_bytes is not None:
                summary = source_bytes.finish(int((time.monotonic() - started) * 1000000000))
                write(root, "source-byte-observation.json", json.dumps(summary, sort_keys=True) + "\n")
            if logical_bytes is not None:
                summary = logical_bytes.finish(int((time.monotonic() - started) * 1000000000))
                write(root, "logical-byte-observation.json", json.dumps(summary, sort_keys=True) + "\n")
            if physical_bytes is not None:
                summary = physical_bytes.finish(int((time.monotonic() - started) * 1000000000))
                write(root, "physical-byte-observation.json", json.dumps(summary, sort_keys=True) + "\n")
            if memory is not None:
                memory.finish()
            if projection is not None:
                projection.stop()
                projection.validate_coverage()
            if sink is not None:
                sink.finish(started)
            if consumer_outage:
                require(pause_finished and recovered_at is not None, "consumer_outage_incomplete")
                pause_ns = int((resumed_at - paused_at) * 1000000000)
                recovery_ns = int((recovered_at - resumed_at) * 1000000000)
                require(300000000000 <= pause_ns <= 302000000000
                        and 0 <= recovery_ns <= 600000000000, "consumer_outage_timing")
                write(root, "consumer-outage.json", json.dumps({
                    "schema": "riffdb.ticketdesk-lifecycle-consumer-outage-preparation/v1",
                    "pause_elapsed_ns": pause_ns, "recovery_elapsed_ns": recovery_ns,
                    "start_elapsed_ns": int((paused_at - started) * 1000000000),
                    "paused_events": oracle.first["events_checked"], "drained_events": 2048,
                    "observed_samples": oracle.samples, "live_progress_during_pause": True}))
        except ResourceError as error:
            # Preserve the closed original refusal before cleanup can raise a
            # second error. This record is diagnostic and never qualifies a run.
            encoded = json.dumps(error.observation(), sort_keys=True) + "\n"
            require(len(encoded) <= 512, "resource_refusal_bound")
            write(root, "resource-refusal.json", encoded)
            raise
        finally:
            if logical_bytes is not None:
                logical_bytes.__exit__(None, None, None)
            if physical_bytes is not None:
                physical_bytes.__exit__(None, None, None)
            if source_bytes is not None:
                source_bytes.__exit__(None, None, None)
            if providers is not None:
                providers.__exit__(None, None, None)
            if memory is not None:
                memory.__exit__(None, None, None)
            if process.poll() is None:
                process.terminate()
                try:
                    process.wait(timeout=10)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait(timeout=5)
            pump.join(timeout=5)
            if (root / "consumer.pause").exists():
                (root / "consumer.pause").unlink()
            if projection is not None:
                projection.stop()


def other_language_smokes(root, repository, python_native, port):
    go_stage = root / "go"
    (go_stage / "generated").mkdir(parents=True, mode=0o700)
    shutil.copyfile(root / "application/generated/go/client.go", go_stage / "generated/client.go")
    shutil.copyfile(repository / "examples/ticketdesk/lifecycle/go/smoke.go", go_stage / "main.go")
    write(go_stage, "go.mod", "module lifecycle-preparation\n\ngo 1.24\n\n"
        "require riffdb.dev/application v0.0.0\n\nreplace riffdb.dev/application => "
        + json.dumps(str(repository / "clients/go/runtime")) + "\n")
    go_environment = dict(os.environ, GOCACHE=str(go_stage / "build-cache"),
                          GOMODCACHE=str(go_stage / "module-cache"), GOTOOLCHAIN="local")
    invoke(root, "go-build", ["go", "-C", str(go_stage), "build", "-mod=readonly", "-buildvcs=false",
        "-o", str(go_stage / "smoke"), "."], timeout=120, environment=go_environment)
    invoke(root, "go-smoke", [str(go_stage / "smoke"), str(root)], timeout=40)
    python_stage = root / "python"
    python_stage.mkdir(mode=0o700)
    shutil.copytree(repository / "clients/python/runtime/src/riffdb_application",
                    python_stage / "riffdb_application",
                    ignore=shutil.ignore_patterns("__pycache__", "*.so"))
    shutil.copyfile(python_native, python_stage / "riffdb_application/_native.so")
    shutil.copyfile(root / "application/generated/python/client.py", python_stage / "client.py")
    shutil.copyfile(repository / "examples/ticketdesk/lifecycle/python/smoke.py", python_stage / "smoke.py")
    write(root, "python.connection.json", json.dumps({"endpoint": f"https://127.0.0.1:{port}"}))
    invoke(root, "python-smoke", [sys.executable, str(python_stage / "smoke.py"), str(root)], timeout=40,
        environment=dict(os.environ, PYTHONDONTWRITEBYTECODE="1"))
    for language in ("go", "python"):
        require(read_json(root / (language + "-smoke.stdout"), 4096) == {
            "schema": "riffdb.ticketdesk-lifecycle-" + language + "-smoke/v1",
            "named_read": True, "partition_isolation": True, "caller_fence": True,
            "idempotency": True, "state_unchanged": True, "live_query_snapshot": True},
            language + "_observation")


def stop_driver(root, driver):
    """Keep the existing deadline/refusal; retain the actual failure class."""
    started = time.monotonic_ns()
    timed_out = False
    if driver.poll() is None:
        driver.terminate()
    try:
        driver.wait(timeout=15)
    except subprocess.TimeoutExpired:
        timed_out = True
        driver.kill()
        driver.wait(timeout=5)
    elapsed = time.monotonic_ns() - started
    require(type(driver.returncode) is int and -255 <= driver.returncode <= 255
            and 0 <= elapsed <= 60000000000, "driver_shutdown_observation")
    write(root, "driver-shutdown.json", json.dumps({
        "schema": "riffdb.ticketdesk-lifecycle-driver-shutdown/v1",
        "timed_out": timed_out, "exit_code": driver.returncode,
        "elapsed_ns": elapsed}, sort_keys=True) + "\n")
    require(not timed_out and driver.returncode == 0, "driver_shutdown")


@contextmanager
def owned_driver(root, driver):
    """Always join the child; preserve a primary failure and record cleanup failure."""
    failed = False
    try:
        yield driver
    except BaseException:
        failed = True
        raise
    finally:
        try:
            stop_driver(root, driver)
        except SmokeError as error:
            if not failed:
                raise
            print("ticketdesk-lifecycle-smoke: cleanup_" + str(error), file=sys.stderr)


def typescript_smoke(root, repository, driver_binary, port, python_native=None):
    runtime = repository / "clients/typescript/runtime"
    compiler = runtime / "node_modules/.bin/tsc"
    require(compiler.is_file() and (runtime / "dist/index.js").is_file(), "typescript_runtime")
    stage = root / "typescript"
    stage.mkdir(mode=0o700)
    shutil.copyfile(repository / "examples/ticketdesk/lifecycle/typescript/smoke.ts", stage / "smoke.ts")
    shutil.copyfile(root / "application/generated/typescript/client.ts", stage / "client.ts")
    write(stage, "package.json", '{"type":"module"}\n')
    modules = stage / "node_modules"
    (modules / "@riffdb").mkdir(parents=True, mode=0o700)
    (modules / "@riffdb/application").symlink_to(runtime, target_is_directory=True)
    (modules / "@types").symlink_to(runtime / "node_modules/@types", target_is_directory=True)
    invoke(root, "typescript-build", [str(compiler), str(stage / "smoke.ts"),
           "--target", "ES2022", "--module", "NodeNext", "--moduleResolution", "NodeNext",
           "--strict", "--noUncheckedIndexedAccess", "--exactOptionalPropertyTypes",
           "--types", "node", "--typeRoots", str(runtime / "node_modules/@types"),
           "--outDir", str(stage / "dist")])
    lock = read_json(root / "application/riffdb.application.lock.json")
    role = next(role for role in lock["roles"] if role["definition"]["name"] == "TicketDeskLifecycleApplication")
    catalog = next(artifact for artifact in lock["artifacts"] if artifact["kind"] == "mcp")
    endpoint = f"https://127.0.0.1:{port}"
    identity = {"applicationManifestHash": lock["exact_manifest_hash"],
                "operationCatalogHash": catalog["content_hash"],
                "contractLineage": "TicketDeskLifecycle", "contractVersion": lock["contract"]["version"],
                "contractBundleHash": lock["contract"]["bundle_hash"], "database": "default",
                "role": "TicketDeskLifecycleApplication", "roleDefinitionHash": role["definition_hash"],
                "remoteIdentityHash": hashlib.sha256((endpoint + "|127.0.0.1").encode()).hexdigest()}
    write(root, "application.identity.json", json.dumps(identity))
    quote = lambda name: json.dumps(str(root / name))
    config = write(root, "application-driver.toml", f'''[driver]
socket = {quote("application.sock")}
[application]
lock_file = {quote("application/riffdb.application.lock.json")}
manifest_file = {quote("application/generated/riffdb.application.exact.json")}
operation_catalog_file = {quote("application/generated/mcp/tools.json")}
database = "default"
role = "TicketDeskLifecycleApplication"
[remote]
endpoint = "{endpoint}"
tls_trust_root = {quote("ca.pem")}
tls_server_name = "127.0.0.1"
credential_file = {quote("application.credential")}
pool_connections = 1
streams_per_connection = 4
''')
    with (root / "driver.stdout").open("xb") as output, (root / "driver.stderr").open("xb") as errors:
        driver = ObservedProcess([str(driver_binary), str(config)],
            observation=root / "driver.process-usage.json", stdout=output, stderr=errors)
        with owned_driver(root, driver):
            deadline = time.monotonic() + 30
            while not (root / "application.sock").is_socket() and driver.poll() is None:
                require(time.monotonic() < deadline, "driver_startup")
                threading.Event().wait(0.05)
            require(driver.poll() is None and (root / "application.sock").is_socket(), "driver_startup")
            invoke(root, "typescript-smoke", ["node", str(stage / "dist/smoke.js"), str(root)])
            result = root / "typescript-smoke.stdout"
            require(result.stat().st_size <= 4096, "typescript_observation")
            require(read_json(result, 4096) == {
                "schema": "riffdb.ticketdesk-lifecycle-typescript-smoke/v1", "named_read": True,
                "partition_isolation": True, "caller_fence": True, "idempotency": True,
                "state_unchanged": True, "live_query_snapshot": True}, "typescript_observation")
            if python_native:
                other_language_smokes(root, repository, python_native, port)


def validate_projection(projection, projection_id, frontier, updates, plan_hash):
    require(0 <= updates <= 8640000 and frontier > 0, "projection_input")
    require(projection.get("schema") == "riffdb.cli.output/v1"
            and projection.get("command") == "projection.query" and projection.get("ok") is True,
            "projection_observation")
    result = projection["result"]
    require(result["status"] == "ready", "projection_ready")
    fence = result["observed_fence"]
    require(fence["identity"] == {"contract_lineage": "TicketDeskLifecycle",
            "projection_id": projection_id, "projection_plan_hash": plan_hash}
            and int(fence["generation"]) > 0, "projection_identity")
    require(result["frontier"]["type"] == "applied_through"
            and int(result["frontier"]["sequence"]) >= frontier
            and fence["frontier"] == result["frontier"], "projection_frontier")
    expected = (updates // 65536) * 1024 + min(updates % 65536, 1024)
    require(result["rows"] == [{"group": [
        {"type": "uuid", "value": "01900000-0000-7000-8001-000000000000"}],
        "values": {"fields": [{"field_id": 1, "value": {"type": "i64", "value": str(expected)}}]}}],
        "projection_reconciliation")
    require(result.get("next_cursor") is None, "projection_page")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", required=True, type=Path)
    parser.add_argument("--server", required=True, type=Path)
    parser.add_argument("--cli", required=True, type=Path)
    parser.add_argument("--worker", required=True, type=Path)
    parser.add_argument("--prepare-campaign-control", action="store_true",
                        help="prepare fresh campaign controls; the controller must start its original observer before seeding")
    parser.add_argument("--prepare-successor", action="store_true", help="generate the exact-parent V2 closure in the private root")
    parser.add_argument("--additive-deploy", action="store_true", help="deploy exact-parent V2 before exercising retained V1 bindings")
    parser.add_argument("--observe", action="store_true", help="register consumer and live query before seeding")
    parser.add_argument("--archive-witness", action="store_true",
                        help="reconcile two actual archive events against independent command witnesses")
    parser.add_argument("--online-retention", action="store_true",
                        help="measure bounded online retention during an observed population preparation")
    parser.add_argument("--capability-rotation", action="store_true",
                        help="replace one application bearer and prove fresh revocation and same-principal replay")
    parser.add_argument("--python-native", type=Path,
                        help="also run Go and Python conformance with this built first-party Python extension and --driver")
    parser.add_argument("--restart-recovery", choices=("graceful_restart", "process_kill"),
                        help="interrupt and resolve one original generated update; preparation only")
    parser.add_argument("--consumer-outage", action="store_true",
                        help="time a five-minute consumer pause in an observed preparation of 900 or 1500 seconds")
    parser.add_argument("--sink-outage", action="store_true",
                        help="deny archive access for five minutes under an observed load of 900 or 1500 seconds")
    parser.add_argument("--native-observations", action="store_true",
                        help="use one persistent Rust health/statistics/projection sampler during population preparation")
    parser.add_argument("--driver", type=Path, help="also exercise retained TypeScript bindings through native Rust driver")
    parser.add_argument("--population-probe-seconds", type=int, default=0,
                        help="fresh 65536-ticket load preparation; never a campaign receipt")
    args = parser.parse_args()
    require(not args.prepare_campaign_control or args.online_retention and not any((
        args.observe, args.archive_witness, args.population_probe_seconds, args.additive_deploy,
        args.prepare_successor, args.restart_recovery, args.capability_rotation, args.driver,
        args.python_native, args.consumer_outage, args.sink_outage, args.native_observations)),
        "campaign_population_mode")
    lifetime = 100800 if args.prepare_campaign_control else 3600
    archive_quota = 8 * 1024**3 if args.prepare_campaign_control else 1024**3
    require(not args.native_observations or args.population_probe_seconds and args.observe,
            "native_sample_mode")
    outage_mode = args.consumer_outage or args.sink_outage
    outage_durations = (900, MAX_PREPARATION_SAMPLE_SECONDS)
    require(not (args.consumer_outage and args.sink_outage), "separate_outage_preparations")
    require(0 <= args.population_probe_seconds <= 300
            or outage_mode and args.population_probe_seconds in outage_durations, "probe_duration")
    require(not args.consumer_outage or args.observe and args.population_probe_seconds in outage_durations,
            "consumer_outage_mode")
    require(not args.sink_outage or args.observe and args.population_probe_seconds in outage_durations,
            "sink_outage_mode")
    require(not args.restart_recovery or not (args.observe or args.additive_deploy or args.population_probe_seconds
                                             or args.prepare_successor or args.driver), "restart_recovery_mode")
    require(not args.archive_witness or not (args.additive_deploy or args.restart_recovery or args.prepare_successor),
            "archive_witness_mode")
    require(not args.online_retention or args.population_probe_seconds and args.observe
            or args.archive_witness or args.prepare_campaign_control,
            "retention_mode")
    require(not args.capability_rotation or args.archive_witness and not
            (args.population_probe_seconds or args.observe or args.additive_deploy or args.restart_recovery
             or args.prepare_successor or args.driver), "rotation_mode")
    require(not args.python_native or args.driver and not args.population_probe_seconds, "language_mode")
    root = args.root
    require(root.is_absolute() and root.resolve() == root and not root.exists(), "root")
    require(root.parent.is_dir(), "root")
    executables = [path.resolve(strict=True) for path in (args.server, args.cli, args.worker)]
    require(all(path.is_file() and os.access(path, os.X_OK) for path in executables), "binary")
    server_binary, cli, worker = map(str, executables)
    driver_binary = args.driver.resolve(strict=True) if args.driver else None
    python_native = args.python_native.resolve(strict=True) if args.python_native else None
    if python_native:
        require(python_native.is_file() and not args.python_native.is_symlink(), "python_native")
    if driver_binary:
        require(driver_binary.is_file() and os.access(driver_binary, os.X_OK), "driver_binary")
    os.umask(0o077)
    root.mkdir(mode=0o700)
    for directory in ("data", "backups", "projections", "archive"):
        (root / directory).mkdir(mode=0o700)
    repository = Path(__file__).resolve().parent.parent
    shutil.copytree(repository / "examples/ticketdesk/lifecycle", root / "application")
    with socket.socket() as listener:
        listener.bind(("127.0.0.1", 0))
        port = listener.getsockname()[1]
    invoke(root, "ca", ["openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes",
                        "-days", "2", "-subj", "/CN=RiffDB lifecycle smoke CA",
                        "-keyout", str(root / "ca.key"), "-out", str(root / "ca.pem")])
    invoke(root, "leaf", ["openssl", "req", "-newkey", "rsa:2048", "-nodes",
                          "-subj", "/CN=localhost", "-keyout", str(root / "server.key"),
                          "-out", str(root / "server.csr")])
    write(root, "server.ext", "subjectAltName=DNS:localhost,IP:127.0.0.1\nextendedKeyUsage=serverAuth\n")
    invoke(root, "certificate", ["openssl", "x509", "-req", "-days", "2", "-sha256",
                                 "-in", str(root / "server.csr"), "-CA", str(root / "ca.pem"),
                                 "-CAkey", str(root / "ca.key"), "-CAcreateserial",
                                 "-extfile", str(root / "server.ext"), "-out", str(root / "server.pem")])
    write(root, "capability.keys", "riffdb-capability-digest-keys-v1\n1:" + os.urandom(32).hex() + "\n")
    write(root, "idempotency.keys", "riffdb-idempotency-digest-keys-v1\n1:" + os.urandom(32).hex() + "\n")
    retention_document = ("[databases.default.retention]\nretained_sequences = 32768\n"
                          "sequences_per_epoch = 256\n") if args.online_retention else ""
    quote = lambda name: json.dumps(str(root / name))
    config = write(root, "server.toml", f'''[server]
audience = "riffdb-ticketdesk-lifecycle"
capability_keys = {quote("capability.keys")}
idempotency_keys = {quote("idempotency.keys")}
[server.application_listener]
mode = "direct_tls"
listen = "127.0.0.1:{port}"
public_endpoint = "https://127.0.0.1:{port}"
certificate_chain = {quote("server.pem")}
private_key = {quote("server.key")}
[databases.default]
path = {quote("data/ticketdesk.redb")}
backup_root = {quote("backups")}
projections_root = {quote("projections")}
environment = "development"
[databases.default.outbox]
kind = "durable_local"
directory = {quote("archive")}
quota_encoded_bytes = {archive_quota}
{retention_document}
''')
    client = write(root, "client.toml", f'''[client]
endpoint = "https://127.0.0.1:{port}"
database = "default"
output = "json"
max_attempts = 1
tls_trust_root = {quote("ca.pem")}
tls_server_name = "127.0.0.1"
''')
    invoke(root, "descriptor", [worker, "descriptor"])
    require((root / "descriptor.stdout").stat().st_size <= 4096, "descriptor")
    descriptor = read_json(root / "descriptor.stdout", 4096)
    require(descriptor.get("schema") == "riffdb.ticketdesk-lifecycle-descriptor/v1"
            and type(descriptor.get("projection_id")) is int and descriptor["projection_id"] > 0, "descriptor")
    bootstrap = write(root, "bootstrap.json", json.dumps({
        "principal_id": "lifecycle-smoke-operator", "actor_kind": "human",
        "requested_lifetime_seconds": lifetime, "audiences": ["riffdb-ticketdesk-lifecycle"],
        "grant": {"tenant_scope": {"type": "global"}, "partition_scope": {"type": "all"},
                  "permissions": [{"type": permission} for permission in (
                      "validate_contract", "read_contract", "deploy_contract")] + [
                      {"type": "query_projection", "contract_lineage": "TicketDeskLifecycle",
                       "stable_id": descriptor["projection_id"]}] + [
                      {"type": permission} for permission in ("read_health", "read_statistics", "create_capability",
                                                               "revoke_capability", "administer_capabilities")] + [
                      {"type": "seek_event_stream_consumer", "contract_lineage": "TicketDeskLifecycle",
                       "reactive_module_hash": module, "operation_name": "TicketEvents"}
                      for module in sorted((descriptor["reactive_v1"], descriptor["reactive_v2"]))],
                  "field_visibility": [], "max_scan_rows": 50, "approval_required": []},
    }))
    ready = queue.Queue(maxsize=1)
    observer = None
    observer_pump = None
    latest = queue.Queue(maxsize=1)
    inventory = InventoryMonitor(root / "data") if args.online_retention else None
    with (root / "server.stderr").open("xb") as errors:
        server = ObservedProcess([server_binary, "--config", str(config)],
                                  observation=root / "server.process-usage.json",
                                  stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=errors)
        pump = threading.Thread(target=pump_ready, args=(server, root, ready), daemon=True)
        pump.start()
        try:
            require(ready.get(timeout=30) is True, "startup")
            if inventory:
                inventory.start()
            base = [cli, "--config", str(client)]
            invoke(root, "bootstrap", base + ["capability", "bootstrap", "--request", str(bootstrap),
                   "--generate", str(root / "bootstrap.credential"),
                   "--bearer-output", str(root / "operator.credential")])
            base += ["--credential-file", str(root / "operator.credential")]
            source = root / "application/riffdb.application.json"
            invoke(root, "deploy", base + ["application", "deploy", str(source),
                   "--lock", "riffdb.application.lock.json"])
            for role, name in (("TicketDeskLifecycleSeeder", "seed"),
                               ("TicketDeskLifecycleApplication", "application")):
                invoke(root, "bind-" + name, base + ["role", "bind", str(source), "--role", role,
                       "--principal", "lifecycle-smoke-" + name, "--actor-kind", "service",
                       "--audience", "riffdb-ticketdesk-lifecycle", "--lifetime-seconds", str(lifetime),
                       "--credential-output", str(root / (name + ".credential"))])
            environment = dict(os.environ,
                RIFFDB_LIFECYCLE_ENDPOINT=f"https://127.0.0.1:{port}",
                RIFFDB_LIFECYCLE_CA=str(root / "ca.pem"),
                RIFFDB_LIFECYCLE_SEED_CREDENTIAL=str(root / "seed.credential"),
                RIFFDB_LIFECYCLE_APPLICATION_CREDENTIAL=str(root / "application.credential"),
                RIFFDB_LIFECYCLE_OPERATOR_CREDENTIAL=str(root / "operator.credential"))
            if args.archive_witness or args.prepare_campaign_control:
                environment["RIFFDB_LIFECYCLE_WITNESS_ROOT"] = str(root)
            if args.prepare_successor or args.prepare_campaign_control:
                successor = root / "successor"
                shutil.copytree(root / "application", successor)
                (successor / "riffdb.application.lock.json").unlink()
                shutil.rmtree(successor / "generated")
                shutil.copyfile(repository / "fixtures/ticketdesk_lifecycle/additive-v2.riff",
                                successor / "riffdb/contract.riff")
                manifest_path = successor / "riffdb.application.json"
                manifest = read_json(manifest_path)
                manifest["contract"]["version"] = 2
                manifest_path.write_text(json.dumps(manifest, indent=2) + "\n")
                invoke(root, "successor-lock", base + ["application", "lock", "--write",
                       str(manifest_path), "--lock", "riffdb.application.lock.json"])
                invoke(root, "successor-check", base + ["application", "lock", "--check",
                       str(manifest_path), "--lock", "riffdb.application.lock.json"])
                if args.prepare_successor:
                    print("Exact-parent successor closure generated privately; no campaign qualification claimed.")
                    return 0
            if args.prepare_campaign_control:
                maintenance_request = write(root, "maintenance-principal.json", json.dumps({
                    "principal_id": "lifecycle-campaign-maintenance", "actor_kind": "human",
                    "requested_lifetime_seconds": lifetime,
                    "audiences": ["riffdb-ticketdesk-lifecycle"],
                    "grant": {"tenant_scope": {"type": "global"}, "partition_scope": {"type": "all"},
                              "permissions": [{"type": "administer_capabilities"}],
                              "field_visibility": [], "max_scan_rows": 1, "approval_required": []},
                }))
                invoke(root, "maintenance-principal-create", base + ["capability", "create",
                    "--request", str(maintenance_request), "--credential-output",
                    str(root / "maintenance.credential")])
                created = read_json(root / "maintenance-principal-create.stdout", 4096)
                require(created.get("schema") == "riffdb.cli.output/v1"
                        and created.get("command") == "capability.create"
                        and created.get("ok") is True and created["result"]["status"] == "created",
                        "campaign_maintenance_principal")
                require(not (root / "seed.witness").exists()
                        and not (root / "updates.witness").exists(), "campaign_controls_fresh")
                write(root, "campaign-control.json", json.dumps({
                    "schema": "riffdb.ticketdesk-lifecycle-control-preparation/v1",
                    "seeded_tickets": 0, "offered_updates": 0,
                    "capability_lifetime_seconds": lifetime, "archive_quota_encoded_bytes": archive_quota,
                    "qualifies_campaign": False}, sort_keys=True) + "\n")
                print("Fresh campaign controls prepared; the original observer must precede seeding.")
                return 0
            if args.observe:
                if args.population_probe_seconds:
                    environment["RIFFDB_LIFECYCLE_DEFER_LIVE"] = "1"
                environment["RIFFDB_LIFECYCLE_OBSERVER_STOP"] = str(root / "observer.stop")
                observer_ready = queue.Queue(maxsize=1)
                with (root / "observer.stderr").open("xb") as observer_errors:
                    observer = ObservedProcess([worker, "observe"], env=environment,
                                                observation=root / "observer.process-usage.json",
                                                stdout=subprocess.PIPE, stderr=observer_errors)
                observer_pump = threading.Thread(target=pump_observer,
                    args=(observer, root, observer_ready, latest), daemon=True)
                observer_pump.start()
                require(observer_ready.get(timeout=30) is True, "observer_startup")
            if args.population_probe_seconds:
                environment["RIFFDB_LIFECYCLE_WITNESS_ROOT"] = str(root)
                invoke(root, "seed", [worker, "seed"], environment=environment, timeout=1200)
                drain_archive(root, "seed", base, server, observer)
                if observer:
                    write(root, "live.start", "start\n")
                    deadline = time.monotonic() + 120
                    while True:
                        remaining = deadline - time.monotonic()
                        require(remaining > 0 and observer.poll() is None, "observer_live_start")
                        observed = latest.get(timeout=remaining)
                        require(observed["events_checked"] <= 1024, "observer_seed_events")
                        if observed["live_updates"] > 0 and observed["events_checked"] == 1024:
                            break
                environment["RIFFDB_LIFECYCLE_DURATION_SECONDS"] = str(args.population_probe_seconds)
                environment["RIFFDB_LIFECYCLE_LOAD_CONTROL"] = str(root)
                projection_identity = {"contract_lineage": "TicketDeskLifecycle",
                    "projection_id": descriptor["projection_id"],
                    "projection_plan_hash": descriptor["projection_plan_hash"]}
                projection_sampler = (NativeProjectionSampler(root, worker, environment, projection_identity,
                    args.population_probe_seconds) if args.native_observations else
                    ProjectionSampler(root, base, projection_identity, args.population_probe_seconds))
                try:
                    if args.sink_outage:
                        with LocalArchiveOutage(root / "archive") as custody:
                            sink = SinkOutagePreparation(root, base, custody)
                            observed_load(root, worker, environment, args.population_probe_seconds,
                                          observer, latest, False, sink=sink, projection=projection_sampler,
                                          server=server,
                                          collect_source_bytes=args.online_retention and args.native_observations)
                    else:
                        observed_load(root, worker, environment, args.population_probe_seconds,
                                      observer, latest, args.consumer_outage, projection=projection_sampler,
                                      server=server,
                                      collect_source_bytes=args.online_retention and args.native_observations)
                finally:
                    projection_sampler.stop()
                environment["RIFFDB_LIFECYCLE_COMPLETED_COMMANDS"] = str(args.population_probe_seconds * 100)
                environment["RIFFDB_LIFECYCLE_RECONCILIATION_WITNESS"] = str(root / "updates.witness")
                invoke(root, "reconciliation", [worker, "reconcile"], environment=environment, timeout=900)
                drain_archive(root, "load", base, server, observer, maximum=600)
                require((root / "load.stdout").stat().st_size <= 65536, "probe_observation")
                samples = [json.loads(line) for line in (root / "load.stdout").read_bytes().splitlines()]
                require(samples[0]["schema"] == "riffdb.ticketdesk-lifecycle-load-ready/v1", "probe_observation")
                windows = samples[1:-1]
                require(len(windows) == (args.population_probe_seconds // 300 if outage_mode else 1),
                        "probe_observation")
                normal_windows = 0
                for index, window in enumerate(windows):
                    start, end = index * 300, min((index + 1) * 300, args.population_probe_seconds)
                    require(window["start_s"] == start and window["end_s"] == end, "probe_observation")
                    require(window["completed_commands"] == window["offered_commands"] == (end - start) * 100
                            and window["completed_reads"] == window["offered_reads"] == (end - start) * 400,
                            "probe_rate")
                    fault = False
                    if outage_mode:
                        name = "consumer-outage.json" if args.consumer_outage else "sink-outage.json"
                        outage = read_json(root / name, 4096)
                        fault = outage_window(start, end, outage)
                    if not fault:
                        normal_windows += 1
                        require(window["p95_us"] < 100000 and window["p99_us"] < 250000, "probe_latency")
                    require(window["load_peak_in_flight"] <= 28 and window["reserved_auxiliary_slots"] == 4,
                            "probe_concurrency")
                require(normal_windows > 0, "probe_normal_window")
                final = samples[-1]
                require(final["schema"] == "riffdb.ticketdesk-lifecycle-load-stopped/v1"
                        and final["post_duration_updates"] == 0 and final["post_duration_reads"] == 0,
                        "probe_drain")
            else:
                invoke(root, "worker", [worker, "smoke"], environment=environment)
                require((root / "worker.stdout").stat().st_size <= 4096, "worker_observation")
                observation = read_json(root / "worker.stdout", 4096)
                require(observation == {
                    "schema": "riffdb.ticketdesk-lifecycle-smoke/v1", "caller_fence": True,
                    "idempotency": True, "state_reconciled": True, "partition_isolation": True,
                    "events_reconciled": True, "live_query_snapshot": True,
                }, "worker_observation")
            if driver_binary:
                typescript_smoke(root, repository, driver_binary, port, python_native)
            invoke(root, "projection-health", base + ["server", "health"])
            health = read_json(root / "projection-health.stdout")
            frontier = health["result"]["last_commit_sequence"]
            query_input = write(root, "projection-input.json", json.dumps({"leading_components": [
                {"type": "uuid", "value": "01900000-0000-7000-8001-000000000000"}]}))
            invoke(root, "projection-query", base + ["projection", "query", str(descriptor["projection_id"]),
                   "--contract-lineage", "TicketDeskLifecycle", "--contract-version", "1",
                   "--input", str(query_input), "--after", str(frontier),
                   "--wait-nanos", "30000000000", "--limit", "1"])
            projection = read_json(root / "projection-query.stdout")
            validate_projection(projection, descriptor["projection_id"], int(frontier),
                                args.population_probe_seconds * 100 if args.population_probe_seconds else 1,
                                descriptor["projection_plan_hash"])
            if observer:
                updates = args.population_probe_seconds * 100
                expected_events = 1024 + (updates // 65536) * 1024 + min(updates % 65536, 1024) if updates else 2
                deadline = time.monotonic() + 30
                while True:
                    remaining = deadline - time.monotonic()
                    require(remaining > 0 and observer.poll() is None, "observer_reconciliation")
                    observed = latest.get(timeout=remaining)
                    require(observed["events_checked"] <= expected_events
                            and observed["auxiliary_slots"] == 2, "observer_reconciliation")
                    if observed["events_checked"] == expected_events and observed["live_head"] >= int(frontier):
                        require(observed["live_updates"] > 1 and observed["duplicates"] == 0,
                                "observer_reconciliation")
                        if not args.population_probe_seconds and observed["live_renewals"] == 0:
                            continue
                        require(observed["live_renewals"] > 0, "observer_live_renewal")
                        break
            if args.restart_recovery:
                server, pump = interrupted_update(root, args.restart_recovery, worker, environment,
                    server, pump, server_binary, config)
            if args.capability_rotation:
                original = read_json(root / "bind-application.stdout")
                capability = original["result"]["transition"]["identity"]["capability_id"]
                invoke(root, "bind-replacement", base + ["role", "bind", str(source),
                    "--role", "TicketDeskLifecycleApplication", "--principal", "lifecycle-smoke-application",
                    "--actor-kind", "service", "--audience", "riffdb-ticketdesk-lifecycle",
                    "--lifetime-seconds", "3600", "--credential-output", str(root / "replacement.credential")])
                invoke(root, "revoke-original", base + ["capability", "revoke", capability, "--reason", "replaced"])
                environment["RIFFDB_LIFECYCLE_REVOKED_CREDENTIAL"] = str(root / "application.credential")
                environment["RIFFDB_LIFECYCLE_APPLICATION_CREDENTIAL"] = str(root / "replacement.credential")
                invoke(root, "rotation-worker", [worker, "rotation-smoke"], environment=environment)
                require(read_json(root / "rotation-worker.stdout", 4096) == {
                    "schema": "riffdb.ticketdesk-lifecycle-rotation-smoke/v1",
                    "revoked_reads_refused": True, "revoked_replay_refused": True,
                    "same_principal_replay": True, "state_reconciled": True}, "rotation_observation")
            if args.additive_deploy:
                require(not args.population_probe_seconds, "successor_preparation_mode")
                handover = None
                if observer:
                    write(root, "observer.quiesce", "quiesce\n")
                    deadline = time.monotonic() + 15
                    while not (root / "observer.quiesced").is_file():
                        require(time.monotonic() < deadline and observer.poll() is None,
                                "observer_quiescence")
                        threading.Event().wait(0.05)
                    handover = read_json(root / "observer.quiesced", 4096)
                    require(handover["schema"] == "riffdb.ticketdesk-lifecycle-observer-quiesced/v1"
                            and handover["generation"] == handover["contract_version"] == 1
                            and handover["events_checked"] == 2 and handover["duplicates"] == 0,
                            "observer_handover")
                    consumer_args = ["--operation", "TicketEvents", "--consumer-name",
                        "ticketdesk-lifecycle-campaign", "--parameter",
                        'organization_id={"type":"uuid","value":"01900000-0000-7000-8001-000000000000"}']
                    invoke(root, "retire-parent-consumer", base + ["event", "retire",
                        "--module-hash", descriptor["reactive_v1"], *consumer_args])
                    retired = read_json(root / "retire-parent-consumer.stdout")
                    require(retired.get("schema") == "riffdb.cli.output/v1"
                            and retired.get("command") == "event.retire" and retired["ok"] is True
                            and retired["result"] == {"result": "applied"},
                            "consumer_retirement")
                successor = root / "successor"
                shutil.copytree(repository / "examples/ticketdesk/lifecycle-v2", successor)
                source_v2 = successor / "riffdb.application.json"
                invoke(root, "additive-deploy", base + ["application", "deploy", str(source_v2),
                       "--lock", "riffdb.application.lock.json"])
                deployment = read_json(root / "additive-deploy.stdout")
                require(deployment.get("schema") == "riffdb.cli.output/v1"
                        and deployment.get("command") == "application.deploy" and deployment.get("ok") is True
                        and deployment["result"]["contract_version"] == "2", "additive_activation")
                invoke(root, "bind-successor", base + ["role", "bind", str(source_v2),
                       "--role", "TicketDeskLifecycleApplication", "--principal", "lifecycle-smoke-application",
                       "--actor-kind", "service", "--audience", "riffdb-ticketdesk-lifecycle",
                       "--lifetime-seconds", "3600", "--credential-output", str(root / "application-v2.credential")])
                environment["RIFFDB_LIFECYCLE_CONTRACT_VERSION"] = "2"
                environment["RIFFDB_LIFECYCLE_APPLICATION_CREDENTIAL"] = str(root / "application-v2.credential")
                if observer:
                    app2base = [cli, "--config", str(client), "--credential-file",
                                str(root / "application-v2.credential")]
                    invoke(root, "register-successor-consumer", app2base + ["event", "consume",
                        "--module-hash", descriptor["reactive_v2"], *consumer_args,
                        "--batch-limit", "1", "--in-flight-limit", "1", "--lease-seconds", "60",
                        "--wait-nanos", "0"])
                    registered = read_json(root / "register-successor-consumer.stdout")
                    require(registered.get("schema") == "riffdb.cli.output/v1"
                            and registered.get("command") == "event.consume" and registered["ok"] is True
                            and isinstance(registered["result"]["events"], list)
                            and len(registered["result"]["events"]) <= 1, "consumer_handover_registration")
                    for delivery in registered["result"]["events"]:
                        require(delivery["history_incarnation"] == str(handover["history_incarnation"])
                                and int(delivery["event_id"].split(":")[0]) <= handover["consumer_checkpoint"],
                                "consumer_handover_registered_prefix")
                        invoke(root, "release-successor-lease", app2base + ["event", "nack",
                            "--module-hash", descriptor["reactive_v2"], *consumer_args,
                            "--event-id", delivery["event_id"], "--lease-token", delivery["lease_token"],
                            "--history-incarnation", delivery["history_incarnation"],
                            "--retry-delay-nanos", "0"])
                        released = read_json(root / "release-successor-lease.stdout")
                        require(released.get("schema") == "riffdb.cli.output/v1"
                                and released.get("command") == "event.nack" and released["ok"] is True
                                and released["result"] == {"result": "applied"},
                                "consumer_handover_lease_release")
                    invoke(root, "seek-successor-consumer", base + ["event", "seek",
                        "--module-hash", descriptor["reactive_v2"], *consumer_args,
                        "--checkpoint", str(handover["consumer_checkpoint"]) + ":0"])
                    sought = read_json(root / "seek-successor-consumer.stdout")
                    require(sought.get("schema") == "riffdb.cli.output/v1"
                            and sought.get("command") == "event.seek" and sought["ok"] is True
                            and sought["result"] == {"result": "applied"}, "consumer_handover_seek")
                    write(root, "load.phase", "2 2 1 application-v2.credential\n")
                    (root / "observer.quiesce").unlink()
                    deadline = time.monotonic() + 15
                    while True:
                        remaining = deadline - time.monotonic()
                        require(remaining > 0 and observer.poll() is None, "observer_handover")
                        resumed = latest.get(timeout=remaining)
                        if resumed["release_generation"] == 2 and not resumed["observer_quiesced"]:
                            require(resumed["events_checked"] == 2
                                    and resumed["history_incarnation"] == handover["history_incarnation"],
                                    "observer_handover_continuity")
                            break
                invoke(root, "successor-worker", [worker, "successor-smoke"], environment=environment)
                require(read_json(root / "successor-worker.stdout", 4096) == {
                    "schema": "riffdb.ticketdesk-lifecycle-successor-smoke/v1", "contract_version": 2,
                    "caller_fence": True, "idempotency": True, "state_reconciled": True,
                    "partition_isolation": True}, "successor_observation")
                if observer:
                    deadline = time.monotonic() + 15
                    while True:
                        remaining = deadline - time.monotonic()
                        require(remaining > 0 and observer.poll() is None, "successor_events")
                        observed = latest.get(timeout=remaining)
                        require(observed["events_checked"] <= 3 and observed["duplicates"] == 0,
                                "successor_events")
                        if observed["events_checked"] == 3:
                            break
                if driver_binary:
                    successor_smoke = root / "successor-smoke"
                    successor_smoke.mkdir(mode=0o700)
                    shutil.copytree(successor, successor_smoke / "application")
                    shutil.copyfile(root / "ca.pem", successor_smoke / "ca.pem")
                    shutil.copyfile(root / "application-v2.credential", successor_smoke / "application.credential")
                    typescript_smoke(successor_smoke, repository, driver_binary, port, python_native)
        finally:
            primary_error = sys.exception()
            cleanup_failures = []
            inventory_failed = False
            if inventory:
                try:
                    inventory.close()
                except (InventoryError, OSError):
                    inventory_failed = True
            observer_failed = False
            if observer:
                write(root, "observer.stop", "stop\n")
                try:
                    observer.wait(timeout=15)
                except subprocess.TimeoutExpired:
                    observer.kill()
                    observer.wait(timeout=5)
                    observer_failed = True
                observer_pump.join(timeout=5)
                observer_failed |= observer.returncode != 0 or observer_pump.is_alive()
            if server.poll() is None:
                server.terminate()
            try:
                server.stdin.close()
            except OSError:
                cleanup_failures.append("shutdown")
            try:
                server.wait(timeout=30)
            except subprocess.TimeoutExpired:
                server.kill()
                server.wait(timeout=5)
                cleanup_failures.append("shutdown")
            pump.join(timeout=5)
            if pump.is_alive() or server.returncode != 0:
                cleanup_failures.append("shutdown")
            if observer_failed:
                cleanup_failures.append("observer_shutdown")
            if inventory_failed:
                cleanup_failures.append("inventory_failed")
            if cleanup_failures:
                if primary_error is None:
                    raise SmokeError(cleanup_failures[0])
                for code in sorted(set(cleanup_failures)):
                    print("ticketdesk-lifecycle-smoke: cleanup_" + code, file=sys.stderr)
    if inventory:
        inventory.finish(root)
    if args.archive_witness or args.population_probe_seconds:
        invoke(root, "archive-reconciliation", [worker, "archive-reconcile"],
               environment=environment, timeout=900)
        archived = read_json(root / "archive-reconciliation.stdout", 4096)
        expected = 65536 + args.population_probe_seconds * 100 if args.population_probe_seconds else 2
        require(archived["schema"] == "riffdb.ticketdesk-lifecycle-archive-reconciliation/v1"
                and archived["records_checked"] == expected and archived["payloads_reconciled"] is True
                and archived["policy_anchors_reconciled"] is True, "archive_reconciliation")
    if args.population_probe_seconds:
        print("Population load preparation and full state reconciliation passed; no campaign qualification claimed.")
    else:
        print("Generated TicketDesk lifecycle public TLS smoke passed; no campaign qualification claimed.")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (SmokeError, NativeObservationError, InventoryError, FaultError, ResourceError, ProviderBudgetError) as error:
        print("ticketdesk-lifecycle-smoke: " + str(error), file=sys.stderr)
        sys.exit(1)
    except (OSError, ValueError, TypeError, KeyError, queue.Empty, subprocess.SubprocessError):
        print("ticketdesk-lifecycle-smoke: failed; inspect private preparation logs", file=sys.stderr)
        sys.exit(1)
