#!/usr/bin/env python3
# req: END-001, END-002, END-003, END-004, END-007, END-008
"""Run the generated lifecycle client in an owned TLS preparation database.

This is a semantic smoke test, not a campaign receipt or host qualification.
Artifacts, credentials and diagnostic logs remain in the private supplied root.
"""

import argparse
import hashlib
import json
import os
from pathlib import Path
import queue
import shutil
import socket
import subprocess
import sys
import threading
import time


class SmokeError(ValueError):
    """Closed diagnostic; input paths and child output stay in private files."""


def require(condition, code):
    if not condition:
        raise SmokeError(code)


def write(root, name, value):
    path = root / name
    with path.open("x") as output:
        os.chmod(path, 0o600)
        output.write(value)
    return path


def invoke(root, name, arguments, *, environment=None, timeout=60):
    with (root / (name + ".stdout")).open("xb") as output, \
            (root / (name + ".stderr")).open("xb") as errors:
        result = subprocess.run(arguments, stdout=output, stderr=errors,
                                env=environment, timeout=timeout, check=False)
    require(result.returncode == 0, name)


def pump_ready(server, root, ready):
    sent = False
    with (root / "server.stdout").open("xb") as output:
        while line := server.stdout.readline(4097):
            output.write(line)
            output.flush()
            if not sent and line.startswith(b"riffdbd-ready-v1"):
                ready.put_nowait(True)
                sent = True
            if len(line) > 4096:
                if not sent:
                    ready.put_nowait(False)
                return
        if not sent:
            ready.put_nowait(False)


def typescript_smoke(root, repository, driver_binary, port):
    runtime = repository / "clients/typescript/runtime"
    compiler = runtime / "node_modules/.bin/tsc"
    require(compiler.is_file() and (runtime / "dist/index.js").is_file(), "typescript_runtime")
    stage = root / "typescript"
    stage.mkdir(mode=0o700)
    shutil.copyfile(repository / "examples/ticketdesk/lifecycle/typescript/smoke.ts", stage / "smoke.ts")
    shutil.copyfile(root / "application/generated/typescript/client.ts", stage / "client.ts")
    write(stage, "package.json", '{"type":"module"}\n')
    modules = stage / "node_modules"
    (modules / "@riffdb").mkdir(parents=True, mode=0o700)
    (modules / "@riffdb/application").symlink_to(runtime, target_is_directory=True)
    (modules / "@types").symlink_to(runtime / "node_modules/@types", target_is_directory=True)
    invoke(root, "typescript-build", [str(compiler), str(stage / "smoke.ts"),
           "--target", "ES2022", "--module", "NodeNext", "--moduleResolution", "NodeNext",
           "--strict", "--noUncheckedIndexedAccess", "--exactOptionalPropertyTypes",
           "--types", "node", "--typeRoots", str(runtime / "node_modules/@types"),
           "--outDir", str(stage / "dist")])
    lock = json.loads((root / "application/riffdb.application.lock.json").read_bytes())
    role = next(role for role in lock["roles"] if role["definition"]["name"] == "TicketDeskLifecycleApplication")
    catalog = next(artifact for artifact in lock["artifacts"] if artifact["kind"] == "mcp")
    endpoint = f"https://127.0.0.1:{port}"
    identity = {"applicationManifestHash": lock["exact_manifest_hash"],
                "operationCatalogHash": catalog["content_hash"],
                "contractLineage": "TicketDeskLifecycle", "contractVersion": 1,
                "contractBundleHash": lock["contract"]["bundle_hash"], "database": "default",
                "role": "TicketDeskLifecycleApplication", "roleDefinitionHash": role["definition_hash"],
                "remoteIdentityHash": hashlib.sha256((endpoint + "|127.0.0.1").encode()).hexdigest()}
    write(root, "application.identity.json", json.dumps(identity))
    quote = lambda name: json.dumps(str(root / name))
    config = write(root, "application-driver.toml", f'''[driver]
socket = {quote("application.sock")}
[application]
lock_file = {quote("application/riffdb.application.lock.json")}
manifest_file = {quote("application/generated/riffdb.application.exact.json")}
operation_catalog_file = {quote("application/generated/mcp/tools.json")}
database = "default"
role = "TicketDeskLifecycleApplication"
[remote]
endpoint = "{endpoint}"
tls_trust_root = {quote("ca.pem")}
tls_server_name = "127.0.0.1"
credential_file = {quote("application.credential")}
pool_connections = 1
streams_per_connection = 4
''')
    with (root / "driver.stdout").open("xb") as output, (root / "driver.stderr").open("xb") as errors:
        driver = subprocess.Popen([str(driver_binary), str(config)], stdout=output, stderr=errors)
        try:
            deadline = time.monotonic() + 30
            while not (root / "application.sock").is_socket() and driver.poll() is None:
                require(time.monotonic() < deadline, "driver_startup")
                threading.Event().wait(0.05)
            require(driver.poll() is None and (root / "application.sock").is_socket(), "driver_startup")
            invoke(root, "typescript-smoke", ["node", str(stage / "dist/smoke.js"), str(root)])
            result = root / "typescript-smoke.stdout"
            require(result.stat().st_size <= 4096, "typescript_observation")
            require(json.loads(result.read_bytes()) == {
                "schema": "riffdb.ticketdesk-lifecycle-typescript-smoke/v1", "named_read": True,
                "partition_isolation": True, "caller_fence": True, "idempotency": True,
                "state_unchanged": True, "live_query_snapshot": True}, "typescript_observation")
        finally:
            if driver.poll() is None:
                driver.terminate()
            try:
                driver.wait(timeout=15)
            except subprocess.TimeoutExpired:
                driver.kill()
                driver.wait(timeout=5)
                raise SmokeError("driver_shutdown")
            require(driver.returncode == 0, "driver_shutdown")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", required=True, type=Path)
    parser.add_argument("--server", required=True, type=Path)
    parser.add_argument("--cli", required=True, type=Path)
    parser.add_argument("--worker", required=True, type=Path)
    parser.add_argument("--driver", type=Path, help="also exercise retained TypeScript bindings through native Rust driver")
    parser.add_argument("--population-probe-seconds", type=int, default=0,
                        help="fresh 65536-ticket load preparation; never a campaign receipt")
    args = parser.parse_args()
    require(0 <= args.population_probe_seconds <= 300, "probe_duration")
    root = args.root
    require(root.is_absolute() and root.resolve() == root and not root.exists(), "root")
    require(root.parent.is_dir(), "root")
    executables = [path.resolve(strict=True) for path in (args.server, args.cli, args.worker)]
    require(all(path.is_file() and os.access(path, os.X_OK) for path in executables), "binary")
    server_binary, cli, worker = map(str, executables)
    driver_binary = args.driver.resolve(strict=True) if args.driver else None
    if driver_binary:
        require(driver_binary.is_file() and os.access(driver_binary, os.X_OK), "driver_binary")
    os.umask(0o077)
    root.mkdir(mode=0o700)
    for directory in ("data", "backups", "projections", "archive"):
        (root / directory).mkdir(mode=0o700)
    repository = Path(__file__).resolve().parent.parent
    shutil.copytree(repository / "examples/ticketdesk/lifecycle", root / "application")
    with socket.socket() as listener:
        listener.bind(("127.0.0.1", 0))
        port = listener.getsockname()[1]
    invoke(root, "ca", ["openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes",
                        "-days", "2", "-subj", "/CN=RiffDB lifecycle smoke CA",
                        "-keyout", str(root / "ca.key"), "-out", str(root / "ca.pem")])
    invoke(root, "leaf", ["openssl", "req", "-newkey", "rsa:2048", "-nodes",
                          "-subj", "/CN=localhost", "-keyout", str(root / "server.key"),
                          "-out", str(root / "server.csr")])
    write(root, "server.ext", "subjectAltName=DNS:localhost,IP:127.0.0.1\nextendedKeyUsage=serverAuth\n")
    invoke(root, "certificate", ["openssl", "x509", "-req", "-days", "2", "-sha256",
                                 "-in", str(root / "server.csr"), "-CA", str(root / "ca.pem"),
                                 "-CAkey", str(root / "ca.key"), "-CAcreateserial",
                                 "-extfile", str(root / "server.ext"), "-out", str(root / "server.pem")])
    write(root, "capability.keys", "riffdb-capability-digest-keys-v1\n1:" + os.urandom(32).hex() + "\n")
    write(root, "idempotency.keys", "riffdb-idempotency-digest-keys-v1\n1:" + os.urandom(32).hex() + "\n")
    quote = lambda name: json.dumps(str(root / name))
    config = write(root, "server.toml", f'''[server]
audience = "riffdb-ticketdesk-lifecycle"
capability_keys = {quote("capability.keys")}
idempotency_keys = {quote("idempotency.keys")}
[server.application_listener]
mode = "direct_tls"
listen = "127.0.0.1:{port}"
public_endpoint = "https://127.0.0.1:{port}"
certificate_chain = {quote("server.pem")}
private_key = {quote("server.key")}
[databases.default]
path = {quote("data/ticketdesk.redb")}
backup_root = {quote("backups")}
projections_root = {quote("projections")}
environment = "development"
[databases.default.outbox]
kind = "durable_local"
directory = {quote("archive")}
quota_encoded_bytes = 1073741824
''')
    client = write(root, "client.toml", f'''[client]
endpoint = "https://127.0.0.1:{port}"
database = "default"
output = "json"
max_attempts = 1
tls_trust_root = {quote("ca.pem")}
tls_server_name = "127.0.0.1"
''')
    bootstrap = write(root, "bootstrap.json", json.dumps({
        "principal_id": "lifecycle-smoke-operator", "actor_kind": "human",
        "requested_lifetime_seconds": 3600, "audiences": ["riffdb-ticketdesk-lifecycle"],
        "grant": {"tenant_scope": {"type": "global"}, "partition_scope": {"type": "all"},
                  "permissions": [{"type": permission} for permission in (
                      "validate_contract", "read_contract", "deploy_contract", "read_health",
                      "create_capability", "revoke_capability", "administer_capabilities")],
                  "field_visibility": [], "max_scan_rows": 50, "approval_required": []},
    }))
    ready = queue.Queue(maxsize=1)
    with (root / "server.stderr").open("xb") as errors:
        server = subprocess.Popen([server_binary, "--config", str(config)],
                                  stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=errors)
        pump = threading.Thread(target=pump_ready, args=(server, root, ready), daemon=True)
        pump.start()
        try:
            require(ready.get(timeout=30) is True, "startup")
            base = [cli, "--config", str(client)]
            invoke(root, "bootstrap", base + ["capability", "bootstrap", "--request", str(bootstrap),
                   "--generate", str(root / "bootstrap.credential"),
                   "--bearer-output", str(root / "operator.credential")])
            base += ["--credential-file", str(root / "operator.credential")]
            source = root / "application/riffdb.application.json"
            invoke(root, "deploy", base + ["application", "deploy", str(source),
                   "--lock", "riffdb.application.lock.json"])
            for role, name in (("TicketDeskLifecycleSeeder", "seed"),
                               ("TicketDeskLifecycleApplication", "application")):
                invoke(root, "bind-" + name, base + ["role", "bind", str(source), "--role", role,
                       "--principal", "lifecycle-smoke-" + name, "--actor-kind", "service",
                       "--audience", "riffdb-ticketdesk-lifecycle", "--lifetime-seconds", "3600",
                       "--credential-output", str(root / (name + ".credential"))])
            environment = dict(os.environ,
                RIFFDB_LIFECYCLE_ENDPOINT=f"https://127.0.0.1:{port}",
                RIFFDB_LIFECYCLE_CA=str(root / "ca.pem"),
                RIFFDB_LIFECYCLE_SEED_CREDENTIAL=str(root / "seed.credential"),
                RIFFDB_LIFECYCLE_APPLICATION_CREDENTIAL=str(root / "application.credential"))
            if args.population_probe_seconds:
                invoke(root, "seed", [worker, "seed"], environment=environment, timeout=1200)
                environment["RIFFDB_LIFECYCLE_DURATION_SECONDS"] = str(args.population_probe_seconds)
                invoke(root, "load", [worker, "probe"], environment=environment,
                       timeout=args.population_probe_seconds + 120)
                environment["RIFFDB_LIFECYCLE_COMPLETED_COMMANDS"] = str(args.population_probe_seconds * 100)
                invoke(root, "reconciliation", [worker, "reconcile"], environment=environment, timeout=900)
                require((root / "load.stdout").stat().st_size <= 65536, "probe_observation")
                samples = [json.loads(line) for line in (root / "load.stdout").read_bytes().splitlines()]
                require(samples[0]["schema"] == "riffdb.ticketdesk-lifecycle-load-ready/v1", "probe_observation")
                windows = samples[1:-1]
                require(len(windows) == 1, "probe_observation")
                window = windows[0]
                require(window["start_s"] == 0 and window["end_s"] == args.population_probe_seconds,
                        "probe_observation")
                require(window["completed_commands"] == window["offered_commands"] == args.population_probe_seconds * 100
                        and window["completed_reads"] == window["offered_reads"] == args.population_probe_seconds * 400,
                        "probe_rate")
                require(window["p95_us"] < 100000 and window["p99_us"] < 250000, "probe_latency")
                require(window["load_peak_in_flight"] <= 28 and window["reserved_auxiliary_slots"] == 4,
                        "probe_concurrency")
                final = samples[-1]
                require(final["schema"] == "riffdb.ticketdesk-lifecycle-load-stopped/v1"
                        and final["post_duration_updates"] == 0 and final["post_duration_reads"] == 0,
                        "probe_drain")
            else:
                invoke(root, "worker", [worker, "smoke"], environment=environment)
                require((root / "worker.stdout").stat().st_size <= 4096, "worker_observation")
                observation = json.loads((root / "worker.stdout").read_bytes())
                require(observation == {
                    "schema": "riffdb.ticketdesk-lifecycle-smoke/v1", "caller_fence": True,
                    "idempotency": True, "state_reconciled": True, "partition_isolation": True,
                    "events_reconciled": True, "live_query_snapshot": True,
                }, "worker_observation")
            if driver_binary:
                typescript_smoke(root, repository, driver_binary, port)
        finally:
            if server.poll() is None:
                server.terminate()
            server.stdin.close()
            try:
                server.wait(timeout=30)
            except subprocess.TimeoutExpired:
                server.kill()
                server.wait(timeout=5)
                raise SmokeError("shutdown")
            pump.join(timeout=5)
            require(not pump.is_alive() and server.returncode == 0, "shutdown")
    if args.population_probe_seconds:
        print("Population load preparation and full state reconciliation passed; no campaign qualification claimed.")
    else:
        print("Generated TicketDesk lifecycle public TLS smoke passed; no campaign qualification claimed.")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except SmokeError as error:
        print("ticketdesk-lifecycle-smoke: " + str(error), file=sys.stderr)
        sys.exit(1)
    except (OSError, ValueError, TypeError, KeyError, queue.Empty, subprocess.SubprocessError):
        print("ticketdesk-lifecycle-smoke: failed; inspect private preparation logs", file=sys.stderr)
        sys.exit(1)
