#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
case "${1:-}" in
    "") mode=--write ;;
    --check) mode=--check ;;
    *) printf 'usage: %s [--check]\n' "$0" >&2; exit 2 ;;
esac
if [[ "$#" -gt 1 ]]; then
    printf 'usage: %s [--check]\n' "$0" >&2
    exit 2
fi
cargo run --quiet --locked -p riffdb-storage-api --example generate_authoritative_catalog -- "$mode"
cargo run --quiet --locked -p riffdb-storage-api --example generate_changelog_fixtures -- "$mode"
