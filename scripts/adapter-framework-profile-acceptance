#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 0 ]]; then
    echo "usage: ./scripts/adapter-framework-profile-acceptance" >&2
    exit 2
fi

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

contract="fixtures/adapters/framework-profile/riffdb/contract.riff"
for forbidden in 'Better Auth' BetterAuth better_auth payload Payload; do
    if rg -q --fixed-strings "$forbidden" "$contract"; then
        echo "framework profile fixture contains framework-specific symbol: $forbidden" >&2
        exit 1
    fi
done

cargo +1.98.1 test -p riffdb-contract-compiler --test framework_profile --quiet
cargo +1.98.1 test -p riffdb-runtime --test runtime framework_profile --quiet
cargo +1.98.1 test -p riffdb-client-rust \
    adapter_minted_idempotency_survives_driver_retries_with_fresh_transport_ids \
    --quiet
# An exact filter that matches nothing still exits 0, so every named
# schedule must prove its triggering set is non-empty.
run_exact_concurrency_test() {
    local name="$1" output
    output="$(cargo +1.98.1 test --test command_concurrency "$name" --quiet -- --exact 2>&1)" || {
        printf '%s\n' "$output" >&2
        return 1
    }
    printf '%s\n' "$output"
    if ! grep -q "1 passed" <<<"$output"; then
        echo "expected exactly one exact-match schedule to run: $name" >&2
        return 1
    fi
}

run_exact_concurrency_test \
    equal_scoped_unique_values_commit_once_and_loser_replays_without_sequence
run_exact_concurrency_test \
    create_before_delete_refuses_then_delete_releases_unique_value_for_reinsert
run_exact_concurrency_test \
    framework_profile_declared_refusal_commits_terminally_on_the_v9_bundle

echo "Framework-profile compilation, atomicity, token, workflow, uniqueness, and retry identity: passed"
