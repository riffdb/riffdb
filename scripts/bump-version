#!/usr/bin/env python3
"""Synchronize and validate the canonical RiffDB release version across all manifests."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import re
import shutil
import sys
import tempfile


ROOT = Path(__file__).resolve().parent.parent
SEMVER_RE = re.compile(r"^[0-9]+\.[0-9]+\.[0-9]+$")

JSON_VERSION_FILES = [
    ("release/distribution/manifest-v1.json", "version"),
    ("release/distribution/development-registry-v1.json", "base_version"),
    ("clients/typescript/runtime/package.json", "version"),
    ("clients/editor/tree-sitter-riff/package.json", "version"),
    ("clients/editor/tree-sitter-riffql/package.json", "version"),
    ("clients/editor/vscode-riffdb/package.json", "version"),
]

TOML_VERSION_FILES = [
    "Cargo.toml",
    "release/python/Cargo.sdist.toml",
    "release/python/pyproject.toml",
    "clients/python/runtime/pyproject.toml",
    "release/agent-application-alpha/sdk-Cargo.toml",
    "release/agent-application-alpha/riffdb-api-grpc-client.Cargo.toml",
]


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def load_json(path: Path) -> dict:
    return json.loads(path.read_text(encoding="utf-8"))


def save_json(path: Path, payload: dict) -> None:
    path.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8", newline="\n")


def check_root(root: Path) -> list[str]:
    errors: list[str] = []
    topology_path = root / "release/version-topology-v1.json"
    durable_path = root / "release/durable-format-manifest-v1.json"
    dist_path = root / "release/distribution/manifest-v1.json"

    topology = load_json(topology_path)
    durable = load_json(durable_path)
    dist = load_json(dist_path)

    version = topology.get("release")
    if not isinstance(version, str) or not SEMVER_RE.fullmatch(version):
        return [f"invalid canonical release version in {topology_path}: {version!r}"]

    if durable.get("release") != version:
        errors.append(
            f"release/durable-format-manifest-v1.json release {durable.get('release')!r} != {version!r}"
        )

    durable_sha = sha256(durable_path)
    dist_durable = dist.get("durable_format", {})
    if dist_durable.get("sha256") != durable_sha:
        errors.append(
            "release/distribution/manifest-v1.json durable_format.sha256 drifted from release/durable-format-manifest-v1.json"
        )

    for rel_path, field in JSON_VERSION_FILES:
        target = root / rel_path
        if not target.is_file():
            continue
        data = load_json(target)
        actual = data.get(field)
        if actual != version:
            errors.append(f"{rel_path} {field}={actual!r} != {version!r}")

    for rel_path in TOML_VERSION_FILES:
        target = root / rel_path
        if not target.is_file():
            continue
        text = target.read_text(encoding="utf-8")
        if f'version = "{version}"' not in text:
            errors.append(f'{rel_path} does not declare version = "{version}"')

    chart_path = root / "release/helm/riffdb/Chart.yaml"
    if chart_path.is_file():
        chart_text = chart_path.read_text(encoding="utf-8")
        if f"version: {version}\n" not in chart_text:
            errors.append(f"release/helm/riffdb/Chart.yaml lacks version: {version}")
        if f'appVersion: "{version}"\n' not in chart_text:
            errors.append(f'release/helm/riffdb/Chart.yaml lacks appVersion: "{version}"')

    return errors


def bump_root(root: Path, new_version: str) -> None:
    if not SEMVER_RE.fullmatch(new_version):
        raise SystemExit(f"bump_version_failed: invalid SemVer version {new_version!r}")

    topology_path = root / "release/version-topology-v1.json"
    durable_path = root / "release/durable-format-manifest-v1.json"
    dist_path = root / "release/distribution/manifest-v1.json"

    topology = load_json(topology_path)
    old_version = str(topology["release"])
    topology["release"] = new_version
    if isinstance(topology.get("supported_release_window"), dict):
        topology["supported_release_window"]["maximum"] = new_version
    for domain in topology.get("domains", []):
        scalars = domain.get("manifest_scalar_assertions")
        if isinstance(scalars, dict) and "maximum_supported_source_release" in scalars:
            scalars["maximum_supported_source_release"] = new_version
    save_json(topology_path, topology)

    durable = load_json(durable_path)
    durable["release"] = new_version
    durable["maximum_supported_source_release"] = new_version
    save_json(durable_path, durable)

    for rel_path, field in JSON_VERSION_FILES:
        target = root / rel_path
        if not target.is_file():
            continue
        data = load_json(target)
        data[field] = new_version
        if rel_path == "release/distribution/development-registry-v1.json" and isinstance(
            data.get("formats"), dict
        ):
            data["formats"] = {
                key: str(val).replace(old_version, new_version)
                for key, val in data["formats"].items()
            }
        if rel_path == "release/distribution/manifest-v1.json":
            data.setdefault("durable_format", {})["sha256"] = sha256(durable_path)
        save_json(target, data)

    escaped_old = re.escape(old_version)
    for rel_path in TOML_VERSION_FILES:
        target = root / rel_path
        if not target.is_file():
            continue
        text = target.read_text(encoding="utf-8")
        text = re.sub(
            rf'(^version\s*=\s*"){escaped_old}(")',
            rf"\g<1>{new_version}\2",
            text,
            flags=re.MULTILINE,
        )
        text = re.sub(
            rf'(riffdb-[a-z0-9-]+\s*=\s*\{{[^\n}}]*?version\s*=\s*"){escaped_old}(")',
            rf"\g<1>{new_version}\2",
            text,
        )
        target.write_text(text, encoding="utf-8", newline="\n")

    for cargo_toml in sorted((root / "crates").glob("*/Cargo.toml")) + sorted(
        (root / "examples").glob("*/Cargo.toml")
    ):
        text = cargo_toml.read_text(encoding="utf-8")
        updated = re.sub(
            rf'(riffdb-[a-z0-9-]+\s*=\s*\{{[^\n}}]*?version\s*=\s*"){escaped_old}(")',
            rf"\g<1>{new_version}\2",
            text,
        )
        if updated != text:
            cargo_toml.write_text(updated, encoding="utf-8", newline="\n")

    chart_path = root / "release/helm/riffdb/Chart.yaml"
    if chart_path.is_file():
        chart_text = chart_path.read_text(encoding="utf-8")
        chart_text = chart_text.replace(f"version: {old_version}\n", f"version: {new_version}\n")
        chart_text = chart_text.replace(
            f'appVersion: "{old_version}"\n', f'appVersion: "{new_version}"\n'
        )
        chart_path.write_text(chart_text, encoding="utf-8", newline="\n")


def run_self_test() -> int:
    errors = check_root(ROOT)
    if errors:
        for error in errors:
            print(f"- {error}", file=sys.stderr)
        return 1
    with tempfile.TemporaryDirectory(prefix="riffdb-bump-version-") as tmp:
        stage = Path(tmp)
        files_to_copy = [
            "release/version-topology-v1.json",
            "release/durable-format-manifest-v1.json",
            "release/helm/riffdb/Chart.yaml",
            *[rel for rel, _ in JSON_VERSION_FILES],
            *TOML_VERSION_FILES,
        ]
        for rel in files_to_copy:
            src = ROOT / rel
            if src.is_file():
                dst = stage / rel
                dst.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(src, dst)
        bump_root(stage, "0.1.1")
        post_errors = check_root(stage)
        if post_errors:
            print("self-test failed after bumping to 0.1.1:", file=sys.stderr)
            for error in post_errors:
                print(f"- {error}", file=sys.stderr)
            return 1
        # Negative check: corrupt Chart.yaml and confirm check_root rejects it.
        chart = stage / "release/helm/riffdb/Chart.yaml"
        chart.write_text(
            chart.read_text(encoding="utf-8").replace("version: 0.1.1\n", "version: 9.9.9\n"),
            encoding="utf-8",
        )
        if not any("Chart.yaml" in err for err in check_root(stage)):
            print("self-test failed to detect Chart.yaml version drift", file=sys.stderr)
            return 1
    print("bump-version self-test passed.")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="Verify all versioned manifests match")
    parser.add_argument("--to", metavar="X.Y.Z", help="Bump all versioned manifests to X.Y.Z")
    parser.add_argument("--self-test", action="store_true", help="Run positive and negative self-tests")
    args = parser.parse_args()

    if args.self_test:
        return run_self_test()
    if args.to:
        bump_root(ROOT, args.to)
        errors = check_root(ROOT)
        if errors:
            for error in errors:
                print(f"- {error}", file=sys.stderr)
            return 1
        print(f"Bumped repository manifests to {args.to}.")
        return 0

    errors = check_root(ROOT)
    if errors:
        print("version synchronization check failed:", file=sys.stderr)
        for error in errors:
            print(f"- {error}", file=sys.stderr)
        return 1
    version = load_json(ROOT / "release/version-topology-v1.json")["release"]
    print(f"All release and client manifests are synchronized at v{version}.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
