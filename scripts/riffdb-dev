#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

role=ticketdesk-application
watch=0
acceptance=0
seed_dir=
seed_builtin=0
seed_concurrency=8
while (($#)); do
    case "$1" in
        --role)
            role="${2:-}"
            shift 2
            ;;
        --watch) watch=1; shift ;;
        --acceptance) acceptance=1; shift ;;
        --seed-dir)
            seed_dir="${2:-}"
            shift 2
            ;;
        --seed) seed_builtin=1; shift ;;
        --seed-concurrency)
            seed_concurrency="${2:-}"
            shift 2
            ;;
        *)
            echo "usage: riffdb-dev [--role ticketdesk-application|ticketdesk-agent|ticketdesk-kernel] [--watch] [--seed] [--seed-dir DIR] [--seed-concurrency 1..8] [--acceptance]" >&2
            exit 2
            ;;
    esac
done

case "$role" in
    ticketdesk-application|ticketdesk-agent|ticketdesk-kernel) ;;
    *)
        echo "unknown development role preset: $role" >&2
        exit 2
        ;;
esac
[[ "$seed_concurrency" =~ ^[1-8]$ ]] || {
    echo "seed concurrency must be in 1..8" >&2
    exit 2
}
if [[ -n "$seed_dir" && ! -d "$seed_dir" ]]; then
    echo "seed directory is unavailable" >&2
    exit 2
fi

for tool in cargo jq mkfifo mktemp od timeout tr; do
    command -v "$tool" >/dev/null 2>&1 || {
        echo "required development tool is missing: $tool" >&2
        exit 1
    }
done

profile=debug
profile_args=()
if ((acceptance)); then
    profile=release
    profile_args+=(--release)
fi
cargo build --quiet "${profile_args[@]}" \
    -p riffdb-server --bin riffdbd -p riffdb-cli --bin riffdb \
    -p riffdb-ticketdesk --bin seed --bin benchmark
riffdbd="$repo_root/target/$profile/riffdbd"
riffdb="$repo_root/target/$profile/riffdb"
seed="$repo_root/target/$profile/seed"
benchmark="$repo_root/target/$profile/benchmark"
contract="$repo_root/examples/app-baseline/contracts/ticketdesk.riff"
queries="$repo_root/queries/ticketdesk"
bootstrap_request="$repo_root/release/config/bootstrap-ticketdesk-dev.json"
application_manifest="$repo_root/fixtures/application-manifests/ticketdesk-v1.json"

work_root="$(mktemp -d "${TMPDIR:-/tmp}/riffdb-dev.XXXXXX")"
server_pid=
cleanup() {
    if [[ -n "$server_pid" ]] && kill -0 "$server_pid" 2>/dev/null; then
        kill -TERM "$server_pid" 2>/dev/null || true
        timeout 15s tail --pid="$server_pid" -f /dev/null 2>/dev/null || {
            kill -KILL "$server_pid" 2>/dev/null || true
        }
        wait "$server_pid" 2>/dev/null || true
    fi
    rm -rf "$work_root"
}
trap cleanup EXIT INT TERM

random_hex_32() {
    od -An -tx1 -N32 /dev/urandom | tr -d ' \n'
}

mkdir -p "$work_root/backups"
mkfifo "$work_root/ready.fifo"
(
    umask 077
    capability_key="$(random_hex_32)"
    idempotency_key="$(random_hex_32)"
    while [[ "$idempotency_key" == "$capability_key" ]]; do
        idempotency_key="$(random_hex_32)"
    done
    printf 'riffdb-capability-digest-keys-v1\n1:%s\n' "$capability_key" >"$work_root/capability.keys"
    printf 'riffdb-idempotency-digest-keys-v1\n1:%s\n' "$idempotency_key" >"$work_root/idempotency.keys"
)

"$riffdbd" \
    --database "$work_root/riffdb.redb" \
    --listen 127.0.0.1:0 \
    --environment local-dev \
    --audience riffdb-grpc-loopback \
    --backup-root "$work_root/backups" \
    --capability-keys "$work_root/capability.keys" \
    --idempotency-keys "$work_root/idempotency.keys" \
    </dev/null >"$work_root/ready.fifo" 2>"$work_root/riffdbd.stderr" &
server_pid=$!

exec {ready_fd}<"$work_root/ready.fifo"
IFS= read -r -t 30 ready_line <&"$ready_fd" || {
    echo "development server did not become ready" >&2
    exit 1
}
exec {ready_fd}<&-
case "$ready_line" in
    riffdbd-ready-v1$'\t'*) address="${ready_line#*$'\t'}" ;;
    *)
        echo "development server returned invalid readiness" >&2
        exit 1
        ;;
esac
endpoint="http://$address"

"$riffdb" --endpoint "$endpoint" --output json \
    capability bootstrap \
    --request "$bootstrap_request" \
    --generate "$work_root/bootstrap.credential" \
    --bearer-output "$work_root/operator.credential" \
    >"$work_root/bootstrap.json"
jq -e '.ok == true and .command == "capability.bootstrap"' "$work_root/bootstrap.json" >/dev/null

operator=("$riffdb" --endpoint "$endpoint" --output json --credential-file "$work_root/operator.credential")
"${operator[@]}" contract deploy "$contract" >"$work_root/contract.json"
jq -e '.ok == true and .command == "contract.deploy"' "$work_root/contract.json" >/dev/null
if ! "${operator[@]}" query deploy "$queries" \
    --module-name ticketdesk \
    --module-version 1 \
    --expected-active any \
    --contract-lineage TicketDesk \
    --contract-version 1 >"$work_root/module.json"; then
    cat "$work_root/module.json" >&2
    cat "$work_root/riffdbd.stderr" >&2
    exit 1
fi
jq -e '.ok == true and .command == "query.deploy"' "$work_root/module.json" >/dev/null

case "$role" in
    ticketdesk-application)
        "${operator[@]}" role bind "$application_manifest" \
            --role TicketDeskApplication \
            --principal ticketdesk-dev-application \
            --actor-kind service \
            --lifetime-seconds 86400 \
            --audience riffdb-grpc-loopback \
            --credential-output "$work_root/profile.credential" >"$work_root/role.json"
        jq -e '.ok == true and .command == "role.bind"' "$work_root/role.json" >/dev/null
        ;;
    ticketdesk-agent)
        "${operator[@]}" role bind "$application_manifest" \
            --role TicketDeskAgent \
            --principal ticketdesk-dev-agent \
            --actor-kind agent \
            --lifetime-seconds 86400 \
            --audience riffdb-grpc-loopback \
            --credential-output "$work_root/profile.credential" >"$work_root/role.json"
        jq -e '.ok == true and .command == "role.bind"' "$work_root/role.json" >/dev/null
        ;;
    ticketdesk-kernel)
        "${operator[@]}" capability create \
            --request "$repo_root/release/config/dev-role-ticketdesk-kernel.json" \
            --credential-output "$work_root/profile.credential" >"$work_root/role.json"
        jq -e '.ok == true and .command == "capability.create"' "$work_root/role.json" >/dev/null
        ;;
esac

profile_client=("$riffdb" --endpoint "$endpoint" --output json --credential-file "$work_root/profile.credential")
"${operator[@]}" query module \
    --contract-lineage TicketDesk \
    --contract-version 1 >"$work_root/inspect.json"
jq -e '
  .ok == true
  and .command == "query.module"
  and .result.module.module_name == "ticketdesk"
  and (.result.queries | length) == 8
' "$work_root/inspect.json" >/dev/null

run_seed() {
    local running=0
    local seed_file command_name
    while IFS= read -r -d '' seed_file; do
        command_name="$(basename "$seed_file" .json)"
        command_name="${command_name#*-}"
        "${profile_client[@]}" command run "$command_name" --input "$seed_file" \
            >"$work_root/seed-$(basename "$seed_file").result" &
        ((running += 1))
        if ((running == seed_concurrency)); then
            wait -n
            ((running -= 1))
        fi
    done < <(find "$seed_dir" -maxdepth 1 -type f -name '*.json' -print0 | sort -z)
    wait
}

if [[ "$role" == "ticketdesk-kernel" && ( -n "$seed_dir" || "$seed_builtin" == 1 || "$acceptance" == 1 ) ]]; then
    echo "the kernel profile cannot seed or run application acceptance; select ticketdesk-application or ticketdesk-agent" >&2
    exit 2
fi
if [[ -n "$seed_dir" ]]; then
    run_seed
fi
if ((acceptance || seed_builtin)); then
    if ! seed_result="$("$seed" "$endpoint" "$work_root/profile.credential")"; then
        cat "$work_root/riffdbd.stderr" >&2
        exit 1
    fi
    IFS=$'\t' read -r seed_schema seed_rows seed_ns <<<"$seed_result"
    [[ "$seed_schema" == "riffdb-ticketdesk-seed-v1" && "$seed_rows" == "276" ]] || {
        echo "built-in TicketDesk seed returned an invalid result" >&2
        exit 1
    }
    if ((seed_ns > 3000000000)); then
        echo "built-in TicketDesk seed missed the 3 second gate: ${seed_ns}ns" >&2
        exit 1
    fi
    printf 'riffdb-dev-seed-v1\t%s\t%sns\n' "$seed_rows" "$seed_ns" >&2
    benchmark_result="$("$benchmark" "$endpoint" "$work_root/profile.credential")"
    IFS=$'\t' read -r benchmark_schema list_ns members_ns summary_ns detail_ns <<<"$benchmark_result"
    [[ "$benchmark_schema" == "riffdb-ticketdesk-query-benchmark-v1" ]] || {
        echo "TicketDesk named-query benchmark returned an invalid result" >&2
        exit 1
    }
    if ((list_ns > 15000000 || members_ns > 15000000 || summary_ns > 15000000 || detail_ns > 15000000)); then
        echo "TicketDesk named-query benchmark missed the 15ms gate" >&2
        exit 1
    fi
    printf 'riffdb-dev-query-p50-v1\tlist=%sns\tmembers=%sns\tsummary=%sns\tdetail=%sns\n' \
        "$list_ns" "$members_ns" "$summary_ns" "$detail_ns" >&2
fi

if ((acceptance)) && [[ "$role" == "ticketdesk-application" ]]; then
    if "${profile_client[@]}" query run "$repo_root/queries/ticketdesk/get_ticket.riffq" \
        --contract-lineage TicketDesk \
        --contract-version 1 \
        --parameters "$repo_root/tests/authorization/fixtures/application-ad-hoc-parameters.json" \
        >"$work_root/ad-hoc-denied.json" 2>"$work_root/ad-hoc-denied.stderr"; then
        echo "stable application credential unexpectedly executed ad-hoc RiffQL" >&2
        exit 1
    fi
    jq -e '.ok == false and .error.type == "public"' "$work_root/ad-hoc-denied.json" >/dev/null
fi

printf 'riffdb-dev-ready-v1\t%s\t%s\t%s\n' \
    "$endpoint" "$work_root/profile.credential" "$role"

if ((acceptance)); then
    exit 0
fi

if ((watch == 0)); then
    wait "$server_pid"
    server_pid=
    exit 0
fi

contract_stamp="$(stat -c '%Y:%s' "$contract")"
query_stamp="$(find "$queries" -maxdepth 1 -type f -name '*.riffq' -printf '%f:%T@:%s\n' | sort)"
module_version=1
while kill -0 "$server_pid" 2>/dev/null; do
    sleep 0.25
    next_contract_stamp="$(stat -c '%Y:%s' "$contract")"
    next_query_stamp="$(find "$queries" -maxdepth 1 -type f -name '*.riffq' -printf '%f:%T@:%s\n' | sort)"
    if [[ "$next_contract_stamp" != "$contract_stamp" ]]; then
        "${operator[@]}" contract deploy "$contract" >/dev/null
        contract_stamp="$next_contract_stamp"
    fi
    if [[ "$next_query_stamp" != "$query_stamp" ]]; then
        ((module_version += 1))
        "${operator[@]}" query deploy "$queries" \
            --module-name ticketdesk \
            --module-version "$module_version" \
            --expected-active any \
            --contract-lineage TicketDesk \
            --contract-version 1 >/dev/null
        query_stamp="$next_query_stamp"
    fi
done
wait "$server_pid"
server_pid=
