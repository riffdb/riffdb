#!/usr/bin/env bash
set -euo pipefail
export PYTHONDONTWRITEBYTECODE=1

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if [[ "${1:-}" == "--check" ]]; then
    task_tmp_root="${HOME}/tmp"
    mkdir -p "$task_tmp_root"
    generated="$(mktemp -d "$task_tmp_root/riffdb-query-clients.XXXXXX")"
    trap 'rm -rf "$generated"' EXIT
    cargo run --quiet -p riffdb-query-module --example generate_clients -- "$generated"
    cargo run --quiet -p riffdb-query-module --example generate_agent_alpha_clients -- "$generated"
    cargo run --quiet -p riffdb-query-module --example generate_operational_rotation -- "$generated"
    gofmt -w "$generated/clients/go/ticketdesk/client.go"
    diff -u fixtures/query-modules/ticketdesk.rs "$generated/fixtures/query-modules/ticketdesk.rs"
    diff -u fixtures/query-modules/ticketdesk.mcp.json "$generated/fixtures/query-modules/ticketdesk.mcp.json"
    diff -u fixtures/application-manifests/ticketdesk-v1.json \
        "$generated/fixtures/application-manifests/ticketdesk-v1.json"
    diff -u fixtures/application-manifests/ticketdesk-v1.identity \
        "$generated/fixtures/application-manifests/ticketdesk-v1.identity"
    diff -u fixtures/application-manifests/ticketdesk-agent-role-v1.identity \
        "$generated/fixtures/application-manifests/ticketdesk-agent-role-v1.identity"
    diff -u fixtures/application-manifests/ticketdesk-agent-role-v1.json \
        "$generated/fixtures/application-manifests/ticketdesk-agent-role-v1.json"
    diff -u fixtures/application-manifests/ticketdesk-migration-v3.json \
        "$generated/fixtures/application-manifests/ticketdesk-migration-v3.json"
    diff -u fixtures/application-locks/ticketdesk-migration-v4.json \
        "$generated/fixtures/application-locks/ticketdesk-migration-v4.json"
    diff -u fixtures/application-manifests/policy-surface-v6.json \
        "$generated/fixtures/application-manifests/policy-surface-v6.json"
    diff -u fixtures/application-manifests/policy-surface-exact-v4.json \
        "$generated/fixtures/application-manifests/policy-surface-exact-v4.json"
    diff -u fixtures/application-locks/policy-surface-v7.json \
        "$generated/fixtures/application-locks/policy-surface-v7.json"
    diff -u fixtures/application-locks/row-policy-rotation-v1.json \
        "$generated/fixtures/application-locks/row-policy-rotation-v1.json"
    jq -e '
      .schema == "riffdb-row-policy-identity-rotation/v1"
      and .work_package == "WP-570"
      and .decision == "ADR-0111"
      and .before.preserved == true
      and .after.application_source_schema == "riffdb.application-source/v6"
      and .after.application_manifest_schema == "riffdb.application-manifest/v4"
      and .after.application_lock_schema == "riffdb.application-lock/v7"
      and .after.application_role_definition_format == 3
      and .after.contract_grammar_version == 4
      and .after.contract_ir_version == 4
      and .after.contract_bundle_format == 4
      and .classification.old_fixtures_preserved == true
      and .classification.row_policy_identity_is_additive == true
      and .classification.partial_rotation_is_success == false
      and .repository_closure == [
        "fixtures/application-manifests/policy-surface-v6.json",
        "fixtures/application-manifests/policy-surface-exact-v4.json",
        "fixtures/application-locks/policy-surface-v7.json"
      ]
    ' fixtures/application-locks/row-policy-rotation-v1.json >/dev/null
    diff -u clients/typescript/ticketdesk/client.ts "$generated/clients/typescript/ticketdesk/client.ts"
    diff -u clients/go/ticketdesk/client.go "$generated/clients/go/ticketdesk/client.go"
    diff -u clients/python/ticketdesk/generated.py "$generated/clients/python/ticketdesk/generated.py"
    diff -u fixtures/riffql/operational-identity-rotation-v1.json \
        "$generated/fixtures/riffql/operational-identity-rotation-v1.json"
    jq -e '
      .schema == "riffdb.operational-riffql-identity-rotation/v1"
      and .work_package == "WP-563"
      and .decision == "ADR-0108"
      and .before.language_version == 1
      and .before.query_ir_version == 1
      and .before.query_module_format_version == 1
      and .after.language_version == 2
      and .after.query_ir_version == 2
      and .after.query_module_format_version == 2
      and .operational_family.member_count == 2
      and .operational_family.presence_parameters == ["status"]
      and (.before.artifacts | map(.kind) | sort) ==
        (["contract_bundle", "go", "manifest", "mcp", "python", "rust", "typescript"] | sort)
      and (.after.artifacts | map(.kind) | sort) ==
        (["contract_bundle", "go", "manifest", "mcp", "python", "rust", "typescript"] | sort)
      and (.repository_closure | map(.path) | sort) ==
        (["examples/agent-alpha/riffdb.application.lock.json", "examples/ticketdesk/riffdb.application.lock.json"] | sort)
      and all(.repository_closure[]; .query_module_format == 1 and .rotation == "unchanged_ordinary_v1")
      and .classification.ordinary_v1_bytes_preserved == true
      and .classification.operational_v2_additive == true
      and .classification.partial_rotation_is_success == false
    ' fixtures/riffql/operational-identity-rotation-v1.json >/dev/null
    # agent-alpha clients (non-workspace packages; previously invisible to battery)
    diff -u examples/agent-alpha/generated/rust/client.rs \
        "$generated/examples/agent-alpha/generated/rust/client.rs"
    diff -u examples/agent-alpha/web/src/generated/client.ts \
        "$generated/examples/agent-alpha/web/src/generated/client.ts"

    # The root agent-alpha application is a compiler-owned source/lock closure,
    # not a hand-pinned legacy manifest. Rebuild the complete closure in an
    # isolated application root and compare every generated identity artifact.
    agent_alpha="$generated/agent-alpha-lock"
    mkdir -p "$agent_alpha"
    cp examples/agent-alpha/riffdb.application.json "$agent_alpha/"
    cp -R examples/agent-alpha/riffdb "$agent_alpha/"
    cargo run --quiet -p riffdb-cli --bin riffdb -- application lock --write \
        "$agent_alpha/riffdb.application.json" \
        --lock riffdb.application.lock.json >/dev/null
    diff -u examples/agent-alpha/riffdb.application.lock.json \
        "$agent_alpha/riffdb.application.lock.json"
    diff -u examples/agent-alpha/generated/riffdb.application.exact.json \
        "$agent_alpha/generated/riffdb.application.exact.json"
    diff -u examples/agent-alpha/generated/riffdb.contract.bundle \
        "$agent_alpha/generated/riffdb.contract.bundle"
    diff -u examples/agent-alpha/generated/mcp/tools.json \
        "$agent_alpha/generated/mcp/tools.json"
    diff -u examples/agent-alpha/generated/rust/client.rs \
        "$agent_alpha/generated/rust/client.rs"
    diff -u examples/agent-alpha/web/src/generated/client.ts \
        "$agent_alpha/web/src/generated/client.ts"

    expect_lock_refusal() {
        local label="$1"
        shift
        local output
        if output="$("$@" 2>&1)"; then
            echo "$label unexpectedly accepted an inexact application closure" >&2
            exit 1
        fi
        if ! rg -q 'RDB-AL008|application_lock_inexact' <<<"$output"; then
            echo "$label returned the wrong refusal" >&2
            echo "$output" >&2
            exit 1
        fi
    }

    # Source/lock drift must stop every local and server-touching application
    # path before a deployment journal or transport connection can be created.
    stale_lock="$generated/agent-alpha-stale-lock"
    cp -R "$agent_alpha" "$stale_lock"
    sed -i '/            title/d' "$stale_lock/riffdb/queries/item_page.riffq"
    expect_lock_refusal "application check with stale lock" \
        cargo run --quiet -p riffdb-cli --bin riffdb -- application check \
        "$stale_lock/riffdb.application.json" --output json
    expect_lock_refusal "lock check with stale source" \
        cargo run --quiet -p riffdb-cli --bin riffdb -- application lock --check \
        "$stale_lock/riffdb.application.json" --lock riffdb.application.lock.json \
        --output json
    expect_lock_refusal "deploy with stale lock" \
        cargo run --quiet -p riffdb-cli --bin riffdb -- application deploy \
        "$stale_lock/riffdb.application.json" --lock riffdb.application.lock.json \
        --endpoint http://127.0.0.1:1 --database default --output json
    expect_lock_refusal "role reconciliation with stale lock" \
        cargo run --quiet -p riffdb-cli --bin riffdb -- application bind-dev-role \
        "$stale_lock/riffdb.application.json" --lock riffdb.application.lock.json \
        --role AgentAlphaApplication --endpoint http://127.0.0.1:1 \
        --database default --output json
    test ! -e "$stale_lock/.riffdb"

    # A substituted generated client is the opposite neuter. It must trip the
    # same exactness gate before any server-touching path begins.
    stale_client="$generated/agent-alpha-stale-client"
    cp -R "$agent_alpha" "$stale_client"
    printf '\n// substituted generated artifact\n' \
        >>"$stale_client/web/src/generated/client.ts"
    expect_lock_refusal "application check with stale client" \
        cargo run --quiet -p riffdb-cli --bin riffdb -- application check \
        "$stale_client/riffdb.application.json" --output json
    expect_lock_refusal "lock check with stale client" \
        cargo run --quiet -p riffdb-cli --bin riffdb -- application lock --check \
        "$stale_client/riffdb.application.json" --lock riffdb.application.lock.json \
        --output json
    expect_lock_refusal "deploy with stale client" \
        cargo run --quiet -p riffdb-cli --bin riffdb -- application deploy \
        "$stale_client/riffdb.application.json" --lock riffdb.application.lock.json \
        --endpoint http://127.0.0.1:1 --database default --output json
    expect_lock_refusal "role reconciliation with stale client" \
        cargo run --quiet -p riffdb-cli --bin riffdb -- application bind-dev-role \
        "$stale_client/riffdb.application.json" --lock riffdb.application.lock.json \
        --role AgentAlphaApplication --endpoint http://127.0.0.1:1 \
        --database default --output json
    test ! -e "$stale_client/.riffdb"
    diff -u examples/agent-alpha/domains/agent-blog/generated/rust/client.rs \
        "$generated/examples/agent-alpha/domains/agent-blog/generated/rust/client.rs"
    diff -u examples/agent-alpha/domains/agent-blog/generated/typescript/client.ts \
        "$generated/examples/agent-alpha/domains/agent-blog/generated/typescript/client.ts"
    diff -u examples/agent-alpha/domains/agent-orders/generated/rust/client.rs \
        "$generated/examples/agent-alpha/domains/agent-orders/generated/rust/client.rs"
    diff -u examples/agent-alpha/domains/agent-orders/generated/typescript/client.ts \
        "$generated/examples/agent-alpha/domains/agent-orders/generated/typescript/client.ts"
    python3 -c 'compile(open("clients/python/ticketdesk/generated.py", encoding="utf-8").read(), "clients/python/ticketdesk/generated.py", "exec")'
    if command -v mypy >/dev/null 2>&1; then
        MYPYPATH=clients/python/runtime/src \
            mypy --strict clients/python/ticketdesk/generated.py
    fi
    cargo check --quiet -p riffdb-ticketdesk --all-targets
    cargo run --quiet -p riffdb-cli --bin riffdb -- application lock --check \
        examples/ticketdesk/riffdb.application.json \
        --lock riffdb.application.lock.json --output json >/dev/null
    cargo run --quiet -p riffdb-cli --bin riffdb -- application lock --check \
        examples/agent-alpha/riffdb.application.json \
        --lock riffdb.application.lock.json --output json >/dev/null
    cargo run --quiet -p riffdb-cli --bin riffdb -- application lock --check \
        fixtures/adapters/operational-conformance/riffdb.application.json \
        --lock riffdb.application.lock.json --output json >/dev/null
    cargo run --quiet -p riffdb-cli --bin riffdb -- application lock --check \
        fixtures/adapters/mlflow/riffdb.application.json \
        --lock riffdb.application.lock.json --output json >/dev/null
    cargo run --quiet -p riffdb-cli --bin riffdb -- application lock --check \
        fixtures/adapters/woodpecker/riffdb.application.json \
        --lock riffdb.application.lock.json --output json >/dev/null
    cargo run --quiet -p riffdb-cli --bin riffdb -- application lock --check \
        fixtures/adapters/row-policy-conformance/riffdb.application.json \
        --lock riffdb.application.lock.json --output json >/dev/null
    cargo check --quiet --manifest-path examples/agent-alpha/domains/rust/Cargo.toml
    if command -v tsc >/dev/null 2>&1; then
        tsc --noEmit --strict --target ES2022 \
            "$generated/clients/typescript/ticketdesk/client.ts"
    else
        node --experimental-strip-types --check \
            "$generated/clients/typescript/ticketdesk/client.ts"
    fi
    exit 0
fi

cargo run --quiet -p riffdb-query-module --example generate_clients -- "$repo_root"
cargo run --quiet -p riffdb-query-module --example generate_agent_alpha_clients -- "$repo_root"
gofmt -w "$repo_root/clients/go/ticketdesk/client.go"

# Generated application clients are part of the exact application closure.
# Refresh the owning locks in the same operation so the normal generation path
# cannot leave `application check` red until an operator discovers and repairs
# the artifact hash drift manually.
cargo run --quiet -p riffdb-cli --bin riffdb -- application lock --write \
    examples/ticketdesk/riffdb.application.json \
    --lock riffdb.application.lock.json >/dev/null
cargo run --quiet -p riffdb-cli --bin riffdb -- application lock --write \
    examples/agent-alpha/riffdb.application.json \
    --lock riffdb.application.lock.json >/dev/null
cargo run --quiet -p riffdb-cli --bin riffdb -- application lock --write \
    fixtures/adapters/operational-conformance/riffdb.application.json \
    --lock riffdb.application.lock.json >/dev/null
cargo run --quiet -p riffdb-cli --bin riffdb -- application lock --write \
    fixtures/adapters/mlflow/riffdb.application.json \
    --lock riffdb.application.lock.json >/dev/null
cargo run --quiet -p riffdb-cli --bin riffdb -- application lock --write \
    fixtures/adapters/woodpecker/riffdb.application.json \
    --lock riffdb.application.lock.json >/dev/null
cargo run --quiet -p riffdb-cli --bin riffdb -- application lock --write \
    fixtures/adapters/row-policy-conformance/riffdb.application.json \
    --lock riffdb.application.lock.json >/dev/null
cargo run --quiet -p riffdb-query-module --example generate_operational_rotation -- "$repo_root"
