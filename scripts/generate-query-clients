#!/usr/bin/env bash
set -euo pipefail
export PYTHONDONTWRITEBYTECODE=1

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if [[ "${1:-}" == "--check" ]]; then
    generated="$(mktemp -d)"
    trap 'rm -rf "$generated"' EXIT
    cargo run --quiet -p riffdb-query-module --example generate_clients -- "$generated"
    diff -u fixtures/query-modules/ticketdesk.rs "$generated/fixtures/query-modules/ticketdesk.rs"
    diff -u fixtures/query-modules/ticketdesk.mcp.json "$generated/fixtures/query-modules/ticketdesk.mcp.json"
    diff -u fixtures/application-manifests/ticketdesk-v1.identity \
        "$generated/fixtures/application-manifests/ticketdesk-v1.identity"
    diff -u fixtures/application-manifests/ticketdesk-agent-role-v1.identity \
        "$generated/fixtures/application-manifests/ticketdesk-agent-role-v1.identity"
    diff -u fixtures/application-manifests/ticketdesk-agent-role-v1.json \
        "$generated/fixtures/application-manifests/ticketdesk-agent-role-v1.json"
    diff -u fixtures/application-manifests/ticketdesk-migration-v3.json \
        "$generated/fixtures/application-manifests/ticketdesk-migration-v3.json"
    diff -u fixtures/application-locks/ticketdesk-migration-v4.json \
        "$generated/fixtures/application-locks/ticketdesk-migration-v4.json"
    diff -u clients/typescript/ticketdesk/client.ts "$generated/clients/typescript/ticketdesk/client.ts"
    diff -u clients/python/ticketdesk/generated.py "$generated/clients/python/ticketdesk/generated.py"
    python3 -c 'compile(open("clients/python/ticketdesk/generated.py", encoding="utf-8").read(), "clients/python/ticketdesk/generated.py", "exec")'
    if command -v mypy >/dev/null 2>&1; then
        MYPYPATH=clients/python/runtime/src \
            mypy --strict clients/python/ticketdesk/generated.py
    fi
    cargo check --quiet -p riffdb-ticketdesk --all-targets
    if command -v tsc >/dev/null 2>&1; then
        tsc --noEmit --strict --target ES2022 \
            "$generated/clients/typescript/ticketdesk/client.ts"
    else
        node --experimental-strip-types --check \
            "$generated/clients/typescript/ticketdesk/client.ts"
    fi
    exit 0
fi

cargo run --quiet -p riffdb-query-module --example generate_clients -- "$repo_root"
