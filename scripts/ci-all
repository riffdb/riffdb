#!/usr/bin/env bash
# req: GEN-006
# req: TEST-003
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"
source scripts/tool-versions

require_tool_version() {
    local label="$1"
    local expected="$2"
    shift 2
    local actual
    actual="$("$@" --version)"
    if [[ " $actual " != *" $expected "* ]]; then
        printf '%s must be version %s, found: %s\n' "$label" "$expected" "$actual" >&2
        exit 1
    fi
}

require_tool_version cargo-deny "$RIFFDB_CARGO_DENY_VERSION" cargo deny
require_tool_version cargo-audit "$RIFFDB_CARGO_AUDIT_VERSION" cargo audit
require_tool_version cargo-machete "$RIFFDB_CARGO_MACHETE_VERSION" cargo machete

cargo fmt --all -- --check
cargo fmt --manifest-path xtask/Cargo.toml -- --check
cargo clippy --workspace --all-targets --all-features -- -D warnings
cargo clippy --locked --manifest-path xtask/Cargo.toml --all-targets -- -D warnings
cargo test --workspace --all-features
./scripts/check-archive-cli
cargo test --locked --manifest-path xtask/Cargo.toml
cargo riffdb --help >/dev/null 2>&1
cargo riffdb install --help >/dev/null 2>&1
cargo riffdb bootstrap --help >/dev/null 2>&1
RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps
cargo deny check
cargo audit
cargo machete
./scripts/check-workspace-policy
./scripts/check-generated-mcp-projection-owner
./scripts/check-generated-mcp-projection-owner --self-test
./scripts/check-crate-graph --self-test
./scripts/check-file-size-guard
./scripts/check-test-partition-coverage
./scripts/check-three-places --self-test
./scripts/check-adapter-evidence-claims --self-test
./scripts/check-adapter-evidence-claims
./scripts/expansion_completes_every_driver_before_release_or_refuses_whole
./scripts/expansion_memory_redb_parity_matches_independent_oracle
wp701_proof_root="$(mktemp -d "${TMPDIR:-/tmp}/riffdb-wp701-ci.XXXXXX")"
cleanup_wp701_proof_root() {
    rm -rf -- "$wp701_proof_root"
}
trap cleanup_wp701_proof_root EXIT INT TERM
RIFFDB_CONFORMANCE_RESULT_DIR="$wp701_proof_root" ./scripts/check-operator-acceptance
./scripts/generated_binary_text_interval_surfaces_preserve_logical_strings "$wp701_proof_root"
./scripts/generated_mcp_query_cursor_round_trip_preserves_authority_and_redaction "$wp701_proof_root"
cleanup_wp701_proof_root
trap - EXIT INT TERM
./scripts/check-requirement-coverage
./scripts/check-adr-obligations
./scripts/adr-new --self-test
./scripts/adr-index --check
./scripts/check-acceptance-commits
./scripts/check-performance-freeze
./scripts/check-wp762-baseline-bank
./scripts/check-generated
./scripts/check-helm-render
./scripts/check-helm-operator-package
./scripts/check-helm-upgrade-rehearsal
./scripts/wp722-authoring-acceptance
./scripts/release-source-install-smoke
