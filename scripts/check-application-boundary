#!/usr/bin/env bash
set -euo pipefail

if (($# == 0)); then
    set -- templates/application examples/agent-alpha
fi

status=0
for root in "$@"; do
    if [[ ! -d "$root" ]]; then
        echo "application boundary root is unavailable: $root" >&2
        status=1
        continue
    fi

    while IFS= read -r -d '' file; do
        relative="${file#"$root"/}"
        case "/$relative/" in
            */generated/*)
                case "$file" in
                    *.rs|*.ts)
                        if ! IFS= read -r first_line <"$file" ||
                            [[ "$first_line" != "// @generated by riffdb-query-module; do not edit." ]]; then
                            echo "$file: generated application binding lacks the trusted generator marker" >&2
                            status=1
                        fi
                        ;;
                esac
                continue
                ;;
        esac

        case "$file" in
            */Cargo.toml|*/package.json)
                if rg -n \
                    'riffdb-(api-grpc|proto|service|storage|runtime|commit|kernel)|(^|[\"[:space:]])(tonic|prost|protobufjs|@grpc/grpc-js)([\"[:space:]]|$)' \
                    "$file" >/dev/null; then
                    echo "$file: application manifest imports a kernel or transport package" >&2
                    status=1
                fi
                ;;
            *.rs|*.ts|*.tsx|*.js|*.jsx)
                if rg -n \
                    'RiffDbClient|GetEntityRequest|ScanIndexRequest|FieldSelection|NamedQueryResult|NamedQuery::new|IdempotentCommand|execute_application_command|entity_type_id|field_visibility|capability_mask|encoded[_A-Za-z]*key|tonic::|prost::|riffdb_client_rust::v1|[[:<:]]v1::' \
                    "$file" >/dev/null; then
                    echo "$file: handwritten application code crosses the RiffDB kernel boundary" >&2
                    status=1
                fi
                ;;
        esac
    done < <(
        rg --files -0 "$root" \
            -g 'Cargo.toml' -g 'package.json' \
            -g '*.rs' -g '*.ts' -g '*.tsx' -g '*.js' -g '*.jsx'
    )
done

if ((status != 0)); then
    echo "application boundary check failed" >&2
    exit "$status"
fi
echo "application boundary check passed"
