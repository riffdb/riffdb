#!/usr/bin/env python3
# req: OQ-061
"""Verify the immutable generic operational-query capability receipts."""

from __future__ import annotations

import argparse
import hashlib
from pathlib import Path
import sys


ROOT = Path(__file__).resolve().parent.parent
EXTERNAL = ROOT / "fixtures/riffql/wp701-external-binary-text-interval-capability-v1.json"
EXTERNAL_SHA256 = "22e4a8a69869fd4867a578319a9a80d5ed2d84a37f372a64e3dfe3354ee12673"
PREDECESSOR = ROOT / "fixtures/riffql/operational-query-capability-v4.json"
PREDECESSOR_SHA256 = "d4df09daa026aad644bba0771b0bd2c3ecd108e96b7634c03712d9fb336fd38b"
OUTPUT = ROOT / "fixtures/riffql/operational-query-capability-v5.json"
OUTPUT_SHA256 = "18b7659b3d20853c6171a49e63981e3d7542094f063eb584978600eecd50737c"


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--check", action="store_true")
    arguments = parser.parse_args()
    if not PREDECESSOR.exists() or sha256(PREDECESSOR) != PREDECESSOR_SHA256:
        print(f"immutable predecessor receipt changed: {PREDECESSOR}", file=sys.stderr)
        return 1
    if not EXTERNAL.exists() or sha256(EXTERNAL) != EXTERNAL_SHA256:
        print(f"immutable historical receipt changed: {EXTERNAL}", file=sys.stderr)
        return 1
    if not OUTPUT.exists() or sha256(OUTPUT) != OUTPUT_SHA256:
        print(f"immutable V5 capability fixture changed: {OUTPUT}", file=sys.stderr)
        return 1
    if not arguments.check:
        print(f"{OUTPUT.relative_to(ROOT)} is immutable; no files written")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
