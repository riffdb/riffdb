#!/usr/bin/env bash
# req: DEP-005, OQ-114, OQ-115
set -euo pipefail

# The executor-owned storage-api reader fake proves bounded composite behavior;
# redb proves the identical real-backend path. The testkit remains the
# independent oracle for authoritative state histories.
