#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "open3"
require "tempfile"

ROOT = `git rev-parse --show-toplevel`.strip
abort "not inside a Git worktree" unless $CHILD_STATUS&.success? || !ROOT.empty?

mode = ARGV.fetch(0, "--check")
abort "usage: #{$PROGRAM_NAME} [--check|--write]" unless %w[--check --write].include?(mode)

Dir.chdir(ROOT)
unless system("cargo", "build", "--locked", "--quiet", "-p", "riffdb-cli", "--bin", "riffdb")
  abort "failed to build riffdb CLI"
end

target_dir = ENV.fetch("CARGO_TARGET_DIR", File.join(ROOT, "target"))
binary = File.join(target_dir, "debug", "riffdb")
abort "missing CLI binary at #{binary}" unless File.executable?(binary)

def help_for(binary, path)
  stdout, stderr, status = Open3.capture3(binary, *path, "--help")
  abort "failed to read help for riffdb #{path.join(' ')}: #{stderr}" unless status.success?

  stdout.lines.map(&:rstrip).join("\n").rstrip
end

def child_commands(help)
  lines = help.lines
  start = lines.index { |line| line.strip == "Commands:" }
  return [] unless start

  lines.drop(start + 1).take_while { |line| !line.strip.empty? }.filter_map do |line|
    match = line.match(/^  ([a-z][a-z0-9-]*)(?:\s{2,}.*)?$/)
    match && match[1] != "help" ? match[1] : nil
  end
end

queue = [[]]
seen = {}
sections = []
until queue.empty?
  path = queue.shift
  key = path.join(" ")
  next if seen[key]

  abort "CLI help tree exceeds 128 commands" if seen.length >= 128
  abort "CLI help tree exceeds four nested command levels" if path.length > 4
  seen[key] = true

  help = help_for(binary, path)
  sections << [path, help]
  child_commands(help).each { |child| queue << (path + [child]) }
end

content = +<<~MARKDOWN
  <!-- Generated by scripts/generate-cli-reference. Do not edit by hand. -->

  # CLI Reference

  This reference is generated from the checked-in `riffdb` command tree. See
  [Installation](../installation.md) for setup and
  [Configuration](../configuration.md) for configuration-file semantics.

MARKDOWN

sections.each do |path, help|
  command = (["riffdb"] + path).join(" ")
  level = [2 + path.length, 6].min
  content << "#{'#' * level} `#{command}`\n\n"
  content << "```text\n#{help}\n```\n\n"
end
content = content.rstrip + "\n"

destination = File.join(ROOT, "docs/reference/CLI.md")
if mode == "--write"
  FileUtils.mkdir_p(File.dirname(destination))
  File.write(destination, content)
  puts "Generated #{destination.delete_prefix(ROOT + '/')} (#{sections.length} commands)."
elsif !File.exist?(destination) || File.read(destination) != content
  abort "stale CLI reference: run ./scripts/generate-cli-reference --write"
else
  puts "CLI reference is current (#{sections.length} commands)."
end
