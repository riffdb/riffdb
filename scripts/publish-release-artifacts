#!/usr/bin/env python3
# req: AFC-001, VER-001, VER-004, DRV-014
"""Assemble, sign, verify, and publish immutable RiffDB release and driver artifacts."""

from __future__ import annotations

import argparse
from collections.abc import Mapping
import gzip
import hashlib
import io
import json
import os
from pathlib import Path, PurePosixPath
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import urllib.request
import zipfile


ROOT = Path(__file__).resolve().parent.parent
TOPOLOGY_PATH = ROOT / "release/version-topology-v1.json"
DURABLE_MANIFEST_PATH = ROOT / "release/durable-format-manifest-v1.json"
DISTRIBUTION_MANIFEST_PATH = ROOT / "release/distribution/manifest-v1.json"
HELM_CHART_DIR = ROOT / "release/helm/riffdb"
RELEASE_NAMESPACE = "riffdb-release-v1"
DRIVER_NAMESPACE = "riffdb-driver-distribution-v1"
RUST_RUNTIME_PACKAGES = (
    "riffdb-types",
    "riffdb-errors",
    "riffdb-config",
    "riffdb-contract-ir",
    "riffdb-proto",
    "riffdb-client-rust",
    "riffdb-application",
)


def fail(message: str) -> None:
    raise SystemExit(f"release_publication_failed: {message}")


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while chunk := handle.read(1024 * 1024):
            digest.update(chunk)
    return digest.hexdigest()


def canonical_archive_digest(path: Path) -> str:
    """Compute a compression-library-independent digest of an archive's member inventory."""
    suffix = path.name
    if suffix.endswith((".tgz", ".tar.gz", ".crate")):
        digest = hashlib.sha256()
        with tarfile.open(path, "r:gz") as archive:
            members = [m for m in archive.getmembers() if m.isfile()]
            for member in sorted(members, key=lambda item: item.name):
                extracted = archive.extractfile(member)
                content = extracted.read() if extracted is not None else b""
                member_sha = hashlib.sha256(content).hexdigest()
                digest.update(f"{member.name}\0{len(content)}\0{member_sha}\n".encode("utf-8"))
        return digest.hexdigest()
    if suffix.endswith((".whl", ".zip")):
        digest = hashlib.sha256()
        with zipfile.ZipFile(path, "r") as archive:
            for name in sorted(archive.namelist()):
                content = archive.read(name)
                member_sha = hashlib.sha256(content).hexdigest()
                digest.update(f"{name}\0{len(content)}\0{member_sha}\n".encode("utf-8"))
        return digest.hexdigest()
    return sha256_file(path)


def canonical_json(value: object) -> bytes:
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode("utf-8")


def write_bytes(path: Path, content: bytes, mode: int = 0o644) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("xb") as handle:
        handle.write(content)
    path.chmod(mode)


def run(command: list[str], *, cwd: Path = ROOT, stdin_bytes: bytes | None = None) -> str:
    completed = subprocess.run(
        command,
        cwd=cwd,
        input=stdin_bytes,
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if completed.returncode != 0:
        sys.stderr.write(completed.stdout.decode("utf-8", errors="replace"))
        sys.stderr.write(completed.stderr.decode("utf-8", errors="replace"))
        fail("command failed: " + " ".join(command))
    return completed.stdout.decode("utf-8", errors="replace")


def verify_version_gate(release_tag: str) -> str:
    if not re.fullmatch(r"v[0-9]+\.[0-9]+\.[0-9]+", release_tag):
        fail(f"release tag {release_tag!r} must match v<major>.<minor>.<patch>")
    run([sys.executable, str(ROOT / "scripts/check-version-topology"), "--release-tag", release_tag])
    return release_tag[1:]


def verify_driver_distribution_conformance(
    distribution: Path,
    allowed_signers: Path,
    identity: str,
    version: str,
) -> dict[str, str]:
    run(
        [
            str(ROOT / "scripts/verify-driver-distributions"),
            "--allowed-signers",
            str(allowed_signers),
            "--identity",
            identity,
            str(distribution),
        ]
    )
    durable_copy = distribution / "durable-format-manifest-v1.json"
    if not durable_copy.is_file() or durable_copy.read_bytes() != DURABLE_MANIFEST_PATH.read_bytes():
        fail("driver distribution durable-format-manifest-v1.json is absent or drifted")

    expected_manifests: dict[str, bytes] = {}
    conformance_digests: dict[str, str] = {}
    for language in ("go", "python", "rust", "typescript"):
        canonical_path = ROOT / f"fixtures/driver/manifests/{language}-v1.json"
        distributed_path = distribution / f"conformance/{language}-v1.json"
        if not canonical_path.is_file() or not distributed_path.is_file():
            fail(f"DRV-014 conformance manifest is absent for {language}")
        expected = canonical_path.read_bytes()
        if distributed_path.read_bytes() != expected:
            fail(f"distribution DRV-014 conformance manifest drifted for {language}")
        expected_manifests[language] = expected
        conformance_digests[language] = hashlib.sha256(expected).hexdigest()

    npm_client = distribution / "npm" / f"riffdb-client-{version}.tgz"
    if not npm_client.is_file():
        fail("TypeScript @riffdb/client archive is absent from distribution")
    with tarfile.open(npm_client, "r:gz") as archive:
        member = archive.extractfile("package/conformance-manifest-v1.json")
        if member is None or member.read() != expected_manifests["typescript"]:
            fail("TypeScript @riffdb/client archive lacks exact DRV-014 conformance manifest")

    python_alias = distribution / "pypi" / f"riffdb-{version}-py3-none-any.whl"
    if not python_alias.is_file():
        fail("Python riffdb wheel is absent from distribution")
    with zipfile.ZipFile(python_alias) as archive:
        manifest_member = f"riffdb-{version}.dist-info/conformance-manifest-v1.json"
        if (
            manifest_member not in archive.namelist()
            or archive.read(manifest_member) != expected_manifests["python"]
        ):
            fail("Python riffdb wheel lacks exact DRV-014 conformance manifest")

    go_zip = distribution / "go-proxy/riffdb.dev/application/@v" / f"v{version}.zip"
    if not go_zip.is_file():
        fail("Go proxy zip is absent from distribution")
    with zipfile.ZipFile(go_zip) as archive:
        manifest_member = f"riffdb.dev/application@v{version}/conformance-manifest-v1.json"
        if (
            manifest_member not in archive.namelist()
            or archive.read(manifest_member) != expected_manifests["go"]
        ):
            fail("Go module zip lacks exact DRV-014 conformance manifest")

    rust_crate = distribution / "crates" / f"riffdb-client-rust-{version}.crate"
    if not rust_crate.is_file():
        fail("Rust riffdb-client-rust crate archive is absent from distribution")
    with tarfile.open(rust_crate, "r:gz") as archive:
        member = archive.extractfile(f"riffdb-client-rust-{version}/conformance-manifest-v1.json")
        if member is None or member.read() != expected_manifests["rust"]:
            fail("Rust riffdb-client-rust crate lacks exact DRV-014 conformance manifest")

    return conformance_digests


def package_helm_chart(output_archive: Path, version: str) -> None:
    if not HELM_CHART_DIR.is_dir() or HELM_CHART_DIR.is_symlink():
        fail("Helm chart source directory is absent")
    chart_yaml = (HELM_CHART_DIR / "Chart.yaml").read_text(encoding="utf-8")
    if f"version: {version}\n" not in chart_yaml or f'appVersion: "{version}"\n' not in chart_yaml:
        fail("Helm Chart.yaml version or appVersion disagrees with release version")
    buffer = io.BytesIO()
    with tarfile.open(fileobj=buffer, mode="w", format=tarfile.PAX_FORMAT) as archive:
        for file_path in sorted(HELM_CHART_DIR.rglob("*")):
            if not file_path.is_file() or file_path.is_symlink():
                continue
            rel = file_path.relative_to(HELM_CHART_DIR).as_posix()
            content = file_path.read_bytes()
            info = tarfile.TarInfo(f"riffdb/{rel}")
            info.size = len(content)
            info.mode = 0o644
            info.uid = 0
            info.gid = 0
            info.uname = ""
            info.gname = ""
            info.mtime = 0
            archive.addfile(info, io.BytesIO(content))
    output_archive.parent.mkdir(parents=True, exist_ok=True)
    with output_archive.open("xb") as raw:
        with gzip.GzipFile(filename="", mode="wb", fileobj=raw, mtime=0) as compressed:
            compressed.write(buffer.getvalue())
    output_archive.chmod(0o644)


def assemble_release_publication(
    *,
    release_tag: str,
    bundle_archive: Path,
    extra_bundle_archives: list[Path] | None = None,
    driver_distributions: list[Path],
    driver_allowed_signers: Path,
    driver_identity: str,
    signing_key: Path,
    container_image_digest: str,
    output_dir: Path,
) -> None:
    version = verify_version_gate(release_tag)
    if not bundle_archive.is_file() or bundle_archive.is_symlink():
        fail("release bundle archive must be an existing regular file")
    if output_dir.exists():
        fail("output directory must not already exist")
    if not re.fullmatch(
        r"ghcr\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}", container_image_digest
    ):
        fail("container image digest must be an immutable ghcr.io/@sha256:... reference")

    expected_prefix = f"riffdb-{version}-"
    if not bundle_archive.name.startswith(expected_prefix) or not bundle_archive.name.endswith(".tar.gz"):
        fail("release bundle archive name does not match release version")
    bundle_root = bundle_archive.name[: -len(".tar.gz")]

    with tarfile.open(bundle_archive, "r:gz") as archive:
        names = {member.name for member in archive.getmembers()}
        required_members = {
            f"{bundle_root}/VERSION",
            f"{bundle_root}/REVISION",
            f"{bundle_root}/SHA256SUMS",
            f"{bundle_root}/release/sbom.cdx.json",
            f"{bundle_root}/release/durable-format-manifest-v1.json",
            f"{bundle_root}/release/poc-requirements-v1.json",
        }
        if not required_members.issubset(names):
            fail("release bundle archive is missing required SBOM, durable-format, or evidence members")
        bundle_version = archive.extractfile(f"{bundle_root}/VERSION").read().decode("utf-8").strip()
        bundle_revision = archive.extractfile(f"{bundle_root}/REVISION").read().decode("utf-8").strip()
        bundle_durable = archive.extractfile(
            f"{bundle_root}/release/durable-format-manifest-v1.json"
        ).read()
        bundle_sbom = archive.extractfile(f"{bundle_root}/release/sbom.cdx.json").read()

    if bundle_version != version:
        fail("release bundle VERSION disagrees with release tag")
    if bundle_durable != DURABLE_MANIFEST_PATH.read_bytes():
        fail("release bundle durable-format-manifest-v1.json disagrees with repository manifest")

    if not driver_distributions:
        fail("at least one verified driver distribution is required")

    driver_targets: dict[str, str] = {}
    conformance_digests: dict[str, str] = {}
    staged_parent = output_dir.parent
    staged_parent.mkdir(parents=True, exist_ok=True)
    temporary = Path(tempfile.mkdtemp(prefix=".riffdb-release-publish-", dir=staged_parent))
    staged = temporary / "publication"
    staged.mkdir()
    try:
        write_bytes(staged / bundle_archive.name, bundle_archive.read_bytes())
        for extra_archive in extra_bundle_archives or ():
            if (
                not extra_archive.is_file()
                or extra_archive.is_symlink()
                or not extra_archive.name.startswith(expected_prefix)
                or not extra_archive.name.endswith(".tar.gz")
            ):
                fail("extra release bundle archive is invalid")
            write_bytes(staged / extra_archive.name, extra_archive.read_bytes())
        write_bytes(staged / "sbom.cdx.json", bundle_sbom)
        write_bytes(staged / "durable-format-manifest-v1.json", bundle_durable)
        write_bytes(staged / "version-topology-v1.json", TOPOLOGY_PATH.read_bytes())

        for dist in driver_distributions:
            conformance_digests = verify_driver_distribution_conformance(
                dist, driver_allowed_signers, driver_identity, version
            )
            receipt = json.loads((dist / "metadata/artifacts-v1.json").read_text(encoding="utf-8"))
            if receipt.get("version") != version or receipt.get("revision") != bundle_revision:
                fail("driver distribution revision or version disagrees with release bundle")
            target = str(receipt.get("target", ""))
            if target in driver_targets:
                fail(f"duplicate driver distribution target: {target}")
            driver_targets[target] = sha256_file(dist / "checksums.sha256")
            shutil.copytree(dist, staged / "drivers" / target)
            driver_tarball = staged / f"riffdb-driver-distribution-{version}-{target}.tar.gz"
            run(
                [
                    "tar",
                    "--sort=name",
                    "--mtime=@0",
                    "--owner=0",
                    "--group=0",
                    "--numeric-owner",
                    "-czf",
                    str(driver_tarball),
                    target,
                ],
                cwd=staged / "drivers",
            )

        for language in ("go", "python", "rust", "typescript"):
            write_bytes(
                staged / "conformance" / f"{language}-v1.json",
                (ROOT / f"fixtures/driver/manifests/{language}-v1.json").read_bytes(),
            )

        helm_archive_name = f"riffdb-{version}.tgz"
        package_helm_chart(staged / helm_archive_name, version)
        helm_sha256 = sha256_file(staged / helm_archive_name)
        consumer_verification = {
            "schema": "riffdb.release-consumer-verification/v1",
            "release_tag": release_tag,
            "version": version,
            "revision": bundle_revision,
            "container_image_digest": container_image_digest,
            "helm_chart": {
                "name": helm_archive_name,
                "sha256": helm_sha256,
            },
            "bundle_archive": {
                "name": bundle_archive.name,
                "sha256": sha256_file(staged / bundle_archive.name),
            },
            "signing_namespace": RELEASE_NAMESPACE,
        }
        write_bytes(
            staged / "consumer-verification-v1.json", canonical_json(consumer_verification)
        )

        durable_doc = json.loads(bundle_durable.decode("utf-8"))
        provenance = {
            "schema": "riffdb.release-provenance/v1",
            "release_tag": release_tag,
            "version": version,
            "revision": bundle_revision,
            "bundle_archive": {
                "name": bundle_archive.name,
                "sha256": sha256_file(staged / bundle_archive.name),
            },
            "helm_chart": {
                "name": helm_archive_name,
                "sha256": helm_sha256,
            },
            "consumer_verification": {
                "path": "consumer-verification-v1.json",
                "sha256": sha256_file(staged / "consumer-verification-v1.json"),
            },
            "sbom": {
                "path": "sbom.cdx.json",
                "sha256": sha256_file(staged / "sbom.cdx.json"),
            },
            "durable_format_manifest": {
                "path": "durable-format-manifest-v1.json",
                "sha256": sha256_file(staged / "durable-format-manifest-v1.json"),
                "alpha_epoch": durable_doc["alpha_epoch"],
                "writer": durable_doc["writer"],
                "record_registry_digest": durable_doc["record_registry_digest"],
                "compatibility_fixture_digest": durable_doc["compatibility_fixture_digest"],
            },
            "version_topology": {
                "path": "version-topology-v1.json",
                "sha256": sha256_file(staged / "version-topology-v1.json"),
            },
            "container_image": {
                "dockerfile": "release/container/Dockerfile",
                "digest_reference": container_image_digest,
            },
            "driver_distributions": driver_targets,
            "driver_conformance_manifests": conformance_digests,
            "signing_namespace": RELEASE_NAMESPACE,
        }
        write_bytes(staged / "release-provenance-v1.json", canonical_json(provenance))

        checksum_lines: list[str] = []
        for path in sorted(staged.rglob("*")):
            if not path.is_file() or path.is_symlink():
                continue
            rel = path.relative_to(staged).as_posix()
            if rel in {"SHA256SUMS", "SHA256SUMS.sig"}:
                continue
            checksum_lines.append(f"{sha256_file(path)}  {rel}")
        write_bytes(staged / "SHA256SUMS", ("\n".join(checksum_lines) + "\n").encode("utf-8"))

        run(
            [
                "ssh-keygen",
                "-Y",
                "sign",
                "-f",
                str(signing_key),
                "-n",
                RELEASE_NAMESPACE,
                str(staged / "SHA256SUMS"),
            ]
        )
        sig_path = staged / "SHA256SUMS.sig"
        if not sig_path.is_file() or sig_path.is_symlink():
            fail("ssh-keygen did not produce SHA256SUMS.sig")
        sig_path.chmod(0o644)
        staged.rename(output_dir)
    finally:
        shutil.rmtree(temporary, ignore_errors=True)


def verify_release_publication(
    *,
    publication_dir: Path,
    allowed_signers: Path,
    identity: str,
    expected_tag: str | None = None,
) -> None:
    if not publication_dir.is_dir() or publication_dir.is_symlink():
        fail("publication directory must be a real directory")
    checksums = publication_dir / "SHA256SUMS"
    signature = publication_dir / "SHA256SUMS.sig"
    provenance_path = publication_dir / "release-provenance-v1.json"
    if not checksums.is_file() or not signature.is_file() or not provenance_path.is_file():
        fail("signed release checksums or provenance manifest is absent")

    run(
        [
            "ssh-keygen",
            "-Y",
            "verify",
            "-f",
            str(allowed_signers),
            "-I",
            identity,
            "-n",
            RELEASE_NAMESPACE,
            "-s",
            str(signature),
        ],
        stdin_bytes=checksums.read_bytes(),
    )
    run(["sha256sum", "--strict", "--check", "SHA256SUMS"], cwd=publication_dir)

    provenance = json.loads(provenance_path.read_text(encoding="utf-8"))
    if provenance.get("schema") != "riffdb.release-provenance/v1":
        fail("release provenance schema is invalid")
    if expected_tag is not None and provenance.get("release_tag") != expected_tag:
        fail("release provenance tag does not match expected tag")
    version = verify_version_gate(str(provenance.get("release_tag", "")))
    if provenance.get("version") != version:
        fail("release provenance version disagrees with release tag")
    for language in ("go", "python", "rust", "typescript"):
        manifest_path = publication_dir / "conformance" / f"{language}-v1.json"
        if not manifest_path.is_file():
            fail(f"published DRV-014 conformance manifest is absent for {language}")
        if sha256_file(manifest_path) != provenance.get("driver_conformance_manifests", {}).get(language):
            fail(f"published DRV-014 conformance manifest digest mismatch for {language}")
    helm_path = publication_dir / f"riffdb-{version}.tgz"
    consumer_path = publication_dir / "consumer-verification-v1.json"
    if not helm_path.is_file() or not consumer_path.is_file():
        fail("published Helm chart archive or consumer verification receipt is absent")
    if sha256_file(helm_path) != provenance.get("helm_chart", {}).get("sha256"):
        fail("published Helm chart archive digest disagrees with release provenance")
    if sha256_file(consumer_path) != provenance.get("consumer_verification", {}).get("sha256"):
        fail("published consumer verification receipt digest disagrees with release provenance")


def publish_release_registries(
    *,
    publication_dir: Path,
    release_tag: str,
    repository: str,
    notes_file: Path,
    sdist_path: Path | None = None,
    dry_run: bool = False,
    receipt_path: Path | None = None,
) -> dict[str, object]:
    version = verify_version_gate(release_tag)
    if not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", repository):
        fail("repository must match <owner>/<name>")
    if not notes_file.is_file() or notes_file.is_symlink():
        fail("release notes file is absent")
    provenance_path = publication_dir / "release-provenance-v1.json"
    if not provenance_path.is_file():
        fail("release-provenance-v1.json is absent from publication directory")
    provenance = json.loads(provenance_path.read_text(encoding="utf-8"))
    if provenance.get("release_tag") != release_tag or provenance.get("version") != version:
        fail("release provenance tag or version disagrees with requested publication")
    revision = str(provenance.get("revision", ""))
    if not re.fullmatch(r"[0-9a-f]{40}", revision):
        fail("release provenance revision is not a 40-char git SHA")

    drivers_root = publication_dir / "drivers"
    targets = sorted(
        entry.name for entry in drivers_root.iterdir() if entry.is_dir() and not entry.is_symlink()
    )
    if not targets:
        fail("publication directory contains no driver distributions")

    primary_target = "x86_64-unknown-linux-gnu" if "x86_64-unknown-linux-gnu" in targets else targets[0]
    primary_dist = drivers_root / primary_target
    platform_neutral_relpaths = [
        f"npm/riffdb-cli-{version}.tgz",
        f"npm/riffdb-client-{version}.tgz",
        f"pypi/riffdb-{version}-py3-none-any.whl",
        f"go-proxy/riffdb.dev/application/@v/v{version}.info",
        f"go-proxy/riffdb.dev/application/@v/v{version}.mod",
        f"go-proxy/riffdb.dev/application/@v/v{version}.zip",
    ]
    for crate_name in RUST_RUNTIME_PACKAGES:
        platform_neutral_relpaths.append(f"crates/{crate_name}-{version}.crate")

    for rel in platform_neutral_relpaths:
        expected_file = primary_dist / rel
        if not expected_file.is_file():
            fail(f"required package artifact is absent from {primary_target}: {rel}")
        expected_sha = canonical_archive_digest(expected_file)
        for other_target in targets:
            if other_target == primary_target:
                continue
            other_file = drivers_root / other_target / rel
            if not other_file.is_file() or canonical_archive_digest(other_file) != expected_sha:
                fail(f"platform-neutral package artifact drifted across architectures: {rel}")

    driver_tarballs: list[Path] = []
    for target in targets:
        tarball = publication_dir / f"riffdb-driver-distribution-{version}-{target}.tar.gz"
        if not tarball.exists():
            run(
                [
                    "tar",
                    "--sort=name",
                    "--mtime=@0",
                    "--owner=0",
                    "--group=0",
                    "--numeric-owner",
                    "-czf",
                    str(tarball),
                    target,
                ],
                cwd=drivers_root,
            )
        driver_tarballs.append(tarball)

    npm_packages: list[Path] = []
    for target, platform_os, arch in (
        ("x86_64-unknown-linux-gnu", "linux", "x64"),
        ("aarch64-unknown-linux-gnu", "linux", "arm64"),
        ("aarch64-apple-darwin", "darwin", "arm64"),
    ):
        cand = drivers_root / target / "npm" / f"riffdb-cli-{platform_os}-{arch}-{version}.tgz"
        if cand.is_file():
            npm_packages.append(cand)
    npm_packages.append(primary_dist / "npm" / f"riffdb-cli-{version}.tgz")
    npm_packages.append(primary_dist / "npm" / f"riffdb-client-{version}.tgz")

    pypi_packages: list[Path] = []
    for target in targets:
        pypi_dir = drivers_root / target / "pypi"
        for pattern in (
            f"riffdb_application-{version}-cp311-abi3-*.whl",
            f"riffdb_cli-{version}-py3-none-*.whl",
        ):
            pypi_packages.extend(sorted(pypi_dir.glob(pattern)))
    pypi_packages.append(primary_dist / "pypi" / f"riffdb-{version}-py3-none-any.whl")
    if sdist_path is not None:
        if not sdist_path.is_file() or sdist_path.is_symlink():
            fail("supplied Python sdist is absent")
        pypi_packages.append(sdist_path)

    order_path = primary_dist / "metadata/rust-publish-order-v1.txt"
    if order_path.is_file():
        full_order = order_path.read_text(encoding="utf-8").splitlines()
        rust_publish_order = [pkg for pkg in full_order if pkg in RUST_RUNTIME_PACKAGES]
    else:
        rust_publish_order = list(RUST_RUNTIME_PACKAGES)
    if set(rust_publish_order) != set(RUST_RUNTIME_PACKAGES):
        fail("Rust runtime crate closure in distribution is incomplete")

    go_proxy_dir = primary_dist / "go-proxy/riffdb.dev/application/@v"
    go_assets = [
        go_proxy_dir / f"v{version}.info",
        go_proxy_dir / f"v{version}.mod",
        go_proxy_dir / f"v{version}.zip",
    ]
    go_submodule_tag = f"clients/go/runtime/{release_tag}"
    repo_lower = repository.lower()
    ghcr_image = f"ghcr.io/{repo_lower}:{release_tag}"
    ghcr_helm_oci = f"oci://ghcr.io/{repo_lower}/charts"
    helm_archive = publication_dir / f"riffdb-{version}.tgz"

    primary_bundle_name = str(provenance["bundle_archive"]["name"])
    extra_bundle_assets = sorted(
        path
        for path in publication_dir.glob(f"riffdb-{version}-*.tar.gz")
        if path.name != primary_bundle_name
    )
    github_assets = [
        publication_dir / primary_bundle_name,
        *extra_bundle_assets,
        helm_archive,
        publication_dir / "consumer-verification-v1.json",
        publication_dir / "sbom.cdx.json",
        publication_dir / "durable-format-manifest-v1.json",
        publication_dir / "version-topology-v1.json",
        publication_dir / "release-provenance-v1.json",
        publication_dir / "SHA256SUMS",
        publication_dir / "SHA256SUMS.sig",
        *driver_tarballs,
        *go_assets,
        *(publication_dir / "conformance" / f"{lang}-v1.json" for lang in ("go", "python", "rust", "typescript")),
    ]
    for optional_signer in ("riffdb-release-allowed-signers", "riffdb-driver-allowed-signers"):
        signer_path = publication_dir / optional_signer
        if signer_path.is_file():
            github_assets.append(signer_path)
    if sdist_path is not None:
        github_assets.append(sdist_path)
    for asset in github_assets:
        if not asset.is_file() or asset.is_symlink():
            fail(f"required GitHub Release asset is absent: {asset}")

    auth_modes = (
        {"github": "dry_run", "crates_io": "dry_run", "npm": "dry_run", "pypi": "dry_run"}
        if dry_run
        else resolve_registry_auth_modes(os.environ)
    )

    if not dry_run:
        # 1. GitHub Release
        existing_release = subprocess.run(
            ["gh", "release", "view", release_tag],
            cwd=ROOT,
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        if existing_release.returncode == 0:
            run(["gh", "release", "delete", release_tag, "--yes"])
        run(
            [
                "gh",
                "release",
                "create",
                release_tag,
                "--verify-tag",
                "--title",
                f"RiffDB {release_tag}",
                "--notes-file",
                str(notes_file),
                *(str(asset) for asset in github_assets),
            ]
        )

        # 2. GHCR OCI Helm Chart
        run(["helm", "push", str(helm_archive), ghcr_helm_oci])

        # 3. Go submodule tag
        run(["git", "tag", "-f", go_submodule_tag, revision])
        run(["git", "push", "-f", "origin", f"refs/tags/{go_submodule_tag}"])

        # 4. npm Registry (static NPM_TOKEN or GitHub Actions OIDC Trusted Publishing)
        def run_npm_publish(cmd: list[str]) -> None:
            completed = subprocess.run(
                cmd,
                cwd=ROOT,
                check=False,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
            )
            if completed.returncode != 0:
                combined = (completed.stdout + completed.stderr).decode("utf-8", errors="replace")
                if (
                    "cannot publish over the previously published versions" in combined
                    or "EPUBLISHCONFLICT" in combined
                ):
                    return
                sys.stderr.write(combined)
                fail("command failed: " + " ".join(cmd))

        has_oidc = bool(
            os.environ.get("ACTIONS_ID_TOKEN_REQUEST_URL")
            and os.environ.get("ACTIONS_ID_TOKEN_REQUEST_TOKEN")
        )
        if auth_modes["npm"] == "token":
            with tempfile.TemporaryDirectory(prefix="riffdb-npm-pub-") as npm_tmp:
                npmrc = Path(npm_tmp) / ".npmrc"
                write_bytes(
                    npmrc,
                    f"//registry.npmjs.org/:_authToken={os.environ['NPM_TOKEN']}\n".encode("utf-8"),
                    mode=0o600,
                )
                for tarball in npm_packages:
                    cmd = [
                        "npm",
                        "publish",
                        str(tarball),
                        "--access",
                        "public",
                        "--ignore-scripts",
                        "--userconfig",
                        str(npmrc),
                    ]
                    if has_oidc:
                        cmd.append("--provenance")
                    run_npm_publish(cmd)
        else:
            for tarball in npm_packages:
                run_npm_publish(
                    [
                        "npm",
                        "publish",
                        str(tarball),
                        "--provenance",
                        "--access",
                        "public",
                        "--ignore-scripts",
                    ]
                )

        # 5. PyPI Registry (static PYPI_TOKEN or GitHub Actions OIDC Trusted Publishing)
        pypi_token = (
            os.environ["PYPI_TOKEN"]
            if auth_modes["pypi"] == "token"
            else mint_pypi_oidc_token(os.environ)
        )
        run(
            [
                sys.executable,
                "-m",
                "twine",
                "upload",
                "--non-interactive",
                "--skip-existing",
                "-u",
                "__token__",
                "-p",
                pypi_token,
                *(str(pkg) for pkg in pypi_packages),
            ]
        )

        # 6. crates.io Registry
        with tempfile.TemporaryDirectory(prefix="riffdb-crates-pub-") as crate_tmp:
            crate_stage = Path(crate_tmp)
            for crate_name in rust_publish_order:
                archive_path = primary_dist / "crates" / f"{crate_name}-{version}.crate"
                with tarfile.open(archive_path, "r:gz") as tar:
                    tar.extractall(crate_stage, filter="data")
                crate_dir = crate_stage / f"{crate_name}-{version}"
                for reserved in ("Cargo.toml.orig", ".cargo_vcs_info.json", "Cargo.lock"):
                    (crate_dir / reserved).unlink(missing_ok=True)
                manifest_path = crate_dir / "Cargo.toml"
                manifest_text = manifest_path.read_text(encoding="utf-8")
                if "\ndescription =" not in manifest_text:
                    manifest_text = manifest_text.replace(
                        'license = "MIT OR Apache-2.0"\n',
                        f'description = "First-party RiffDB runtime crate ({crate_name})"\n'
                        'repository = "https://github.com/riffdb/riffdb"\n'
                        'license = "MIT OR Apache-2.0"\n',
                        1,
                    )
                    manifest_path.write_text(manifest_text, encoding="utf-8")
                publish_cmd = [
                    "cargo",
                    "+1.99.1",
                    "publish",
                    "--manifest-path",
                    str(manifest_path),
                    "--no-verify",
                    "--allow-dirty",
                ]
                completed = subprocess.run(
                    publish_cmd,
                    cwd=crate_dir,
                    check=False,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                )
                if completed.returncode != 0:
                    combined = (completed.stdout + completed.stderr).decode("utf-8", errors="replace")
                    if (
                        "is already uploaded" not in combined
                        and "already exists on crates.io index" not in combined
                    ):
                        sys.stderr.write(combined)
                        fail("command failed: " + " ".join(publish_cmd))

    receipt = {
        "schema": "riffdb.release-registry-publication/v1",
        "release_tag": release_tag,
        "version": version,
        "revision": revision,
        "dry_run": dry_run,
        "registries": {
            "github_release": {
                "tag": release_tag,
                "asset_count": len(github_assets),
                "assets": [asset.name for asset in github_assets],
            },
            "ghcr": {
                "container_image": ghcr_image,
                "container_digest": provenance["container_image"]["digest_reference"],
                "helm_oci_repository": ghcr_helm_oci,
                "helm_chart_archive": helm_archive.name,
            },
            "npm": {
                "registry": "https://registry.npmjs.org",
                "auth_mode": auth_modes["npm"],
                "packages": [pkg.name for pkg in npm_packages],
            },
            "pypi": {
                "registry": "https://upload.pypi.org",
                "auth_mode": auth_modes["pypi"],
                "packages": [pkg.name for pkg in pypi_packages],
            },
            "crates_io": {
                "registry": "https://crates.io",
                "auth_mode": auth_modes["crates_io"],
                "crates": [f"{name}-{version}.crate" for name in rust_publish_order],
            },
            "go_module": {
                "module": "riffdb.dev/application",
                "submodule_tag": go_submodule_tag,
                "proxy_assets": [asset.name for asset in go_assets],
            },
        },
    }
    if receipt_path is not None:
        write_bytes(receipt_path, canonical_json(receipt))
    return receipt


def resolve_registry_auth_modes(env: Mapping[str, str]) -> dict[str, str]:
    for token_var in ("GH_TOKEN", "CARGO_REGISTRY_TOKEN"):
        if not env.get(token_var):
            fail(f"missing required registry credential environment variable: {token_var}")
    has_oidc = bool(
        env.get("ACTIONS_ID_TOKEN_REQUEST_URL") and env.get("ACTIONS_ID_TOKEN_REQUEST_TOKEN")
    )
    if env.get("NPM_TOKEN"):
        npm_mode = "token"
    elif has_oidc:
        npm_mode = "oidc"
    else:
        fail(
            "missing required npm credential: set NPM_TOKEN or run in GitHub Actions with OIDC Trusted Publishing (id-token: write)"
        )
    if env.get("PYPI_TOKEN"):
        pypi_mode = "token"
    elif has_oidc:
        pypi_mode = "oidc"
    else:
        fail(
            "missing required PyPI credential: set PYPI_TOKEN or run in GitHub Actions with OIDC Trusted Publishing (id-token: write)"
        )
    return {
        "github": "token",
        "crates_io": "token",
        "npm": npm_mode,
        "pypi": pypi_mode,
    }


def mint_pypi_oidc_token(env: Mapping[str, str]) -> str:
    request_url = env.get("ACTIONS_ID_TOKEN_REQUEST_URL", "")
    request_token = env.get("ACTIONS_ID_TOKEN_REQUEST_TOKEN", "")
    if not request_url or not request_token:
        fail("GitHub Actions OIDC environment variables are absent for PyPI Trusted Publishing")
    separator = "&" if "?" in request_url else "?"
    oidc_request = urllib.request.Request(
        f"{request_url}{separator}audience=pypi",
        headers={
            "Authorization": f"Bearer {request_token}",
            "Accept": "application/json; api-version=2.0",
            "User-Agent": "riffdb-release-publisher/1.0",
        },
        method="GET",
    )
    try:
        with urllib.request.urlopen(oidc_request, timeout=30) as response:
            oidc_payload = json.loads(response.read(65536).decode("utf-8"))
    except Exception as exc:  # noqa: BLE001
        fail(f"failed to fetch GitHub OIDC token for PyPI Trusted Publishing: {exc}")
    oidc_jwt = oidc_payload.get("value")
    if not isinstance(oidc_jwt, str) or not oidc_jwt:
        fail("GitHub OIDC token response did not include a valid JWT value")

    mint_request = urllib.request.Request(
        "https://upload.pypi.org/_/oidc/mint-token",
        data=json.dumps({"token": oidc_jwt}).encode("utf-8"),
        headers={
            "Content-Type": "application/json",
            "Accept": "application/json",
            "User-Agent": "riffdb-release-publisher/1.0",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(mint_request, timeout=30) as response:
            mint_payload = json.loads(response.read(65536).decode("utf-8"))
    except Exception as exc:  # noqa: BLE001
        fail(f"failed to exchange GitHub OIDC JWT for PyPI API token: {exc}")
    pypi_token = mint_payload.get("token")
    if not isinstance(pypi_token, str) or not pypi_token:
        fail("PyPI OIDC mint-token response did not include a valid token")
    return pypi_token


def run_self_test() -> None:
    scratch_root = Path(os.environ.get("RIFFDB_TMP_ROOT", str(Path.home() / "tmp")))
    scratch_root.mkdir(parents=True, exist_ok=True)
    scratch = Path(tempfile.mkdtemp(prefix="riffdb-release-publish-selftest-", dir=scratch_root))
    try:
        version = str(json.loads(TOPOLOGY_PATH.read_text(encoding="utf-8"))["release"])
        release_tag = f"v{version}"
        revision = "a" * 40
        target = "x86_64-unknown-linux-gnu"
        bundle_name = f"riffdb-{version}-{target}"
        bundle_archive = scratch / f"{bundle_name}.tar.gz"
        sbom_bytes = b'{"bomFormat":"CycloneDX","specVersion":"1.5"}\n'
        durable_bytes = DURABLE_MANIFEST_PATH.read_bytes()
        req_bytes = b'{"schema":"riffdb.poc-evidence-manifest/v1"}\n'

        with tarfile.open(bundle_archive, "w:gz") as archive:
            for rel, content in (
                (f"{bundle_name}/VERSION", f"{version}\n".encode("utf-8")),
                (f"{bundle_name}/REVISION", f"{revision}\n".encode("utf-8")),
                (f"{bundle_name}/SHA256SUMS", b""),
                (f"{bundle_name}/release/sbom.cdx.json", sbom_bytes),
                (f"{bundle_name}/release/durable-format-manifest-v1.json", durable_bytes),
                (f"{bundle_name}/release/poc-requirements-v1.json", req_bytes),
            ):
                info = tarfile.TarInfo(rel)
                info.size = len(content)
                info.mode = 0o644
                archive.addfile(info, io.BytesIO(content))

        dist = scratch / "driver-dist"
        dist.mkdir()
        write_bytes(dist / "manifest-v1.json", DISTRIBUTION_MANIFEST_PATH.read_bytes())
        write_bytes(dist / "durable-format-manifest-v1.json", durable_bytes)
        for language in ("go", "python", "rust", "typescript"):
            write_bytes(
                dist / f"conformance/{language}-v1.json",
                (ROOT / f"fixtures/driver/manifests/{language}-v1.json").read_bytes(),
            )

        npm_buf = io.BytesIO()
        with tarfile.open(fileobj=npm_buf, mode="w:gz") as archive:
            ts_bytes = (ROOT / "fixtures/driver/manifests/typescript-v1.json").read_bytes()
            info = tarfile.TarInfo("package/conformance-manifest-v1.json")
            info.size = len(ts_bytes)
            info.mode = 0o644
            archive.addfile(info, io.BytesIO(ts_bytes))
        write_bytes(dist / "npm" / f"riffdb-client-{version}.tgz", npm_buf.getvalue())
        write_bytes(dist / "npm" / f"riffdb-cli-{version}.tgz", npm_buf.getvalue())
        write_bytes(dist / "npm" / f"riffdb-cli-linux-x64-{version}.tgz", npm_buf.getvalue())

        py_wheel = dist / "pypi" / f"riffdb-{version}-py3-none-any.whl"
        py_wheel.parent.mkdir(parents=True, exist_ok=True)
        with zipfile.ZipFile(py_wheel, "w", zipfile.ZIP_DEFLATED) as archive:
            archive.writestr(
                f"riffdb-{version}.dist-info/conformance-manifest-v1.json",
                (ROOT / "fixtures/driver/manifests/python-v1.json").read_bytes(),
            )
        write_bytes(
            dist / "pypi" / f"riffdb_application-{version}-cp311-abi3-manylinux_2_28_x86_64.whl",
            py_wheel.read_bytes(),
        )
        write_bytes(
            dist / "pypi" / f"riffdb_cli-{version}-py3-none-manylinux_2_28_x86_64.whl",
            py_wheel.read_bytes(),
        )

        go_zip = dist / "go-proxy/riffdb.dev/application/@v" / f"v{version}.zip"
        go_zip.parent.mkdir(parents=True, exist_ok=True)
        with zipfile.ZipFile(go_zip, "w", zipfile.ZIP_DEFLATED) as archive:
            archive.writestr(
                f"riffdb.dev/application@v{version}/conformance-manifest-v1.json",
                (ROOT / "fixtures/driver/manifests/go-v1.json").read_bytes(),
            )
        write_bytes(dist / "go-proxy/riffdb.dev/application/@v" / f"v{version}.info", b"{}\n")
        write_bytes(dist / "go-proxy/riffdb.dev/application/@v" / f"v{version}.mod", b"module riffdb.dev/application\n")

        for crate_name in RUST_RUNTIME_PACKAGES:
            rust_buf = io.BytesIO()
            with tarfile.open(fileobj=rust_buf, mode="w:gz") as archive:
                rs_bytes = (ROOT / "fixtures/driver/manifests/rust-v1.json").read_bytes()
                info = tarfile.TarInfo(f"{crate_name}-{version}/conformance-manifest-v1.json")
                info.size = len(rs_bytes)
                info.mode = 0o644
                archive.addfile(info, io.BytesIO(rs_bytes))
            write_bytes(dist / "crates" / f"{crate_name}-{version}.crate", rust_buf.getvalue())
        write_bytes(
            dist / "metadata/rust-publish-order-v1.txt",
            ("\n".join(RUST_RUNTIME_PACKAGES) + "\n").encode("utf-8"),
        )

        write_bytes(
            dist / "metadata/artifacts-v1.json",
            canonical_json(
                {
                    "schema": "riffdb.driver-distribution-artifacts/v1",
                    "version": version,
                    "revision": revision,
                    "target": target,
                    "source_clean": True,
                    "artifacts": [],
                    "secrets_included": False,
                }
            ),
        )
        dist_checksums: list[str] = []
        for path in sorted(dist.rglob("*")):
            if path.is_file():
                dist_checksums.append(f"{sha256_file(path)}  {path.relative_to(dist).as_posix()}")
        write_bytes(dist / "checksums.sha256", ("\n".join(dist_checksums) + "\n").encode("utf-8"))

        keys_dir = scratch / "keys"
        keys_dir.mkdir()
        key_path = keys_dir / "release-ed25519"
        run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", "riffdb-release", "-f", str(key_path)])
        pubkey = run(["ssh-keygen", "-y", "-f", str(key_path)]).strip()
        driver_signers = keys_dir / "driver-allowed-signers"
        release_signers = keys_dir / "release-allowed-signers"
        write_bytes(
            driver_signers,
            f'riffdb-release namespaces="{DRIVER_NAMESPACE}" {pubkey}\n'.encode("utf-8"),
        )
        write_bytes(
            release_signers,
            f'riffdb-release namespaces="{RELEASE_NAMESPACE}" {pubkey}\n'.encode("utf-8"),
        )
        run([str(ROOT / "scripts/sign-driver-distributions"), "--key", str(key_path), str(dist)])

        # 1. Negative test: inconsistent release tag must fail before publication.
        bad_out = scratch / "bad-tag-publication"
        try:
            assemble_release_publication(
                release_tag="v0.9.0",
                bundle_archive=bundle_archive,
                driver_distributions=[dist],
                driver_allowed_signers=driver_signers,
                driver_identity="riffdb-release",
                signing_key=key_path,
                container_image_digest="ghcr.io/riffdb/riffdb@sha256:" + ("b" * 64),
                output_dir=bad_out,
            )
        except SystemExit:
            if bad_out.exists():
                fail("failed version transition check still published output")
        else:
            fail("self-test did not refuse mismatched release tag before publication")

        # 2. Positive test: assemble and verify signed release publication.
        pub_out = scratch / "publication"
        assemble_release_publication(
            release_tag=release_tag,
            bundle_archive=bundle_archive,
            driver_distributions=[dist],
            driver_allowed_signers=driver_signers,
            driver_identity="riffdb-release",
            signing_key=key_path,
            container_image_digest="ghcr.io/riffdb/riffdb@sha256:" + ("b" * 64),
            output_dir=pub_out,
        )
        verify_release_publication(
            publication_dir=pub_out,
            allowed_signers=release_signers,
            identity="riffdb-release",
            expected_tag=release_tag,
        )
        checksums_text = (pub_out / "SHA256SUMS").read_text(encoding="utf-8")
        if f"  riffdb-driver-distribution-{version}-{target}.tar.gz\n" not in checksums_text:
            fail("self-test SHA256SUMS omitted the driver distribution archive")
        registry_receipt = scratch / "registry-receipt.json"
        receipt_doc = publish_release_registries(
            publication_dir=pub_out,
            release_tag=release_tag,
            repository="riffdb/riffdb",
            notes_file=ROOT / "release/RELEASE_NOTES.md",
            dry_run=True,
            receipt_path=registry_receipt,
        )
        if set(receipt_doc["registries"]) != {
            "github_release",
            "ghcr",
            "npm",
            "pypi",
            "crates_io",
            "go_module",
        }:
            fail("self-test registry receipt omitted a required registry")

        # 3. Verify static token and OIDC Trusted Publishing credential resolution.
        token_modes = resolve_registry_auth_modes(
            {
                "GH_TOKEN": "gh-test",
                "CARGO_REGISTRY_TOKEN": "cargo-test",
                "NPM_TOKEN": "npm-test",
                "PYPI_TOKEN": "pypi-test",
            }
        )
        if token_modes != {
            "github": "token",
            "crates_io": "token",
            "npm": "token",
            "pypi": "token",
        }:
            fail("self-test token auth resolution returned unexpected modes")
        oidc_modes = resolve_registry_auth_modes(
            {
                "GH_TOKEN": "gh-test",
                "CARGO_REGISTRY_TOKEN": "cargo-test",
                "ACTIONS_ID_TOKEN_REQUEST_URL": "https://example.com/oidc",
                "ACTIONS_ID_TOKEN_REQUEST_TOKEN": "oidc-req-token",
            }
        )
        if oidc_modes != {
            "github": "token",
            "crates_io": "token",
            "npm": "oidc",
            "pypi": "oidc",
        }:
            fail("self-test OIDC Trusted Publishing resolution returned unexpected modes")
        try:
            resolve_registry_auth_modes(
                {
                    "GH_TOKEN": "gh-test",
                    "CARGO_REGISTRY_TOKEN": "cargo-test",
                }
            )
        except SystemExit:
            pass
        else:
            fail("self-test did not reject missing npm/PyPI credentials without OIDC")

        # 4. Negative test: tampering with a published artifact must fail verification.
        tampered = pub_out / "sbom.cdx.json"
        tampered.write_bytes(b'{"tampered":true}\n')
        try:
            verify_release_publication(
                publication_dir=pub_out,
                allowed_signers=release_signers,
                identity="riffdb-release",
                expected_tag=release_tag,
            )
        except SystemExit:
            pass
        else:
            fail("self-test did not reject tampered release artifact")
    finally:
        shutil.rmtree(scratch, ignore_errors=True)
    print("WP-728 release publication, provenance, and version-gate self-test: passed")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="mode")
    parser.add_argument("--self-test", action="store_true")

    assemble_parser = subparsers.add_parser("assemble")
    assemble_parser.add_argument("--release-tag", required=True)
    assemble_parser.add_argument("--bundle-archive", required=True, type=Path)
    assemble_parser.add_argument("--extra-bundle-archive", action="append", default=[], type=Path)
    assemble_parser.add_argument("--driver-distribution", required=True, action="append", type=Path)
    assemble_parser.add_argument("--driver-allowed-signers", required=True, type=Path)
    assemble_parser.add_argument("--driver-identity", required=True)
    assemble_parser.add_argument("--signing-key", required=True, type=Path)
    assemble_parser.add_argument("--container-image-digest", required=True)
    assemble_parser.add_argument("--output", required=True, type=Path)

    verify_parser = subparsers.add_parser("verify")
    verify_parser.add_argument("--publication", required=True, type=Path)
    verify_parser.add_argument("--allowed-signers", required=True, type=Path)
    verify_parser.add_argument("--identity", required=True)
    verify_parser.add_argument("--expected-tag")

    registries_parser = subparsers.add_parser("publish-registries")
    registries_parser.add_argument("--publication", required=True, type=Path)
    registries_parser.add_argument("--release-tag", required=True)
    registries_parser.add_argument("--repository", required=True)
    registries_parser.add_argument(
        "--notes-file", type=Path, default=ROOT / "release/RELEASE_NOTES.md"
    )
    registries_parser.add_argument("--sdist", type=Path)
    registries_parser.add_argument("--dry-run", action="store_true")
    registries_parser.add_argument("--receipt", type=Path)

    arguments = parser.parse_args()
    if arguments.self_test:
        run_self_test()
        return 0
    if arguments.mode == "assemble":
        assemble_release_publication(
            release_tag=arguments.release_tag,
            bundle_archive=arguments.bundle_archive,
            extra_bundle_archives=arguments.extra_bundle_archive,
            driver_distributions=arguments.driver_distribution,
            driver_allowed_signers=arguments.driver_allowed_signers,
            driver_identity=arguments.driver_identity,
            signing_key=arguments.signing_key,
            container_image_digest=arguments.container_image_digest,
            output_dir=arguments.output,
        )
        return 0
    if arguments.mode == "verify":
        verify_release_publication(
            publication_dir=arguments.publication,
            allowed_signers=arguments.allowed_signers,
            identity=arguments.identity,
            expected_tag=arguments.expected_tag,
        )
        return 0
    if arguments.mode == "publish-registries":
        publish_release_registries(
            publication_dir=arguments.publication,
            release_tag=arguments.release_tag,
            repository=arguments.repository,
            notes_file=arguments.notes_file,
            sdist_path=arguments.sdist,
            dry_run=arguments.dry_run,
            receipt_path=arguments.receipt,
        )
        return 0
    parser.print_help(sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
