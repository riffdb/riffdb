#!/usr/bin/env python3
# req: REC-005, REC-008, PERF-014, PERF-019
"""Fail-closed referee for the two exact WP-760 dirty-recovery evidence reports.

Validates the retained dirty-restart lifecycle evidence at the 65,536-row and
production-scale checkpoints: the bounded dirty path reached readiness with a
pinned zero population-walk count, the reported startup stages and total wall
time are present and separately stated, the peak recovery-owned heap is stated
and within the compiled 64 MiB ceiling, the genuine writer kill is evidenced
(PERF-014), and the background scrub's throughput observation is present.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import sys
from pathlib import Path
from typing import Any

RECOVERY_HEAP_CEILING = 64 * 1024 * 1024
STARTUP_STAGES = [
    "store_open",
    "evidence_begin",
    "structural_drain",
    "catalog_history",
    "evidence_finish",
    "port_activation",
    "current_views",
    "consumer_recovery",
    "outbox_recovery",
    "graph_rest",
    "process_to_ready",
]


def refuse(message: str) -> None:
    print(f"wp760_dirty_recovery_evidence_invalid: {message}", file=sys.stderr)
    raise SystemExit(1)


def object_value(value: Any, label: str) -> dict[str, Any]:
    if not isinstance(value, dict):
        refuse(f"{label} is not an object")
    return value


def integer(value: Any, label: str) -> int:
    if not isinstance(value, int) or isinstance(value, bool) or value < 0:
        refuse(f"{label} is not a nonnegative integer")
    return value


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as source:
        while block := source.read(1024 * 1024):
            digest.update(block)
    return digest.hexdigest()


def report_lifecycle(path: Path, checkpoint: str) -> dict[str, Any]:
    try:
        report = object_value(json.loads(path.read_text()), str(path))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        refuse(f"cannot read {path.name}: {error}")
    candidate = object_value(
        report.get("qualification_candidate"), "qualification_candidate"
    )
    if candidate.get("schema") != "riffdb.app-baseline-qualified-candidate/v1":
        refuse(f"{path.name} has the wrong qualification schema")
    if candidate.get("source_tree_clean") is not True:
        refuse(f"{path.name} was not produced from a clean source tree")
    process_rows = report.get("riffdb_process_evidence")
    if not isinstance(process_rows, list) or len(process_rows) != 1:
        refuse(f"{path.name} must contain one process evidence row")
    lifecycle = object_value(
        object_value(process_rows[0], "process evidence").get(
            "production_lifecycle_evidence"
        ),
        "production lifecycle evidence",
    )
    if lifecycle.get("scale_checkpoint") != checkpoint:
        refuse(f"{path.name} has the wrong scale checkpoint")
    if lifecycle.get("schema") != "riffdb.wp-760-dirty-recovery-lifecycle/v1":
        refuse(f"{path.name} is not a dirty-recovery lifecycle report")
    # ADR-0260: V2 sources restart on the bounded dirty path, graceful or not.
    if lifecycle.get("v2_bounded_restart") is not True:
        refuse(f"{path.name} does not state the V2 bounded restart")
    if lifecycle.get("bounded_clean_claim") is not False:
        refuse(f"{path.name} must not claim bounded clean startup")
    return lifecycle


def check_dirty_restart(lifecycle: dict[str, Any], label: str) -> None:
    dirty = object_value(lifecycle.get("dirty_recovery"), f"{label} dirty recovery")
    startup = object_value(dirty.get("startup"), f"{label} dirty startup")
    # ADR-0182 Decision 1: the bounded dirty path reports the closed mode
    # complete_validation and never enumerates a population table.
    if startup.get("mode") != "complete_validation":
        refuse(f"{label} dirty restart did not report the bounded dirty mode")
    if startup.get("stage_names") != STARTUP_STAGES:
        refuse(f"{label} changed the closed startup-stage registry")
    stages = startup.get("stages_us")
    if not isinstance(stages, list) or len(stages) != len(STARTUP_STAGES):
        refuse(f"{label} omitted a startup stage")
    for index, value in enumerate(stages):
        integer(value, f"{label} startup stage {STARTUP_STAGES[index]}")
    # The pinned zero population-walk count: the bounded dirty path rebuilds
    # no transient population index and walks no population table.
    if integer(
        startup.get("transient_index_rebuilds"), f"{label} transient index rebuilds"
    ) != 0:
        refuse(f"{label} dirty restart rebuilt a population index before readiness")
    if startup.get("population_table_walk") != "none":
        refuse(f"{label} dirty restart enumerated a population table")
    # PERF-014: the genuine writer kill is evidenced by the atomic outcome and
    # the matching predeclared twin.
    if dirty.get("matching_clean_twin") is not True:
        refuse(f"{label} dirty recovery did not match its predeclared twin")
    if dirty.get("atomic_outcome") not in ("absent", "committed"):
        refuse(f"{label} in-flight probe did not resolve atomically")
    if dirty.get("second_restart_added_nothing") is not True:
        refuse(f"{label} second restart advanced authority")
    integer(
        dirty.get("unclean_over_clean_process_to_ready_ratio_millis"),
        f"{label} unclean/clean ratio",
    )
    # REC-005: the peak recovery-owned state is measured by the startup
    # evidence session itself (the historical plan's locator index plus the
    # command cache) and must sit within the compiled 64 MiB ceiling. The
    # process heap envelope is reported beside it; it includes engine caches
    # and runtime state, so it is not the recovery-owned bound.
    recovery_owned = integer(
        startup.get("recovery_owned_bytes"), f"{label} recovery-owned bytes"
    )
    if recovery_owned > RECOVERY_HEAP_CEILING:
        refuse(
            f"{label} recovery-owned state {recovery_owned} exceeds the "
            f"{RECOVERY_HEAP_CEILING}-byte ceiling"
        )
    memory = object_value(dirty.get("memory"), f"{label} dirty memory window")
    integer(memory.get("heap_envelope_bytes"), f"{label} dirty heap envelope")


def check_scrub_observation(lifecycle: dict[str, Any], label: str) -> None:
    scrub = lifecycle.get("background_scrub")
    if scrub is None:
        refuse(f"{label} omitted the background scrub observation")
    scrub = object_value(scrub, f"{label} background scrub")
    state = scrub.get("state")
    if state == "complete":
        integer(scrub.get("rows_per_second"), f"{label} scrub rows per second")
        integer(scrub.get("total_us"), f"{label} scrub total time")
        integer(scrub.get("rows_walked"), f"{label} scrub rows walked")
        return
    if state == "failed":
        # The evidence database is healthy: a failed scrub is a false
        # corruption report (for example an evidence-ceiling refusal), never
        # an acceptable observation.
        refuse(f"{label} background scrub failed on a healthy database")
    if state == "cancelled":
        return
    if state in ("pending", "running"):
        # The dirty generation's lifetime is bounded by its measurement and
        # shutdown; a scrub still working at that boundary is honest progress
        # evidence, not an omission. The scrub's own session open performs
        # the population-proportional retained-history validation before any
        # structural page, so a short-lived generation can observe running
        # with zero walked rows. Pending, however, means the worker never
        # started and is refused.
        if state == "pending":
            refuse(f"{label} background scrub never started before shutdown")
        return
    refuse(f"{label} background scrub state {state!r} is not closed")


def check_offline_scrub(lifecycle: dict[str, Any], label: str) -> None:
    # ADR-0203: the complete validator the public `riffdb storage scrub`
    # drives must pass over the healthy final database at this scale.
    scrub = object_value(lifecycle.get("offline_scrub"), f"{label} offline scrub")
    if scrub.get("result") != "passed":
        refuse(f"{label} offline scrub did not pass: {scrub.get('refusal_kind', scrub.get('result'))}")
    integer(scrub.get("total_us"), f"{label} offline scrub total time")


EVIDENCE_ROOT = Path(__file__).resolve().parent.parent / "release" / "evidence" / "wp-760"


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--rows-65536", type=Path, default=EVIDENCE_ROOT / "rows-65536-dirty-recovery.json"
    )
    parser.add_argument(
        "--production", type=Path, default=EVIDENCE_ROOT / "production-dirty-recovery.json"
    )
    parser.add_argument(
        "--receipt", type=Path, default=EVIDENCE_ROOT / "dirty-recovery-receipt.json"
    )
    parser.add_argument(
        "--write",
        action="store_true",
        help="write the receipt instead of requiring the banked one to match",
    )
    args = parser.parse_args()

    rows = report_lifecycle(args.rows_65536, "rows_65536")
    production = report_lifecycle(args.production, "production")

    check_dirty_restart(rows, "rows_65536")
    check_dirty_restart(production, "production")
    check_scrub_observation(rows, "rows_65536")
    check_scrub_observation(production, "production")
    check_offline_scrub(rows, "rows_65536")
    check_offline_scrub(production, "production")

    receipt = {
        "schema": "riffdb.wp-760-dirty-recovery-evidence/v1",
        "rows_65536_report": {"sha256": sha256(args.rows_65536)},
        "production_report": {"sha256": sha256(args.production)},
    }
    rendered = json.dumps(receipt, indent=2) + "\n"
    if args.write:
        args.receipt.write_text(rendered)
    else:
        try:
            banked = args.receipt.read_text()
        except OSError as error:
            refuse(f"cannot read the banked receipt: {error}")
        if banked != rendered:
            refuse("the banked receipt does not bind these exact reports")
    print(
        "WP-760 dirty-recovery evidence accepted: bounded dirty readiness, "
        "pinned zero population walk, recovery heap stated, genuine kill "
        "evidenced, offline complete validation passed at both checkpoints."
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
