#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
runtime="$repo_root/clients/typescript/runtime"
cache="${RIFFDB_NPM_CACHE:-/home/kevin/tmp/npm-cache}"

for tool in cargo jq mkfifo mktemp node npm; do
    command -v "$tool" >/dev/null 2>&1 || {
        echo "required TypeScript acceptance tool is missing: $tool" >&2
        exit 1
    }
done

npm --cache "$cache" --prefix "$runtime" ci --ignore-scripts
npm --prefix "$runtime" run build
npm --prefix "$runtime" test

cargo build --quiet -p riffdb-cli --bin riffdb
riffdb="$repo_root/target/debug/riffdb"
task_tmp_root="${RIFFDB_TMP_ROOT:-$HOME/tmp}"
mkdir -p "$task_tmp_root"
export TMPDIR="$task_tmp_root"
work_root="$(mktemp -d "$task_tmp_root/riffdb-typescript-acceptance.XXXXXX")"
dev_pid=
web_pid=
cleanup() {
    if [[ -n "$web_pid" ]] && kill -0 "$web_pid" 2>/dev/null; then
        kill -TERM "$web_pid" 2>/dev/null || true
        wait "$web_pid" 2>/dev/null || true
    fi
    if [[ -n "$dev_pid" ]] && kill -0 "$dev_pid" 2>/dev/null; then
        kill -TERM "$dev_pid" 2>/dev/null || true
        wait "$dev_pid" 2>/dev/null || true
    fi
    rm -rf "$work_root"
}
trap cleanup EXIT INT TERM

# Prove the actual TypeScript scaffold. This layout matches the sealed bundle
# and requires no registry or network access after publication.
install_root="$work_root/install"
generated_app="$work_root/generated-app"
mkdir -p "$install_root/bin" "$install_root/public/typescript" "$generated_app"
cp "$riffdb" "$install_root/bin/riffdb"
cp -R "$runtime/node_modules" "$install_root/public/typescript/"
"$install_root/bin/riffdb" new ts-alpha \
    --language typescript \
    --directory "$generated_app"
(
    cd "$generated_app"
    npm_config_offline=true npm run check
    npm_config_offline=true npm run build
)

mkfifo "$work_root/generated-dev.fifo"
exec {generated_dev_fd}<>"$work_root/generated-dev.fifo"
(
    cd "$generated_app"
    "$install_root/bin/riffdb" dev --seed
) >"$work_root/generated-dev.fifo" 2>"$work_root/generated-dev.stderr" &
dev_pid=$!
generated_ready=
while IFS= read -r -t 60 line <&"$generated_dev_fd"; do
    case "$line" in
        riffdb-dev-ready-v1$'\t'*) generated_ready="$line"; break ;;
    esac
done
[[ -n "$generated_ready" ]] || {
    sed -n '1,200p' "$work_root/generated-dev.stderr" >&2
    echo "generated TypeScript development server did not become ready" >&2
    exit 1
}
IFS=$'\t' read -r _ endpoint credential role <<<"$generated_ready"
[[ "$role" == "TsAlphaApplication" && -f "$credential" ]] || {
    echo "generated TypeScript scaffold received an invalid application profile" >&2
    exit 1
}

mkfifo "$work_root/generated-web.fifo"
exec {generated_web_fd}<>"$work_root/generated-web.fifo"
node "$generated_app/dist/src/main.js" \
    "$endpoint" "$credential" "$install_root/bin/riffdb" \
    >"$work_root/generated-web.fifo" 2>"$work_root/generated-web.stderr" &
web_pid=$!
IFS= read -r -t 30 generated_web_ready <&"$generated_web_fd" || {
    sed -n '1,200p' "$work_root/generated-web.stderr" >&2
    echo "generated TypeScript web scaffold did not become ready" >&2
    exit 1
}
case "$generated_web_ready" in
    riffdb-app-ready-v1$'\t'*) generated_web_port="${generated_web_ready#*$'\t'}" ;;
    *)
        echo "generated TypeScript web scaffold returned invalid readiness" >&2
        exit 1
        ;;
esac

node -e '
const port = process.argv[1];
const response = await fetch(`http://127.0.0.1:${port}/item`);
if (!response.ok) process.exit(1);
process.stdout.write(`${await response.text()}\n`);
' "$generated_web_port" >"$work_root/generated-observation.json"

jq -e --slurpfile expected \
    "$repo_root/fixtures/application-parity/agent-alpha-observation-v1.json" '
  .outcome == $expected[0].outcome
  and .title == $expected[0].title
  and (.readAfterCommit | type) == "string"
  and (.applicationHead | type) == "string"
  and ((.applicationHead | tonumber) >= (.readAfterCommit | tonumber))
' "$work_root/generated-observation.json" >/dev/null

echo "TypeScript generated web application and offline scaffold acceptance passed"
