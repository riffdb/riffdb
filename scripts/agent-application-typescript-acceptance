#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
runtime="$repo_root/clients/typescript/runtime"
task_tmp_root="${RIFFDB_TMP_ROOT:-$HOME/tmp}"
mkdir -p "$task_tmp_root"
export TMPDIR="$task_tmp_root"

for tool in cargo mktemp node npm; do
    command -v "$tool" >/dev/null 2>&1 || {
        echo "required TypeScript acceptance tool is missing: $tool" >&2
        exit 1
    }
done
[[ -x "$runtime/node_modules/.bin/tsc" ]] || {
    echo "the reviewed offline TypeScript toolchain is unavailable" >&2
    exit 1
}

work_root="$(mktemp -d "$task_tmp_root/riffdb-typescript-acceptance.XXXXXX")"
cleanup() { rm -rf "$work_root"; }
trap cleanup EXIT INT TERM

# The runtime corpus proves one retained framed session, exact u64/decimal
# values, typed public errors, bounded batch results, AbortSignal cancellation,
# event leases, cursor resumption, and clean shutdown.
npm --prefix "$runtime" run build
npm --prefix "$runtime" test

cargo +1.98.1 build --quiet -p riffdb-cli --bin riffdb
install_root="$work_root/install"
generated_app="$work_root/generated-app"
mkdir -p "$install_root/bin" "$install_root/public/typescript" "$generated_app"
cp "$repo_root/target/debug/riffdb" "$install_root/bin/riffdb"
cp -R "$runtime/node_modules" "$install_root/public/typescript/"
"$install_root/bin/riffdb" new ts-alpha --language typescript --directory "$generated_app"

# No package-manager or network operation occurs after scaffolding.
npm_config_offline=true npm --prefix "$generated_app" run check
npm_config_offline=true npm --prefix "$generated_app" run build
rg -q 'DriverApplicationTransport\.connect' "$generated_app/src/main.ts"
! rg -q 'CliApplicationTransport|execFile|credentialFile|google\.golang\.org/grpc|@grpc/grpc-js' \
    "$generated_app/src" "$generated_app/generated/typescript/client.ts"
[[ -f "$generated_app/vendor/riffdb-application/dist/driver.js" ]]
[[ -f "$generated_app/vendor/riffdb-application/dist/driver.d.ts" ]]

"$repo_root/scripts/check-application-boundary" "$generated_app"
cargo +1.98.1 test -p riffdb-testkit-server --test driver_host --all-features

echo "TypeScript long-lived driver and offline generated scaffold acceptance passed"
