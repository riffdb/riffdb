#!/usr/bin/env bash
set -euo pipefail

if [[ "$#" -ne 2 || "$1" != "--all-domains" || "$2" != "--remote" ]]; then
    echo "usage: ./scripts/adapter-disaster-recovery-acceptance --all-domains --remote" >&2
    exit 2
fi

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$repo_root"

task_tmp_root="${RIFFDB_TMP_ROOT:-$HOME/tmp}"
mkdir -p "$task_tmp_root"
export TMPDIR="$task_tmp_root"

for tool in cargo jq; do
    command -v "$tool" >/dev/null 2>&1 || {
        echo "adapter disaster recovery acceptance requires $tool" >&2
        exit 1
    }
done

./scripts/generate-adapter-conformance-fixtures --check
cargo +1.97.0 build --quiet --release -p riffdb-cli --bin riffdb

for domain in openfga mlflow better-auth woodpecker; do
    root="fixtures/adapters/conformance/$domain"
    for plan in empty-install-plan upgrade-plan; do
        target/release/riffdb application conformance \
            "$root/adapter.conformance.json" --plan "$root/$plan.json" --output json \
            | jq -e --arg domain "$domain" '
                .ok == true
                and .command == "application.conformance"
                and .result.adapter == $domain
                and .result.feature_claims == 7
                and .result.evolution_cases == 2
                and (.result.manifest_hash | test("^[0-9a-f]{64}$"))
                and (.result.installation_plan_hash | test("^[0-9a-f]{64}$"))
            ' >/dev/null
    done
done

receipt_root="$(mktemp -d "$task_tmp_root/riffdb-alpha-disaster-evidence.XXXXXX")"
RIFFDB_DISASTER_RECEIPT_ROOT="$receipt_root" \
    ./scripts/remote-compose-acceptance --backup-restore

mapfile -t receipts < <(find "$receipt_root" -maxdepth 1 -type f -name '*.json' -print)
if [[ "${#receipts[@]}" -ne 1 ]]; then
    echo "adapter disaster recovery emitted an invalid receipt inventory" >&2
    exit 1
fi
jq -e '
    .schema == "riffdb.adapter-disaster-receipt/v1"
    and (.adapters | sort) == (["better-auth", "mlflow", "openfga", "woodpecker"] | sort)
    and .startup_validation == "succeeded"
    and .secrets_included == false
    and (.backup_operation_id | type) == "string"
    and (.restore_operation_id | type) == "string"
    and (.backup_manifest_sha256 | test("^[0-9a-f]{64}$"))
    and (.adapter_observation_sha256 | test("^[0-9a-f]{64}$"))
' "${receipts[0]}" >/dev/null

release_evidence_root="$repo_root/release/evidence/alpha"
mkdir -p "$release_evidence_root"
destination="$release_evidence_root/disaster-recovery-v1.json"
pending="$destination.$$.pending"
cp "${receipts[0]}" "$pending"
chmod 0600 "$pending"
mv -f "$pending" "$destination"

echo "The four general-alpha subjects passed remote destructive backup/restore reconciliation without promoting their ADR-0201 evidence classes."
