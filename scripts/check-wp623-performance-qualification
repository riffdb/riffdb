#!/usr/bin/env python3
"""Fail-closed verifier for the WP-623 dual-profile qualification corpus."""

from __future__ import annotations

import argparse
import copy
import hashlib
import json
import math
from pathlib import Path
import re
import sys
from typing import Any


MANIFEST_SCHEMA = "riffdb.wp-623-performance-qualification-manifest/v1"
RECEIPT_SCHEMA = "riffdb.wp-623-performance-qualification/v1"
LOAD_SCHEMA = "riffdb.app-baseline-load-suite/v1"
PARITY_SCHEMA = "riffdb.app-baseline/v1"
CANDIDATE_SCHEMA = "riffdb.app-baseline-qualified-candidate/v1"
MAX_MANIFEST_BYTES = 128 * 1024
MAX_REPORT_BYTES = 16 * 1024 * 1024
REQUIRED_CLASSES = {"workstation_nvme", "cloud_persistent_disk"}
REQUIRED_REPORTS = {"parity_safe_app", "parity_minimal", "interactive", "write_only"}
REQUIRED_REQUIREMENTS = {"PERF-008", "PERF-018", "END-007", "END-008", "END-009", "END-010"}
CLIENTS = {1, 8, 32, 128}
REPETITIONS = 3
MEASURED_SECONDS = 90
WARMUP_SECONDS = 15
MAX_UNARY_RATIO = 1.10
MIN_MIXED_C32_THROUGHPUT_RATIO = 0.90
MAX_MIXED_C32_P95_RATIO = 1.25
MAX_SEED_RATIO = 5.0
COMMON_SCENARIOS = {
    "point_get_ticket",
    "point_get_user",
    "list_tickets_by_project_status",
    "list_open_tickets_for_assignee",
    "list_comments_for_ticket",
    "list_project_members",
    "ticket_detail_page",
    "board_page_50",
    "board_page_200",
    "board_page_450",
    "create_comment",
    "close_ticket_with_comment",
    "swap_member_roles",
    "open_ticket_with_labels",
}
SHA256 = re.compile(r"^[0-9a-f]{64}$")
REVISION = re.compile(r"^[0-9a-f]{40}$")


def fail(detail: str) -> "None":
    raise ValueError(detail)


def exact_string_set(value: Any, expected: set[str]) -> bool:
    return (
        isinstance(value, list)
        and len(value) == len(expected)
        and all(isinstance(item, str) for item in value)
        and set(value) == expected
    )


def load_json(path: Path, maximum: int) -> tuple[dict[str, Any], str]:
    if not path.is_file() or path.is_symlink():
        fail(f"evidence file is absent or linked: {path}")
    encoded = path.read_bytes()
    if not 0 < len(encoded) <= maximum:
        fail(f"evidence file exceeds its byte bound: {path.name}")
    value = json.loads(encoded.decode("utf-8"))
    if not isinstance(value, dict):
        fail(f"evidence root must be an object: {path.name}")
    return value, hashlib.sha256(encoded).hexdigest()


def require_sha(value: Any, label: str) -> str:
    if not isinstance(value, str) or SHA256.fullmatch(value) is None:
        fail(f"{label} is not a lowercase SHA-256 digest")
    return value


def require_number(value: Any, label: str) -> float:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        fail(f"{label} is not numeric")
    result = float(value)
    if not math.isfinite(result) or result < 0:
        fail(f"{label} is not a finite nonnegative number")
    return result


def summary_median(summary: Any, label: str) -> float:
    if not isinstance(summary, dict):
        fail(f"{label} summary is absent")
    if summary.get("stability") != "stable":
        fail(f"{label} is unstable")
    if summary.get("samples") not in (None, REPETITIONS) and summary.get("reps") not in (
        None,
        REPETITIONS,
    ):
        fail(f"{label} does not contain exactly three repetitions")
    return require_number(summary.get("median"), f"{label}.median")


def verify_host(report: dict[str, Any], label: str) -> None:
    host = report.get("host_validity")
    if not isinstance(host, dict):
        fail(f"{label}: host-validity receipt is absent")
    for boundary in ("preflight", "postflight"):
        observation = host.get(boundary)
        if not isinstance(observation, dict) or observation.get("valid") is not True:
            fail(f"{label}: host validity failed at {boundary}")
        if observation.get("interfering_processes") != []:
            fail(f"{label}: interfering process was recorded at {boundary}")
        inventory = observation.get("inventory_bounds") or {}
        if inventory.get("process_arguments_included") is not False:
            fail(f"{label}: host receipt includes or omits the process-argument redaction pin")


def verify_eligibility(report: dict[str, Any], label: str) -> None:
    eligibility = report.get("evidence_eligibility")
    if not isinstance(eligibility, dict) or eligibility.get("eligible") is not True:
        fail(f"{label}: evidence is not eligible")
    for key in (
        "stable",
        "correctness_clean",
        "same_device_comparable",
        "comparison_complete",
        "host_idle",
    ):
        if eligibility.get(key) is not True:
            fail(f"{label}: evidence eligibility {key} is not true")
    if eligibility.get("non_evidentiary_window") is not False:
        fail(f"{label}: measurement window is non-evidentiary")
    if eligibility.get("missing_required_fields") != []:
        fail(f"{label}: required evidence fields are missing")
    if eligibility.get("reason_codes") != []:
        fail(f"{label}: evidence contains an exclusion reason")


def verify_candidate(report: dict[str, Any], manifest: dict[str, Any], label: str) -> None:
    candidate = report.get("qualification_candidate")
    if not isinstance(candidate, dict) or candidate.get("schema") != CANDIDATE_SCHEMA:
        fail(f"{label}: qualification candidate identity is absent")
    if candidate.get("source_tree_clean") is not True:
        fail(f"{label}: candidate source tree was not clean")
    for key in ("cargo_lock_sha256", "runner_sha256", "riffdbd_sha256", "harness_sha256"):
        require_sha(candidate.get(key), f"{label}.{key}")
    for key in ("source_revision", "cargo_lock_sha256", "harness_sha256"):
        if candidate.get(key) != manifest.get(key):
            fail(f"{label}: candidate {key} differs from the qualification manifest")


def verify_durability(report: dict[str, Any], label: str) -> None:
    durability = report.get("postgres_durability") or {}
    if durability.get("fsync") != "on":
        fail(f"{label}: PostgreSQL fsync is not on")
    if durability.get("synchronous_commit") != "on":
        fail(f"{label}: PostgreSQL synchronous_commit is not on")
    if durability.get("full_page_writes") != "on":
        fail(f"{label}: PostgreSQL full_page_writes is not on")
    if report.get("same_device") is not True:
        fail(f"{label}: backends are not on the same storage device")


def verify_common(report: dict[str, Any], manifest: dict[str, Any], label: str) -> None:
    verify_host(report, label)
    verify_eligibility(report, label)
    verify_candidate(report, manifest, label)
    verify_durability(report, label)
    scale = report.get("scale") or {}
    if scale.get("profile") != "full":
        fail(f"{label}: dataset is not the frozen full profile")


def verify_load(
    report: dict[str, Any], manifest: dict[str, Any], profile: str, label: str
) -> dict[str, float]:
    if report.get("schema") != LOAD_SCHEMA:
        fail(f"{label}: wrong load report schema")
    verify_common(report, manifest, label)
    correctness = report.get("correctness") or {}
    if correctness.get("clean") is not True or correctness.get("failures") != []:
        fail(f"{label}: correctness did not reconcile")
    if correctness.get("server_shutdown_error") is not None:
        fail(f"{label}: server shutdown failed")
    comparison = report.get("comparison") or {}
    contract = comparison.get("comparator_contract") or {}
    workload = contract.get("workload") or {}
    if comparison.get("postgres_comparator") != "postgres_safe_app":
        fail(f"{label}: safe-application PostgreSQL is not the comparator")
    if contract.get("postgres_backend_id") != "postgres_safe_app":
        fail(f"{label}: comparator contract drifted")
    if comparison.get("client_points") != [1, 8, 32, 128]:
        fail(f"{label}: concurrency points drifted")
    if comparison.get("backend_isolation") != "counterbalanced_sequential_exclusive_phases":
        fail(f"{label}: backend isolation drifted")
    transports = contract.get("client_transport_shapes") or {}
    if transports != {
        "automatic_command_retries": False,
        "postgres": "one_warm_tcp_connection_per_session",
        "riffdb": "per_session_http2_connection",
    }:
        fail(f"{label}: transport/client shape drifted")
    if workload.get("profile") != profile:
        fail(f"{label}: workload profile drifted")
    if workload.get("duration_ms") != MEASURED_SECONDS * 1000:
        fail(f"{label}: measured duration drifted")
    if workload.get("warmup_ms") != WARMUP_SECONDS * 1000:
        fail(f"{label}: warmup duration drifted")
    if report.get("reps") != REPETITIONS:
        fail(f"{label}: repetition count drifted")

    runs = report.get("backends")
    if not isinstance(runs, list):
        fail(f"{label}: backend matrix is absent")
    expected = {
        (backend, clients, repetition)
        for backend in ("postgres_safe_app", "riffdb_public_grpc")
        for clients in CLIENTS
        for repetition in range(REPETITIONS)
    }
    observed: set[tuple[str, int, int]] = set()
    for run in runs:
        if not isinstance(run, dict):
            fail(f"{label}: backend cell is not an object")
        cell = (run.get("backend_id"), run.get("clients"), run.get("rep"))
        if cell not in expected or cell in observed:
            fail(f"{label}: backend cell identity is invalid or duplicated")
        observed.add(cell)
        if run.get("profile") != profile or run.get("mode") != "closed_loop":
            fail(f"{label}: backend workload shape drifted")
        if run.get("duration_ms") != MEASURED_SECONDS * 1000:
            fail(f"{label}: backend measured duration drifted")
        if run.get("warmup_ms") != WARMUP_SECONDS * 1000:
            fail(f"{label}: backend warmup duration drifted")
        outcomes = (run.get("aggregate") or {}).get("outcomes") or {}
        for outcome in (
            "error",
            "unavailable",
            "overloaded",
            "idempotency_mismatch",
            "history_incarnation_mismatch",
        ):
            if outcomes.get(outcome, 0) != 0:
                fail(f"{label}: {outcome} outcome is nonzero")
        logical = outcomes.get("logical_operations")
        if not isinstance(logical, int) or logical <= 0 or outcomes.get("success") != logical:
            fail(f"{label}: operation totals do not reconcile")
    if observed != expected:
        fail(f"{label}: concurrency/repetition matrix is incomplete")

    summaries = report.get("load_rep_summaries") or {}
    for backend in ("postgres_safe_app", "riffdb_public_grpc"):
        for clients in CLIENTS:
            summary = summaries.get(f"{backend}@clients={clients}")
            if not isinstance(summary, dict):
                fail(f"{label}: repetition summary is absent for {backend} c={clients}")
            for key, value in summary.items():
                if key not in ("backend_id", "clients"):
                    summary_median(value, f"{label}.{backend}.c{clients}.{key}")

    result: dict[str, float] = {}
    if profile == "interactive":
        pg = summaries["postgres_safe_app@clients=32"]
        rd = summaries["riffdb_public_grpc@clients=32"]
        pg_thr = summary_median(pg.get("throughput_ops_s"), f"{label}.pg.c32.throughput")
        rd_thr = summary_median(rd.get("throughput_ops_s"), f"{label}.riffdb.c32.throughput")
        pg_p95 = summary_median(pg.get("aggregate_p95_ns"), f"{label}.pg.c32.p95")
        rd_p95 = summary_median(rd.get("aggregate_p95_ns"), f"{label}.riffdb.c32.p95")
        throughput_ratio = rd_thr / pg_thr if pg_thr else math.inf
        p95_ratio = rd_p95 / pg_p95 if pg_p95 else math.inf
        if throughput_ratio < MIN_MIXED_C32_THROUGHPUT_RATIO:
            fail(
                f"{label}: c32 mixed throughput ratio {throughput_ratio:.4f} is below "
                f"{MIN_MIXED_C32_THROUGHPUT_RATIO:.2f}"
            )
        if p95_ratio > MAX_MIXED_C32_P95_RATIO:
            fail(
                f"{label}: c32 mixed p95 ratio {p95_ratio:.4f} exceeds "
                f"{MAX_MIXED_C32_P95_RATIO:.2f}"
            )
        result = {
            "mixed_c32_throughput_ratio": throughput_ratio,
            "mixed_c32_p95_ratio": p95_ratio,
        }
    return result


def verify_parity(
    report: dict[str, Any], manifest: dict[str, Any], comparator: str, label: str
) -> dict[str, Any]:
    if report.get("schema") != PARITY_SCHEMA:
        fail(f"{label}: wrong parity report schema")
    verify_common(report, manifest, label)
    if report.get("reps") != REPETITIONS:
        fail(f"{label}: parity repetition count drifted")
    if (report.get("board_page_live_crosscheck") or {}).get("status") != "ok":
        fail(f"{label}: order-sensitive board cross-check is absent")
    backends = report.get("backends")
    if not isinstance(backends, list):
        fail(f"{label}: parity backends are absent")
    expected_backend = "postgres_safe_app" if comparator == "safe_app" else "postgres_minimal"
    backend_ids = {row.get("backend_id") for row in backends if isinstance(row, dict)}
    if backend_ids != {expected_backend, "riffdb_public_grpc"}:
        fail(f"{label}: parity backend set drifted")
    comparisons = report.get("comparisons") or {}
    if comparisons.get("available") is not True:
        fail(f"{label}: parity comparison is absent")
    rep_summaries = comparisons.get("rep_summaries") or {}
    if not rep_summaries:
        fail(f"{label}: parity repetition summaries are absent")
    for name, summary in rep_summaries.items():
        summary_median(summary, f"{label}.{name}")

    rows = comparisons.get("scenarios")
    if not isinstance(rows, list):
        fail(f"{label}: parity scenario ratios are absent")
    names = {row.get("scenario") for row in rows if isinstance(row, dict)}
    if names != COMMON_SCENARIOS:
        fail(f"{label}: representative unary scenario set drifted")
    scenario_ratios: dict[str, float] = {}
    for row in rows:
        name = row.get("scenario")
        if row.get("last_row_count_equal") is not True:
            fail(f"{label}: {name} result cardinality differs")
        ratio = summary_median(
            row.get("ratio_riffdb_over_postgres"), f"{label}.scenario.{name}"
        )
        scenario_ratios[str(name)] = ratio
        if comparator == "safe_app" and ratio > MAX_UNARY_RATIO:
            fail(
                f"{label}: {name} ratio {ratio:.4f} exceeds unary gate "
                f"{MAX_UNARY_RATIO:.2f}"
            )
    seed_ratio = summary_median(
        (comparisons.get("seed") or {}).get("ratio_riffdb_over_postgres"),
        f"{label}.seed_ratio",
    )
    if comparator == "safe_app" and seed_ratio > MAX_SEED_RATIO:
        fail(f"{label}: seed ratio {seed_ratio:.4f} exceeds {MAX_SEED_RATIO:.1f}")
    return {"seed_ratio": seed_ratio, "scenario_ratios": scenario_ratios}


def verify_profile(
    profile: dict[str, Any], reports: dict[str, dict[str, Any]], manifest: dict[str, Any]
) -> dict[str, Any]:
    if set(profile) != {"id", "hardware_class", "reports"}:
        fail("qualification profile has an invalid shape")
    profile_id = profile.get("id")
    if not isinstance(profile_id, str) or not profile_id or len(profile_id) > 64:
        fail("profile id is invalid")
    hardware_class = profile.get("hardware_class")
    if hardware_class not in REQUIRED_CLASSES:
        fail(f"{profile_id}: hardware class is invalid")
    references = profile.get("reports")
    if not isinstance(references, list):
        fail(f"{profile_id}: report inventory is absent")
    kinds = [item.get("kind") for item in references if isinstance(item, dict)]
    if not exact_string_set(kinds, REQUIRED_REPORTS):
        fail(f"{profile_id}: report inventory is incomplete")
    runner_digests = {
        (report.get("qualification_candidate") or {}).get("runner_sha256")
        for report in reports.values()
    }
    daemon_digests = {
        (report.get("qualification_candidate") or {}).get("riffdbd_sha256")
        for report in reports.values()
    }
    if len(runner_digests) != 1 or len(daemon_digests) != 1:
        fail(f"{profile_id}: reports do not measure one exact built artifact")
    safe = verify_parity(
        reports["parity_safe_app"], manifest, "safe_app", f"{profile_id}.parity_safe_app"
    )
    verify_parity(
        reports["parity_minimal"], manifest, "minimal", f"{profile_id}.parity_minimal"
    )
    interactive = verify_load(
        reports["interactive"], manifest, "interactive", f"{profile_id}.interactive"
    )
    verify_load(reports["write_only"], manifest, "write_only", f"{profile_id}.write_only")
    return {
        "id": profile_id,
        "hardware_class": hardware_class,
        **interactive,
        "seed_ratio": safe["seed_ratio"],
        "maximum_unary_ratio": max(safe["scenario_ratios"].values()),
        "runner_sha256": require_sha(next(iter(runner_digests)), f"{profile_id}.runner_sha256"),
        "riffdbd_sha256": require_sha(next(iter(daemon_digests)), f"{profile_id}.riffdbd_sha256"),
    }


def verify_manifest(
    manifest: dict[str, Any], loaded_reports: dict[str, dict[str, dict[str, Any]]]
) -> dict[str, Any]:
    expected_keys = {
        "schema",
        "source_revision",
        "cargo_lock_sha256",
        "harness_sha256",
        "requirements",
        "profiles",
    }
    if set(manifest) != expected_keys or manifest.get("schema") != MANIFEST_SCHEMA:
        fail("qualification manifest has an invalid shape or schema")
    revision = manifest.get("source_revision")
    if not isinstance(revision, str) or REVISION.fullmatch(revision) is None:
        fail("qualification source revision is invalid")
    require_sha(manifest.get("cargo_lock_sha256"), "manifest.cargo_lock_sha256")
    require_sha(manifest.get("harness_sha256"), "manifest.harness_sha256")
    if not exact_string_set(manifest.get("requirements"), REQUIRED_REQUIREMENTS):
        fail("qualification requirements are incomplete")
    profiles = manifest.get("profiles")
    if not isinstance(profiles, list) or len(profiles) != len(REQUIRED_CLASSES):
        fail("qualification must contain exactly the workstation and cloud profiles")
    ids = [profile.get("id") for profile in profiles if isinstance(profile, dict)]
    classes = [profile.get("hardware_class") for profile in profiles if isinstance(profile, dict)]
    if len(set(ids)) != len(profiles) or set(classes) != REQUIRED_CLASSES:
        fail("qualification profile identities are duplicated or incomplete")
    results = []
    for profile in profiles:
        profile_id = profile.get("id")
        if profile_id not in loaded_reports:
            fail(f"{profile_id}: loaded report set is absent")
        results.append(verify_profile(profile, loaded_reports[profile_id], manifest))
    return {
        "schema": RECEIPT_SCHEMA,
        "qualified": True,
        "source_revision": revision,
        "cargo_lock_sha256": manifest["cargo_lock_sha256"],
        "harness_sha256": manifest["harness_sha256"],
        "profiles": results,
        "gate_limits": {
            "maximum_unary_ratio": MAX_UNARY_RATIO,
            "minimum_mixed_c32_throughput_ratio": MIN_MIXED_C32_THROUGHPUT_RATIO,
            "maximum_mixed_c32_p95_ratio": MAX_MIXED_C32_P95_RATIO,
            "maximum_seed_ratio": MAX_SEED_RATIO,
        },
    }


def load_manifest_reports(
    root: Path, manifest: dict[str, Any]
) -> dict[str, dict[str, dict[str, Any]]]:
    loaded: dict[str, dict[str, dict[str, Any]]] = {}
    closed_root = (root / "release/evidence/wp-623").resolve()
    for profile in manifest.get("profiles") or []:
        profile_id = profile.get("id")
        loaded[profile_id] = {}
        for reference in profile.get("reports") or []:
            if set(reference) != {"kind", "path", "sha256"}:
                fail(f"{profile_id}: evidence reference has an invalid shape")
            relative = reference.get("path")
            if not isinstance(relative, str):
                fail(f"{profile_id}: evidence path is invalid")
            path = root / relative
            resolved = path.resolve()
            if not resolved.is_relative_to(closed_root):
                fail(f"{profile_id}: evidence path escapes the WP-623 root")
            report, digest = load_json(path, MAX_REPORT_BYTES)
            if digest != require_sha(reference.get("sha256"), f"{profile_id}.{reference.get('kind')}"):
                fail(f"{profile_id}.{reference.get('kind')}: evidence digest differs")
            loaded[profile_id][reference["kind"]] = report
    return loaded


def fake_candidate(manifest: dict[str, Any]) -> dict[str, Any]:
    return {
        "schema": CANDIDATE_SCHEMA,
        "source_revision": manifest["source_revision"],
        "source_tree_clean": True,
        "cargo_lock_sha256": manifest["cargo_lock_sha256"],
        "runner_sha256": "4" * 64,
        "riffdbd_sha256": "5" * 64,
        "harness_sha256": manifest["harness_sha256"],
    }


def fake_common(manifest: dict[str, Any]) -> dict[str, Any]:
    host = {
        "valid": True,
        "interfering_processes": [],
        "inventory_bounds": {"process_arguments_included": False},
    }
    return {
        "scale": {"profile": "full"},
        "same_device": True,
        "postgres_durability": {
            "fsync": "on",
            "synchronous_commit": "on",
            "full_page_writes": "on",
        },
        "host_validity": {"preflight": host, "postflight": copy.deepcopy(host)},
        "evidence_eligibility": {
            "eligible": True,
            "stable": True,
            "correctness_clean": True,
            "same_device_comparable": True,
            "comparison_complete": True,
            "host_idle": True,
            "non_evidentiary_window": False,
            "missing_required_fields": [],
            "reason_codes": [],
        },
        "qualification_candidate": fake_candidate(manifest),
    }


def fake_summary(value: float) -> dict[str, Any]:
    return {
        "samples": REPETITIONS,
        "median": value,
        "min": value,
        "max": value,
        "spread_ratio": 1.0,
        "stability": "stable",
    }


def fake_parity(manifest: dict[str, Any], backend: str) -> dict[str, Any]:
    report = fake_common(manifest)
    rows = [
        {
            "scenario": name,
            "last_row_count_equal": True,
            "ratio_riffdb_over_postgres": fake_summary(1.0),
        }
        for name in sorted(COMMON_SCENARIOS)
    ]
    summaries = {f"scenario:{name}": fake_summary(1.0) for name in COMMON_SCENARIOS}
    summaries["seed_ratio"] = fake_summary(1.0)
    report.update(
        {
            "schema": PARITY_SCHEMA,
            "reps": REPETITIONS,
            "board_page_live_crosscheck": {"status": "ok"},
            "backends": [{"backend_id": backend}, {"backend_id": "riffdb_public_grpc"}],
            "comparisons": {
                "available": True,
                "seed": {"ratio_riffdb_over_postgres": fake_summary(1.0)},
                "scenarios": rows,
                "rep_summaries": summaries,
            },
        }
    )
    return report


def fake_load(manifest: dict[str, Any], profile: str) -> dict[str, Any]:
    report = fake_common(manifest)
    runs = []
    summaries = {}
    for backend in ("postgres_safe_app", "riffdb_public_grpc"):
        for clients in sorted(CLIENTS):
            for repetition in range(REPETITIONS):
                runs.append(
                    {
                        "backend_id": backend,
                        "clients": clients,
                        "rep": repetition,
                        "profile": profile,
                        "mode": "closed_loop",
                        "duration_ms": MEASURED_SECONDS * 1000,
                        "warmup_ms": WARMUP_SECONDS * 1000,
                        "aggregate": {
                            "outcomes": {"logical_operations": 100, "success": 100}
                        },
                    }
                )
            summaries[f"{backend}@clients={clients}"] = {
                "backend_id": backend,
                "clients": clients,
                "throughput_ops_s": fake_summary(1000.0),
                "aggregate_p95_ns": fake_summary(1000.0),
            }
    report.update(
        {
            "schema": LOAD_SCHEMA,
            "reps": REPETITIONS,
            "correctness": {"clean": True, "failures": [], "server_shutdown_error": None},
            "comparison": {
                "postgres_comparator": "postgres_safe_app",
                "client_points": [1, 8, 32, 128],
                "backend_isolation": "counterbalanced_sequential_exclusive_phases",
                "comparator_contract": {
                    "postgres_backend_id": "postgres_safe_app",
                    "client_transport_shapes": {
                        "automatic_command_retries": False,
                        "postgres": "one_warm_tcp_connection_per_session",
                        "riffdb": "per_session_http2_connection",
                    },
                    "workload": {
                        "profile": profile,
                        "duration_ms": MEASURED_SECONDS * 1000,
                        "warmup_ms": WARMUP_SECONDS * 1000,
                    },
                },
            },
            "backends": runs,
            "load_rep_summaries": summaries,
        }
    )
    return report


def run_self_test() -> None:
    manifest = {
        "schema": MANIFEST_SCHEMA,
        "source_revision": "1" * 40,
        "cargo_lock_sha256": "2" * 64,
        "harness_sha256": "3" * 64,
        "requirements": sorted(REQUIRED_REQUIREMENTS),
        "profiles": [
            {
                "id": "workstation",
                "hardware_class": "workstation_nvme",
                "reports": [{"kind": kind} for kind in sorted(REQUIRED_REPORTS)],
            },
            {
                "id": "cloud",
                "hardware_class": "cloud_persistent_disk",
                "reports": [{"kind": kind} for kind in sorted(REQUIRED_REPORTS)],
            },
        ],
    }
    reports = {}
    for profile_id in ("workstation", "cloud"):
        reports[profile_id] = {
            "parity_safe_app": fake_parity(manifest, "postgres_safe_app"),
            "parity_minimal": fake_parity(manifest, "postgres_minimal"),
            "interactive": fake_load(manifest, "interactive"),
            "write_only": fake_load(manifest, "write_only"),
        }
    receipt = verify_manifest(manifest, reports)
    if receipt.get("qualified") is not True:
        fail("valid self-test corpus did not qualify")

    mutations = {
        "missing_profile": lambda m, r: m["profiles"].pop(),
        "host_interference": lambda m, r: r["cloud"]["interactive"]["host_validity"][
            "postflight"
        ].update(valid=False),
        "unstable": lambda m, r: r["cloud"]["interactive"]["load_rep_summaries"][
            "riffdb_public_grpc@clients=32"
        ]["throughput_ops_s"].update(stability="unstable"),
        "shape_drift": lambda m, r: r["workstation"]["interactive"]["comparison"].update(
            client_points=[1, 32]
        ),
        "artifact_drift": lambda m, r: r["cloud"]["write_only"][
            "qualification_candidate"
        ].update(runner_sha256="6" * 64),
        "missing_ratio": lambda m, r: r["cloud"]["parity_safe_app"]["comparisons"][
            "scenarios"
        ][0].pop("ratio_riffdb_over_postgres"),
        "throughput_miss": lambda m, r: r["cloud"]["interactive"]["load_rep_summaries"][
            "riffdb_public_grpc@clients=32"
        ]["throughput_ops_s"].update(median=899.0),
        "tail_miss": lambda m, r: r["cloud"]["interactive"]["load_rep_summaries"][
            "riffdb_public_grpc@clients=32"
        ]["aggregate_p95_ns"].update(median=1251.0),
        "unary_miss": lambda m, r: r["cloud"]["parity_safe_app"]["comparisons"][
            "scenarios"
        ][0]["ratio_riffdb_over_postgres"].update(median=1.101),
        "seed_miss": lambda m, r: r["cloud"]["parity_safe_app"]["comparisons"]["seed"][
            "ratio_riffdb_over_postgres"
        ].update(median=5.001),
    }
    for name, mutate in mutations.items():
        invalid_manifest = copy.deepcopy(manifest)
        invalid_reports = copy.deepcopy(reports)
        mutate(invalid_manifest, invalid_reports)
        try:
            verify_manifest(invalid_manifest, invalid_reports)
        except ValueError:
            print(f"{name}: rejected")
        else:
            fail(f"{name}: invalid qualification passed")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("--manifest", type=Path)
    parser.add_argument("--output", type=Path)
    parser.add_argument("--self-test", action="store_true")
    args = parser.parse_args()
    if args.self_test and (args.manifest is not None or args.output is not None):
        parser.error("--self-test cannot be combined with --manifest or --output")
    if not args.self_test and args.manifest is None:
        parser.error("--manifest is required unless --self-test is used")
    return args


def main() -> int:
    args = parse_args()
    if args.self_test:
        run_self_test()
        print("WP-623 qualification verifier self-test: passed")
        return 0
    root = Path(__file__).resolve().parent.parent
    manifest_path = args.manifest
    if not manifest_path.is_absolute():
        manifest_path = root / manifest_path
    manifest, _ = load_json(manifest_path, MAX_MANIFEST_BYTES)
    reports = load_manifest_reports(root, manifest)
    receipt = verify_manifest(manifest, reports)
    encoded = json.dumps(receipt, indent=2) + "\n"
    if args.output is not None:
        output = args.output if args.output.is_absolute() else root / args.output
        output.parent.mkdir(parents=True, exist_ok=True)
        output.write_text(encoded, encoding="utf-8")
    else:
        print(encoded, end="")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, UnicodeError, json.JSONDecodeError, ValueError) as error:
        print(f"wp623_performance_qualification_invalid: {error}", file=sys.stderr)
        raise SystemExit(3) from error
