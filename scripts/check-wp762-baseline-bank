#!/usr/bin/env python3
"""Verify the WP-762 baseline bank: one qualified receipt set on N1 and E2.

The bank under release/evidence/wp-762/<profile>/ holds, per inventoried
cloud profile, the interactive 32-client receipt and the write-only
concurrency-sweep receipt (riffdb.app-baseline-load-suite/v1, three 90-second
repetitions after 15 warmup seconds), each host-qualified, correctness-clean,
and carrying a qualification candidate whose method binds the ADR-0171
stability rule to the gated backend. The unary matrix is the WP-674 manifest
and baseline assembled with --require-both-profiles.

Every receipt and the unary manifest must name one source revision, lockfile,
harness, runner, and daemon identity. The check prints the banked values
(c32 throughput and p95 ratios, seed ratio, write-only ratios per client
point) so the freeze record and docs/performance/wp-762-baseline-bank.md quote
numbers that the receipts actually contain.

usage: check-wp762-baseline-bank [--bank DIR] [--unary-manifest PATH]
                                 [--unary-baseline PATH] [--json] [--self-test]
"""
# req: PERF-021, PERF-018
from __future__ import annotations

import argparse
import copy
import json
import os
import statistics
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any

LOAD_SCHEMA = "riffdb.app-baseline-load-suite/v1"
CANDIDATE_SCHEMA = "riffdb.app-baseline-qualified-candidate/v1"
UNARY_MANIFEST_SCHEMA = "riffdb.wp-674-unary-manifest/v2"
UNARY_BASELINE_SCHEMA = "riffdb.wp-674-unary-baseline/v2"
PROFILES = ("n1", "e2")
RECEIPTS = {"interactive": "interactive-c32.json", "write_only": "write-only-sweep.json"}
POSTGRES = "postgres_safe_app"
RIFFDB = "riffdb_public_grpc"
IDENTITY_KEYS = ("source_revision", "cargo_lock_sha256", "runner_sha256", "riffdbd_sha256", "harness_sha256")
MAX_BYTES = 64 * 1024 * 1024


def root() -> Path:
    override = os.environ.get("RIFFDB_GOVERNANCE_ROOT")
    if override:
        return Path(override)
    out = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True)
    return Path(out.stdout.strip())


def load(path: Path) -> dict[str, Any]:
    if not path.is_file():
        raise ValueError(f"missing: {path}")
    if path.stat().st_size > MAX_BYTES:
        raise ValueError(f"too large: {path}")
    with path.open("r", encoding="utf-8") as handle:
        value = json.load(handle)
    if not isinstance(value, dict):
        raise ValueError(f"not an object: {path}")
    return value


def summary_median(report: dict[str, Any], backend: str, clients: int, metric: str, label: str) -> float:
    key = f"{backend}@clients={clients}"
    summary = (report.get("load_rep_summaries") or {}).get(key) or {}
    value = summary.get(metric) or {}
    if value.get("stability") != "stable" or not isinstance(value.get("median"), (int, float)):
        raise ValueError(f"{label}: {key}.{metric} is missing or unstable")
    return float(value["median"])


def seed_median(report: dict[str, Any], backend: str, clients: int, label: str) -> float:
    seeds = [
        float(row["seed_ns"])
        for row in report.get("backends") or []
        if isinstance(row, dict) and row.get("backend_id") == backend and row.get("clients") == clients
        and isinstance(row.get("seed_ns"), (int, float)) and row["seed_ns"] > 0
    ]
    if not seeds:
        raise ValueError(f"{label}: no seed timing for {backend} at {clients} clients")
    return statistics.median(seeds)


def verify_receipt(report: dict[str, Any], label: str, kind: str) -> dict[str, Any]:
    if report.get("schema") != LOAD_SCHEMA:
        raise ValueError(f"{label}: schema is not {LOAD_SCHEMA}")
    if int(report.get("reps") or 0) != 3:
        raise ValueError(f"{label}: expected three repetitions")
    eligibility = report.get("evidence_eligibility") or {}
    for key in ("eligible", "host_idle", "stable", "correctness_clean", "same_device_comparable", "comparison_complete"):
        if eligibility.get(key) is not True:
            raise ValueError(f"{label}: evidence_eligibility.{key} is not true")
    if eligibility.get("reason_codes") != [] or eligibility.get("missing_required_fields") != []:
        raise ValueError(f"{label}: evidence carries an exclusion reason or missing field")
    correctness = report.get("correctness") or {}
    if correctness.get("clean") is not True or correctness.get("failures") != []:
        raise ValueError(f"{label}: correctness did not reconcile")
    host = report.get("host_validity") or {}
    for side in ("preflight", "postflight"):
        if (host.get(side) or {}).get("valid") is not True:
            raise ValueError(f"{label}: host validity {side} is not valid")
    candidate = report.get("qualification_candidate") or {}
    if candidate.get("schema") != CANDIDATE_SCHEMA or candidate.get("source_tree_clean") is not True:
        raise ValueError(f"{label}: qualification candidate is absent or the tree was not clean")
    if (candidate.get("method") or {}).get("stability_rule_binds") != "gated_backend":
        raise ValueError(f"{label}: candidate stability rule is not bound to the gated backend")
    identity = {key: candidate.get(key) for key in IDENTITY_KEYS}
    if any(not isinstance(value, str) or not value for value in identity.values()):
        raise ValueError(f"{label}: candidate identity is incomplete")
    values: dict[str, Any] = {"identity": identity}
    if kind == "interactive":
        pg_tp = summary_median(report, POSTGRES, 32, "throughput_ops_s", label)
        rd_tp = summary_median(report, RIFFDB, 32, "throughput_ops_s", label)
        pg_p95 = summary_median(report, POSTGRES, 32, "aggregate_p95_ns", label)
        rd_p95 = summary_median(report, RIFFDB, 32, "aggregate_p95_ns", label)
        values.update({
            "c32_postgres_ops_s": pg_tp,
            "c32_riffdb_ops_s": rd_tp,
            "c32_throughput_ratio": rd_tp / pg_tp,
            "c32_postgres_p95_ms": pg_p95 / 1e6,
            "c32_riffdb_p95_ms": rd_p95 / 1e6,
            "c32_p95_ratio": rd_p95 / pg_p95,
            "seed_ratio": seed_median(report, RIFFDB, 32, label) / seed_median(report, POSTGRES, 32, label),
        })
    else:
        points = sorted({int(row.get("clients")) for row in report.get("curve") or [] if isinstance(row, dict) and row.get("clients")})
        if points != [1, 8, 32, 128]:
            raise ValueError(f"{label}: write-only sweep points are {points}, expected [1, 8, 32, 128]")
        per_client = {}
        for clients in points:
            per_client[str(clients)] = {
                "throughput_ratio": summary_median(report, RIFFDB, clients, "throughput_ops_s", label)
                / summary_median(report, POSTGRES, clients, "throughput_ops_s", label),
                "p95_ratio": summary_median(report, RIFFDB, clients, "aggregate_p95_ns", label)
                / summary_median(report, POSTGRES, clients, "aggregate_p95_ns", label),
                "riffdb_p95_ms": summary_median(report, RIFFDB, clients, "aggregate_p95_ns", label) / 1e6,
            }
        values["write_only"] = per_client
    return values


def verify_bank(bank: Path, unary_manifest: Path, unary_baseline: Path) -> dict[str, Any]:
    result: dict[str, Any] = {"profiles": {}, "errors": []}
    identities: dict[str, dict[str, str]] = {}
    for profile in PROFILES:
        result["profiles"][profile] = {}
        for kind, name in RECEIPTS.items():
            label = f"{profile}/{name}"
            try:
                values = verify_receipt(load(bank / profile / name), label, kind)
            except ValueError as exc:
                result["errors"].append(str(exc))
                continue
            identities[label] = values.pop("identity")
            result["profiles"][profile][kind] = values
    try:
        manifest = load(unary_manifest)
        if manifest.get("schema") != UNARY_MANIFEST_SCHEMA:
            raise ValueError("unary manifest schema is invalid")
        if manifest.get("stability_rule_binds") != "gated_backend":
            raise ValueError("unary manifest stability rule is not bound to the gated backend")
        present = {p.get("id") for p in manifest.get("profiles") or [] if isinstance(p, dict)}
        if not set(PROFILES) <= present:
            raise ValueError(f"unary manifest lacks a profile: has {sorted(present)}")
        identities["unary manifest"] = {
            "source_revision": manifest.get("source_revision"),
            "cargo_lock_sha256": manifest.get("cargo_lock_sha256"),
            "runner_sha256": manifest.get("runner_sha256"),
            "riffdbd_sha256": manifest.get("riffdbd_sha256"),
            "harness_sha256": manifest.get("harness_sha256"),
        }
        baseline = load(unary_baseline)
        if baseline.get("schema") != UNARY_BASELINE_SCHEMA:
            raise ValueError("unary baseline schema is invalid")
        if (baseline.get("method") or {}).get("stability_rule_binds") != "gated_backend":
            raise ValueError("unary baseline stability rule is not bound to the gated backend")
        result["unary"] = {"manifest": str(unary_manifest), "baseline": str(unary_baseline),
                           "profiles": sorted(present)}
    except ValueError as exc:
        result["errors"].append(str(exc))
    distinct = {json.dumps(identity, sort_keys=True) for identity in identities.values()}
    if len(distinct) > 1:
        result["errors"].append("artifact identities differ across receipts: " + "; ".join(
            f"{label} {identity['source_revision'][:8]}/{identity['riffdbd_sha256'][:8]}" for label, identity in identities.items()))
    elif identities:
        result["identity"] = next(iter(identities.values()))
    return result


def render(result: dict[str, Any]) -> str:
    lines = []
    identity = result.get("identity") or {}
    if identity:
        lines.append(f"revision {identity['source_revision']}  riffdbd {identity['riffdbd_sha256'][:12]}  runner {identity['runner_sha256'][:12]}")
    for profile, kinds in result["profiles"].items():
        inter = kinds.get("interactive")
        if inter:
            lines.append(f"{profile} c32: throughput {inter['c32_throughput_ratio']:.3f}x  p95 {inter['c32_p95_ratio']:.3f}x  "
                         f"seed {inter['seed_ratio']:.2f}x  (riffdb {inter['c32_riffdb_ops_s']:.0f} ops/s, p95 {inter['c32_riffdb_p95_ms']:.2f} ms)")
        wo = kinds.get("write_only")
        if wo:
            lines.append(f"{profile} write-only: " + "  ".join(
                f"c{c}: {v['throughput_ratio']:.3f}x/{v['p95_ratio']:.3f}x" for c, v in wo.items()))
    if result.get("unary"):
        lines.append(f"unary: manifest and baseline present for {', '.join(result['unary']['profiles'])}, gated-backend rule")
    return "\n".join(lines)


def self_test() -> bool:
    def receipt(kind: str, identity: dict[str, str], ok: bool = True) -> dict[str, Any]:
        points = [32] if kind == "interactive" else [1, 8, 32, 128]
        summaries = {}
        backends = []
        for backend, base in ((POSTGRES, 1000.0), (RIFFDB, 900.0)):
            for clients in points:
                summaries[f"{backend}@clients={clients}"] = {
                    "throughput_ops_s": {"median": base * clients, "stability": "stable"},
                    "aggregate_p95_ns": {"median": 1e6 * (1.0 if backend == POSTGRES else 1.2), "stability": "stable"},
                }
                for rep in range(3):
                    backends.append({"backend_id": backend, "clients": clients, "rep": rep,
                                     "seed_ns": 1e9 * (1.0 if backend == POSTGRES else 3.5)})
        return {
            "schema": LOAD_SCHEMA, "reps": 3,
            "evidence_eligibility": {"eligible": ok, "host_idle": True, "stable": True, "correctness_clean": True,
                                     "same_device_comparable": True, "comparison_complete": True,
                                     "reason_codes": [], "missing_required_fields": []},
            "correctness": {"clean": True, "failures": []},
            "host_validity": {"preflight": {"valid": True}, "postflight": {"valid": True}},
            "qualification_candidate": {"schema": CANDIDATE_SCHEMA, "source_tree_clean": True,
                                        "method": {"stability_rule_binds": "gated_backend"}, **identity},
            "load_rep_summaries": summaries, "backends": backends,
            "curve": [{"clients": c} for c in points],
        }

    identity = {"source_revision": "a" * 40, "cargo_lock_sha256": "b" * 64, "runner_sha256": "c" * 64,
                "riffdbd_sha256": "d" * 64, "harness_sha256": "e" * 64}
    failures: list[str] = []
    with tempfile.TemporaryDirectory() as tmp:
        bank = Path(tmp) / "bank"
        for profile in PROFILES:
            (bank / profile).mkdir(parents=True)
            for kind, name in RECEIPTS.items():
                (bank / profile / name).write_text(json.dumps(receipt(kind, identity)))
        manifest = Path(tmp) / "manifest.json"
        baseline = Path(tmp) / "baseline.json"
        manifest.write_text(json.dumps({"schema": UNARY_MANIFEST_SCHEMA, "stability_rule_binds": "gated_backend",
                                        "profiles": [{"id": "n1"}, {"id": "e2"}], **identity}))
        baseline.write_text(json.dumps({"schema": UNARY_BASELINE_SCHEMA, "method": {"stability_rule_binds": "gated_backend"}}))
        good = verify_bank(bank, manifest, baseline)
        if good["errors"]:
            failures.append(f"complete bank must pass: {good['errors']}")
        elif abs(good["profiles"]["n1"]["interactive"]["c32_throughput_ratio"] - 0.9) > 1e-9 or abs(good["profiles"]["e2"]["interactive"]["seed_ratio"] - 3.5) > 1e-9:
            failures.append("banked values were not computed from the receipts")

        (bank / "e2" / RECEIPTS["write_only"]).unlink()
        if not verify_bank(bank, manifest, baseline)["errors"]:
            failures.append("a missing E2 receipt must fail")
        (bank / "e2" / RECEIPTS["write_only"]).write_text(json.dumps(receipt("write_only", dict(identity, riffdbd_sha256="f" * 64))))
        if not any("identities differ" in e for e in verify_bank(bank, manifest, baseline)["errors"]):
            failures.append("a differing daemon digest must fail")
        (bank / "e2" / RECEIPTS["write_only"]).write_text(json.dumps(receipt("write_only", identity)))

        bad = receipt("interactive", identity)
        bad["qualification_candidate"]["method"]["stability_rule_binds"] = "gated_backend_only"
        (bank / "n1" / RECEIPTS["interactive"]).write_text(json.dumps(bad))
        if not any("gated backend" in e for e in verify_bank(bank, manifest, baseline)["errors"]):
            failures.append("a receipt not bound to the gated backend must fail")
        (bank / "n1" / RECEIPTS["interactive"]).write_text(json.dumps(receipt("interactive", identity, ok=False)))
        if not any("eligible" in e for e in verify_bank(bank, manifest, baseline)["errors"]):
            failures.append("an ineligible receipt must fail")
        (bank / "n1" / RECEIPTS["interactive"]).write_text(json.dumps(receipt("interactive", identity)))
        manifest.write_text(json.dumps({"schema": UNARY_MANIFEST_SCHEMA, "stability_rule_binds": "gated_backend",
                                        "profiles": [{"id": "n1"}], **identity}))
        if not any("lacks a profile" in e for e in verify_bank(bank, manifest, baseline)["errors"]):
            failures.append("an N1-only unary manifest must fail")
    if failures:
        for failure in failures:
            print(failure, file=sys.stderr)
        return False
    print("wp762 baseline-bank self-test passed.")
    return True


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--bank", type=Path)
    parser.add_argument("--unary-manifest", type=Path)
    parser.add_argument("--unary-baseline", type=Path)
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--self-test", action="store_true")
    args = parser.parse_args()
    if args.self_test:
        return 0 if self_test() else 1
    repo = root()
    bank = args.bank or repo / "release/evidence/wp-762"
    manifest = args.unary_manifest or repo / "release/evidence/wp-674/manifest-v1.json"
    baseline = args.unary_baseline or repo / "release/evidence/wp-674/baseline-v1.json"
    if not bank.is_dir():
        print(f"no bank at {bank}; WP-762 has not banked a baseline")
        return 0
    result = verify_bank(bank, manifest, baseline)
    if args.json:
        print(json.dumps(result, indent=2))
    else:
        print(render(result))
        for error in result["errors"]:
            print(error, file=sys.stderr)
    return 1 if result["errors"] else 0


if __name__ == "__main__":
    sys.exit(main())
