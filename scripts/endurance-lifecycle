#!/usr/bin/env python3
"""Run one real, receipted lifecycle action for the alpha endurance harness."""

from __future__ import annotations

import fcntl
import hashlib
import json
import os
from pathlib import Path
import signal
import shutil
import subprocess
import sys
import time
from typing import Any


STATE_SCHEMA = "riffdb.alpha-endurance-lifecycle-state/v1"
RESULT_SCHEMA = "riffdb.alpha-endurance-action-result/v1"
WORKER_SCHEMA = "riffdb.alpha-endurance-worker/v1"
LANGUAGES = ("go", "python", "rust", "typescript")
MAX_JSON_BYTES = 1024 * 1024
JOURNAL_HEADER_BYTES = 4096
JOURNAL_MAGIC = b"RDBJEX03"
MAX_RETAINED_BACKUPS = 2


def fail(message: str) -> "None":
    raise ValueError(message)


def artifact_root() -> Path:
    raw = os.environ.get("RIFFDB_ENDURANCE_ARTIFACT_ROOT", "")
    candidate = Path(raw)
    if not raw or not candidate.is_absolute() or candidate.is_symlink() or not candidate.is_dir():
        fail("RIFFDB_ENDURANCE_ARTIFACT_ROOT must be an absolute non-symlink directory")
    return candidate


def read_object(path: Path) -> dict[str, Any]:
    if path.is_symlink() or not path.is_file():
        fail(f"endurance lifecycle input is absent: {path.name}")
    encoded = path.read_bytes()
    if not 0 < len(encoded) <= MAX_JSON_BYTES:
        fail(f"endurance lifecycle input exceeds its byte bound: {path.name}")
    value = json.loads(encoded)
    if not isinstance(value, dict):
        fail(f"endurance lifecycle input is not an object: {path.name}")
    return value


def integer(value: Any, name: str) -> int:
    if type(value) is not int or value < 0:
        fail(f"endurance lifecycle {name} is invalid")
    return value


def journal_generation(database: Path, *, allow_absent: bool = False) -> int:
    generations: list[int] = []
    for suffix in (".riffjournal", ".riffjournal.checkpoint"):
        candidate = Path(f"{database}{suffix}")
        if not candidate.exists():
            continue
        if candidate.is_symlink() or not candidate.is_file():
            fail("endurance journal extent is not a regular file")
        with candidate.open("rb") as source:
            for _slot in range(2):
                header = source.read(JOURNAL_HEADER_BYTES)
                if len(header) != JOURNAL_HEADER_BYTES:
                    break
                if header[: len(JOURNAL_MAGIC)] != JOURNAL_MAGIC:
                    continue
                if hashlib.sha256(header[:-32]).digest() != header[-32:]:
                    continue
                generation = int.from_bytes(header[32:40], "big")
                if generation > 0:
                    generations.append(generation)
    if not generations and allow_absent:
        return 0
    if not generations:
        fail("endurance journal generation is unavailable")
    return max(generations)


def initial_state(generation: int) -> dict[str, Any]:
    return {
        "schema": STATE_SCHEMA,
        "journal_generation": generation,
        "retention_watermark": 0,
        "tombstone_count": 0,
        "writer_queue_depth": 0,
        "consumer_backlog": 0,
        "backup_count": 0,
        "capability_administration_sequence": 0,
        "certificate_rotation_count": 0,
        "deployment_count": 0,
        "checkpoint_count": 0,
        "checkpoint_frontier": 0,
        "recovery_count": 0,
        "restart_count": 0,
        "reactive_operations": 0,
        "lifecycle_microseconds": 0,
    }


def validate_state(value: dict[str, Any]) -> None:
    expected = set(initial_state(1))
    if set(value) != expected or value.get("schema") != STATE_SCHEMA:
        fail("endurance lifecycle state has an invalid shape")
    for name in expected - {"schema"}:
        integer(value.get(name), name)


def atomic_write(path: Path, value: dict[str, Any]) -> None:
    pending = path.with_name(f".{path.name}.{os.getpid()}.pending")
    encoded = json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n"
    try:
        with pending.open("x", encoding="utf-8") as destination:
            os.chmod(pending, 0o600)
            destination.write(encoded)
            destination.flush()
            os.fsync(destination.fileno())
        pending.replace(path)
    finally:
        if pending.exists():
            pending.unlink()


def run_json(
    argv: list[str],
    *,
    cwd: Path | None = None,
    timeout_seconds: int = 180,
    allow_unavailable: bool = False,
) -> dict[str, Any] | None:
    result = subprocess.run(
        argv,
        cwd=cwd,
        stdin=subprocess.DEVNULL,
        capture_output=True,
        text=True,
        timeout=timeout_seconds,
        check=False,
    )
    if result.returncode != 0:
        if allow_unavailable:
            return None
        fail("endurance public operation failed")
    if not 0 < len(result.stdout.encode()) <= MAX_JSON_BYTES:
        fail("endurance public operation result exceeds its bound")
    value = json.loads(result.stdout)
    if (
        not isinstance(value, dict)
        or value.get("schema") != "riffdb.cli.output/v1"
        or value.get("ok") is not True
        or not isinstance(value.get("result"), dict)
    ):
        fail("endurance public operation result is invalid")
    return value


def cli(environment: Path) -> list[str]:
    state = read_object(environment / "state.json")
    executable = Path(str(state.get("riffdb", "")))
    if not executable.is_absolute() or executable.is_symlink() or not executable.is_file():
        fail("endurance CLI installation is invalid")
    return [
        str(executable),
        "--config",
        str(environment / "bootstrap-client.toml"),
    ]


def retention_cli(environment: Path) -> list[str]:
    state = read_object(environment / "state.json")
    executable = Path(str(state.get("riffdb", "")))
    config = environment / "retention-seeder-client.toml"
    if (
        not executable.is_absolute()
        or executable.is_symlink()
        or not executable.is_file()
        or config.is_symlink()
        or not config.is_file()
    ):
        fail("endurance retention-lane CLI installation is invalid")
    return [str(executable), "--config", str(config)]


def retention_status(environment: Path, database: Path) -> dict[str, Any]:
    status = run_json(
        cli(environment)
        + [
            "retention",
            "status",
            "--database-path",
            str(database),
            "--output",
            "json",
        ]
    )
    if status is None or status.get("command") != "retention.status":
        fail("endurance retention status unexpectedly returned no result")
    return status["result"]


def positive_decimal(value: Any, name: str) -> int:
    if (
        not isinstance(value, str)
        or not value.isascii()
        or not value.isdigit()
        or value == "0"
    ):
        fail(f"endurance lifecycle {name} is invalid")
    return int(value)


def positive_decimal_or_zero(value: Any, name: str) -> int:
    if (
        not isinstance(value, str)
        or not value.isascii()
        or not value.isdigit()
    ):
        fail(f"endurance lifecycle {name} is invalid")
    return int(value)


def sha256_file(path: Path) -> str:
    if path.is_symlink() or not path.is_file():
        fail("endurance evidence artifact is not a regular file")
    digest = hashlib.sha256()
    with path.open("rb") as source:
        while chunk := source.read(1024 * 1024):
            digest.update(chunk)
    return digest.hexdigest()


def atomic_replace_file(source: Path, destination: Path, mode: int) -> None:
    if source.is_symlink() or not source.is_file() or destination.is_symlink():
        fail("endurance certificate rotation source is invalid")
    pending = destination.with_name(f".{destination.name}.{os.getpid()}.pending")
    try:
        with source.open("rb") as reader, pending.open("xb") as writer:
            os.chmod(pending, mode)
            shutil.copyfileobj(reader, writer, length=64 * 1024)
            writer.flush()
            os.fsync(writer.fileno())
        pending.replace(destination)
        directory = os.open(destination.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if pending.exists():
            pending.unlink()


def reactive_operations(environment: Path) -> tuple[int, int, int]:
    operations = 0
    acknowledgements = 0
    events_emitted = 0
    for language in LANGUAGES:
        value = read_object(environment / "metrics" / f"{language}.json")
        if value.get("schema") != WORKER_SCHEMA or value.get("language") != language:
            fail("endurance worker metric identity is invalid")
        workloads = value.get("workloads")
        if not isinstance(workloads, dict):
            fail("endurance worker workload metrics are absent")
        operations += integer(workloads.get("events"), f"{language}.events")
        operations += integer(workloads.get("workflows"), f"{language}.workflows")
        acknowledgements += integer(
            value.get("consumer_acknowledgements"),
            f"{language}.consumer_acknowledgements",
        )
        events_emitted += integer(value.get("events_emitted"), f"{language}.events_emitted")
    return operations, acknowledgements, events_emitted


def process_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        fail("endurance server process ownership changed")
    return True


def health_frontier(environment: Path) -> int:
    state = read_object(environment / "state.json")
    executable = Path(str(state.get("riffdb", "")))
    if not executable.is_absolute() or executable.is_symlink() or not executable.is_file():
        fail("endurance CLI installation is invalid")
    result = subprocess.run(
        [
            str(executable),
            "--config",
            str(environment / "bootstrap-client.toml"),
            "server",
            "health",
            "--output",
            "json",
        ],
        stdin=subprocess.DEVNULL,
        capture_output=True,
        text=True,
        timeout=30,
        check=False,
    )
    if result.returncode != 0:
        fail("endurance server health failed")
    value = json.loads(result.stdout)
    payload = value.get("result") if isinstance(value, dict) else None
    frontier = payload.get("last_commit_sequence") if isinstance(payload, dict) else None
    components = payload.get("components") if isinstance(payload, dict) else None
    component_statuses: dict[str, str] = {}
    if isinstance(components, list):
        for component in components:
            if not isinstance(component, dict):
                fail("endurance server health component is invalid")
            name = component.get("component")
            status = component.get("status")
            if (
                not isinstance(name, str)
                or not isinstance(status, str)
                or name in component_statuses
            ):
                fail("endurance server health component is invalid")
            component_statuses[name] = status
    critical_components_healthy = all(
        component_statuses.get(name) == "healthy"
        for name in ("authoritative_storage", "catalog", "commit_coordinator")
    )
    if (
        not isinstance(value, dict)
        or not isinstance(payload, dict)
        or value.get("schema") != "riffdb.cli.output/v1"
        or value.get("ok") is not True
        or payload.get("status") not in ("ready", "degraded")
        or payload.get("database") != "default"
        or not critical_components_healthy
        or (
            frontier is not None
            and (
                not isinstance(frontier, str)
                or not frontier.isascii()
                or not frontier.isdigit()
                or frontier == "0"
            )
        )
    ):
        fail("endurance server health is not an authenticated serving frontier")
    # Authenticated health omits the optional application head before the first
    # command commit. That is the canonical before-first position, not an
    # unavailable observation.
    return 0 if frontier is None else int(frontier)


def shutdown_writer_queue_depth(stdout: Path, offset: int) -> int:
    if stdout.is_symlink() or not stdout.is_file():
        fail("endurance server output is unavailable")
    with stdout.open("rb") as source:
        source.seek(offset)
        suffix = source.read(MAX_JSON_BYTES + 1)
    if len(suffix) > MAX_JSON_BYTES:
        fail("endurance server shutdown evidence exceeds its byte bound")
    lines = [
        line.decode("ascii")
        for line in suffix.splitlines()
        if line.startswith(b"riffdb-writer-evidence-v1\t")
    ]
    if len(lines) != 2:
        fail("endurance server emitted an incomplete writer evidence inventory")
    depths = []
    for line in lines:
        scalar = line.split("\t", 2)[1]
        fields = {}
        for item in scalar.split(";"):
            name, separator, raw = item.partition("=")
            if not separator or name in fields:
                fail("endurance writer evidence is malformed")
            fields[name] = raw
        raw_depth = fields.get("dispatch_deferred_max")
        if raw_depth is None or not raw_depth.isascii() or not raw_depth.isdigit():
            fail("endurance writer queue evidence is absent")
        depths.append(int(raw_depth))
    return max(depths)


def inspect_checkpoint(environment: Path) -> int:
    executable = environment / "bin" / "riffdb-endurance-inspect"
    database = environment / "data" / "ticketdesk.redb"
    if executable.is_symlink() or not executable.is_file():
        fail("endurance stopped-database inspector is absent")
    result = subprocess.run(
        [str(executable), str(database)],
        stdin=subprocess.DEVNULL,
        capture_output=True,
        text=True,
        timeout=30,
        check=False,
    )
    if result.returncode != 0:
        fail("endurance checkpoint inspection failed")
    value = json.loads(result.stdout)
    checkpoint = value.get("checkpoint_commit_sequence") if isinstance(value, dict) else None
    if value.get("schema") != "riffdb.alpha-endurance-storage-inspection/v1":
        fail("endurance checkpoint inspection identity is invalid")
    return integer(checkpoint, "checkpoint_commit_sequence")


def wait_stopped(pid: int, timeout_seconds: int) -> None:
    deadline = time.monotonic() + timeout_seconds
    while process_alive(pid):
        if time.monotonic() >= deadline:
            fail("endurance server did not stop before the bounded deadline")
        time.sleep(0.05)


def stop_server(
    environment: Path,
) -> tuple[dict[str, Any], int, int, int]:
    process_state_path = environment / "state.json"
    process_state = read_object(process_state_path)
    old_pid = integer(process_state.get("server_pid"), "server_pid")
    if not process_alive(old_pid):
        fail("endurance server was not running before lifecycle restart")
    before_frontier = health_frontier(environment)
    stdout_path = environment / "server.stdout"
    stdout_offset = stdout_path.stat().st_size
    with (environment / "server.input").open("w", encoding="ascii") as control:
        control.write("shutdown\n")
        control.flush()
    wait_stopped(old_pid, 45)
    checkpoint = inspect_checkpoint(environment)
    if checkpoint < before_frontier:
        fail("graceful shutdown checkpoint precedes the observed application frontier")
    queue_depth = shutdown_writer_queue_depth(stdout_path, stdout_offset)
    return process_state, before_frontier, checkpoint, queue_depth


def start_server(
    environment: Path,
    process_state: dict[str, Any],
    minimum_frontier: int,
) -> int:
    stdin = (environment / "server.input").open("rb", buffering=0)
    stdout = (environment / "server.stdout").open("ab", buffering=0)
    stderr = (environment / "server.stderr").open("ab", buffering=0)
    process: subprocess.Popen[bytes] | None = None
    try:
        process = subprocess.Popen(
            [str(environment / "bin" / "riffdbd"), "--config", str(environment / "riffdbd.toml")],
            stdin=stdin,
            stdout=stdout,
            stderr=stderr,
            start_new_session=True,
        )
    finally:
        stdin.close()
        stdout.close()
        stderr.close()
    if process is None:
        fail("endurance server restart did not launch")
    try:
        deadline = time.monotonic() + 60
        after_frontier = 0
        ready = False
        while time.monotonic() < deadline:
            if process.poll() is not None:
                fail("endurance server exited before restart readiness")
            try:
                after_frontier = health_frontier(environment)
                if after_frontier >= minimum_frontier:
                    ready = True
                    break
                time.sleep(0.1)
            except (json.JSONDecodeError, OSError, subprocess.SubprocessError, ValueError):
                time.sleep(0.1)
        if not ready or after_frontier < minimum_frontier:
            fail(
                "restarted server did not publish the checkpoint frontier "
                f"(required {minimum_frontier}, observed {after_frontier})"
            )
    except BaseException:
        if process.poll() is None:
            process.send_signal(signal.SIGTERM)
        raise

    process_state["server_pid"] = process.pid
    atomic_write(environment / "state.json", process_state)
    return after_frontier


def restart_server(environment: Path, lifecycle: dict[str, Any]) -> tuple[int, int, int]:
    process_state, before_frontier, checkpoint, queue_depth = stop_server(environment)
    after_frontier = start_server(environment, process_state, checkpoint)
    lifecycle["writer_queue_depth"] = max(
        integer(lifecycle["writer_queue_depth"], "writer_queue_depth"), queue_depth
    )
    lifecycle["checkpoint_count"] = integer(lifecycle["checkpoint_count"], "checkpoint_count") + 1
    lifecycle["checkpoint_frontier"] = checkpoint
    lifecycle["restart_count"] = integer(lifecycle["restart_count"], "restart_count") + 1
    return before_frontier, after_frontier, queue_depth


def evidence_digest(environment: Path, name: str, ordinal: int, evidence: dict[str, Any]) -> str:
    evidence_root = environment / "lifecycle-evidence"
    evidence_root.mkdir(mode=0o700, exist_ok=True)
    path = evidence_root / f"{name}-{ordinal:06}.json"
    atomic_write(path, evidence)
    return hashlib.sha256(path.read_bytes()).hexdigest()


def initialize(environment: Path, state_path: Path) -> None:
    if state_path.exists():
        fail("endurance lifecycle state already exists")
    database = environment / "data" / "ticketdesk.redb"
    # The standard-profile extent is created lazily by the first application
    # command. Environment setup deliberately precedes workload launch, so an
    # absent extent is the only honest initial observation. Every subsequent
    # sample and recycle action still requires a validated real extent header.
    atomic_write(
        state_path,
        initial_state(journal_generation(database, allow_absent=True)),
    )


def journal_recycle(environment: Path, state: dict[str, Any]) -> tuple[int, int, dict[str, Any]]:
    before = integer(state["journal_generation"], "journal_generation")
    database = environment / "data" / "ticketdesk.redb"
    deadline = time.monotonic() + 540
    while True:
        after = journal_generation(database)
        if after > before:
            state["journal_generation"] = after
            return before, after, {
                "schema": "riffdb.alpha-endurance-journal-recycle-evidence/v1",
                "generation_before": before,
                "generation_after": after,
                "database": "default",
            }
        if time.monotonic() >= deadline:
            fail("journal generation did not recycle before the bounded deadline")
        time.sleep(0.25)


def reactive_consumer(environment: Path, state: dict[str, Any]) -> tuple[int, int, dict[str, Any]]:
    before = integer(state["reactive_operations"], "reactive_operations")
    deadline = time.monotonic() + 60
    while True:
        operations, acknowledgements, events_emitted = reactive_operations(environment)
        if acknowledgements > before and operations > 0:
            state["reactive_operations"] = acknowledgements
            backlog = max(0, events_emitted * 2 - acknowledgements)
            state["consumer_backlog"] = backlog
            return before, acknowledgements, {
                "schema": "riffdb.alpha-endurance-reactive-consumer-evidence/v1",
                "acknowledgements_before": before,
                "acknowledgements_after": acknowledgements,
                "reactive_operations": operations,
                "events_emitted": events_emitted,
                "consumer_backlog": backlog,
                "languages": list(LANGUAGES),
            }
        if time.monotonic() >= deadline:
            fail("reactive consumers did not advance before the bounded deadline")
        time.sleep(0.1)


def backup(environment: Path, state: dict[str, Any]) -> tuple[int, int, dict[str, Any]]:
    backup_root = environment / "backups" / "default"
    if backup_root.is_symlink() or not backup_root.is_dir():
        fail("endurance backup root is invalid")
    existing = sorted(
        path.name
        for path in backup_root.iterdir()
        if path.name != ".maintenance" and path.is_dir() and not path.is_symlink()
    )
    before = integer(state["backup_count"], "backup_count")
    if len(existing) > MAX_RETAINED_BACKUPS or any(
        not name.startswith("endurance-") for name in existing
    ):
        fail("endurance backup inventory exceeds its closed retention policy")
    name = f"endurance-{before + 1:06d}"
    started = run_json(cli(environment) + ["backup", "create", name, "--output", "json"])
    if started is None:
        fail("endurance backup start unexpectedly returned no result")
    started_result = started["result"]
    if (
        started.get("command") != "backup.create"
        or started_result.get("status") != "accepted"
        or started_result.get("kind") != "create_backup"
        or started_result.get("backup_name") != name
    ):
        fail("endurance backup was not accepted with the exact identity")
    operation_id = started_result.get("maintenance_operation_id")
    if not isinstance(operation_id, str) or len(operation_id) != 36:
        fail("endurance backup operation identity is invalid")

    deadline = time.monotonic() + 180
    terminal: dict[str, Any] | None = None
    while time.monotonic() < deadline:
        polled = run_json(
            cli(environment)
            + ["backup", "operation", operation_id, "--output", "json"],
            timeout_seconds=30,
            allow_unavailable=True,
        )
        if polled is not None:
            candidate = polled["result"]
            if (
                polled.get("command") == "backup.operation"
                and candidate.get("status") == "found"
                and candidate.get("maintenance_operation_id") == operation_id
                and candidate.get("kind") == "create_backup"
                and candidate.get("backup_name") == name
            ):
                if candidate.get("phase") == "succeeded":
                    terminal = candidate
                    break
                if candidate.get("phase") in {"failed", "refused"}:
                    fail("endurance backup reached a non-success terminal phase")
        # Offline maintenance deliberately closes and reopens the listener;
        # polling remains bounded and identity-stable across that interval.
        time.sleep(0.1)
    if terminal is None:
        fail("endurance backup did not complete before its bounded deadline")

    backup_path = backup_root / name
    expected = {"database.redb", "journal.riffextent", "format.riffdb", "manifest.riffdb"}
    actual = {
        path.name
        for path in backup_path.iterdir()
        if path.is_file() and not path.is_symlink()
    }
    if actual != expected:
        fail("endurance backup closed inventory is invalid")
    inventory = [
        {
            "name": artifact,
            "bytes": (backup_path / artifact).stat().st_size,
            "sha256": sha256_file(backup_path / artifact),
        }
        for artifact in sorted(expected)
    ]
    published = sorted(
        path.name
        for path in backup_root.iterdir()
        if path.name != ".maintenance" and path.is_dir() and not path.is_symlink()
    )
    if name not in published or len(published) != len(existing) + 1:
        fail("endurance backup did not publish exactly one immutable inventory")
    retired_backup_names = published[:-MAX_RETAINED_BACKUPS]
    retirement_receipts: list[dict[str, Any]] = []
    for retired_name in retired_backup_names:
        retired = backup_root / retired_name
        if (
            retired.parent != backup_root
            or retired.is_symlink()
            or not retired.is_dir()
            or not retired_name.startswith("endurance-")
        ):
            fail("endurance backup retirement target is invalid")
        retirement = run_json(
            cli(environment) + ["backup", "retire", retired_name, "--output", "json"]
        )
        if retirement is None:
            fail("endurance backup retirement unexpectedly returned no result")
        retirement_result = retirement["result"]
        if (
            retirement.get("command") != "backup.retire"
            or retirement_result.get("status") != "accepted"
            or retirement_result.get("kind") != "retire_backup"
            or retirement_result.get("backup_name") != retired_name
        ):
            fail("endurance backup retirement was not accepted with the exact identity")
        retirement_operation_id = retirement_result.get("maintenance_operation_id")
        if not isinstance(retirement_operation_id, str) or len(retirement_operation_id) != 36:
            fail("endurance backup retirement identity is invalid")

        retirement_deadline = time.monotonic() + 180
        retirement_terminal: dict[str, Any] | None = None
        while time.monotonic() < retirement_deadline:
            polled = run_json(
                cli(environment)
                + [
                    "backup",
                    "operation",
                    retirement_operation_id,
                    "--output",
                    "json",
                ],
                timeout_seconds=30,
                allow_unavailable=True,
            )
            if polled is not None:
                candidate = polled["result"]
                if (
                    polled.get("command") == "backup.operation"
                    and candidate.get("status") == "found"
                    and candidate.get("maintenance_operation_id")
                    == retirement_operation_id
                    and candidate.get("kind") == "retire_backup"
                    and candidate.get("backup_name") == retired_name
                ):
                    if candidate.get("phase") == "succeeded":
                        retirement_terminal = candidate
                        break
                    if candidate.get("phase") in {"failed", "refused"}:
                        fail("endurance backup retirement reached a non-success terminal phase")
            time.sleep(0.1)
        if retirement_terminal is None:
            fail("endurance backup retirement did not complete before its bounded deadline")
        if retired.exists() or retired.is_symlink():
            fail("endurance retired backup remains published")
        retirement_receipts.append(
            {
                "backup_name": retired_name,
                "maintenance_operation_id": retirement_operation_id,
                "input_hash": retirement_terminal.get("input_hash"),
                "phase": retirement_terminal.get("phase"),
            }
        )
    retained_backup_names = sorted(
        path.name
        for path in backup_root.iterdir()
        if path.name != ".maintenance" and path.is_dir() and not path.is_symlink()
    )
    if len(retained_backup_names) > MAX_RETAINED_BACKUPS or name not in retained_backup_names:
        fail("endurance backup retention did not preserve the newest inventory")
    after = before + 1
    state["backup_count"] = after
    health_frontier(environment)
    return before, after, {
        "schema": "riffdb.alpha-endurance-backup-evidence/v1",
        "backup_name": name,
        "maintenance_operation_id": operation_id,
        "input_hash": terminal.get("input_hash"),
        "phase": terminal.get("phase"),
        "inventory": inventory,
        "retired_backup_names": retired_backup_names,
        "retirement_receipts": retirement_receipts,
        "retained_backup_names": retained_backup_names,
    }


def capability_rotation(
    environment: Path, state: dict[str, Any]
) -> tuple[int, int, dict[str, Any]]:
    before = integer(
        state["capability_administration_sequence"],
        "capability_administration_sequence",
    )
    rotation_path = environment / "capability-rotation.json"
    previous = read_object(rotation_path) if rotation_path.exists() else None
    ordinal = before + 1
    request_path = environment / f"capability-rotation-{ordinal}.request.json"
    credential_path = environment / f"capability-rotation-{ordinal}.credential"
    atomic_write(
        request_path,
        {
            "principal_id": f"alpha-endurance-rotation-{ordinal}",
            "actor_kind": "service",
            "requested_lifetime_seconds": 86400,
            "audiences": ["riffdb-alpha-endurance"],
            "grant": {
                "tenant_scope": {"type": "global"},
                "partition_scope": {"type": "all"},
                "permissions": [{"type": "read_health"}],
                "field_visibility": [],
                "max_scan_rows": 1,
                "approval_required": [],
            },
        },
    )
    created = run_json(
        cli(environment)
        + [
            "capability",
            "create",
            "--request",
            str(request_path),
            "--credential-output",
            str(credential_path),
            "--output",
            "json",
        ]
    )
    if created is None:
        fail("endurance capability create unexpectedly returned no result")
    result = created["result"]
    transition = result.get("transition")
    identity = transition.get("identity") if isinstance(transition, dict) else None
    capability_id = identity.get("capability_id") if isinstance(identity, dict) else None
    if (
        created.get("command") != "capability.create"
        or result.get("status") != "created"
        or not isinstance(capability_id, str)
        or not credential_path.is_file()
        or credential_path.is_symlink()
    ):
        fail("endurance replacement capability was not durably created")
    after = positive_decimal(
        transition.get("administration_sequence"),
        "capability create administration sequence",
    )
    revoked_id: str | None = None
    if previous is not None:
        revoked_id = previous.get("capability_id")
        if not isinstance(revoked_id, str):
            fail("endurance prior rotation capability identity is invalid")
        revoked = run_json(
            cli(environment)
            + [
                "capability",
                "revoke",
                "--reason",
                "replaced",
                revoked_id,
                "--output",
                "json",
            ]
        )
        if revoked is None:
            fail("endurance capability revoke unexpectedly returned no result")
        revoked_result = revoked["result"]
        revoked_transition = revoked_result.get("transition")
        if (
            revoked.get("command") != "capability.revoke"
            or revoked_result.get("status") not in {"revoked", "already_revoked"}
            or not isinstance(revoked_transition, dict)
        ):
            fail("endurance prior rotation capability was not revoked")
        after = positive_decimal(
            revoked_transition.get("administration_sequence"),
            "capability revoke administration sequence",
        )
    if after <= before:
        fail("endurance capability rotation did not advance administration history")
    atomic_write(
        rotation_path,
        {
            "capability_id": capability_id,
            "administration_sequence": after,
            "credential_file": credential_path.name,
        },
    )
    state["capability_administration_sequence"] = after
    return before, after, {
        "schema": "riffdb.alpha-endurance-capability-rotation-evidence/v1",
        "replacement_capability_id": capability_id,
        "revoked_capability_id": revoked_id,
        "administration_sequence": after,
        "least_authority": ["read_health"],
    }


def deploy_under_load(
    environment: Path, state: dict[str, Any]
) -> tuple[int, int, dict[str, Any]]:
    before = integer(state["deployment_count"], "deployment_count")
    application = environment / "application"
    manifest = application / "riffdb.application.json"
    lock = application / "riffdb.application.lock.json"
    if (
        application.is_symlink()
        or not application.is_dir()
        or manifest.is_symlink()
        or not manifest.is_file()
        or lock.is_symlink()
        or not lock.is_file()
    ):
        fail("endurance exact application package is invalid")
    deployed = run_json(
        cli(environment)
        + [
            "application",
            "deploy",
            manifest.name,
            "--lock",
            lock.name,
            "--output",
            "json",
        ],
        cwd=application,
    )
    if deployed is None:
        fail("endurance application deploy unexpectedly returned no result")
    result = deployed["result"]
    if (
        deployed.get("command") != "application.deploy"
        or result.get("application") != "ticketdesk-reactive"
        or result.get("contract_lineage") != "TicketDesk"
        or result.get("contract_version") != "1"
        or result.get("database") != "default"
        or result.get("seeded") is not False
    ):
        fail("endurance exact application deploy result is invalid")
    after = before + 1
    state["deployment_count"] = after
    return before, after, {
        "schema": "riffdb.alpha-endurance-deploy-evidence/v1",
        "application": result.get("application"),
        "contract_lineage": result.get("contract_lineage"),
        "contract_version": result.get("contract_version"),
        "database": result.get("database"),
        "lock_hash": result.get("lock_hash"),
        "exact_lock_sha256": sha256_file(lock),
        "manifest_sha256": sha256_file(manifest),
        "provisioned": result.get("provisioned"),
        "seeded": result.get("seeded"),
        "deployment_ordinal": after,
    }


def certificate_rotation(
    environment: Path, state: dict[str, Any]
) -> tuple[int, int, dict[str, Any]]:
    before = integer(state["certificate_rotation_count"], "certificate_rotation_count")
    slot = 2 if before % 2 == 0 else 1
    active_certificate = environment / "server.pem"
    active_key = environment / "server.key"
    replacement_certificate = environment / f"server-{slot}.pem"
    replacement_key = environment / f"server-{slot}.key"
    old_certificate_sha256 = sha256_file(active_certificate)
    new_certificate_sha256 = sha256_file(replacement_certificate)
    if old_certificate_sha256 == new_certificate_sha256:
        fail("endurance certificate rotation did not select a different leaf")
    atomic_replace_file(replacement_certificate, active_certificate, 0o444)
    atomic_replace_file(replacement_key, active_key, 0o600)
    process_state, frontier_before, checkpoint, queue_depth = stop_server(environment)
    frontier_after = start_server(environment, process_state, checkpoint)
    if frontier_after < frontier_before:
        fail("endurance certificate rotation regressed the application frontier")
    after = before + 1
    state["certificate_rotation_count"] = after
    state["writer_queue_depth"] = max(
        integer(state["writer_queue_depth"], "writer_queue_depth"), queue_depth
    )
    state["checkpoint_count"] = integer(state["checkpoint_count"], "checkpoint_count") + 1
    state["checkpoint_frontier"] = checkpoint
    state["restart_count"] = integer(state["restart_count"], "restart_count") + 1
    return before, after, {
        "schema": "riffdb.alpha-endurance-certificate-rotation-evidence/v1",
        "certificate_slot": slot,
        "certificate_sha256_before": old_certificate_sha256,
        "certificate_sha256_after": new_certificate_sha256,
        "application_frontier_before": frontier_before,
        "application_frontier_after": frontier_after,
        "checkpoint_frontier": checkpoint,
        "writer_queue_depth_max": queue_depth,
    }


def advance_retention_lane(environment: Path, previous_watermark: int) -> None:
    """Create one event-free command history entry through the public symbolic surface."""
    ordinal = previous_watermark + 1
    if ordinal >= 1 << 48:
        fail("endurance retention-lane identity space is exhausted")
    organization_id = f"01980000-0000-7000-8000-{ordinal:012x}"
    input_path = environment / f"retention-create-{ordinal:012x}.json"
    atomic_write(
        input_path,
        {
            "idempotency_key": f"alpha-endurance-retention-{ordinal}",
            "organization_id": {"$uuid": organization_id},
            "name": f"Retention lane {ordinal}",
        },
    )
    result = run_json(
        retention_cli(environment)
        + [
            "command",
            "run",
            "CreateOrganization",
            "--input",
            str(input_path),
            "--application",
            str(environment / "application" / "riffdb.application.json"),
            "--output",
            "json",
        ]
    )
    if result is None or result.get("command") != "command.run":
        fail("endurance retention-lane command returned the wrong operation identity")


def retention(environment: Path, state: dict[str, Any]) -> tuple[int, int, dict[str, Any]]:
    before = integer(state["retention_watermark"], "retention_watermark")
    advance_retention_lane(environment, before)
    process_state, application_frontier, checkpoint, queue_depth = stop_server(environment)
    primary_database = environment / "data" / "ticketdesk.redb"
    database = environment / "data" / "retention.redb"
    restarted = False
    try:
        primary = retention_status(environment, primary_database)
        primary_fence_binding = primary.get("fence_binding")
        primary_maximum_raw = primary.get("max_permissible_watermark")
        primary_maximum = (
            positive_decimal_or_zero(
                primary_maximum_raw, "primary maximum permissible watermark"
            )
            if primary_maximum_raw is not None
            else 0
        )
        if (
            primary_fence_binding != "UndeliveredOutboxLowWater"
            or primary_maximum >= application_frontier
        ):
            fail("endurance primary retention did not preserve its undelivered-outbox fence")

        current = retention_status(environment, database)
        current_watermark = positive_decimal_or_zero(
            current.get("watermark_sequence"), "retention watermark"
        )
        if current_watermark != before:
            fail("endurance retention watermark differs from lifecycle state")
        target_raw = current.get("max_permissible_watermark")
        target = (
            positive_decimal(target_raw, "maximum permissible watermark")
            if target_raw is not None
            else 0
        )
        if target <= before:
            fail("endurance retention fencing has not advanced beyond the watermark")
        pruned = run_json(
            cli(environment)
            + [
                "retention",
                "prune",
                "--database-path",
                str(database),
                "--target-sequence",
                str(target),
                "--output",
                "json",
            ],
            timeout_seconds=300,
        )
        if pruned is None or pruned.get("command") != "retention.prune":
            fail("endurance retention prune unexpectedly returned no result")
        result = pruned["result"]
        after = positive_decimal(result.get("watermark_sequence"), "pruned watermark")
        tombstones = positive_decimal_or_zero(
            result.get("tombstone_count"), "retention tombstone count"
        )
        if after != target or after <= before:
            fail("endurance retention prune did not publish the fenced target")
        after_frontier = start_server(environment, process_state, checkpoint)
        restarted = True
    finally:
        if not restarted:
            try:
                start_server(environment, process_state, checkpoint)
            except (json.JSONDecodeError, OSError, subprocess.SubprocessError, ValueError):
                pass
    if after_frontier < application_frontier:
        fail("endurance retention restart regressed the application frontier")
    state["retention_watermark"] = after
    state["tombstone_count"] = tombstones
    state["writer_queue_depth"] = max(
        integer(state["writer_queue_depth"], "writer_queue_depth"), queue_depth
    )
    state["checkpoint_count"] = integer(state["checkpoint_count"], "checkpoint_count") + 1
    state["checkpoint_frontier"] = checkpoint
    state["restart_count"] = integer(state["restart_count"], "restart_count") + 1
    return before, after, {
        "schema": "riffdb.alpha-endurance-retention-evidence/v1",
        "watermark_before": before,
        "watermark_after": after,
        "tombstone_count": tombstones,
        "fence_binding": result.get("fence_binding"),
        "retention_lane": "retention",
        "primary_fence_binding": primary_fence_binding,
        "primary_maximum_permissible_watermark": primary_maximum,
        "application_frontier_before": application_frontier,
        "application_frontier_after": after_frontier,
        "checkpoint_frontier": checkpoint,
        "writer_queue_depth_max": queue_depth,
    }


def checkpoint_or_restart(
    environment: Path, state: dict[str, Any], name: str
) -> tuple[int, int, dict[str, Any]]:
    checkpoint_count_before = integer(state["checkpoint_count"], "checkpoint_count")
    restart_count_before = integer(state["restart_count"], "restart_count")
    frontier_before, frontier_after, queue_depth = restart_server(environment, state)
    if name == "checkpoint":
        before = checkpoint_count_before
        after = integer(state["checkpoint_count"], "checkpoint_count")
    else:
        before = restart_count_before
        after = integer(state["restart_count"], "restart_count")
    return before, after, {
        "schema": "riffdb.alpha-endurance-checkpoint-restart-evidence/v1",
        "action": name,
        "application_frontier_before": frontier_before,
        "application_frontier_after": frontier_after,
        "checkpoint_frontier": integer(state["checkpoint_frontier"], "checkpoint_frontier"),
        "writer_queue_depth_max": queue_depth,
    }


def recovery(environment: Path, state: dict[str, Any]) -> tuple[int, int, dict[str, Any]]:
    before = integer(state["recovery_count"], "recovery_count")
    process_state = read_object(environment / "state.json")
    old_pid = integer(process_state.get("server_pid"), "server_pid")
    if not process_alive(old_pid):
        fail("endurance server was not running before recovery crash")
    frontier_before = health_frontier(environment)
    database = environment / "data" / "ticketdesk.redb"
    generation_before = journal_generation(database)
    os.kill(old_pid, signal.SIGKILL)
    wait_stopped(old_pid, 30)
    recovery_started = time.monotonic_ns()
    frontier_after = start_server(environment, process_state, frontier_before)
    recovery_microseconds = max(1, (time.monotonic_ns() - recovery_started) // 1_000)
    generation_after = journal_generation(database)
    if frontier_after < frontier_before or generation_after < generation_before:
        fail("endurance unclean recovery regressed a durable frontier")
    after = before + 1
    state["recovery_count"] = after
    state["restart_count"] = integer(state["restart_count"], "restart_count") + 1
    return before, after, {
        "schema": "riffdb.alpha-endurance-recovery-evidence/v1",
        "termination_signal": "SIGKILL",
        "application_frontier_before": frontier_before,
        "application_frontier_after": frontier_after,
        "journal_generation_before": generation_before,
        "journal_generation_after": generation_after,
        "recovery_microseconds": recovery_microseconds,
    }


def run_action(environment: Path, state_path: Path, name: str) -> dict[str, Any]:
    started = time.monotonic_ns()
    state = read_object(state_path)
    validate_state(state)
    if name == "journal_recycle":
        before, after, evidence = journal_recycle(environment, state)
    elif name == "reactive_consumer":
        before, after, evidence = reactive_consumer(environment, state)
    elif name == "backup":
        before, after, evidence = backup(environment, state)
    elif name == "capability_rotation":
        before, after, evidence = capability_rotation(environment, state)
    elif name == "certificate_rotation":
        before, after, evidence = certificate_rotation(environment, state)
    elif name == "deploy_under_load":
        before, after, evidence = deploy_under_load(environment, state)
    elif name == "retention":
        before, after, evidence = retention(environment, state)
    elif name == "recovery":
        before, after, evidence = recovery(environment, state)
    elif name in {"checkpoint", "restart"}:
        before, after, evidence = checkpoint_or_restart(environment, state, name)
    else:
        fail(f"endurance lifecycle action is not implemented: {name}")
    elapsed_us = max(1, (time.monotonic_ns() - started) // 1_000)
    state["lifecycle_microseconds"] = integer(
        state["lifecycle_microseconds"], "lifecycle_microseconds"
    ) + elapsed_us
    validate_state(state)
    atomic_write(state_path, state)
    digest = evidence_digest(environment, name, after, evidence)
    return {
        "schema": RESULT_SCHEMA,
        "kind": "lifecycle",
        "name": name,
        "status": "passed",
        "evidence_sha256": digest,
        "frontier_before": before,
        "frontier_after": after,
        "recovered": True,
    }


def self_test() -> None:
    header = bytearray(JOURNAL_HEADER_BYTES)
    header[:8] = JOURNAL_MAGIC
    header[32:40] = (7).to_bytes(8, "big")
    header[-32:] = hashlib.sha256(header[:-32]).digest()
    if header[:8] != JOURNAL_MAGIC or int.from_bytes(header[32:40], "big") != 7:
        fail("journal header self-test failed")
    state = initial_state(7)
    validate_state(state)
    print("endurance lifecycle state: passed")


def main() -> int:
    if sys.argv[1:] == ["--self-test"]:
        self_test()
        return 0
    root = artifact_root()
    environment = root / "environment-v1"
    if environment.is_symlink() or not environment.is_dir():
        fail("endurance environment is absent")
    state_path = environment / "lifecycle-state.json"
    lock_path = environment / "lifecycle.lock"
    with lock_path.open("a+b") as lock:
        os.chmod(lock_path, 0o600)
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        if sys.argv[1:] == ["--initialize"]:
            initialize(environment, state_path)
            return 0
        if len(sys.argv) != 2:
            fail("usage: endurance-lifecycle <backup|capability_rotation|certificate_rotation|checkpoint|deploy_under_load|journal_recycle|reactive_consumer|recovery|restart|retention> | --initialize | --self-test")
        result = run_action(environment, state_path, sys.argv[1])
    print(json.dumps(result, sort_keys=True, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (json.JSONDecodeError, OSError, ValueError) as error:
        print(f"endurance_lifecycle_invalid: {error}", file=sys.stderr)
        raise SystemExit(3) from error
