#!/usr/bin/env bash
set -euo pipefail

backup_restore=false
if [[ "$#" -gt 1 ]]; then
    printf 'usage: ./scripts/remote-compose-acceptance [--backup-restore]\n' >&2
    exit 2
fi
if [[ "$#" -eq 1 ]]; then
    [[ "$1" == "--backup-restore" ]] || {
        printf 'usage: ./scripts/remote-compose-acceptance [--backup-restore]\n' >&2
        exit 2
    }
    backup_restore=true
fi

fail() {
    printf 'remote Compose acceptance failed: %s\n' "$1" >&2
    exit 1
}

for tool in cmp docker jq openssl ruby sha256sum; do
    command -v "$tool" >/dev/null 2>&1 || fail "required tool is missing: $tool"
done
docker compose version >/dev/null 2>&1 || fail "Docker Compose v2 is unavailable"

workspace="$(cd "$(dirname "$0")/.." && pwd -P)"
temporary_parent="${TMPDIR:-${HOME}/tmp}"
mkdir -p "$temporary_parent"
work_root="$(mktemp -d "$temporary_parent/riffdb-remote-compose.XXXXXX")"
runtime_root="$work_root/runtime"
mkdir -p "$runtime_root/data" "$runtime_root/backups" "$runtime_root/bootstrap"
chmod 0700 "$work_root" "$runtime_root" "$runtime_root/data" "$runtime_root/backups" \
    "$runtime_root/bootstrap"

image="riffdb:remote-alpha-acceptance"
project="riffdb-remote-$PPID-$$"
proxy_port="$(ruby -rsocket -e 's = TCPServer.new("127.0.0.1", 0); puts s.addr[1]; s.close')"
compose_files=(-f "$workspace/release/container/compose.yaml")
if [[ "$(docker --version 2>/dev/null || true)" == podman\ version\ * ]]; then
    cat >"$work_root/podman-keep-id.yaml" <<'EOF'
services:
  riffdbd:
    userns_mode: keep-id
  application-probe:
    userns_mode: keep-id
  operator-probe:
    userns_mode: keep-id
EOF
    compose_files+=(-f "$work_root/podman-keep-id.yaml")
fi
compose=(docker compose --project-name "$project" "${compose_files[@]}")

compose_with_runtime() {
    RIFFDB_CONTAINER_ROOT="$runtime_root" \
    RIFFDB_CONTAINER_UID="$(id -u)" \
    RIFFDB_CONTAINER_GID="$(id -g)" \
    RIFFDB_IMAGE="$image" \
    RIFFDB_PROXY_PORT="$proxy_port" \
        "${compose[@]}" "$@"
}

operator_cli() {
    compose_with_runtime --profile operator run --rm operator-probe \
        riffdb --config /etc/riffdb/operator.toml --max-attempts 1 "$@"
}

wait_for_tls_endpoint() {
    local deadline=$((SECONDS + 30))
    local observation="$work_root/replacement-health.json"
    while (( SECONDS < deadline )); do
        if "$cli" --config "$work_root/bootstrap-client.toml" \
            server health >"$observation" 2>/dev/null; then
            return 0
        fi
        if jq -e '
            .schema == "riffdb.cli.output/v1"
            and .ok == false
            and .error.type == "public"
            and .error.code != "tls_connection_failed"
        ' "$observation" >/dev/null 2>&1; then
            return 0
        fi
        sleep 0.25
    done
    return 1
}

wait_for_maintenance_success() {
    local operation_id="$1"
    local output_path="$2"
    local deadline=$((SECONDS + 180))
    while (( SECONDS < deadline )); do
        if "$cli" --config "$work_root/bootstrap-client.toml" \
            backup operation "$operation_id" >"$output_path" 2>/dev/null \
            && jq -e '.ok == true and .result.status == "found" and .result.phase == "succeeded"' \
                "$output_path" >/dev/null; then
            # The retained proof is fetched once more from the separate
            # operator container; host polling only avoids constructing a new
            # container while the selected database is intentionally offline.
            operator_cli backup operation "$operation_id" >"$output_path"
            jq -e '.ok == true and .result.status == "found" and .result.phase == "succeeded"' \
                "$output_path" >/dev/null
            return 0
        fi
        if [[ -s "$output_path" ]] \
            && jq -e '.ok == true and .result.status == "found" and .result.phase == "failed_closed"' \
                "$output_path" >/dev/null 2>&1; then
            sed -n '1,20p' "$output_path" >&2
            return 1
        fi
        sleep 0.25
    done
    [[ ! -s "$output_path" ]] || sed -n '1,20p' "$output_path" >&2
    return 1
}

cleanup() {
    local status=$?
    if (( status != 0 )); then
        compose_with_runtime logs --no-color riffdbd riffdb-proxy >&2 || true
    fi
    compose_with_runtime down --timeout 25 >/dev/null 2>&1 || true
    return "$status"
}
trap cleanup EXIT

cp "$workspace/release/container/"{riffdbd,liveness,application,operator}.toml "$runtime_root/"
sed "s#public_endpoint = .*#public_endpoint = \"https://127.0.0.1:$proxy_port\"#" \
    "$runtime_root/riffdbd.toml" >"$work_root/riffdbd.toml.next"
if [[ "$backup_restore" == true ]]; then
    sed 's/environment = "container-alpha"/environment = "development"/' \
        "$work_root/riffdbd.toml.next" >"$work_root/riffdbd.toml.acceptance"
    mv "$work_root/riffdbd.toml.acceptance" "$work_root/riffdbd.toml.next"
fi
mv "$work_root/riffdbd.toml.next" "$runtime_root/riffdbd.toml"
chmod 0600 "$runtime_root/"*.toml
printf '%s\n' \
    'riffdb-capability-digest-keys-v1' \
    '1:000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f' \
    >"$runtime_root/capability.keys"
printf '%s\n' \
    'riffdb-idempotency-digest-keys-v1' \
    '1:202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f' \
    >"$runtime_root/idempotency.keys"
chmod 0600 "$runtime_root/"*.keys

openssl req -x509 -newkey rsa:2048 -nodes -days 2 \
    -subj '/CN=RiffDB remote acceptance CA' \
    -keyout "$work_root/ca.key" -out "$runtime_root/riffdb-ca.pem" \
    >/dev/null 2>&1
cat >"$work_root/server.ext" <<'EOF'
subjectAltName=DNS:riffdbd,DNS:riffdb-proxy,IP:127.0.0.1
extendedKeyUsage=serverAuth
EOF
openssl req -newkey rsa:2048 -nodes -subj '/CN=riffdbd' \
    -keyout "$runtime_root/server-key.pem" -out "$work_root/server.csr" \
    >/dev/null 2>&1
openssl x509 -req -days 2 -sha256 \
    -in "$work_root/server.csr" \
    -CA "$runtime_root/riffdb-ca.pem" -CAkey "$work_root/ca.key" -CAcreateserial \
    -extfile "$work_root/server.ext" -out "$runtime_root/server-chain.pem" \
    >/dev/null 2>&1
chmod 0600 "$runtime_root/server-key.pem" "$work_root/ca.key"
chmod 0444 "$runtime_root/server-chain.pem" "$runtime_root/riffdb-ca.pem"

cat >"$work_root/bootstrap.json" <<'EOF'
{
  "principal_id": "container-alpha-operator",
  "actor_kind": "human",
  "requested_lifetime_seconds": 3600,
  "audiences": ["riffdb-container-application"],
  "grant": {
    "tenant_scope": {"type": "global"},
    "partition_scope": {"type": "all"},
    "permissions": [
      {"type": "validate_contract"},
      {"type": "read_contract"},
      {"type": "deploy_contract"},
      {"type": "read_health"},
      {"type": "create_capability"},
      {"type": "revoke_capability"},
      {"type": "administer_capabilities"}
    ],
    "field_visibility": [],
    "max_scan_rows": 50,
    "approval_required": []
  }
}
EOF
cat >"$work_root/application.json" <<'EOF'
{
  "principal_id": "container-alpha-application",
  "actor_kind": "service",
  "requested_lifetime_seconds": 3600,
  "audiences": ["riffdb-container-application"],
  "grant": {
    "tenant_scope": {"type": "global"},
    "partition_scope": {"type": "all"},
    "permissions": [{"type": "read_health"}],
    "field_visibility": [],
    "max_scan_rows": 50,
    "approval_required": []
  }
}
EOF
cat >"$work_root/bootstrap-client.toml" <<EOF
[client]
endpoint = "https://127.0.0.1:$proxy_port"
database = "default"
output = "json"
max_attempts = 3
tls_trust_root = "$runtime_root/riffdb-ca.pem"
tls_server_name = "127.0.0.1"
EOF
cat >"$runtime_root/bootstrap/bootstrap.toml" <<EOF
[client]
endpoint = "https://127.0.0.1:7443"
database = "default"
output = "json"
max_attempts = 3
tls_trust_root = "/run/secrets/riffdb-ca.pem"
tls_server_name = "127.0.0.1"
EOF
cp "$work_root/bootstrap.json" "$runtime_root/bootstrap/bootstrap.json"
chmod 0600 "$work_root/"*.json "$work_root/bootstrap-client.toml"
chmod 0600 "$runtime_root/bootstrap/"*.toml "$runtime_root/bootstrap/"*.json

cd "$workspace"
TMPDIR="$temporary_parent" cargo +1.97.0 build --release -p riffdb-cli -p riffdb-server
docker build \
    --build-arg RIFFDB_PROFILE=release \
    -t "$image" -f release/container/Dockerfile . >/dev/null

RIFFDB_CONTAINER_ROOT="$runtime_root" \
RIFFDB_CONTAINER_UID="$(id -u)" \
RIFFDB_CONTAINER_GID="$(id -g)" \
RIFFDB_IMAGE="$image" \
RIFFDB_PROXY_PORT="$proxy_port" \
    "${compose[@]}" config --quiet
RIFFDB_CONTAINER_ROOT="$runtime_root" \
RIFFDB_CONTAINER_UID="$(id -u)" \
RIFFDB_CONTAINER_GID="$(id -g)" \
RIFFDB_IMAGE="$image" \
RIFFDB_PROXY_PORT="$proxy_port" \
    "${compose[@]}" up -d --wait riffdbd riffdb-proxy

cli="$workspace/target/release/riffdb"
printf 'remote-compose phase=liveness\n' >&2
"$cli" --config "$work_root/bootstrap-client.toml" server health >/dev/null
printf 'remote-compose phase=bootstrap\n' >&2
if ! RIFFDB_CONTAINER_ROOT="$runtime_root" RIFFDB_CONTAINER_UID="$(id -u)" \
    RIFFDB_CONTAINER_GID="$(id -g)" RIFFDB_IMAGE="$image" RIFFDB_PROXY_PORT="$proxy_port" \
    "${compose[@]}" exec -T riffdbd \
    riffdb --config /run/bootstrap/bootstrap.toml capability bootstrap \
    --request /run/bootstrap/bootstrap.json \
    --generate /run/bootstrap/bootstrap.credential \
    --bearer-output /run/bootstrap/operator.credential \
    >"$work_root/bootstrap-result.jsonl"; then
    sed -n '1,20p' "$work_root/bootstrap-result.jsonl" >&2
    fail "operator bootstrap failed"
fi
cp "$runtime_root/bootstrap/operator.credential" "$runtime_root/operator.credential"
chmod 0600 "$runtime_root/operator.credential"

cat >>"$work_root/bootstrap-client.toml" <<EOF
credential_file = "$runtime_root/operator.credential"
EOF
printf 'remote-compose phase=application-credential\n' >&2
if ! "$cli" --config "$work_root/bootstrap-client.toml" capability create \
    --request "$work_root/application.json" \
    --capability-id 01900000-0000-7000-8000-000000000001 \
    --credential-output "$runtime_root/application.credential" \
    >"$work_root/application-create.jsonl"; then
    sed -n '1,20p' "$work_root/application-create.jsonl" >&2
    fail "application credential creation failed"
fi
chmod 0600 "$runtime_root/application.credential"
cp "$runtime_root/application.credential" "$work_root/predecessor.credential"
chmod 0600 "$work_root/predecessor.credential"

RIFFDB_CONTAINER_ROOT="$runtime_root" RIFFDB_CONTAINER_UID="$(id -u)" \
RIFFDB_CONTAINER_GID="$(id -g)" RIFFDB_IMAGE="$image" RIFFDB_PROXY_PORT="$proxy_port" \
    "${compose[@]}" --profile operator run --rm operator-probe >/dev/null
RIFFDB_CONTAINER_ROOT="$runtime_root" RIFFDB_CONTAINER_UID="$(id -u)" \
RIFFDB_CONTAINER_GID="$(id -g)" RIFFDB_IMAGE="$image" RIFFDB_PROXY_PORT="$proxy_port" \
    "${compose[@]}" --profile application run --rm application-probe >/dev/null

# Publish the same valid identity through new inodes. A new handshake triggers
# server reload; deterministic paused-clock coverage proves predecessor drain.
cp "$runtime_root/server-chain.pem" "$work_root/server-chain.next"
cp "$runtime_root/server-key.pem" "$work_root/server-key.next"
chmod 0444 "$work_root/server-chain.next"
chmod 0600 "$work_root/server-key.next"
mv "$work_root/server-chain.next" "$runtime_root/server-chain.pem"
mv "$work_root/server-key.next" "$runtime_root/server-key.pem"
"$cli" --config "$work_root/bootstrap-client.toml" server health >/dev/null

# Prove successor-before-revocation with disjoint files, then prove the old
# bearer is rejected even over an established public endpoint.
"$cli" --config "$work_root/bootstrap-client.toml" capability create \
    --request "$work_root/application.json" \
    --capability-id 01900000-0000-7000-8000-000000000002 \
    --credential-output "$work_root/application.next.credential" >/dev/null
chmod 0600 "$work_root/application.next.credential"
cp "$work_root/application.next.credential" "$runtime_root/.application.credential.next"
chmod 0600 "$runtime_root/.application.credential.next"
mv "$runtime_root/.application.credential.next" "$runtime_root/application.credential"
RIFFDB_CONTAINER_ROOT="$runtime_root" RIFFDB_CONTAINER_UID="$(id -u)" \
RIFFDB_CONTAINER_GID="$(id -g)" RIFFDB_IMAGE="$image" RIFFDB_PROXY_PORT="$proxy_port" \
    "${compose[@]}" --profile application run --rm application-probe >/dev/null
"$cli" --config "$work_root/bootstrap-client.toml" capability revoke \
    01900000-0000-7000-8000-000000000001 --reason replaced >/dev/null

sed "s#credential_file = .*#credential_file = \"$work_root/predecessor.credential\"#" \
    "$work_root/bootstrap-client.toml" >"$work_root/predecessor.toml"
chmod 0600 "$work_root/predecessor.toml"
if "$cli" --config "$work_root/predecessor.toml" server health >/dev/null 2>&1; then
    fail "revoked application predecessor remained authorized"
fi

if [[ "$backup_restore" == true ]]; then
    # Offline maintenance is intentionally unavailable while the database is
    # still in DeploymentRequired. Deploy and seed the release-owned corpus
    # whose one bounded application covers all four general-alpha subject shapes.
    cp -R "$workspace/fixtures/adapters/operational-conformance" \
        "$work_root/adapter-application"
    (
        cd "$work_root/adapter-application"
        "$cli" --config "$work_root/bootstrap-client.toml" application deploy \
            riffdb.application.json --lock riffdb.application.lock.json \
            --provision-role AdapterOperationalApplication --lifetime-seconds 3600 \
            >"$work_root/adapter-deploy.jsonl"
    )
    adapter_deployment="$work_root/adapter-application/.riffdb/deployments/default"
    adapter_credential_name="$(jq -r '
        if (.role.credential_file // "") == "" then
            "application.credential"
        else
            .role.credential_file
        end
    ' "$adapter_deployment/deployment-state.json")"
    if [[ "$adapter_credential_name" == /* ]]; then
        adapter_credential="$adapter_credential_name"
    else
        adapter_credential="$adapter_deployment/$adapter_credential_name"
    fi
    [[ -f "$adapter_credential" ]] || fail "adapter application credential was not provisioned"
    RIFFDB_CONFORMANCE_ENDPOINT="https://127.0.0.1:$proxy_port" \
    RIFFDB_CONFORMANCE_TRUST_ROOT="$runtime_root/riffdb-ca.pem" \
    RIFFDB_CONFORMANCE_CREDENTIAL="$adapter_credential" \
        cargo +1.97.0 run --quiet -p riffdb-testkit-server \
            --example adapter_operational_remote_client -- \
            >"$work_root/adapter-before.json"
    jq -e '
        .schema == "riffdb.adapter-operational-observation/v1"
        and .adapters == ["mlflow", "openfga", "better-auth", "woodpecker"]
        and .regression_adapters == ["payload"]
        and .catalog_preflight == true
        and .optional_filters == true
        and .stable_cursor == true
        and .null_predicate == true
        and .binary_prefix == true
        and .exact_aggregates == true
    ' "$work_root/adapter-before.json" >/dev/null
    printf 'remote-compose phase=backup-create\n' >&2
    if ! operator_cli backup create alpha-disaster >"$work_root/backup-start.jsonl"; then
        jq -e '.ok == false and .error.type == "uncertain" and .error.recovery_action == "poll_maintenance_operation"' \
            "$work_root/backup-start.jsonl" >/dev/null \
            || fail "backup start failed without a pollable uncertain identity"
    fi
    backup_operation_id="$(jq -er '.result.maintenance_operation_id // .error.maintenance_operation_id' "$work_root/backup-start.jsonl")"
    wait_for_maintenance_success "$backup_operation_id" "$work_root/backup-status.jsonl" \
        || fail "remote operator backup did not succeed"

    # Create one post-backup authority record whose disappearance distinguishes
    # a real restore from merely reopening the same live database.
    "$cli" --config "$work_root/bootstrap-client.toml" capability create \
        --request "$work_root/application.json" \
        --capability-id 01900000-0000-7000-8000-000000000003 \
        --credential-output "$work_root/post-backup.credential" >/dev/null
    chmod 0600 "$work_root/post-backup.credential"
    sed "s#credential_file = .*#credential_file = \"$work_root/post-backup.credential\"#" \
        "$work_root/bootstrap-client.toml" >"$work_root/post-backup.toml"
    chmod 0600 "$work_root/post-backup.toml"
    "$cli" --config "$work_root/post-backup.toml" server health >/dev/null \
        || fail "post-backup authority was not active before volume loss"

    printf 'remote-compose phase=destroy-volume\n' >&2
    # Rootless engines may assign a new network address when the database
    # container restarts. Stop the pass-through proxy as part of the disaster
    # boundary so its backend identity is resolved against the replacement
    # database rather than a stale pre-loss address.
    compose_with_runtime stop --timeout 25 riffdb-proxy riffdbd >/dev/null
    expected_data_root="$work_root/runtime/data"
    [[ "$runtime_root/data" == "$expected_data_root" && -d "$expected_data_root" ]] \
        || fail "refusing to destroy an unexpected data root"
    find "$expected_data_root" -mindepth 1 -delete
    [[ -z "$(find "$expected_data_root" -mindepth 1 -print -quit)" ]] \
        || fail "database volume was not emptied"
    compose_with_runtime up -d --wait riffdbd riffdb-proxy >/dev/null
    wait_for_tls_endpoint \
        || fail "TLS proxy did not reach the replacement database before restore"

    printf 'remote-compose phase=backup-restore\n' >&2
    if ! operator_cli backup restore alpha-disaster --confirm-replace-current-database \
        >"$work_root/restore-start.jsonl"; then
        jq -e '.ok == false and .error.type == "uncertain" and .error.recovery_action == "poll_maintenance_operation"' \
            "$work_root/restore-start.jsonl" >/dev/null \
            || fail "restore start failed without a pollable uncertain identity"
    fi
    restore_operation_id="$(jq -er '.result.maintenance_operation_id // .error.maintenance_operation_id' "$work_root/restore-start.jsonl")"
    wait_for_maintenance_success "$restore_operation_id" "$work_root/restore-status.jsonl" \
        || fail "remote operator restore did not succeed"

    "$cli" --config "$work_root/bootstrap-client.toml" server health >/dev/null \
        || fail "restored operator authority is unavailable"
    RIFFDB_CONTAINER_ROOT="$runtime_root" RIFFDB_CONTAINER_UID="$(id -u)" \
    RIFFDB_CONTAINER_GID="$(id -g)" RIFFDB_IMAGE="$image" RIFFDB_PROXY_PORT="$proxy_port" \
        "${compose[@]}" --profile application run --rm application-probe >/dev/null \
        || fail "restored application authority is unavailable"
    if "$cli" --config "$work_root/post-backup.toml" server health >/dev/null 2>&1; then
        fail "post-backup authority survived destructive restore"
    fi
    RIFFDB_CONFORMANCE_ENDPOINT="https://127.0.0.1:$proxy_port" \
    RIFFDB_CONFORMANCE_TRUST_ROOT="$runtime_root/riffdb-ca.pem" \
    RIFFDB_CONFORMANCE_CREDENTIAL="$adapter_credential" \
        cargo +1.97.0 run --quiet -p riffdb-testkit-server \
            --example adapter_operational_remote_client -- \
            >"$work_root/adapter-after.json"
    cmp -s "$work_root/adapter-before.json" "$work_root/adapter-after.json" \
        || fail "restored four-domain adapter observations diverged from the backup frontier"
    backup_manifest="$runtime_root/backups/alpha-disaster/manifest.riffdb"
    [[ -f "$backup_manifest" ]] \
        || fail "verified backup manifest is absent"
    receipt_root="${RIFFDB_DISASTER_RECEIPT_ROOT:-$workspace/target/adapter-disaster-recovery}"
    mkdir -p "$receipt_root"
    receipt_path="$receipt_root/$backup_operation_id.json"
    jq -n \
        --arg backupOperationId "$backup_operation_id" \
        --arg restoreOperationId "$restore_operation_id" \
        --arg backupInputHash "$(jq -er '.result.input_hash' "$work_root/backup-status.jsonl")" \
        --arg restoreInputHash "$(jq -er '.result.input_hash' "$work_root/restore-status.jsonl")" \
        --arg backupManifestSha256 "$(sha256sum "$backup_manifest" | cut -d' ' -f1)" \
        --arg adapterObservationSha256 "$(sha256sum "$work_root/adapter-after.json" | cut -d' ' -f1)" \
        --arg contractBundleHash "$(jq -er '.contract.bundle_hash' "$work_root/adapter-application/riffdb.application.lock.json")" \
        --arg expectedDestroyedCapability "01900000-0000-7000-8000-000000000003" \
        '{
            schema: "riffdb.adapter-disaster-receipt/v1",
            adapters: ["mlflow", "openfga", "better-auth", "woodpecker"],
            regression_adapters: ["payload"],
            backup_operation_id: $backupOperationId,
            restore_operation_id: $restoreOperationId,
            backup_input_hash: $backupInputHash,
            restore_input_hash: $restoreInputHash,
            backup_manifest_sha256: $backupManifestSha256,
            frontier_binding: {kind: "verified_backup_manifest", sha256: $backupManifestSha256},
            contract_bundle_hash: $contractBundleHash,
            expected_destroyed_suffix: {capability_id: $expectedDestroyedCapability},
            startup_validation: "succeeded",
            adapter_observation_sha256: $adapterObservationSha256,
            secrets_included: false
        }' >"$receipt_path"
    printf 'remote-compose disaster-receipt=%s\n' "$receipt_path" >&2
fi

cleanup
trap - EXIT
[[ -s "$runtime_root/data/riffdb.redb" ]] || fail "container did not retain its database"
if [[ "$backup_restore" == true ]]; then
    printf 'Remote Compose acceptance passed (TLS, proxy, rotation, volume loss, verified restore).\n'
else
    printf 'Remote Compose acceptance passed (TLS, proxy, liveness, readiness, rotation, drain).\n'
fi
