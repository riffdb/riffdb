#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

npm_cache="${RIFFDB_NPM_CACHE:-${TMPDIR:-/tmp}/riffdb-npm-cache}"
ensure_typescript_dependencies() {
    local project="$1"
    if [[ ! -x "$project/node_modules/.bin/tsc" ]]; then
        mkdir -p "$npm_cache"
        npm --cache "$npm_cache" --prefix "$project" ci \
            --ignore-scripts --no-audit --no-fund
    fi
}

command -v npm >/dev/null 2>&1 || {
    echo "application binding checks require npm" >&2
    exit 1
}
ensure_typescript_dependencies "$repo_root/clients/typescript/runtime"
ensure_typescript_dependencies "$repo_root/examples/agent-alpha/web"
ensure_typescript_dependencies "$repo_root/examples/ticketdesk/web"

./scripts/check-generated
./scripts/check-application-boundary

ticket_manifest="fixtures/application-manifests/ticketdesk-v1.json"
ticket_identity="$(<fixtures/application-manifests/ticketdesk-v1.identity)"
ticket_module_hash="$(jq -er '.query_modules[0].module_hash' "$ticket_manifest")"
ticket_bundle_hash="$(jq -er '.contract.bundle_hash' "$ticket_manifest")"

jq -e '
  .schema == "riffdb.application-manifest/v1"
  and (.query_modules | length) == 1
  and (.roles | length) == 2
  and (.query_modules[0].queries | length) == 13
  and all(.roles[]; (.queries | length) == 13 and (.commands | length) == 11)
  and (.generation.rust | endswith(".rs"))
  and (.generation.typescript | endswith(".ts"))
  and (.generation.mcp | endswith(".json"))
' "$ticket_manifest" >/dev/null

rg -q "pub struct TicketDeskClient" fixtures/query-modules/ticketdesk.rs
rg -q "impl GeneratedQuery for TicketPageQuery" fixtures/query-modules/ticketdesk.rs
rg -q "execute_generated_with_recovery" crates/riffdb-client-rust/src/client.rs
rg -q "export class TicketDeskClient" clients/typescript/ticketdesk/client.ts
rg -q "RiffDB application identity mismatch" clients/typescript/ticketdesk/client.ts
jq -e \
  --arg identity "$ticket_identity" \
  --arg module_hash "$ticket_module_hash" \
  --arg bundle_hash "$ticket_bundle_hash" '
    .application_manifest_hash == $identity
    and (.tools | length) == 13
    and (.commands | length) == 11
    and all(.tools[]; .module_hash == $module_hash)
    and all(.commands[]; .contract_bundle_hash == $bundle_hash)
    and all(.commands[]; .annotations.idempotentHint == true)
    and all(.commands[]; .input_schema.properties.idempotency_key.type == "string")
  ' fixtures/query-modules/ticketdesk.mcp.json >/dev/null
if rg -n \
  'BTreeMap|NamedQueryResult|ApplicationValue|RiffDbClient|riffdb_proto|execute_named_query|execute_query\(|get_entity|scan_index|field_id|entity_type_id|index_id|tonic::' \
  examples/ticketdesk/src/lib.rs; then
    echo "TicketDesk stable application source contains handwritten RiffDB glue" >&2
    exit 1
fi

source_manifest="examples/agent-alpha/riffdb.application.json"
lock="examples/agent-alpha/riffdb.application.lock.json"
manifest="examples/agent-alpha/generated/riffdb.application.exact.json"
module_hash="$(jq -er '.modules[0].module_hash' "$lock")"
contract_hash="$(jq -er '.contract.bundle_hash' "$lock")"
manifest_hash="$(jq -er '.exact_manifest_hash' "$lock")"
role_hash="$(jq -er '.roles[0].definition_hash' "$lock")"
typescript="examples/agent-alpha/web/src/generated/client.ts"
rust="examples/agent-alpha/generated/rust/client.rs"

jq -e \
  --arg module_hash "$module_hash" \
  --arg contract_hash "$contract_hash" '
    .schema == "riffdb.application-manifest/v1"
    and .query_modules[0].module_hash == $module_hash
    and .contract.bundle_hash == $contract_hash
  ' "$manifest" >/dev/null
jq -e \
  --arg manifest_hash "$manifest_hash" \
  --arg module_hash "$module_hash" \
  --arg contract_hash "$contract_hash" '
    .schema == "riffdb-generated-application-operations/v2"
    and .application_manifest_hash == $manifest_hash
    and all(.tools[]; .module_hash == $module_hash)
    and all(.tools[]; (.operation_name | type == "string" and length > 0))
    and all(.commands[]; .contract_bundle_hash == $contract_hash)
    and all(.commands[]; (.operation_name | type == "string" and length > 0))
    and all(.reactive_tools[]; (.operation_name | type == "string" and length > 0))
  ' examples/agent-alpha/generated/mcp/tools.json >/dev/null
if ! rg -F "export const QUERY_MODULE_HASH = \"$module_hash\"" "$typescript" >/dev/null \
  || ! rg -F "export const CONTRACT_BUNDLE_HASH = \"$contract_hash\"" "$typescript" >/dev/null; then
    jq -n \
      --arg expected_manifest "$manifest_hash" \
      --arg locked_contract "$contract_hash" \
      --arg locked_module "$module_hash" \
      --arg locked_role "$role_hash" \
      --arg active_module "not_observed_by_offline_gate" \
      --arg generated_artifact "typescript" '
        {
          code: "RDB-AL008",
          cause: "generated_artifact_identity_mismatch",
          expected_manifest: $expected_manifest,
          locked_contract: $locked_contract,
          locked_module: $locked_module,
          locked_role: $locked_role,
          active_module: $active_module,
          generated_artifact: $generated_artifact,
          fix: "review_and_write_lock"
        }
      ' >&2
    exit 1
fi
rg -F "// @generated by riffdb-query-module; do not edit." "$rust" "$typescript" >/dev/null
cargo run --quiet -p riffdb-cli --bin riffdb -- application check \
    "$source_manifest" --output json >/dev/null
cargo run --quiet -p riffdb-cli --bin riffdb -- application lock --check \
    "$source_manifest" --lock riffdb.application.lock.json --output json >/dev/null
if rg -n 'implements[[:space:]]+ApplicationTransport|GetEntityRequest|ScanIndexRequest|@grpc/grpc-js|protobufjs' \
    examples/agent-alpha --glob '!**/generated/**' >/dev/null; then
    echo "application binding check found handwritten transport or kernel use" >&2
    exit 1
fi

npm --prefix clients/typescript/runtime run check
npm --prefix examples/agent-alpha/web run check
npm --prefix examples/ticketdesk/web run check
npm --prefix examples/ticketdesk/web run build
npm --prefix examples/ticketdesk/web test
./scripts/check-application-boundary examples/ticketdesk/web
typescript_tsc="clients/typescript/runtime/node_modules/.bin/tsc"
if [[ -x "$typescript_tsc" ]]; then
    "$typescript_tsc" --noEmit --strict --noUnusedLocals --noUnusedParameters \
        --target ES2022 clients/typescript/ticketdesk/client.ts
elif command -v tsc >/dev/null 2>&1; then
    tsc --noEmit --strict --noUnusedLocals --noUnusedParameters --target ES2022 \
        clients/typescript/ticketdesk/client.ts
else
    node --experimental-strip-types --check clients/typescript/ticketdesk/client.ts
fi
cargo test --quiet -p riffdb-query-module --all-features
cargo test --quiet -p riffdb-client-rust --all-features
cargo test --quiet -p riffdb-ticketdesk
echo "Application bindings are canonical, identity-pinned, typed, and boundary-clean."
