#!/usr/bin/env bash
set -euo pipefail
umask 077

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Freeze every archive-owned timestamp and generated SBOM identity. Maturin's
# wheel is otherwise structurally valid but cargo-cyclonedx gives its embedded
# SBOM a fresh timestamp and UUID on every invocation, which makes the sealed
# bundle hash impossible to reproduce for the canary verifier.
export SOURCE_DATE_EPOCH="${SOURCE_DATE_EPOCH:-1735689600}"
destination="${1:-}"
[[ -n "$destination" && "$destination" == /* ]] || {
    echo "usage: scripts/agent-application-alpha-package /absolute/new-directory" >&2
    exit 2
}
[[ ! -e "$destination" ]] || {
    echo "sealed bundle destination already exists" >&2
    exit 2
}
parent="$(dirname "$destination")"
[[ -d "$parent" ]] || {
    echo "sealed bundle parent is unavailable" >&2
    exit 2
}
temporary="$(mktemp -d "$parent/.riffdb-agent-alpha.XXXXXX")"
cleanup() {
    if [[ -d "$temporary" ]]; then
        if [[ "${RIFFDB_AGENT_ALPHA_PACKAGE_KEEP_WORKSPACE:-false}" == true ]]; then
            echo "retained sealed-bundle workspace: $temporary" >&2
        else
            rm -rf "$temporary"
        fi
    fi
}
trap cleanup EXIT INT TERM

for tool in cargo cmp find go jq python3 rg sha256sum sort uv; do
    command -v "$tool" >/dev/null 2>&1 || {
        echo "required sealed-bundle tool is missing: $tool" >&2
        exit 1
    }
done

cargo build --quiet --release \
    -p riffdb-cli --bin riffdb \
    -p riffdb-driver-host --bin riffdb-driverd \
    -p riffdb-server --bin riffdbd \
    -p riffdb-api-mcp --features stdio --bin riffdb-builder-mcp \
    -p riffdb-mcp-stdio --bin riffdb-mcp

mkdir -p "$temporary/bin" "$temporary/.cargo" "$temporary/docs" \
    "$temporary/evaluation" "$temporary/libexec" "$temporary/public/python" \
    "$temporary/public/typescript" \
    "$temporary/public/rust-sdk/crates" "$temporary/share/riffdb"

python_wheel="${RIFFDB_APPLICATION_WHEEL:-}"
if [[ -z "$python_wheel" ]]; then
    python_build="$temporary/.python-build"
    mkdir -p "$python_build"
    (
        cd "$repo_root/clients/python/runtime"
        python3 -m maturin build --quiet --release --locked \
            --interpreter python3 --compatibility linux --out "$python_build"
    )
    python_wheel="$(find "$python_build" -maxdepth 1 -type f -name '*.whl' -print -quit)"
fi
python_wheel_name="$(basename "$python_wheel")"
case "$python_wheel_name" in
    riffdb_application-0.1.0-cp313-abi3-*.whl) ;;
    *) echo "matching riffdb-application wheel is unavailable" >&2; exit 1 ;;
esac
cp "$python_wheel" "$temporary/public/python/$python_wheel_name"
rm -rf "$temporary/.python-build"
cp "$repo_root/target/release/riffdb" "$temporary/bin/"
cp "$repo_root/target/release/riffdbd" "$temporary/bin/"
cp "$repo_root/target/release/riffdb-driverd" "$temporary/bin/"
cp "$repo_root/target/release/riffdb-mcp" "$temporary/bin/"
cp "$repo_root/target/release/riffdb-builder-mcp" "$temporary/bin/"
cp "$repo_root/scripts/riffdb-dev-installed" "$temporary/bin/riffdb-dev"
cp "$repo_root/scripts/check-application-boundary" \
    "$temporary/libexec/check-application-boundary"
cp "$repo_root/release/config/bootstrap-ticketdesk-dev.json" \
    "$temporary/share/riffdb/bootstrap-dev.json"
mkdir -p "$temporary/share/riffdb/dev-tls"
cp "$repo_root/crates/riffdb-server/tests/fixtures/localhost-cert.pem" \
    "$temporary/share/riffdb/dev-tls/server.pem"
cp "$repo_root/crates/riffdb-server/tests/fixtures/localhost-key.pem" \
    "$temporary/share/riffdb/dev-tls/server.key"
cp "$repo_root/crates/riffdb-server/tests/fixtures/test-ca.pem" \
    "$temporary/share/riffdb/dev-tls/ca.pem"
chmod 0444 \
    "$temporary/share/riffdb/dev-tls/server.pem" \
    "$temporary/share/riffdb/dev-tls/ca.pem"
chmod 0600 "$temporary/share/riffdb/dev-tls/server.key"
cp "$repo_root/README.md" "$temporary/docs/README.md"
cp "$repo_root/docs/safety-by-construction.md" "$temporary/docs/"
cp "$repo_root/docs/agent-application-alpha.md" "$temporary/docs/"
cp "$repo_root/docs/installation.md" "$temporary/docs/"
cp "$repo_root/docs/python-driver.md" "$temporary/docs/"
cp "$repo_root/docs/configuration.md" "$temporary/docs/"
mkdir -p "$temporary/docs/sdks"
cp "$repo_root/docs/sdks/GO.md" "$temporary/docs/sdks/"
cp "$repo_root/docs/sdks/DRIVER-HOST.md" "$temporary/docs/sdks/"
cp -R "$repo_root/docs/contracts" "$temporary/docs/"
mkdir -p "$temporary/docs/mcp"
cp "$repo_root/docs/mcp/agent-cookbook.md" "$temporary/docs/mcp/"
mkdir -p "$temporary/docs/getting-started"
for document in \
    AGENT-APPLICATION-QUICKSTART.md APPLICATION-ERRORS.md APPLICATION-MANIFEST.md \
    AUTHORING-DIAGNOSTICS.md COMMAND-BATCHES.md INSPECTION.md \
    SAFE-APPLICATION-PROFILES.md SYMBOLIC-APPLICATIONS.md \
    TYPESCRIPT-APPLICATIONS.md; do
    cp "$repo_root/docs/getting-started/$document" "$temporary/docs/getting-started/"
done
cp "$repo_root/docs/getting-started/application-source-v1.schema.json" \
    "$temporary/docs/getting-started/"
cp -R "$repo_root/docs/riffql" "$temporary/docs/"
cp "$repo_root/clients/typescript/runtime/package.json" "$temporary/public/typescript/"
cp "$repo_root/clients/typescript/runtime/package-lock.json" "$temporary/public/typescript/"
cp -R "$repo_root/clients/typescript/runtime/dist" "$temporary/public/typescript/"
cp -R "$repo_root/clients/typescript/runtime/node_modules" "$temporary/public/typescript/"
for crate in \
    riffdb-api-grpc \
    riffdb-application \
    riffdb-client-rust \
    riffdb-config \
    riffdb-contract-ir \
    riffdb-errors \
    riffdb-proto \
    riffdb-types; do
    cp -R "$repo_root/crates/$crate" "$temporary/public/rust-sdk/crates/"
done
cp -R "$repo_root/proto" "$temporary/public/rust-sdk/"
mkdir -p "$temporary/public/rust-sdk/fixtures"
cp -R "$repo_root/fixtures/proto" "$temporary/public/rust-sdk/fixtures/"
cp "$repo_root/release/agent-application-alpha/sdk-Cargo.toml" \
    "$temporary/public/rust-sdk/Cargo.toml"
cp "$repo_root/templates/application/Cargo.lock" \
    "$temporary/public/rust-sdk/Cargo.lock"
cp "$repo_root/release/agent-application-alpha/riffdb-api-grpc-client.Cargo.toml" \
    "$temporary/public/rust-sdk/crates/riffdb-api-grpc/Cargo.toml"
cp "$repo_root/release/agent-application-alpha/riffdb-application-client.Cargo.toml" \
    "$temporary/public/rust-sdk/crates/riffdb-application/Cargo.toml"
cp "$repo_root/release/agent-application-alpha/riffdb-contract-ir-client.Cargo.toml" \
    "$temporary/public/rust-sdk/crates/riffdb-contract-ir/Cargo.toml"
cp "$repo_root/release/agent-application-alpha/BUNDLE.md" "$temporary/README.md"
cp "$repo_root/release/agent-application-alpha/cargo-config.toml" \
    "$temporary/.cargo/config.toml"
cp -R "$repo_root/evaluations/agent-application-alpha/briefs" "$temporary/evaluation/"
cp "$repo_root/evaluations/agent-application-alpha/CANARY-PROTOCOL.md" \
    "$temporary/evaluation/"
cp "$repo_root/evaluations/agent-application-alpha/event-schema.json" "$temporary/evaluation/"
cp "$repo_root/evaluations/agent-application-alpha/qualified-event-schema.json" \
    "$temporary/evaluation/"
cp "$repo_root/evaluations/agent-application-alpha/report-schema.json" "$temporary/evaluation/"
mkdir -p "$temporary/evaluation/installed-first-application"
cp "$repo_root/evaluations/installed-first-application/BRIEF.md" \
    "$temporary/evaluation/installed-first-application/"
cp "$repo_root/evaluations/installed-first-application/PROTOCOL.md" \
    "$temporary/evaluation/installed-first-application/"
cp "$repo_root/evaluations/installed-first-application/report-schema.json" \
    "$temporary/evaluation/installed-first-application/"

"$temporary/bin/riffdb" --help >/dev/null
mkdir "$temporary/.application-smoke"
"$temporary/bin/riffdb" new agent-alpha-smoke \
    --directory "$temporary/.application-smoke" >/dev/null
[[ -s "$temporary/.application-smoke/Cargo.lock" ]] || {
    echo "Rust scaffold omitted its exact Cargo.lock" >&2
    exit 1
}
CARGO_TARGET_DIR="$temporary/.sdk-check-target" cargo check --quiet \
    --manifest-path "$temporary/public/rust-sdk/Cargo.toml" \
    -p riffdb-client-rust
app_patch="patch.crates-io.riffdb-client-rust.path=\"$temporary/public/rust-sdk/crates/riffdb-client-rust\""
cargo vendor --quiet --locked --versioned-dirs \
    --manifest-path "$temporary/public/rust-sdk/Cargo.toml" \
    --sync "$temporary/.application-smoke/Cargo.toml" \
    --config "$app_patch" \
    "$temporary/public/rust-sdk/vendor" >/dev/null
CARGO_HOME="$temporary/.cargo" CARGO_NET_OFFLINE=true \
    CARGO_TARGET_DIR="$temporary/.sdk-check-target" \
    cargo check --quiet --locked \
    --manifest-path "$temporary/public/rust-sdk/Cargo.toml" \
    -p riffdb-client-rust
cp "$temporary/.application-smoke/Cargo.lock" \
    "$temporary/.application-smoke.Cargo.lock.expected"
rm "$temporary/.application-smoke/Cargo.lock"
CARGO_HOME="$temporary/.cargo" CARGO_NET_OFFLINE=true \
    cargo generate-lockfile --quiet \
    --manifest-path "$temporary/.application-smoke/Cargo.toml" \
    --config "$app_patch"
cmp "$temporary/.application-smoke.Cargo.lock.expected" \
    "$temporary/.application-smoke/Cargo.lock" || {
    diff -u "$temporary/.application-smoke.Cargo.lock.expected" \
        "$temporary/.application-smoke/Cargo.lock" >&2 || true
    echo "Rust scaffold Cargo.lock is stale against the sealed dependency set" >&2
    exit 1
}
rm "$temporary/.application-smoke.Cargo.lock.expected"
CARGO_HOME="$temporary/.cargo" CARGO_NET_OFFLINE=true \
    CARGO_TARGET_DIR="$temporary/.sdk-check-target" \
    cargo check --quiet --locked \
    --manifest-path "$temporary/.application-smoke/Cargo.toml" \
    --config "$app_patch"
"$temporary/public/typescript/node_modules/.bin/tsc" --version >/dev/null

mkdir "$temporary/.go-smoke"
"$temporary/bin/riffdb" new go-alpha-smoke --language go \
    --directory "$temporary/.go-smoke" >/dev/null
(
    cd "$temporary/.go-smoke"
    GOCACHE="$temporary/.go-cache" \
        GOMODCACHE="$temporary/.go-mod-cache" \
        GOTOOLCHAIN=local \
        go test ./... >/dev/null
)
rm -rf "$temporary/.go-smoke" "$temporary/.go-cache" \
    "$temporary/.go-mod-cache"

mkdir "$temporary/.python-smoke"
"$temporary/bin/riffdb" new python-alpha-smoke --language python \
    --directory "$temporary/.python-smoke" >/dev/null
(
    cd "$temporary/.python-smoke"
    UV_CACHE_DIR="$temporary/.uv-cache" uv sync --locked >/dev/null
    PYTHONPATH=src UV_CACHE_DIR="$temporary/.uv-cache" \
        uv run --locked python -m unittest discover -s tests >/dev/null
)
rm -rf "$temporary/.python-smoke" "$temporary/.uv-cache"
rm -rf "$temporary/.sdk-check-target"

(
    cd "$temporary/.application-smoke"
    CARGO_HOME="$temporary/.cargo" \
        RIFFDB_RUST_SDK="$temporary/public/rust-sdk/crates/riffdb-client-rust" \
        "$temporary/bin/riffdb" dev --seed --acceptance >/dev/null
)
rm -rf "$temporary/.application-smoke"
rm -f \
    "$temporary/.cargo/.global-cache" \
    "$temporary/.cargo/.package-cache" \
    "$temporary/.cargo/.package-cache-mutate" \
    "$temporary/.cargo/registry/CACHEDIR.TAG"
rmdir "$temporary/.cargo/registry" 2>/dev/null || {
    echo "sealed Cargo home retained unexpected mutable state" >&2
    exit 1
}

if find "$temporary" -type f \
    \( -iname '*ticketdesk*' -o -name SPEC.md -o -name work_packages.yaml \) \
    | grep -q .; then
    echo "sealed bundle contains prohibited product source" >&2
    exit 1
fi
if find "$temporary" -type f -name '*.rs' \
    ! -path "$temporary/public/rust-sdk/*" | grep -q .; then
    echo "sealed bundle contains non-SDK Rust implementation source" >&2
    exit 1
fi

(
    cd "$temporary"
    find . \( -type f -o -type l \) \
        ! -name bundle.json \
        ! -name checksums.sha256 \
        -print0 \
        | sort -z \
        | xargs -0 sha256sum >checksums.sha256
)
bundle_hash="$(sha256sum "$temporary/checksums.sha256" | cut -d' ' -f1)"
jq -n \
    --arg hash "$bundle_hash" \
    --arg revision "$(git -C "$repo_root" rev-parse HEAD)" \
    '{
      schema: "riffdb-agent-application-alpha-bundle/v1",
      bundle_hash: $hash,
      revision: $revision,
      sealed: true,
      contains_ticketdesk: false,
      contains_riffdb_implementation: false,
      public_rust_sdk_source: true
    }' >"$temporary/bundle.json"

mv "$temporary" "$destination"
trap - EXIT INT TERM
echo "$bundle_hash"
