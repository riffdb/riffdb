if [[ -n "$proof_output_dir" ]]; then
    proof_artifacts=(
        go.json
        typescript.json
        python.json
        binary_interval_rust.json
        binary_interval_cli.json
        binary_interval_mcp.json
        binary_interval_mcp_stdio.json
