       (.result_schema.oneOf[0].properties[] | select(.type == "array")
        | .maxItems == 4
          and (.items.properties[] | select(.type == "array") | .maxItems == 4)))
  and (.tools[] | select(.operation_name == "SearchDirectoryUsers")
       | (.input_schema.required | sort) == ["excluded_states", "needle", "organization_id"]
         and .input_schema.properties.excluded_states.maxItems == 64
         and .input_schema.properties.excluded_states.uniqueItems == true
         and .result_schema.oneOf[0].properties.users.maxItems == 499)
  and all(.tools[] | select(.operation_name | startswith("InventoryBy"));
       (.input_schema.required | sort) == ["organization_id"]
       and (.input_schema.properties | keys | sort) == ["limit", "offset", "organization_id"]
       and .input_schema.properties.limit.maximum == 499
       and .result_schema.oneOf[0].properties.records.maxItems == 499
       and .result_schema.oneOf[0].properties.total.properties.value.type == "string")
' \
    fixtures/adapters/operational-conformance/generated/mcp/tools.json >/dev/null

git show HEAD:fixtures/adapters/operational-conformance/generated/mcp/tools.json \
