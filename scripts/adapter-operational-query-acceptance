        mcp-auth-first-output.json
        mcp-stdio-auth-first.json
        server.stderr
        server-stdio.stderr
        mcp-stdio.stderr
    )
    for artifact in "${proof_artifacts[@]}"; do
        [[ -f "$work_root/$artifact" ]] || {
            echo "executed conformance proof artifact is absent: $artifact" >&2
            exit 1
        }
        artifact_bytes="$(wc -c <"$work_root/$artifact")"
        (( artifact_bytes <= 4194304 )) || {
            echo "executed conformance proof artifact exceeds 4,194,304 bytes: $artifact" >&2
            exit 1
        }
        cp "$work_root/$artifact" "$proof_output_dir/$artifact"
        chmod 0600 "$proof_output_dir/$artifact"
    done
fi

