#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ "$#" -ne 1 || "$1" != "--all-languages" ]]; then
    echo "usage: ./scripts/adapter-operational-query-acceptance --all-languages" >&2
    exit 2
fi

task_tmp_root="${RIFFDB_TMP_ROOT:-$HOME/tmp}"
mkdir -p "$task_tmp_root"
export TMPDIR="$task_tmp_root"
export GOCACHE="${RIFFDB_GO_CACHE:-$task_tmp_root/riffdb-go-cache}"
export GOPATH="${RIFFDB_GO_PATH:-$task_tmp_root/riffdb-go-path}"
export GOPROXY=off
export UV_CACHE_DIR="${UV_CACHE_DIR:-$task_tmp_root/riffdb-uv-cache}"
mkdir -p "$GOCACHE" "$GOPATH" "$UV_CACHE_DIR"

proof_output_dir="${RIFFDB_CONFORMANCE_RESULT_DIR:-}"
if [[ -n "$proof_output_dir" ]]; then
    [[ "$proof_output_dir" == /* && -d "$proof_output_dir" && ! -L "$proof_output_dir" ]] || {
        echo "conformance result directory must be an absolute existing non-symlink directory" >&2
        exit 2
    }
    [[ -z "$(find "$proof_output_dir" -mindepth 1 -maxdepth 1 -print -quit)" ]] || {
        echo "conformance result directory must be empty" >&2
        exit 2
    }
    chmod 0700 "$proof_output_dir"
fi

for tool in cargo curl go jq mkfifo mktemp node npm python3 sha256sum uv; do
    command -v "$tool" >/dev/null 2>&1 || {
        echo "required adapter-operational tool is missing: $tool" >&2
        exit 1
    }
done

work_root="$(mktemp -d "$task_tmp_root/riffdb-adapter-operational.XXXXXX")"
server_pid=
driver_pid=
cleanup() {
    if [[ -n "$driver_pid" ]] && kill -0 "$driver_pid" 2>/dev/null; then
        kill -TERM "$driver_pid" 2>/dev/null || true
        wait "$driver_pid" 2>/dev/null || true
    fi
    if [[ -n "$server_pid" ]] && kill -0 "$server_pid" 2>/dev/null; then
        printf 'shutdown\n' >&"$server_input_fd" 2>/dev/null || true
        wait "$server_pid" 2>/dev/null || true
    fi
    if [[ "${RIFFDB_KEEP_CONFORMANCE:-0}" == "1" ]]; then
        echo "retained adapter-operational work root: $work_root" >&2
    else
        rm -rf "$work_root"
    fi
}
trap cleanup EXIT INT TERM

cd "$repo_root"
cargo +1.97.0 build --quiet \
    -p riffdb-server --bin riffdbd \
    -p riffdb-cli --bin riffdb \
    -p riffdb-mcp-stdio --bin riffdb-mcp \
    -p riffdb-driver-host --bin riffdb-driverd
cargo +1.97.0 test --quiet -p riffdb-client-rust application_catalog_preflight --all-features
npm --prefix clients/typescript/runtime run build >/dev/null
(
    cd clients/python/runtime
    python3 -m maturin build --quiet --interpreter python3 \
        --compatibility linux --out "$work_root/dist"
)
python_wheel="$(find "$work_root/dist" -maxdepth 1 -type f -name '*.whl' -print -quit)"
[[ -n "$python_wheel" ]] || { echo "Python adapter wheel was not built" >&2; exit 1; }
uv venv "$work_root/python-venv" >/dev/null
uv pip install --offline --python "$work_root/python-venv/bin/python" "$python_wheel" >/dev/null

port="$($work_root/python-venv/bin/python - <<'PY'
import socket
with socket.socket() as listener:
    listener.bind(("127.0.0.1", 0))
    print(listener.getsockname()[1])
PY
)"
mcp_port="$($work_root/python-venv/bin/python - <<'PY'
import socket
with socket.socket() as listener:
    listener.bind(("127.0.0.1", 0))
    print(listener.getsockname()[1])
PY
)"
cp crates/riffdb-server/tests/fixtures/localhost-cert.pem "$work_root/server.pem"
cp crates/riffdb-server/tests/fixtures/localhost-key.pem "$work_root/server.key"
cp crates/riffdb-server/tests/fixtures/test-ca.pem "$work_root/ca.pem"
chmod 0444 "$work_root/server.pem" "$work_root/ca.pem"
chmod 0600 "$work_root/server.key"
printf '%s' 'riffdb-capability-digest-keys-v1
1:000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
' >"$work_root/capability.keys"
printf '%s' 'riffdb-idempotency-digest-keys-v1
1:202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f
' >"$work_root/idempotency.keys"
chmod 0600 "$work_root/capability.keys" "$work_root/idempotency.keys"
mkdir -m 0700 "$work_root/backups-default" "$work_root/backups-other"

cat >"$work_root/riffdbd.toml" <<EOF
[server]
audience = "riffdb-adapter-operational"
capability_keys = "$work_root/capability.keys"
idempotency_keys = "$work_root/idempotency.keys"
mcp_listen = "127.0.0.1:$mcp_port"

[server.application_listener]
mode = "direct_tls"
listen = "127.0.0.1:$port"
public_endpoint = "https://127.0.0.1:$port"
certificate_chain = "$work_root/server.pem"
private_key = "$work_root/server.key"

[server.application_listener.bounds]
max_connections = 64
max_streams_per_connection = 128
handshake_timeout_seconds = 5
drain_timeout_seconds = 5

[databases.default]
path = "$work_root/riffdb.redb"
backup_root = "$work_root/backups-default"
environment = "development"

[databases.other]
path = "$work_root/riffdb-other.redb"
backup_root = "$work_root/backups-other"
environment = "development"
EOF

mkfifo "$work_root/server.input" "$work_root/server.output"
exec {server_input_fd}<>"$work_root/server.input"
exec {server_output_fd}<>"$work_root/server.output"
target/debug/riffdbd --config "$work_root/riffdbd.toml" \
    <&"$server_input_fd" >"$work_root/server.output" 2>"$work_root/server.stderr" &
server_pid=$!
ready=
while IFS= read -r -t 60 line <&"$server_output_fd"; do
    if [[ "$line" == riffdbd-ready-v1$'\t'* ]]; then ready="$line"; break; fi
done
[[ "$ready" == "riffdbd-ready-v1"$'\t'"127.0.0.1:$port" ]] || {
    sed -n '1,200p' "$work_root/server.stderr" >&2
    echo "adapter-operational RiffDB did not become ready" >&2
    exit 1
}

cat >"$work_root/bootstrap.json" <<'EOF'
{"principal_id":"adapter-operational-operator","actor_kind":"human","requested_lifetime_seconds":86400,"audiences":["riffdb-adapter-operational"],"grant":{"tenant_scope":{"type":"global"},"partition_scope":{"type":"all"},"permissions":[{"type":"validate_contract"},{"type":"read_contract"},{"type":"deploy_contract"},{"type":"read_health"},{"type":"create_capability"},{"type":"revoke_capability"},{"type":"administer_capabilities"}],"field_visibility":[],"max_scan_rows":50,"approval_required":[]}}
EOF
cat >"$work_root/bootstrap-client.toml" <<EOF
[client]
endpoint = "https://127.0.0.1:$port"
database = "default"
output = "json"
max_attempts = 3
tls_trust_root = "$work_root/ca.pem"
tls_server_name = "127.0.0.1"
EOF
target/debug/riffdb --config "$work_root/bootstrap-client.toml" capability bootstrap \
    --request "$work_root/bootstrap.json" --generate "$work_root/bootstrap.credential" \
    --bearer-output "$work_root/operator.credential" >/dev/null
sed 's/database = "default"/database = "other"/' "$work_root/bootstrap-client.toml" \
    >"$work_root/other-bootstrap-client.toml"
target/debug/riffdb --config "$work_root/other-bootstrap-client.toml" capability bootstrap \
    --request "$work_root/bootstrap.json" --generate "$work_root/other-bootstrap.credential" \
    --bearer-output "$work_root/other-operator.credential" >/dev/null
cat >"$work_root/operator-client.toml" <<EOF
[client]
endpoint = "https://127.0.0.1:$port"
database = "default"
output = "json"
max_attempts = 3
credential_file = "$work_root/operator.credential"
tls_trust_root = "$work_root/ca.pem"
tls_server_name = "127.0.0.1"
EOF
sed -e 's/database = "default"/database = "other"/' \
    -e 's#operator\.credential#other-operator.credential#' \
    "$work_root/operator-client.toml" >"$work_root/other-operator-client.toml"

cp -R fixtures/adapters/operational-conformance "$work_root/application"
cp fixtures/riffql/wp701-binary-text-interval/documents_in_title_window.riffq \
    "$work_root/application/riffdb/queries/documents_in_title_window.riffq"
jq '
  .query_modules[0].queries += [{"name":"DocumentsInTitleWindow","source":"riffdb/queries/documents_in_title_window.riffq"}]
  | .roles[] |= if .name == "AdapterOperationalApplication"
      then .queries += ["DocumentsInTitleWindow"] else . end
' "$work_root/application/riffdb.application.json" \
    >"$work_root/application/riffdb.application.wp701.json"
mv "$work_root/application/riffdb.application.wp701.json" \
    "$work_root/application/riffdb.application.json"
(
    cd "$work_root/application"
    "$repo_root/target/debug/riffdb" application lock --write \
        riffdb.application.json --lock riffdb.application.lock.json >/dev/null
)
(
    cd "$work_root/application"
    "$repo_root/target/debug/riffdb" --config "$work_root/operator-client.toml" application deploy \
        riffdb.application.json --lock riffdb.application.lock.json \
        --provision-role AdapterOperationalApplication --lifetime-seconds 3600 >/dev/null
)
deployment_root="$work_root/application/.riffdb/deployments/default"
credential_file="$(jq -r 'if (.role.credential_file // "") == "" then "application.credential" else .role.credential_file end' "$deployment_root/deployment-state.json")"
if [[ "$credential_file" == /* ]]; then credential="$credential_file"; else credential="$deployment_root/$credential_file"; fi
[[ -f "$credential" ]] || { echo "adapter application credential was not provisioned" >&2; exit 1; }
(
    cd "$work_root/application"
    "$repo_root/target/debug/riffdb" --config "$work_root/other-operator-client.toml" application deploy \
        riffdb.application.json --lock riffdb.application.lock.json \
        --provision-role AdapterOperationalApplication --lifetime-seconds 3600 >/dev/null
)
other_deployment_root="$work_root/application/.riffdb/deployments/other"
other_credential_file="$(jq -r 'if (.role.credential_file // "") == "" then "application.credential" else .role.credential_file end' "$other_deployment_root/deployment-state.json")"
if [[ "$other_credential_file" == /* ]]; then other_credential="$other_credential_file"; else other_credential="$other_deployment_root/$other_credential_file"; fi
[[ -f "$other_credential" ]] || { echo "other-database application credential was not provisioned" >&2; exit 1; }

target/debug/riffdb --config "$work_root/operator-client.toml" role bind \
    "$work_root/application/generated/riffdb.application.exact.json" \
    --role AdapterOperationalLimited --principal adapter-operational-limited \
    --actor-kind service --audience riffdb-adapter-operational --lifetime-seconds 3600 \
    --credential-output "$work_root/limited.credential" --output json >/dev/null
target/debug/riffdb --config "$work_root/operator-client.toml" role bind \
    "$work_root/application/generated/riffdb.application.exact.json" \
    --role AdapterOperationalApplication --principal adapter-operational-mcp \
    --actor-kind agent --audience "http://127.0.0.1:$mcp_port/mcp" --lifetime-seconds 3600 \
    --capability-id 01990000-0000-7000-8000-000000000701 \
    --credential-output "$work_root/mcp.credential" --output json >/dev/null
target/debug/riffdb --config "$work_root/operator-client.toml" role bind \
    "$work_root/application/generated/riffdb.application.exact.json" \
    --role AdapterOperationalApplication --principal adapter-operational-mcp-auth \
    --actor-kind agent --audience "http://127.0.0.1:$mcp_port/mcp" --lifetime-seconds 3600 \
    --capability-id 01990000-0000-7000-8000-000000000702 \
    --credential-output "$work_root/mcp-auth.credential" --output json >/dev/null
target/debug/riffdb --config "$work_root/other-operator-client.toml" role bind \
    "$work_root/application/generated/riffdb.application.exact.json" \
    --role AdapterOperationalApplication --principal adapter-operational-mcp-other \
    --actor-kind agent --audience "http://127.0.0.1:$mcp_port/mcp" --lifetime-seconds 3600 \
    --capability-id 01990000-0000-7000-8000-000000000703 \
    --credential-output "$work_root/mcp-other.credential" --output json >/dev/null
target/debug/riffdb --config "$work_root/operator-client.toml" role bind \
    "$work_root/application/generated/riffdb.application.exact.json" \
    --role AdapterOperationalApplication --principal adapter-operational-stdio-auth \
    --actor-kind agent --audience riffdb-adapter-operational --lifetime-seconds 3600 \
    --capability-id 01990000-0000-7000-8000-000000000704 \
    --credential-output "$work_root/stdio-auth.credential" --output json >/dev/null

export RIFFDB_CONFORMANCE_ENDPOINT="https://127.0.0.1:$port"
export RIFFDB_CONFORMANCE_TRUST_ROOT="$work_root/ca.pem"
export RIFFDB_CONFORMANCE_CREDENTIAL="$credential"
cat >"$work_root/application-client.toml" <<EOF
[client]
endpoint = "https://127.0.0.1:$port"
database = "default"
output = "json"
max_attempts = 3
credential_file = "$credential"
tls_trust_root = "$work_root/ca.pem"
tls_server_name = "127.0.0.1"
EOF
module_hash="$(jq -r '.modules[0].module_hash' "$work_root/application/riffdb.application.lock.json")"
RIFFDB_WP701_BINARY_INTERVAL=1 RIFFDB_CONFORMANCE_SEED_ONLY=1 \
    cargo +1.97.0 run --quiet -p riffdb-testkit-server --example adapter_operational_remote_client -- \
    >"$work_root/rust-seed.json"
cat >"$work_root/binary-interval-parameters.json" <<'EOF'
{
  "site_id": {"$uuid":"018f0f8b-7c6d-7e31-8a4f-000000000023"},
  "after_title": "a",
  "horizon_title": "😀",
  "after": null
}
EOF
binary_interval_ready=''
for _attempt in $(seq 1 100); do
    if target/debug/riffdb --config "$work_root/application-client.toml" \
        query run-named DocumentsInTitleWindow \
        --contract-lineage AdapterOperationalConformance --contract-version 1 \
        --module-hash "$module_hash" --parameters "$work_root/binary-interval-parameters.json" \
        --output json >"$work_root/binary-interval-readiness.out" 2>&1; then
        binary_interval_ready=yes
        break
    fi
    if ! rg -q 'RDB-QUERY-0102' "$work_root/binary-interval-readiness.out"; then
        cat "$work_root/binary-interval-readiness.out" >&2
        exit 1
    fi
done
[[ "$binary_interval_ready" == yes ]] || {
    cat "$work_root/binary-interval-readiness.out" >&2
    echo "DocumentsInTitleWindow provider did not become ready within the bounded poll budget" >&2
    exit 1
}
cat >"$work_root/exact-provider-readiness.json" <<'EOF'
{
  "site_id": {"$uuid":"018f0f8b-7c6d-7e31-8a4f-00000000001e"},
  "needle": "Alpha",
  "document_id": null,
  "limit": 1,
  "offset": {"$u64":"0"}
}
EOF
for exact_query in ExactDocumentsContainsAsc ExactDocumentsEndsWithDesc ExactDocumentsStartsWithAsc; do
    exact_provider_ready=''
    for _attempt in $(seq 1 100); do
        if target/debug/riffdb --config "$work_root/application-client.toml" \
            query run-named "$exact_query" \
            --contract-lineage AdapterOperationalConformance --contract-version 1 \
            --module-hash "$module_hash" --parameters "$work_root/exact-provider-readiness.json" \
            --output json >"$work_root/exact-provider-readiness.out" 2>&1; then
            exact_provider_ready=yes
            break
        fi
        if ! rg -q 'RDB-QUERY-0102' "$work_root/exact-provider-readiness.out"; then
            cat "$work_root/exact-provider-readiness.out" >&2
            exit 1
        fi
    done
    [[ "$exact_provider_ready" == yes ]] || {
        cat "$work_root/exact-provider-readiness.out" >&2
        echo "$exact_query provider did not become ready within the bounded poll budget" >&2
        exit 1
    }
done
cat >"$work_root/exact-predicate-readiness.json" <<'EOF'
{
  "organization_id": {"$uuid":"018f0f8b-7c6d-7e31-8a4f-00000000003c"},
  "needle": "example",
  "excluded_states": ["disabled"],
  "maximum_created_at": null,
  "limit": 1,
  "offset": {"$u64":"0"}
}
EOF
cat >"$work_root/exact-predicate-reviewed-readiness.json" <<'EOF'
{
  "organization_id": {"$uuid":"018f0f8b-7c6d-7e31-8a4f-00000000003c"},
  "states": ["active", "archive"],
  "before_created_at": {"$u64":"35"},
  "limit": 25,
  "offset": {"$u64":"0"}
}
EOF
exact_provider_ready=''
for _attempt in $(seq 1 100); do
    if target/debug/riffdb --config "$work_root/application-client.toml" \
        query run-named SearchDirectoryUsers \
        --contract-lineage AdapterOperationalConformance --contract-version 1 \
        --module-hash "$module_hash" --parameters "$work_root/exact-predicate-readiness.json" \
        --output json >"$work_root/exact-provider-readiness.out" 2>&1; then
        exact_provider_ready=yes
        break
    fi
    if ! rg -q 'RDB-QUERY-0102' "$work_root/exact-provider-readiness.out"; then
        cat "$work_root/exact-provider-readiness.out" >&2
        exit 1
    fi
done
[[ "$exact_provider_ready" == yes ]] || {
    cat "$work_root/exact-provider-readiness.out" >&2
    echo "SearchDirectoryUsers provider did not become ready within the bounded poll budget" >&2
    exit 1
}
for query_and_file in \
    "ReviewedDirectoryUsers:$work_root/exact-predicate-reviewed-readiness.json"; do
    exact_query="${query_and_file%%:*}"
    readiness_file="${query_and_file#*:}"
    exact_provider_ready=''
    for _attempt in $(seq 1 100); do
        if target/debug/riffdb --config "$work_root/application-client.toml" \
            query run-named "$exact_query" \
            --contract-lineage AdapterOperationalConformance --contract-version 1 \
            --module-hash "$module_hash" --parameters "$readiness_file" \
            --output json >"$work_root/exact-provider-readiness.out" 2>&1; then
            exact_provider_ready=yes
            break
        fi
        if ! rg -q 'RDB-QUERY-0102' "$work_root/exact-provider-readiness.out"; then
            cat "$work_root/exact-provider-readiness.out" >&2
            exit 1
        fi
    done
    [[ "$exact_provider_ready" == yes ]] || {
        cat "$work_root/exact-provider-readiness.out" >&2
        echo "$exact_query provider did not become ready within the bounded poll budget" >&2
        exit 1
    }
done

cat >"$work_root/nullable-order-readiness.json" <<'EOF'
{
  "organization_id": {"$uuid":"018f0f8b-7c6d-7e31-8a4f-000000000046"},
  "limit": 2,
  "offset": {"$u64":"0"}
}
EOF
for exact_query in \
    InventoryBySubtitleAscNullsFirst \
    InventoryBySubtitleDescNullsLast \
    InventoryByObservedAscNullsLast \
    InventoryByObservedDescNullsFirst; do
    nullable_provider_ready=''
    for _attempt in $(seq 1 100); do
        if target/debug/riffdb --config "$work_root/application-client.toml" \
            query run-named "$exact_query" \
            --contract-lineage AdapterOperationalConformance --contract-version 1 \
            --module-hash "$module_hash" --parameters "$work_root/nullable-order-readiness.json" \
            --output json >"$work_root/nullable-provider-readiness.out" 2>&1; then
            nullable_provider_ready=yes
            break
        fi
        if ! rg -q 'RDB-QUERY-0102' "$work_root/nullable-provider-readiness.out"; then
            cat "$work_root/nullable-provider-readiness.out" >&2
            exit 1
        fi
    done
    [[ "$nullable_provider_ready" == yes ]] || {
        cat "$work_root/nullable-provider-readiness.out" >&2
        echo "$exact_query provider did not become ready within the bounded poll budget" >&2
        exit 1
    }
done

WP701_GENERATED_ROOT="$work_root/application/generated" \
    CARGO_TARGET_DIR="$work_root/wp701-rust-target" \
    cargo +1.97.0 run --quiet \
        --manifest-path fixtures/riffql/wp701-binary-text-interval/runner/rust/Cargo.toml \
        >"$work_root/binary_interval_rust.json"

target/debug/riffdb --config "$work_root/application-client.toml" \
    query run-named DocumentsInTitleWindow \
    --contract-lineage AdapterOperationalConformance --contract-version 1 \
    --module-hash "$module_hash" --parameters "$work_root/binary-interval-parameters.json" \
    --output json >"$work_root/binary-interval-cli-first.json"
binary_interval_cli_cursor="$(jq -r '.result.next_cursor // empty' "$work_root/binary-interval-cli-first.json")"
[[ -n "$binary_interval_cli_cursor" ]] || {
    echo "CLI binary interval first page omitted its cursor" >&2
    exit 1
}
target/debug/riffdb --config "$work_root/application-client.toml" \
    query run-named DocumentsInTitleWindow \
    --contract-lineage AdapterOperationalConformance --contract-version 1 \
    --module-hash "$module_hash" --parameters "$work_root/binary-interval-parameters.json" \
    --cursor="$binary_interval_cli_cursor" \
    --output json >"$work_root/binary-interval-cli-second.json"
jq -n \
    --slurpfile first "$work_root/binary-interval-cli-first.json" \
    --slurpfile second "$work_root/binary-interval-cli-second.json" \
    '{surface:"cli",transport:"remote_grpc",
      first_page:[$first[0].result.fields[] | select(.name == "documents") | .records[].fields[] | select(.name == "title") | .value.value],
      second_page:[$second[0].result.fields[] | select(.name == "documents") | .records[].fields[] | select(.name == "title") | .value.value],
      first_cursor:($first[0].result.next_cursor != null),second_cursor:($second[0].result.next_cursor != null)}' \
    >"$work_root/binary_interval_cli.json"

cat >"$work_root/list-fga-parameters.json" <<'EOF'
{
  "store_id": {"$uuid":"018f0f8b-7c6d-7e31-8a4f-00000000000a"},
  "relation": "viewer",
  "after": null
}
EOF
target/debug/riffdb --config "$work_root/application-client.toml" query run-named ListFgaTuples \
    --contract-lineage AdapterOperationalConformance --contract-version 1 \
    --module-hash "$module_hash" --parameters "$work_root/list-fga-parameters.json" \
    --output json >"$work_root/cli.json"
jq -e '.ok == true and .result.outcome == "Found" and (.result.fields[0].records | length) == 1' \
    "$work_root/cli.json" >/dev/null

cat >"$work_root/ticket-expansion-parameters.json" <<'EOF'
{"organization_id":{"$uuid":"018f0f8b-7c6d-7e31-8a4f-000000000050"},"state":"open"}
EOF
cat >"$work_root/run-expansion-parameters.json" <<'EOF'
{"experiment_id":{"$uuid":"018f0f8b-7c6d-7e31-8a4f-00000000005a"},"lifecycle":"active"}
EOF
cat >"$work_root/object-expansion-parameters.json" <<'EOF'
{"store_id":{"$uuid":"018f0f8b-7c6d-7e31-8a4f-000000000064"},"kind":"document"}
EOF
for query_and_parameters in \
    "TicketPageWithComments:$work_root/ticket-expansion-parameters.json:tickets:comments" \
    "MlflowRunsWithTags:$work_root/run-expansion-parameters.json:runs:tags" \
    "FgaObjectsWithRelations:$work_root/object-expansion-parameters.json:objects:relations"; do
    query="${query_and_parameters%%:*}"
    remainder="${query_and_parameters#*:}"
    parameters="${remainder%%:*}"
    remainder="${remainder#*:}"
    root_field="${remainder%%:*}"
    nested_field="${remainder#*:}"
    target/debug/riffdb --config "$work_root/application-client.toml" query run-named "$query" \
        --contract-lineage AdapterOperationalConformance --contract-version 1 \
        --module-hash "$module_hash" --parameters "$parameters" \
        --output json >"$work_root/cli-$query.json"
    jq -e --arg root "$root_field" --arg nested "$nested_field" '
      .ok == true and .result.outcome == "Found"
      and (.result.fields[] | select(.name == $root) | .records | length) == 2
      and (.result.fields[] | select(.name == $root) | .records[0].fields[]
           | select(.name == $nested) | .value
           | .type == "list" and (.values | length) == 2)
      and (.result.fields[] | select(.name == $root) | .records[1].fields[]
           | select(.name == $nested) | .value
           | .type == "list" and (.values | length) == 1)
    ' "$work_root/cli-$query.json" >/dev/null
done

