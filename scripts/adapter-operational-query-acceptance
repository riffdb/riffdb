mcp_endpoint="http://127.0.0.1:$mcp_port/mcp"
write_mcp_curl_config() {
    local credential_path="$1"
    local database="$2"
    local output="$3"
    cat >"$output" <<EOF
url = "$mcp_endpoint"
header = "Authorization: Bearer $(<"$credential_path")"
header = "riffdb-database: $database"
header = "Content-Type: application/json"
header = "Accept: application/json, text/event-stream"
header = "Mcp-Protocol-Version: 2025-11-25"
max-time = 45
silent
show-error
EOF
    chmod 0600 "$output"
}
write_mcp_curl_config "$work_root/mcp.credential" default "$work_root/mcp-curl.conf"
write_mcp_curl_config "$work_root/mcp-auth.credential" default "$work_root/mcp-auth-curl.conf"
write_mcp_curl_config "$work_root/mcp-other.credential" other "$work_root/mcp-other-curl.conf"
normalize_mcp_response() {
    jq -Rse '
      [split("\n")[] | select(startswith("data: ")) | ltrimstr("data: ") | fromjson]
      | if length == 1 then .[0] else error("expected exactly one MCP data event") end
    ' "$1" >"$2"
}
initialize_mcp_session() {
    local config="$1"
    local prefix="$2"
    jq -cn '{jsonrpc:"2.0",id:1,method:"initialize",params:{protocolVersion:"2025-11-25",capabilities:{},clientInfo:{name:"riffdb-operator-acceptance",version:"1"}}}' >"$work_root/$prefix-initialize.json"
    curl --config "$config" --dump-header "$work_root/$prefix-initialize.headers" \
        --output "$work_root/$prefix-initialize-output.sse" \
        --data-binary @"$work_root/$prefix-initialize.json"
    mcp_session_id="$(awk 'tolower($1) == "mcp-session-id:" {gsub(/\r/, "", $2); print $2}' "$work_root/$prefix-initialize.headers")"
    [[ -n "$mcp_session_id" && "$mcp_session_id" != *$'\n'* ]] || {
        echo "hosted MCP initialization omitted its bounded session ID" >&2
        exit 1
    }
    normalize_mcp_response "$work_root/$prefix-initialize-output.sse" \
        "$work_root/$prefix-initialize-output.json"
    jq -e '.result.protocolVersion == "2025-11-25"' "$work_root/$prefix-initialize-output.json" >/dev/null
    jq -cn '{jsonrpc:"2.0",method:"notifications/initialized"}' >"$work_root/$prefix-notification.json"
    curl --config "$config" --header "Mcp-Session-Id: $mcp_session_id" \
        --output "$work_root/$prefix-notification-output.json" \
        --data-binary @"$work_root/$prefix-notification.json"
}
raw_mcp_call() {
    local config="$1"
    local call_session_id="$2"
    local request_id="$3"
    local tool="$4"
    local arguments="$5"
    local prefix="$6"
    jq -cn --argjson id "$request_id" --arg tool "$tool" --argjson arguments "$arguments" \
        '{jsonrpc:"2.0",id:$id,method:"tools/call",params:{name:$tool,arguments:$arguments}}' \
        >"$work_root/$prefix.json"
    local http_status
    http_status="$(curl --config "$config" --header "Mcp-Session-Id: $call_session_id" \
        --output "$work_root/$prefix-output.sse" --write-out '%{http_code}' \
        --data-binary @"$work_root/$prefix.json")"
    if rg -q '^data: ' "$work_root/$prefix-output.sse"; then
        normalize_mcp_response "$work_root/$prefix-output.sse" "$work_root/$prefix-output.json"
    elif [[ -s "$work_root/$prefix-output.sse" ]] \
        && jq -e . "$work_root/$prefix-output.sse" >"$work_root/$prefix-output.json" 2>/dev/null; then
        :
    elif [[ "$http_status" == 401 || "$http_status" == 403 ]]; then
        jq -n --argjson status "$http_status" \
            '{error:{type:"http_authorization_failure",status:$status}}' \
            >"$work_root/$prefix-output.json"
    else
        echo "hosted MCP returned an undecodable response with HTTP status $http_status" >&2
        exit 1
    fi
}
initialize_mcp_session "$work_root/mcp-curl.conf" mcp
session_id="$mcp_session_id"
run_mcp_call() {
    local request_id="$1"
    local tool="$2"
    local arguments="$3"
    local root_field="$4"
    local nested_field="$5"
    jq -cn --argjson id "$request_id" --arg tool "$tool" --argjson arguments "$arguments" \
        '{jsonrpc:"2.0",id:$id,method:"tools/call",params:{name:$tool,arguments:$arguments}}' \
        >"$work_root/mcp-call-$request_id.json"
    curl --config "$work_root/mcp-curl.conf" --header "Mcp-Session-Id: $session_id" \
        --dump-header "$work_root/mcp-call-$request_id.headers" \
        --output "$work_root/mcp-call-$request_id-output.sse" \
        --data-binary @"$work_root/mcp-call-$request_id.json"
    normalize_mcp_response "$work_root/mcp-call-$request_id-output.sse" \
        "$work_root/mcp-call-$request_id-output.json"
    jq -e --arg root "$root_field" --arg nested "$nested_field" '
      .result.isError == false
      and (.result.structuredContent[$root] | map(.[$nested] | length)) == [2, 1]
    ' "$work_root/mcp-call-$request_id-output.json" >/dev/null
}
