import json
import os
import subprocess

def start(config):
    environment = dict(os.environ)
    environment["RIFFDB_MCP_CONFIG"] = config
    return subprocess.Popen(
        [os.environ["RIFFDB_MCP_BINARY"]],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        env=environment,
    )

def send(process, message, response=True):
    process.stdin.write(json.dumps(message, separators=(",", ":"), ensure_ascii=False) + "\n")
    process.stdin.flush()
    if not response:
        return None
    line = process.stdout.readline()
    if not line:
        raise RuntimeError("stdio MCP closed before responding")
    return json.loads(line)

def initialize(process):
    initialized = send(process, {"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-11-25","capabilities":{},"clientInfo":{"name":"riffdb-wp701","version":"1"}}})
    if initialized.get("result", {}).get("protocolVersion") != "2025-11-25":
        raise RuntimeError("stdio MCP initialization diverged")
    send(process, {"jsonrpc":"2.0","method":"notifications/initialized"}, response=False)

def call(process, request_id, tool, arguments):
    return send(process, {"jsonrpc":"2.0","id":request_id,"method":"tools/call","params":{"name":tool,"arguments":arguments}})

def close(process):
    process.stdin.close()
    process.wait(timeout=10)
    diagnostics = process.stderr.read()
    if process.returncode != 0:
        raise RuntimeError("stdio MCP exited unsuccessfully: " + diagnostics)
    return diagnostics

document_tool = "adapter_operational_conformance_documents_in_title_window"
fga_tool = "adapter_operational_conformance_list_fga_tuples"
arguments = {"site_id":"018f0f8b-7c6d-7e31-8a4f-000000000023","after_title":"a","horizon_title":"😀"}
process = start(os.environ["RIFFDB_MCP_CONFIG"])
initialize(process)
stale = call(process, 2, document_tool, dict(arguments, after=os.environ["RIFFDB_HOSTED_STALE_CURSOR"]))
first = call(process, 3, document_tool, arguments)
if "result" not in first:
    raise RuntimeError("stdio MCP first call failed: " + json.dumps(first, separators=(",", ":")))
structured = first["result"]["structuredContent"]
if sorted(structured) != ["page", "result"] or sorted(structured["result"]) != ["documents", "outcome"]:
    raise RuntimeError("stdio MCP exposed an open or physical result shape")
if [row["title"] for row in structured["result"]["documents"]] != ["aa", "b"]:
    raise RuntimeError("stdio MCP first page diverged")
cursor = structured["page"]["next_cursor"]
if not isinstance(cursor, str) or len(cursor) != 22:
    raise RuntimeError("stdio MCP cursor presentation diverged")
malformed = call(process, 4, document_tool, dict(arguments, after="AAAAAAAAAAAAAAAAAAAAAB"))
cross_query = call(process, 5, fga_tool, {"store_id":"018f0f8b-7c6d-7e31-8a4f-00000000000a","relation":"viewer","after":cursor})
second = call(process, 6, document_tool, dict(arguments, after=cursor))
second_structured = second["result"]["structuredContent"]
if [row["title"] for row in second_structured["result"]["documents"]] != ["é"] or second_structured["page"] != {"next_cursor":None}:
    raise RuntimeError("stdio MCP continuation diverged")
if json.loads(first["result"]["content"][0]["text"]) != structured or json.loads(second["result"]["content"][0]["text"]) != second_structured:
    raise RuntimeError("stdio MCP text and structured content diverged")
auth_process = start(os.environ["RIFFDB_MCP_AUTH_CONFIG"])
initialize(auth_process)
authorization_first = call(auth_process, 2, document_tool, arguments)
authorization_cursor = authorization_first["result"]["structuredContent"]["page"]["next_cursor"]
with open(os.environ["RIFFDB_MCP_AUTH_FIRST"], "w", encoding="utf-8") as output:
    json.dump(authorization_first, output, separators=(",", ":"), ensure_ascii=False)
    output.write("\n")

other_process = start(os.environ["RIFFDB_MCP_OTHER_CONFIG"])
initialize(other_process)
cross_database = call(other_process, 2, document_tool, dict(arguments, after=authorization_cursor))
other_diagnostics = close(other_process)

subprocess.run(
    [os.environ["RIFFDB_CLI"], "--config", os.environ["RIFFDB_OPERATOR_CONFIG"],
     "capability", "revoke", "01990000-0000-7000-8000-000000000704",
     "--reason", "policy_change"],
    check=True,
    stdout=subprocess.DEVNULL,
)
authorization = call(auth_process, 3, document_tool, dict(arguments, after=authorization_cursor))
with open(os.environ["RIFFDB_MCP_RESULT"], "w", encoding="utf-8") as output:
    json.dump({"surface":"mcp","transport":"stdio_mcp","first_page":["aa","b"],"first_cursor":True,"second_page":["é"],"second_cursor":False,"raw_shape_exact":True}, output, separators=(",", ":"), ensure_ascii=False)
    output.write("\n")
with open(os.environ["RIFFDB_MCP_PROOF"], "w", encoding="utf-8") as output:
    json.dump({"schema":"riffdb.mcp-paginated-query-proof/v1","transport":"stdio_mcp",
               "first":first,"second":second,"malformed":malformed,
               "cross_query":cross_query,"cross_database":cross_database,
               "stale":stale,"authorization":authorization},
              output, separators=(",", ":"), ensure_ascii=False)
    output.write("\n")
diagnostics = close(process)
auth_diagnostics = close(auth_process)
with open(os.environ["RIFFDB_MCP_STDERR"], "w", encoding="utf-8") as output:
    output.write(diagnostics)
    output.write(other_diagnostics)
    output.write(auth_diagnostics)
PY
