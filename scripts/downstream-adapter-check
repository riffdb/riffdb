#!/usr/bin/env bash
set -euo pipefail

# Compiles the out-of-tree adapter repositories against this working tree.
#
# The adapter repositories are the only consumers that exercise the contract
# and RiffQL languages end to end, and nothing in this repository's own test
# suite compiles them. A language change therefore lands green here and leaves
# them broken until somebody opens one: ADR-0167 required `Limit<MAX>`, was
# migrated in riffdb-openfga, and left riffdb-better-auth failing RDB-QS003.
#
# Default: fetch every immutable pin into a temporary directory. --repo-root
# checks existing working copies read-only. No adapter code is executed.
# req: VER-003, DRV-014

usage() {
    echo "usage: ./scripts/downstream-adapter-check [--repo-root DIR] [--repo NAME]... [--reproduce-adr-0167]" >&2
    exit 2
}

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

downstream_root=""
reproduce=false
declare -a requested=()
while (($#)); do
    case "$1" in
        --repo-root)
            (($# >= 2)) && [[ -n "$2" ]] || usage
            downstream_root="${2:-}"
            shift 2
            ;;
        --repo)
            (($# >= 2)) && [[ -n "$2" ]] || usage
            requested+=("${2:-}")
            shift 2
            ;;
        --reproduce-adr-0167)
            reproduce=true
            shift
            ;;
        *) usage ;;
    esac
done

for tool in cargo jq git python3; do
    command -v "$tool" >/dev/null 2>&1 || {
        echo "required downstream check tool is missing: $tool" >&2
        exit 1
    }
done
pins="$repo_root/scripts/downstream-adapters.json"
jq -e '
    .version == 1 and (.adapters | type == "array" and length > 0 and length <= 32)
    and ([.adapters[].name] | length == (unique | length))
    and all(.adapters[];
        (.name | test("^riffdb-[a-z0-9-]+$")) and
        (.repository == ("https://github.com/riffdb/" + .name + ".git")) and
        (.revision | test("^[0-9a-f]{40}$")))
' "$pins" >/dev/null || {
    echo "downstream-adapter-check: invalid immutable adapter pins" >&2
    exit 1
}
if ((${#requested[@]} == 0)); then
    mapfile -t requested < <(jq -r '.adapters[].name' "$pins")
fi
for repo in "${requested[@]}"; do
    jq -e --arg name "$repo" 'any(.adapters[]; .name == $name)' "$pins" >/dev/null || {
        echo "downstream-adapter-check: unknown adapter: $repo" >&2
        exit 1
    }
done
scratch="$(mktemp -d "${TMPDIR:-/tmp}/riffdb-downstream.XXXXXX")"
trap 'rm -rf -- "$scratch"' EXIT
if [[ -z "$downstream_root" ]]; then
    downstream_root="$scratch/adapters"
    mkdir -p "$downstream_root"
    for repo in "${requested[@]}"; do
        url="$(jq -r --arg name "$repo" '.adapters[] | select(.name == $name) | .repository' "$pins")"
        revision="$(jq -r --arg name "$repo" '.adapters[] | select(.name == $name) | .revision' "$pins")"
        directory="$downstream_root/$repo"
        git init --quiet "$directory"
        GIT_TERMINAL_PROMPT=0 git -C "$directory" fetch --quiet --depth=1 "$url" "$revision"
        git -C "$directory" -c advice.detachedHead=false checkout --quiet --detach FETCH_HEAD
        [[ "$(git -C "$directory" rev-parse HEAD)" == "$revision" ]] || exit 1
        printf 'downstream-adapter-pin-v1\t%s\t%s\n' "$repo" "$revision"
    done
fi
cargo_target_dir="$(cargo metadata --quiet --format-version 1 --no-deps \
    | jq -er '.target_directory | select(type == "string" and length > 0)')" || {
    echo "Cargo target directory could not be resolved" >&2
    exit 1
}
[[ "$cargo_target_dir" == /* ]] || {
    echo "Cargo returned a non-absolute target directory" >&2
    exit 1
}
cargo build --locked --release -p riffdb-cli --bin riffdb
riffdb="$cargo_target_dir/release/riffdb"

status=0
checked=0
for repo in "${requested[@]}"; do
    directory="$downstream_root/$repo"
    if [[ ! -d "$directory" ]]; then
        echo "downstream-adapter-check: $repo is absent at $directory" >&2
        status=1
        continue
    fi
    if [[ ! -f "$directory/riffdb.toml" ]]; then
        echo "$repo: no riffdb.toml; not a RiffDB application repository" >&2
        status=1
        continue
    fi
    checked=$((checked + 1))
    if (cd "$directory" && "$riffdb" application check); then
        printf 'downstream-adapter-check-v1\t%s\tcompiles\n' "$repo"
    else
        printf 'downstream-adapter-check-v1\t%s\tfailed\n' "$repo" >&2
        status=1
    fi
done

if ((checked == 0)); then
    echo "downstream-adapter-check: no adapter repository was checked" >&2
    echo "fetch the pinned repositories, or pass --repo-root DIR" >&2
    exit 1
fi

if [[ "$reproduce" == true ]] && ((status == 0)); then
    # Copy the successful Better Auth tree and restore ADR-0167's rejected
    # spelling. Exercise this same checker, including its exit propagation.
    [[ -d "$downstream_root/riffdb-better-auth" ]] || {
        echo "ADR-0167 reproduction requires riffdb-better-auth" >&2
        exit 1
    }
    mkdir -p "$scratch/regression"
    cp -a "$downstream_root/riffdb-better-auth" "$scratch/regression/"
    python3 - "$scratch/regression/riffdb-better-auth/riffdb/queries/admin_users_all_email_asc.riffq" <<'PY'
from pathlib import Path
import re
import sys
path = Path(sys.argv[1])
source, count = re.subn(r'\bLimit<\d+>', 'Limit', path.read_text(), count=1)
if count != 1:
    raise SystemExit('ADR-0167 fixture no longer contains the bounded Limit declaration')
path.write_text(source)
PY
    if "$repo_root/scripts/downstream-adapter-check" --repo-root "$scratch/regression" \
        --repo riffdb-better-auth >"$scratch/regression.log" 2>&1; then
        echo "ADR-0167 reproduction incorrectly passed" >&2
        exit 1
    fi
    cat "$scratch/regression.log"
    grep -F 'RDB-QS003' "$scratch/regression.log" >/dev/null
    grep -F $'downstream-adapter-check-v1\triffdb-better-auth\tfailed' "$scratch/regression.log" >/dev/null
    echo "downstream-adapter-regression-v1: ADR-0167 rejected by the CI checker"
fi

exit "$status"
