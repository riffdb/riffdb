#!/usr/bin/env python3
"""ADR-0183 / ADR-0199 performance-package freeze: seal and check.

The freeze record lives under `performance_freeze:` in work_packages.yaml and
is created once, by WP-762, in the same change that banks the baseline. It
inventories every package that lists a `PERF-*` requirement at freeze start
and, for each then-open package, stores SHA-256 over the RFC 8785 JSON
Canonicalization Scheme UTF-8 bytes of the entire parsed package mapping after
removing only its top-level `closure` member (`PERF-020`).

While the freeze is in force this check accepts:
  - a package closed before the recorded start;
  - an inert open entry whose normalized definition is byte-identical to its
    sealed digest and which has gained no closure;
  - the exact WP-750 / WP-760 transition: unchanged definition plus a closure;
  - WP-762 and WP-763 under their existing authority (definition may change
    and a closure may be added; no `PERF-*` requirement may be added).
It rejects a new performance-bearing package, an altered or closed inert
entry, a changed exception definition or `PERF-*` set, a fifth exception, a
non-JSON or non-finite scalar in a sealed definition, and any lift that does
not satisfy ADR-0183 Decision 1 (both WP-750 and WP-760 closed and a later,
separately accepted record named in `lifted_by`).

The exception identifiers and their roles are first-party constants below; the
record must restate them exactly and may not append to them.

usage:
  check-performance-freeze                    check the manifest; exit 1 on a violation
  check-performance-freeze --seal --started-at DATE --baseline-revision SHA
                           --receipt PATH ... [--write]
                                              print (or write) the freeze record
  check-performance-freeze --digest WP-NNN    print one package's sealed-definition digest
  check-performance-freeze --self-test        prove the decision table on fabricated manifests
  check-performance-freeze --json             machine-readable result
"""
# req: PERF-020, PERF-021
from __future__ import annotations

import argparse
import copy
import datetime as _dt
import hashlib
import json
import math
import os
import re
import subprocess
import sys
from pathlib import Path
from typing import Any

import yaml

SCHEMA = "riffdb.performance-freeze/v1"
DIGEST_RULE = "sha256(rfc8785-jcs(package without top-level closure))"
STARTED_BY = "WP-762"
# First-party constants (ADR-0199 Decision 5). A record must restate exactly these.
EXCEPTIONS: dict[str, str] = {
    "WP-750": "closure_only_prerequisite",
    "WP-760": "closure_only_prerequisite",
    "WP-762": "bank_and_start",
    "WP-763": "candidate_build_activate_or_remove",
}
LIFT_PREREQUISITES = ("WP-750", "WP-760")
# ADR-0239 lifts the freeze before the prerequisites close. That deviation is
# enumerated here rather than by weakening the guard: every other record still
# has to wait for WP-750 and WP-760, and --self-test proves it.
EARLY_LIFT_EXCEPTION = "ADR-0239"
PERF = re.compile(r"^PERF-\d{3}$")
HEX64 = re.compile(r"^[0-9a-f]{64}$")
HEX40 = re.compile(r"^[0-9a-f]{40}$")
ADR_ID = re.compile(r"^ADR-(\d{4})$")


def root() -> Path:
    override = os.environ.get("RIFFDB_GOVERNANCE_ROOT")
    if override:
        return Path(override)
    out = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True)
    return Path(out.stdout.strip())


# --- RFC 8785 JSON Canonicalization Scheme -----------------------------------

class InvalidScalar(ValueError):
    pass


def _es_number(value: float) -> str:
    """ECMAScript Number::toString for a finite double (RFC 8785 section 3.2.2.3)."""
    if value == 0:
        return "0"
    if value != value or value in (math.inf, -math.inf):
        raise InvalidScalar("non-finite number")
    sign = "-" if value < 0 else ""
    value = abs(value)
    text = repr(value)  # shortest round-trip digits, as ECMAScript requires
    if "e" in text or "E" in text:
        mantissa, exponent = text.lower().split("e")
        exp = int(exponent)
    else:
        mantissa, exp = text, 0
    digits = mantissa.replace(".", "").lstrip("0") or "0"
    if "." in mantissa:
        int_part, frac_part = mantissa.split(".")
        point = len(int_part.lstrip("0")) if int_part.strip("0") else -(len(frac_part) - len(frac_part.lstrip("0")))
    else:
        point = len(mantissa)
    digits = digits.rstrip("0") or "0"
    n = point + exp  # position of the decimal point relative to digits
    k = len(digits)
    if k <= n <= 21:
        return sign + digits + "0" * (n - k)
    if 0 < n <= 21:
        return sign + digits[:n] + "." + digits[n:]
    if -6 < n <= 0:
        return sign + "0." + "0" * (-n) + digits
    e = n - 1
    exp_text = f"e{'+' if e >= 0 else '-'}{abs(e)}"
    if k == 1:
        return sign + digits + exp_text
    return sign + digits[0] + "." + digits[1:] + exp_text


def _jcs_string(value: str) -> str:
    out = ['"']
    for ch in value:
        code = ord(ch)
        if ch == '"':
            out.append('\\"')
        elif ch == "\\":
            out.append("\\\\")
        elif ch == "\b":
            out.append("\\b")
        elif ch == "\f":
            out.append("\\f")
        elif ch == "\n":
            out.append("\\n")
        elif ch == "\r":
            out.append("\\r")
        elif ch == "\t":
            out.append("\\t")
        elif code < 0x20:
            out.append(f"\\u{code:04x}")
        else:
            out.append(ch)
    out.append('"')
    return "".join(out)


def jcs(value: Any) -> str:
    """Serialize a JSON-compatible Python value per RFC 8785."""
    if value is None:
        return "null"
    if value is True:
        return "true"
    if value is False:
        return "false"
    if isinstance(value, int):
        return str(value)
    if isinstance(value, float):
        return _es_number(value)
    if isinstance(value, str):
        return _jcs_string(value)
    if isinstance(value, list):
        return "[" + ",".join(jcs(item) for item in value) + "]"
    if isinstance(value, dict):
        for key in value:
            if not isinstance(key, str):
                raise InvalidScalar(f"non-string object key {key!r}")
        ordered = sorted(value.items(), key=lambda item: item[0].encode("utf-16-be"))
        return "{" + ",".join(_jcs_string(k) + ":" + jcs(v) for k, v in ordered) + "}"
    raise InvalidScalar(f"non-JSON scalar of type {type(value).__name__}")


def sealed_digest(package: dict[str, Any]) -> str:
    definition = {k: copy.deepcopy(v) for k, v in package.items() if k != "closure"}
    return hashlib.sha256(jcs(definition).encode("utf-8")).hexdigest()


# --- Manifest access -----------------------------------------------------------

def load_manifest(path: Path) -> dict[str, Any]:
    with path.open("r", encoding="utf-8") as handle:
        return yaml.safe_load(handle) or {}


def packages_by_id(manifest: dict[str, Any]) -> dict[str, dict[str, Any]]:
    result: dict[str, dict[str, Any]] = {}
    for package in manifest.get("work_packages") or []:
        if isinstance(package, dict) and isinstance(package.get("id"), str):
            result[package["id"]] = package
    return result


def perf_ids(package: dict[str, Any]) -> set[str]:
    return {r for r in (package.get("requirements") or []) if isinstance(r, str) and PERF.match(r)}


def is_closed(package: dict[str, Any]) -> bool:
    closure = package.get("closure")
    return isinstance(closure, dict) and bool(closure)


# --- Seal ----------------------------------------------------------------------

def seal(manifest: dict[str, Any], started_at: str, revision: str, receipts: list[dict[str, str]]) -> dict[str, Any]:
    inventory = []
    for pid, package in sorted(packages_by_id(manifest).items()):
        if not perf_ids(package):
            continue
        entry: dict[str, Any] = {"id": pid, "state": "closed" if is_closed(package) else "open"}
        if entry["state"] == "open":
            entry["digest"] = sealed_digest(package)
            entry["perf_requirements"] = sorted(perf_ids(package))
        inventory.append(entry)
    return {
        "schema": SCHEMA,
        "started_at": started_at,
        "started_by": STARTED_BY,
        "digest_rule": DIGEST_RULE,
        "baseline": {"source_revision": revision, "receipts": receipts},
        "exceptions": dict(EXCEPTIONS),
        "inventory": inventory,
        "lifted_by": None,
    }


# --- Check ---------------------------------------------------------------------

def check(manifest: dict[str, Any], repo: Path | None) -> dict[str, Any]:
    errors: list[str] = []
    record = manifest.get("performance_freeze")
    if record is None:
        return {"started": False, "errors": [], "note": "no performance_freeze record; the freeze has not started"}
    if not isinstance(record, dict) or record.get("schema") != SCHEMA:
        return {"started": True, "errors": ["performance_freeze record has an unknown schema"]}

    expected_keys = {"schema", "started_at", "started_by", "digest_rule", "baseline", "exceptions", "inventory", "lifted_by"}
    if set(record) != expected_keys:
        errors.append(f"performance_freeze keys are {sorted(record)}, expected {sorted(expected_keys)}")
    if record.get("started_by") != STARTED_BY:
        errors.append(f"performance_freeze.started_by must be {STARTED_BY}")
    if record.get("digest_rule") != DIGEST_RULE:
        errors.append("performance_freeze.digest_rule drifted")
    baseline = record.get("baseline") if isinstance(record.get("baseline"), dict) else {}
    if not HEX40.match(str(baseline.get("source_revision", ""))):
        errors.append("performance_freeze.baseline.source_revision is not a 40-hex revision")
    receipts = baseline.get("receipts")
    if not isinstance(receipts, list) or not receipts:
        errors.append("performance_freeze.baseline.receipts must list the banked receipts")
    else:
        for receipt in receipts:
            if not isinstance(receipt, dict) or set(receipt) != {"path", "sha256"} or not HEX64.match(str(receipt.get("sha256", ""))):
                errors.append(f"performance_freeze.baseline receipt is malformed: {receipt!r}")
                continue
            if repo is not None:
                path = repo / str(receipt["path"])
                if not path.is_file():
                    errors.append(f"banked receipt is missing: {receipt['path']}")
                elif hashlib.sha256(path.read_bytes()).hexdigest() != receipt["sha256"]:
                    errors.append(f"banked receipt digest differs: {receipt['path']}")

    exceptions = record.get("exceptions")
    if exceptions != EXCEPTIONS:
        extra = sorted(set(exceptions or {}) - set(EXCEPTIONS)) if isinstance(exceptions, dict) else []
        if extra:
            errors.append(f"performance_freeze.exceptions names a fifth exception: {', '.join(extra)}")
        else:
            errors.append("performance_freeze.exceptions must restate exactly the four first-party exceptions and roles")

    inventory = record.get("inventory")
    sealed: dict[str, dict[str, Any]] = {}
    if not isinstance(inventory, list):
        errors.append("performance_freeze.inventory must be a list")
    else:
        for entry in inventory:
            if not isinstance(entry, dict) or not isinstance(entry.get("id"), str) or entry.get("state") not in ("open", "closed"):
                errors.append(f"performance_freeze.inventory entry is malformed: {entry!r}")
                continue
            if entry["state"] == "open" and not HEX64.match(str(entry.get("digest", ""))):
                errors.append(f"performance_freeze.inventory {entry['id']} lacks a 64-hex digest")
            sealed[entry["id"]] = entry

    packages = packages_by_id(manifest)
    lifted = record.get("lifted_by")
    lift_ok = False
    if lifted is not None:
        if not isinstance(lifted, str) or not ADR_ID.match(lifted):
            errors.append("performance_freeze.lifted_by must be an ADR identifier or null")
        else:
            open_prereqs = [pid for pid in LIFT_PREREQUISITES if not is_closed(packages.get(pid, {}))]
            if open_prereqs and lifted != EARLY_LIFT_EXCEPTION:
                errors.append(f"performance_freeze.lifted_by is set while {', '.join(open_prereqs)} remain open (premature lift)")
            if repo is not None:
                number = ADR_ID.match(lifted).group(1)
                matches = list((repo / "adr").glob(f"{number}-*.md")) if (repo / "adr").is_dir() else []
                if not matches:
                    errors.append(f"performance_freeze.lifted_by names {lifted}, which does not exist")
                else:
                    text = matches[0].read_text(encoding="utf-8")
                    if not re.search(r"^status:\s*accepted\s*$", text, re.M) and "**Status:** Accepted" not in text:
                        errors.append(f"performance_freeze.lifted_by names {lifted}, which is not accepted")
            lift_ok = not errors

    if lift_ok:
        return {"started": True, "lifted": True, "errors": [], "note": f"freeze lifted by {lifted}"}

    # Every package that lists a PERF requirement now must be accounted for.
    for pid, package in sorted(packages.items()):
        current_perf = perf_ids(package)
        entry = sealed.get(pid)
        if not current_perf:
            if entry is not None and entry["state"] == "open" and pid not in EXCEPTIONS:
                errors.append(f"{pid}: inert entry dropped its PERF requirements (definition changed)")
            continue
        if entry is None:
            errors.append(f"{pid}: new performance-bearing package registered during the freeze (human review trigger)")
            continue
        if entry["state"] == "closed":
            continue
        try:
            digest = sealed_digest(package)
        except InvalidScalar as exc:
            errors.append(f"{pid}: {exc}")
            continue
        sealed_perf = set(entry.get("perf_requirements") or [])
        role = EXCEPTIONS.get(pid)
        if role is None:
            if digest != entry.get("digest"):
                errors.append(f"{pid}: inert entry changed its sealed definition")
            if is_closed(package):
                errors.append(f"{pid}: inert entry gained a closure during the freeze")
        elif role == "closure_only_prerequisite":
            if digest != entry.get("digest"):
                errors.append(f"{pid}: prerequisite may add only a closure; its definition changed")
            if current_perf != sealed_perf:
                errors.append(f"{pid}: prerequisite changed its PERF requirement set")
        else:  # WP-762 / WP-763 existing authority
            if not current_perf <= sealed_perf:
                errors.append(f"{pid}: added a PERF requirement beyond its sealed set: {sorted(current_perf - sealed_perf)}")
    for pid, entry in sealed.items():
        if pid not in packages:
            errors.append(f"{pid}: sealed inventory entry is missing from the manifest")

    return {"started": True, "lifted": False, "errors": errors, "inventory": len(sealed), "open_at_start": sum(1 for e in sealed.values() if e["state"] == "open")}


# --- Self-test -----------------------------------------------------------------

def _fixture() -> dict[str, Any]:
    def wp(pid: str, reqs: list[str], closed: bool = False, extra: dict[str, Any] | None = None) -> dict[str, Any]:
        package: dict[str, Any] = {"id": pid, "name": f"{pid} name", "requirements": reqs, "allowed_paths": ["crates/**"]}
        if extra:
            package.update(extra)
        if closed:
            package["closure"] = {"status": "complete", "completed_at": "2026-01-01"}
        return package
    manifest = {
        "work_packages": [
            wp("WP-100", ["PERF-001"], closed=True),
            wp("WP-200", ["PERF-002", "API-001"]),
            wp("WP-750", ["REP-008", "PERF-008"]),
            wp("WP-760", ["REC-005", "PERF-019"]),
            wp("WP-762", ["PERF-020", "PERF-021"]),
            wp("WP-763", ["PERF-022"]),
            wp("WP-300", ["API-001"]),
        ]
    }
    manifest["performance_freeze"] = seal(manifest, "2026-01-02", "a" * 40, [{"path": "x", "sha256": "b" * 64}])
    return manifest


def self_test() -> bool:
    failures: list[str] = []

    def expect(label: str, manifest: dict[str, Any], ok: bool, needle: str = "") -> None:
        result = check(manifest, None)
        passed = not result["errors"]
        if passed != ok:
            failures.append(f"{label}: expected {'pass' if ok else 'fail'}, got {result['errors'] or 'pass'}")
        elif not ok and needle and not any(needle in e for e in result["errors"]):
            failures.append(f"{label}: error must mention {needle!r}: {result['errors']}")

    base = _fixture()
    expect("sealed manifest passes", copy.deepcopy(base), True)

    m = copy.deepcopy(base); m["work_packages"].append({"id": "WP-900", "requirements": ["PERF-030"]})
    expect("new PERF package", m, False, "new performance-bearing package")

    m = copy.deepcopy(base); m["work_packages"][1]["name"] = "edited"
    expect("inert edit", m, False, "changed its sealed definition")

    m = copy.deepcopy(base); m["work_packages"][1]["closure"] = {"status": "complete"}
    expect("inert closure", m, False, "gained a closure")

    m = copy.deepcopy(base); m["work_packages"][2]["closure"] = {"status": "complete", "completed_at": "2026-02-01"}
    expect("WP-750 closure-only", m, True)
    m["work_packages"][3]["closure"] = {"status": "complete", "completed_at": "2026-02-02"}
    expect("WP-750 and WP-760 closure-only", m, True)

    m = copy.deepcopy(base); m["work_packages"][2]["allowed_paths"].append("crates/riffdb-commit/**")
    expect("WP-750 widened definition", m, False, "definition changed")

    m = copy.deepcopy(base); m["work_packages"][3]["requirements"].append("PERF-050")
    expect("WP-760 PERF set change", m, False, "definition changed")

    m = copy.deepcopy(base); m["performance_freeze"]["exceptions"]["WP-300"] = "closure_only_prerequisite"
    expect("fifth exception", m, False, "fifth exception")

    m = copy.deepcopy(base); m["work_packages"][2]["closure"] = {"status": "complete"}; m["performance_freeze"]["lifted_by"] = "ADR-0999"
    expect("premature lift with WP-760 open", m, False, "premature lift")

    # The enumerated exception is exactly one record: any other early lift,
    # including one differing by a single digit, is still premature.
    m = copy.deepcopy(base); m["work_packages"][2]["closure"] = {"status": "complete"}; m["performance_freeze"]["lifted_by"] = "ADR-0240"
    expect("premature lift by a record other than the exception", m, False, "premature lift")

    m = copy.deepcopy(base); m["work_packages"][4]["closure"] = {"status": "complete"}; m["work_packages"][5]["objective"] = "candidate removed"; m["work_packages"][5]["closure"] = {"status": "complete_negative_mechanics_result"}
    expect("WP-762 and WP-763 existing authority", m, True)

    m = copy.deepcopy(base); m["work_packages"][5]["requirements"].append("PERF-031")
    expect("WP-763 adds a PERF requirement", m, False, "beyond its sealed set")

    m = copy.deepcopy(base); m["work_packages"][1]["name"] = 1.5
    m["performance_freeze"]["inventory"][1]["digest"] = "0" * 64
    expect("float scalar still compares by digest", m, False, "changed its sealed definition")
    try:
        sealed_digest({"id": "x", "value": float("inf")})
        failures.append("non-finite number must invalidate")
    except InvalidScalar:
        pass
    try:
        sealed_digest({"id": "x", "value": _dt.date(2026, 1, 1)})
        failures.append("non-JSON scalar must invalidate")
    except InvalidScalar:
        pass

    # JCS vectors (RFC 8785 appendix and ES number formatting).
    if jcs({"b": 1, "a": [True, None, "x\n"]}) != '{"a":[true,null,"x\\n"],"b":1}':
        failures.append("jcs object/array serialization drifted")
    for value, expected in ((1e21, "1e+21"), (1e-7, "1e-7"), (0.000001, "0.000001"), (123456789012345680000.0, "123456789012345680000"), (-0.5, "-0.5"), (10.0, "10")):
        if _es_number(value) != expected:
            failures.append(f"es number {value!r}: got {_es_number(value)!r}, expected {expected!r}")

    if failures:
        for failure in failures:
            print(failure, file=sys.stderr)
        return False
    print("performance-freeze self-test passed.")
    return True


# --- CLI -----------------------------------------------------------------------

def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--manifest", type=Path, default=None)
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--self-test", action="store_true")
    parser.add_argument("--digest", metavar="WP-NNN")
    parser.add_argument("--seal", action="store_true")
    parser.add_argument("--started-at")
    parser.add_argument("--baseline-revision")
    parser.add_argument("--receipt", action="append", default=[], help="receipt path relative to the repository root; repeatable")
    parser.add_argument("--write", action="store_true", help="with --seal: write the record into the manifest")
    args = parser.parse_args()

    if args.self_test:
        return 0 if self_test() else 1

    repo = root()
    manifest_path = args.manifest or (repo / "work_packages.yaml")
    manifest = load_manifest(manifest_path)

    if args.digest:
        package = packages_by_id(manifest).get(args.digest)
        if package is None:
            print(f"unknown package {args.digest}", file=sys.stderr)
            return 2
        print(sealed_digest(package))
        return 0

    if args.seal:
        if not args.started_at or not args.baseline_revision or not args.receipt:
            parser.error("--seal requires --started-at, --baseline-revision, and at least one --receipt")
        if manifest.get("performance_freeze") is not None:
            print("performance_freeze already exists; refusing to reseal", file=sys.stderr)
            return 2
        receipts = []
        for rel in args.receipt:
            path = repo / rel
            if not path.is_file():
                print(f"receipt missing: {rel}", file=sys.stderr)
                return 2
            receipts.append({"path": rel, "sha256": hashlib.sha256(path.read_bytes()).hexdigest()})
        record = seal(manifest, args.started_at, args.baseline_revision, receipts)
        text = yaml.safe_dump({"performance_freeze": record}, sort_keys=False, width=100, allow_unicode=True)
        if args.write:
            source = manifest_path.read_text(encoding="utf-8")
            marker = "\nwork_packages:\n"
            if source.count(marker) != 1:
                print("cannot locate the work_packages key to insert the record", file=sys.stderr)
                return 2
            manifest_path.write_text(source.replace(marker, "\n" + text + "work_packages:\n", 1), encoding="utf-8")
            print(f"performance_freeze written to {manifest_path} ({len(record['inventory'])} inventory entries)")
        else:
            print(text, end="")
        return 0

    result = check(manifest, repo)
    if args.json:
        print(json.dumps(result, indent=2))
    elif not result.get("started"):
        print(result["note"])
    elif result.get("lifted"):
        print(result["note"])
    elif result["errors"]:
        for error in result["errors"]:
            print(error, file=sys.stderr)
        print(f"{len(result['errors'])} performance-freeze violation(s).", file=sys.stderr)
    else:
        print(f"performance freeze in force since {manifest['performance_freeze']['started_at']}: "
              f"{result['inventory']} sealed entries ({result['open_at_start']} open at start), no violations.")
    return 1 if result.get("errors") else 0


if __name__ == "__main__":
    sys.exit(main())
