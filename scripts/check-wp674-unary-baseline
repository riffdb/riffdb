def fail(detail: str) -> "None":
    raise ValueError(detail)


def load_json(path: Path, maximum: int) -> tuple[dict[str, Any], str]:
    encoded = bounded_read(path, maximum, "evidence file")
    value = json.loads(encoded.decode("utf-8"))
    if not isinstance(value, dict):
        fail(f"evidence root must be an object: {path}")
    return value, hashlib.sha256(encoded).hexdigest()


def require_sha(value: Any, label: str) -> str:
    if not isinstance(value, str) or SHA256.fullmatch(value) is None:
        fail(f"{label} is not a lowercase SHA-256 digest")
    return value


def require_number(value: Any, label: str) -> float:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        fail(f"{label} is not numeric")
    result = float(value)
    if not math.isfinite(result) or result < 0:
        fail(f"{label} is not finite and nonnegative")
    return result


def require_exact_integer(value: Any, expected: int, label: str) -> None:
    if type(value) is not int or value != expected:
        fail(f"{label} is not the exact integer {expected}")


def exact_strings(value: Any, expected: set[str], label: str) -> None:
    if (
        not isinstance(value, list)
        or len(value) != len(expected)
        or any(not isinstance(item, str) for item in value)
        or set(value) != expected
    ):
        fail(f"{label} is not the exact frozen set")


def scenario_class(name: str) -> str:
    for class_name, members in SCENARIO_CLASSES.items():
        if name in members:
            return class_name
    fail(f"unknown frozen unary scenario {name}")


def summary_spread(summary: Any, label: str) -> float:
    """Central-three spread of a five-generation summary, validated first.

    ADR-0171 makes this number invalidating for RiffDB and disclosable for the
    comparator, so both paths must compute it identically and neither may skip
    the structural validation that precedes it.
    """
    return summary_value(summary, label, require_stable=False, return_spread=True)


def summary_value(
    summary: Any,
    label: str,
    *,
    require_stable: bool = True,
    return_spread: bool = False,
) -> float:
    if not isinstance(summary, dict):
        fail(f"{label} summary is absent")
    require_exact_integer(summary.get("reps"), REPETITIONS, f"{label}.reps")
    values = summary.get("values")
    if not isinstance(values, list) or len(values) != REPETITIONS:
        fail(f"{label} does not retain all five generations")
    retained = [require_number(value, f"{label}.values") for value in values]
    if any(value <= 0 for value in retained):
        fail(f"{label} contains a non-positive generation")
    ordered = sorted(retained)
    median = require_number(summary.get("median"), f"{label}.median")
    minimum = require_number(summary.get("min"), f"{label}.min")
    maximum = require_number(summary.get("max"), f"{label}.max")
    spread = require_number(summary.get("spread_ratio"), f"{label}.spread_ratio")
    if not math.isclose(minimum, ordered[0]) or not math.isclose(maximum, ordered[4]):
        fail(f"{label} retained extremes differ from min/max")
    if not math.isclose(median, ordered[2]):
        fail(f"{label} qualified value is not the median of five")
    expected_spread = maximum / minimum
    if not math.isclose(spread, expected_spread, rel_tol=1e-9, abs_tol=1e-9):
        fail(f"{label} spread arithmetic differs")
    central_spread = ordered[3] / ordered[1]
    if require_stable and central_spread > MAX_SPREAD:
        fail(
            f"{label} central-three spread {central_spread:.4f} "
            f"exceeds {MAX_SPREAD:.2f}"
        )
    if return_spread:
        return central_spread
    return median


def verify_host(report: dict[str, Any], profile_id: str, label: str) -> tuple[str, str]:
    host = report.get("host_validity")
    if not isinstance(host, dict):
        fail(f"{label}: host validity is absent")
    inventories = list(validate_valid_host_pair(host, profile_id))
    stable_identities: list[dict[str, Any]] = []
    for boundary, observation in zip(("preflight", "postflight"), inventories):
        if (
            not isinstance(observation, dict)
            or observation.get("schema") != "riffdb.app-baseline-host-validity/v2"
            or observation.get("valid") is not True
        ):
            fail(f"{label}: host invalid at {boundary}")
        if observation.get("interfering_processes") != []:
            fail(f"{label}: host interference at {boundary}")
        bounds = observation.get("inventory_bounds") or {}
        if bounds.get("process_arguments_included") is not False:
            fail(f"{label}: process-argument redaction pin is absent")
        require_sha(
            observation.get("boot_identity_sha256"),
            f"{label}.{boundary}.boot_identity_sha256",
        )
        checked_cpu_accounting = observation.get("cpu_accounting") or {}
        total_ticks = checked_cpu_accounting.get("total_ticks")
        steal_ticks = checked_cpu_accounting.get("steal_ticks")
        if (
            isinstance(total_ticks, bool)
            or not isinstance(total_ticks, int)
            or total_ticks < 0
            or isinstance(steal_ticks, bool)
            or not isinstance(steal_ticks, int)
            or steal_ticks < 0
            or steal_ticks > total_ticks
        ):
            fail(f"{label}: {boundary} CPU accounting is invalid")
        identity = observation.get("hardware_identity")
        if not isinstance(identity, dict):
            fail(f"{label}: hardware identity is absent")
        rules = PROFILE_HARDWARE_RULES[profile_id]
        if observation.get("logical_cpus") != rules["logical_cpus"]:
            fail(f"{label}: logical CPU count differs from {profile_id}")
        cpu_model = identity.get("cpu_model")
        if not isinstance(cpu_model, str) or rules["cpu_contains"] not in cpu_model:
            fail(f"{label}: CPU model differs from {profile_id}")
        stable_identities.append(
            {
                "logical_cpus": observation["logical_cpus"],
                "hardware_identity": identity,
            }
        )
    preflight, postflight = inventories
    if preflight.get("whole_cell") is not None:
        fail(f"{label}: preflight unexpectedly claims whole-cell evidence")
    whole_cell = postflight.get("whole_cell")
    if (
        not isinstance(whole_cell, dict)
        or whole_cell.get("valid") is not True
        or whole_cell.get("reason") is not None
        or whole_cell.get("maximum_steal_percent") != 1.0
    ):
        fail(f"{label}: valid whole-cell steal evidence is absent")
    elapsed_total = whole_cell.get("elapsed_total_ticks")
    elapsed_steal = whole_cell.get("elapsed_steal_ticks")
    steal_percent = whole_cell.get("steal_percent")
    if (
        isinstance(elapsed_total, bool)
        or not isinstance(elapsed_total, int)
        or elapsed_total <= 0
        or isinstance(elapsed_steal, bool)
        or not isinstance(elapsed_steal, int)
        or elapsed_steal < 0
        or elapsed_steal > elapsed_total
        or isinstance(steal_percent, bool)
        or not isinstance(steal_percent, (int, float))
        or not math.isclose(
            float(steal_percent),
            round(elapsed_steal / elapsed_total * 100.0, 6),
            rel_tol=0.0,
            abs_tol=0.000001,
        )
        or float(steal_percent) > 1.0
    ):
        fail(f"{label}: whole-cell steal arithmetic is invalid")
    bound_preflight = require_sha(
        postflight.get("baseline_report_sha256"),
        f"{label}.postflight.baseline_report_sha256",
    )
    canonical_preflight = (json.dumps(preflight, sort_keys=True) + "\n").encode()
    if bound_preflight != hashlib.sha256(canonical_preflight).hexdigest():
        fail(f"{label}: postflight does not bind its exact preflight")
    if preflight.get("boot_identity_sha256") != postflight.get("boot_identity_sha256"):
        fail(f"{label}: boot identity changed during measurement")
    if stable_identities[0] != stable_identities[1]:
        fail(f"{label}: hardware identity changed during measurement")
    environment = report.get("environment") or {}
    medium = environment.get("medium") or {}
    stable_identity = {
        **stable_identities[0],
        "storage": {
            key: medium.get(key) for key in ("kind", "fstype", "device_model")
        },
    }
    if stable_identity["storage"]["kind"] != "disk":
        fail(f"{label}: storage is not persistent disk")
    encoded = json.dumps(inventories, sort_keys=True, separators=(",", ":")).encode()
    stable = json.dumps(stable_identity, sort_keys=True, separators=(",", ":")).encode()
    return hashlib.sha256(encoded).hexdigest(), hashlib.sha256(stable).hexdigest()


def verify_candidate(
    report: dict[str, Any], manifest: dict[str, Any], label: str
) -> dict[str, str]:
    candidate = report.get("qualification_candidate")
    if (
        not isinstance(candidate, dict)
        or set(candidate)
        != {
            "schema",
            "source_revision",
            "source_tree_clean",
            "cargo_lock_sha256",
            "runner_sha256",
            "riffdbd_sha256",
            "harness_sha256",
            "method",
        }
        or candidate.get("schema") != CANDIDATE_SCHEMA
    ):
        fail(f"{label}: exact candidate identity is absent")
    # ADR-0171: every banked receipt records which backend the stability rule
    # binds, so a candidate measured under a different rule fails method drift.
    if candidate.get("method") != {"stability_rule_binds": "gated_backend"}:
        fail(f"{label}: candidate stability rule is not bound to the gated backend")
    if candidate.get("source_tree_clean") is not True:
        fail(f"{label}: source tree was not clean")
    for key in (
        "source_revision",
        "cargo_lock_sha256",
        "harness_sha256",
        "runner_sha256",
        "riffdbd_sha256",
    ):
        if candidate.get(key) != manifest.get(key):
            fail(f"{label}: candidate {key} differs from manifest")
    return {
        key: require_sha(candidate.get(key), f"{label}.{key}")
        for key in ("runner_sha256", "riffdbd_sha256")
    }


def verify_counterbalance(report: dict[str, Any], postgres: str, label: str) -> None:
    expected = []
    for generation in range(REPETITIONS):
        pair = [postgres, "riffdb_public_grpc"]
        expected.extend(pair if generation % 2 == 0 else reversed(pair))
    if report.get("backend_execution_order") != expected:
        fail(f"{label}: backend generations are not counterbalanced")


def verify_frozen_workload(report: dict[str, Any], label: str) -> None:
    if report.get("report_id") != "ticketdesk-app-baseline":
        fail(f"{label}: report identity drifted")
    if report.get("domain") != "TicketDesk":
        fail(f"{label}: workload domain drifted")
    strict_equal(report.get("tables"), FROZEN_TABLES, f"{label}.tables")
    strict_equal(report.get("scale"), FROZEN_FULL_SCALE, f"{label}.scale")
    strict_equal(
        report.get("scale_shape"),
        FROZEN_FULL_SCALE_SHAPE,
        f"{label}.scale_shape",
    )
    configuration = report.get("configuration")
    if not isinstance(configuration, dict):
        fail(f"{label}: configuration is absent")
    for key, expected in FROZEN_CONFIGURATION_PINS.items():
        strict_equal(configuration.get(key), expected, f"{label}.configuration.{key}")


def verify_storage_topology(report: dict[str, Any], label: str) -> None:
    environment = report.get("environment")
    if not isinstance(environment, dict):
        fail(f"{label}: environment is absent")
    environment_medium = environment.get("medium")
    riffdb_medium = report.get("riffdb_storage_medium")
    postgres_medium = report.get("postgres_storage_medium")
    if not all(
        isinstance(medium, dict)
        for medium in (environment_medium, riffdb_medium, postgres_medium)
    ):
        fail(f"{label}: storage-medium evidence is absent")
    strict_equal(riffdb_medium, environment_medium, f"{label}.riffdb_storage_medium")
    strict_equal(postgres_medium, environment_medium, f"{label}.postgres_storage_medium")
    if environment_medium.get("kind") != "disk" or report.get("same_device") is not True:
        fail(f"{label}: backends are not on one persistent device")


def verify_timing(row: dict[str, Any], label: str) -> None:
    timing = row.get("timing")
    expected_keys = {
        "max_ns",
        "mean_ns",
        "min_ns",
        "p50_ns",
        "p95_ns",
        "p99_ns",
        "sample_count",
        "samples_ns",
    }
    if not isinstance(timing, dict) or set(timing) != expected_keys:
        fail(f"{label}: timing sample shape drifted")
    require_exact_integer(
        timing.get("sample_count"), MEASUREMENTS, f"{label}.sample_count"
    )
    samples = timing.get("samples_ns")
    if not isinstance(samples, list) or len(samples) != MEASUREMENTS:
        fail(f"{label}: timing samples are not exact")
    if any(type(sample) is not int or sample <= 0 for sample in samples):
        fail(f"{label}: timing samples are not positive integers")
    ordered = sorted(samples)
    expected = {
        "min_ns": ordered[0],
        "max_ns": ordered[-1],
        "mean_ns": sum(ordered) // MEASUREMENTS,
        "p50_ns": ordered[math.ceil(0.50 * MEASUREMENTS) - 1],
        "p95_ns": ordered[math.ceil(0.95 * MEASUREMENTS) - 1],
        "p99_ns": ordered[math.ceil(0.99 * MEASUREMENTS) - 1],
    }
    for key, expected_value in expected.items():
        require_exact_integer(timing.get(key), expected_value, f"{label}.{key}")


def verify_process_evidence(
    report: dict[str, Any], label: str, *, scenario_class_name: str | None
) -> None:
    generations = report.get("riffdb_process_evidence")
    if (
        not isinstance(generations, list)
        or len(generations) != REPETITIONS
        or any(not isinstance(generation, dict) for generation in generations)
    ):
        fail(f"{label}: RiffDB process-generation evidence shape drifted")
    selected_scenario = scenario_class_name is not None
    expected_scope = (
        "after_seed_before_measured_process_to_after_clean_shutdown_and_structural_reopen"
        if selected_scenario
        else "post_shutdown_structural_reopen_inventory_only"
    )
    for index, generation in enumerate(generations):
        prefix = f"{label}.riffdb_process_evidence[{index}]"
        if generation.get("labels") != "closed_fixed_cardinality":
            fail(f"{prefix}: evidence labels drifted")
        if generation.get("post_shutdown_structural_reopen") is not True:
            fail(f"{prefix}: clean shutdown and structural reopen are not proven")
        if generation.get("table_inventory_scope") != expected_scope:
            fail(f"{prefix}: process-generation inventory scope drifted")
        for field in ("graph_shutdown_elapsed_us", "harness_shutdown_elapsed_us"):
            value = generation.get(field)
            if type(value) is not int or value < 0:
                fail(f"{prefix}.{field}: shutdown evidence is not an integer")
        shutdown_stages = generation.get("shutdown_stages_us")
        if (
            not isinstance(shutdown_stages, list)
            or len(shutdown_stages) != 8
            or any(type(value) is not int or value < 0 for value in shutdown_stages)
        ):
            fail(f"{prefix}: shutdown-stage evidence is incomplete")
        inventory = generation.get("authoritative_table_inventory")
        if (
            not isinstance(inventory, list)
            or not inventory
            or any(not isinstance(row, dict) or not row for row in inventory)
        ):
            fail(f"{prefix}: post-shutdown table inventory is absent")
        stage_inventories = {
            "read_pipeline_stages": READ_PIPELINE_STAGES,
            "write_service_stages": WRITE_SERVICE_STAGES,
            "command_pipeline_stages": COMMAND_PIPELINE_STAGES,
        }
        stage_counts: dict[str, list[int]] = {}
        for field, expected_stages in stage_inventories.items():
            rows = generation.get(field)
            if (
                not isinstance(rows, list)
                or [row.get("stage") for row in rows if isinstance(row, dict)]
                != list(expected_stages)
            ):
                fail(f"{prefix}.{field}: process-generation stages are absent")
            if any(type(row.get("count")) is not int or row["count"] < 0 for row in rows):
                fail(f"{prefix}.{field}: process-generation counts are invalid")
            stage_counts[field] = [row["count"] for row in rows]
        for field in (
            "writer_frame_census",
            "writer_flush_census",
            "writer_journal_stages",
            "writer_publication_stages",
            "completion_lane",
        ):
            value = generation.get(field)
            if not isinstance(value, dict) or not value:
                fail(f"{prefix}.{field}: process-generation census is absent")
        writer = generation.get("writer")
        if not isinstance(writer, dict) or not writer:
            fail(f"{prefix}.writer: writer evidence is absent")
        for field in ("physical_commits", "logical_commands_committed"):
            value = writer.get(field)
            if type(value) is not int or value < 0:
                fail(f"{prefix}.writer.{field}: writer work is not proven")
        for field in ("frontier_equivalence_failures", "prepared_epoch_proof_mismatches"):
            require_exact_integer(writer.get(field), 0, f"{prefix}.writer.{field}")
        if scenario_class_name == "compiled_command":
            if (
                stage_counts["read_pipeline_stages"] != [0] * len(READ_PIPELINE_STAGES)
                or stage_counts["write_service_stages"] != [MEASUREMENTS] * len(WRITE_SERVICE_STAGES)
                or stage_counts["command_pipeline_stages"] != [MEASUREMENTS] * len(COMMAND_PIPELINE_STAGES)
            ):
                fail(f"{prefix}: compiled-command process topology or cardinality drifted")
            require_exact_integer(writer.get("physical_commits"), MEASUREMENTS, f"{prefix}.physical_commits")
            require_exact_integer(writer.get("logical_commands_committed"), MEASUREMENTS, f"{prefix}.logical_commands")
        elif selected_scenario:
            expected_reads = MEASUREMENTS + WARMUPS
            if (
                stage_counts["read_pipeline_stages"] != [expected_reads] * len(READ_PIPELINE_STAGES)
                or stage_counts["write_service_stages"] != [0] * len(WRITE_SERVICE_STAGES)
                or stage_counts["command_pipeline_stages"] != [0] * len(COMMAND_PIPELINE_STAGES)
            ):
                fail(f"{prefix}: named-read process topology or cardinality drifted")
            require_exact_integer(writer.get("physical_commits"), 0, f"{prefix}.physical_commits")
            require_exact_integer(writer.get("logical_commands_committed"), 0, f"{prefix}.logical_commands")
        else:
            physical_commits = writer["physical_commits"]
            # The minimal cell's first process generation also serves the three
            # board-page live crosscheck reads (limits 50, 200, 450); later
            # generations carry the measured reads only. Every retained column,
            # including the 2026-08-30 N1 column, records 10,206 then 10,203.
            expected_reads = 10_206 if index == 0 else 10_203
            if (
                stage_counts["read_pipeline_stages"] != [expected_reads] * len(READ_PIPELINE_STAGES)
                or stage_counts["write_service_stages"]
                != [4_000, 23_220, 23_220, 23_220, 4_000]
                or stage_counts["command_pipeline_stages"]
                != [physical_commits] * len(COMMAND_PIPELINE_STAGES)
                or not 0 < physical_commits <= 23_220
            ):
                fail(f"{prefix}: minimal process topology or cardinality drifted")
            require_exact_integer(writer.get("logical_commands_committed"), 23_220, f"{prefix}.logical_commands")


def verify_postgres_durability(report: dict[str, Any], label: str) -> None:
    expected = {
        "data_directory": "/var/lib/postgresql/18/docker",
        "fsync": "on",
        "full_page_writes": "on",
        "server_version_num": "180004",
        "synchronous_commit": "on",
        "wal_sync_method": "fdatasync",
    }
    strict_equal(report.get("postgres_durability"), expected, f"{label}.postgres_durability")


def verify_correctness(
    comparison: dict[str, Any],
    backend_rows: dict[str, dict[str, Any]],
    label: str,
) -> None:
    postgres = backend_rows["postgres"]
    riffdb = backend_rows["riffdb"]
    values = {
        "postgres comparison": comparison.get("postgres_last_row_count"),
        "riffdb comparison": comparison.get("riffdb_last_row_count"),
        "postgres backend": postgres.get("last_row_count"),
        "riffdb backend": riffdb.get("last_row_count"),
    }
    if any(type(value) is not int or value < 0 for value in values.values()):
        fail(f"{label}: correctness row counts are not non-negative integers")
    if len(set(values.values())) != 1 or comparison.get("last_row_count_equal") is not True:
        fail(f"{label}: backend and comparison row counts differ")


def verify_selected_p50(
    backend_row: dict[str, Any], summary: Any, label: str
) -> None:
    observed = (backend_row.get("timing") or {}).get("p50_ns")
    expected = summary_value(summary, label, require_stable=False)
    if type(observed) is not int or not math.isclose(float(observed), expected):
        fail(f"{label}: selected timing p50 differs from the five-generation median")


def verify_evidence_eligibility(
    report: dict[str, Any],
    postgres_disclosures: list[str],
    riffdb_stable: bool,
    label: str,
    *,
    host_invalid: bool,
    riffdb_disclosures: list[str] | None = None,
) -> None:
    expected = {
        "eligible": not host_invalid and riffdb_stable,
        "host_idle": not host_invalid,
        "reason_codes": ["host_interference"] if host_invalid else [],
        "postgres_central_three_spread_disclosed": sorted(postgres_disclosures),
        "stable": riffdb_stable,
        "correctness_clean": True,
        "same_device_comparable": True,
        "comparison_complete": True,
        "missing_required_fields": [] if riffdb_stable else ["stability"],
        "non_evidentiary_window": False,
    }
    if riffdb_disclosures is not None:
        # ADR-0171 Amendment 2: the minimal cell publishes RiffDB's spreads as
        # disclosure instead of re-proving the dedicated cells' rule.
        expected["riffdb_central_three_spread_disclosed"] = sorted(riffdb_disclosures)
    strict_equal(report.get("evidence_eligibility"), expected, f"{label}.evidence_eligibility")


def verify_report(
    report: dict[str, Any],
    manifest: dict[str, Any],
    profile_id: str,
    scenario: str,
    label: str,
    *,
    host_invalid: bool = False,
    require_stable: bool = True,
) -> tuple[dict[str, Any], dict[str, str]]:
    if report.get("schema") != REPORT_SCHEMA:
        fail(f"{label}: report schema or repetition count drifted")
    require_exact_integer(report.get("reps"), REPETITIONS, f"{label}.reps")
    verify_frozen_workload(report, label)
    configuration = report.get("configuration") or {}
    require_exact_integer(
        configuration.get("warmup_iterations"), WARMUPS, f"{label}.warmups"
    )
    require_exact_integer(
        configuration.get("measured_samples"), MEASUREMENTS, f"{label}.measurements"
    )
    selection = report.get("unary_qualification") or {}
    expected_selection = {
        "schema": SELECTION_SCHEMA,
        "scenario": scenario,
        "class": scenario_class(scenario),
        "daemon_restart_after_common_setup": True,
        "same_scenario_warmups_after_restart": WARMUPS,
        "measured_operations_per_generation": MEASUREMENTS,
        "process_generations": REPETITIONS,
    }
    try:
        strict_equal(selection, expected_selection, f"{label}.unary_qualification")
    except ValueError:
        fail(f"{label}: frozen selection or class drifted")
    if report.get("same_device") is not True:
        fail(f"{label}: PostgreSQL and RiffDB are not on one device")
    verify_postgres_durability(report, label)
    if not report.get("environment") or not report.get("device_baseline"):
        fail(f"{label}: environment or device observation is absent")
    verify_storage_topology(report, label)
    verify_process_evidence(report, label, scenario_class_name=scenario_class(scenario))
    if host_invalid:
        if "qualification_candidate" in report:
            fail(f"{label}: host-invalid report claims a qualified candidate")
        host_digest = ""
        hardware_digest = ""
        binaries = {}
    else:
        host_digest, hardware_digest = verify_host(report, profile_id, label)
        binaries = verify_candidate(report, manifest, label)
    verify_counterbalance(report, "postgres_safe_app", label)

    backends = report.get("backends")
    if not isinstance(backends, list):
        fail(f"{label}: backend reports are absent")
    backend_ids = [row.get("backend_id") for row in backends if isinstance(row, dict)]
    if backend_ids != ["postgres_safe_app", "riffdb_public_grpc"]:
        fail(f"{label}: backend set drifted")
    encoded_sizes: dict[str, dict[str, int]] = {}
    timed_rows: dict[str, dict[str, Any]] = {}
    for backend in backends:
        rows = backend.get("scenarios") if isinstance(backend, dict) else None
        if not isinstance(rows, list) or len(rows) != 1 or rows[0].get("scenario") != scenario:
            fail(f"{label}: report contains another timed scenario")
        verify_timing(rows[0], f"{label}.{backend.get('backend_id')}.{scenario}")
        timed_rows["postgres" if backend["backend_id"] == "postgres_safe_app" else "riffdb"] = rows[0]
        encoded = rows[0].get("encoded_size") or {}
        if encoded.get("schema") != "riffdb.app-baseline-canonical-semantic-frame/v1":
            fail(f"{label}: encoded-size schema is absent or drifted")
        if encoded.get("transport_framing_included") is not False:
            fail(f"{label}: encoded-size transport framing declaration drifted")
        request_bytes = encoded.get("request_bytes")
        response_bytes = encoded.get("response_bytes")
        if (
            not isinstance(request_bytes, int)
            or isinstance(request_bytes, bool)
            or request_bytes <= 0
            or not isinstance(response_bytes, int)
            or isinstance(response_bytes, bool)
            or response_bytes <= 0
        ):
            fail(f"{label}: encoded request/response sizes are not positive integers")
        encoded_sizes[backend["backend_id"]] = {
            "request_bytes": request_bytes,
            "response_bytes": response_bytes,
        }
    if len({tuple(sorted(value.items())) for value in encoded_sizes.values()}) != 1:
        fail(f"{label}: backends did not execute one encoded semantic payload shape")

    comparisons = report.get("comparisons") or {}
    if comparisons.get("available") is not True:
        fail(f"{label}: comparison is absent")
    rows = comparisons.get("scenarios")
    if (
        not isinstance(rows, list)
        or len(rows) != 1
        or rows[0].get("scenario") != scenario
        or rows[0].get("last_row_count_equal") is not True
    ):
        fail(f"{label}: correctness or scenario identity differs")
    verify_correctness(rows[0], timed_rows, f"{label}.{scenario}")
    summaries = comparisons.get("unary_rep_summaries")
    if not isinstance(summaries, dict) or set(summaries) != {scenario}:
        fail(f"{label}: unary generation summaries are not exact")
    entry = summaries[scenario]
    if not isinstance(entry, dict) or set(entry) != {
        "postgres",
        "riffdb",
        "ratios_riffdb_over_postgres",
    }:
        fail(f"{label}: unary summary shape drifted")

    result: dict[str, Any] = {
        "class": scenario_class(scenario),
        "postgres": {},
        "riffdb": {},
        "ratios_riffdb_over_postgres": {},
        "encoded_size": next(iter(encoded_sizes.values())),
    }
    # ADR-0171: the central-three spread rule binds the gated backend. RiffDB's
    # values gate the release, so an unstable RiffDB spread is invalid evidence.
    # PostgreSQL must still run in every generation and its spread is still
    # computed and retained, but it is published as disclosure rather than
    # invalidating a receipt -- the comparator's measurement stability is not a
    # property RiffDB can influence, and its ratios are not a gate.
    comparator_spreads: dict[str, float] = {}
    riffdb_spreads: dict[str, float] = {}
    for backend in ("postgres", "riffdb"):
        gated = require_stable and backend == "riffdb"
        for statistic in ("p50_ns", "p95_ns"):
            summary = (entry.get(backend) or {}).get(statistic)
            result[backend][statistic] = summary_value(
                summary,
                f"{label}.{backend}.{statistic}",
                require_stable=gated,
            )
            if backend == "postgres":
                comparator_spreads[statistic] = summary_spread(
                    summary, f"{label}.{backend}.{statistic}"
                )
            else:
                riffdb_spreads[statistic] = summary_spread(
                    summary, f"{label}.{backend}.{statistic}"
                )
        verify_selected_p50(
            timed_rows[backend],
            (entry.get(backend) or {}).get("p50_ns"),
            f"{label}.{backend}.p50_ns",
        )
    result["postgres_central_three_spread"] = comparator_spreads
    # Disclosure marker, so a reader weighing a published ratio can see that the
    # comparator it was computed against was unstable, without opening a
    # separate document.
    result["postgres_stability_disclosure"] = sorted(
        statistic
        for statistic, spread in comparator_spreads.items()
        if spread > MAX_SPREAD
    )
    for statistic in ("p50", "p95"):
        calculated = result["riffdb"][f"{statistic}_ns"] / result["postgres"][f"{statistic}_ns"]
        ratio_summary = (entry.get("ratios_riffdb_over_postgres") or {}).get(statistic)
        summary_value(ratio_summary, f"{label}.ratio.{statistic}", require_stable=False)
        reported = require_number(
            ratio_summary.get("qualified_ratio_of_backend_medians")
            if isinstance(ratio_summary, dict) else None,
            f"{label}.ratio.{statistic}.qualified_ratio_of_backend_medians",
        )
        if not math.isclose(calculated, reported, rel_tol=1e-9, abs_tol=1e-9):
            fail(f"{label}: {statistic} ratio is not derived from backend medians")
        result["ratios_riffdb_over_postgres"][statistic] = reported
    result["profile"] = profile_id
    result["host_observation_sha256"] = host_digest
    result["hardware_identity_sha256"] = hardware_digest
    verify_evidence_eligibility(
        report,
        [f"{scenario}.{statistic}" for statistic in result["postgres_stability_disclosure"]],
        all(spread <= MAX_SPREAD for spread in riffdb_spreads.values()),
        label,
        host_invalid=host_invalid,
    )
    return result, binaries


def verify_minimal_report(
    report: dict[str, Any],
    manifest: dict[str, Any],
    profile_id: str,
    label: str,
    *,
    host_invalid: bool = False,
    require_stable: bool = True,
) -> tuple[dict[str, Any], dict[str, str], str, str]:
    if report.get("schema") != REPORT_SCHEMA:
        fail(f"{label}: minimal report schema or repetition count drifted")
    require_exact_integer(report.get("reps"), REPETITIONS, f"{label}.reps")
    verify_frozen_workload(report, label)
    configuration = report.get("configuration") or {}
    require_exact_integer(
        configuration.get("warmup_iterations"), WARMUPS, f"{label}.warmups"
    )
    require_exact_integer(
        configuration.get("measured_samples"), MEASUREMENTS, f"{label}.measurements"
    )
    if report.get("same_device") is not True:
        fail(f"{label}: minimal backends are not on one device")
    if "unary_qualification" in report:
        fail(f"{label}: minimal report contains a unary selection")
    verify_postgres_durability(report, label)
    if not report.get("environment") or not report.get("device_baseline"):
        fail(f"{label}: minimal environment or device observation is absent")
    verify_storage_topology(report, label)
    verify_process_evidence(report, label, scenario_class_name=None)
    if host_invalid:
        if "qualification_candidate" in report:
            fail(f"{label}: host-invalid minimal report claims a qualified candidate")
        host_digest = ""
        hardware_digest = ""
        binaries = {}
    else:
        host_digest, hardware_digest = verify_host(report, profile_id, label)
        binaries = verify_candidate(report, manifest, label)
    verify_counterbalance(report, "postgres_minimal", label)
    backends = report.get("backends")
    if not isinstance(backends, list) or [
        row.get("backend_id") for row in backends if isinstance(row, dict)
    ] != ["postgres_minimal", "riffdb_public_grpc"]:
        fail(f"{label}: minimal backend set drifted")
    encoded_by_backend: dict[str, dict[str, tuple[int, int]]] = {}
    timed_rows_by_backend: dict[str, dict[str, dict[str, Any]]] = {}
    for backend in backends:
        encoded_by_backend[backend["backend_id"]] = {}
        timed_rows_by_backend[backend["backend_id"]] = {}
        scenario_rows = backend.get("scenarios") if isinstance(backend, dict) else None
        expected_scenarios = (
            SCENARIO_ORDER
            if backend.get("backend_id") == "postgres_minimal"
            else RIFFDB_MINIMAL_SCENARIO_ORDER
        )
        if (
            not isinstance(scenario_rows, list)
            or len(scenario_rows) != len(expected_scenarios)
            or [
                row.get("scenario") for row in scenario_rows if isinstance(row, dict)
            ]
            != list(expected_scenarios)
        ):
            fail(f"{label}: minimal backend scenario inventory or order drifted")
        for row in scenario_rows:
            scenario = row.get("scenario")
            verify_timing(row, f"{label}.{backend.get('backend_id')}.{scenario}")
            timed_rows_by_backend[backend["backend_id"]][scenario] = row
            encoded = row.get("encoded_size") or {}
            request_bytes = encoded.get("request_bytes")
            response_bytes = encoded.get("response_bytes")
            if (
                encoded.get("schema") != "riffdb.app-baseline-canonical-semantic-frame/v1"
                or encoded.get("transport_framing_included") is not False
                or not isinstance(request_bytes, int)
                or isinstance(request_bytes, bool)
                or request_bytes <= 0
                or not isinstance(response_bytes, int)
                or isinstance(response_bytes, bool)
                or response_bytes <= 0
            ):
                fail(f"{label}.{scenario}: minimal encoded-size disclosure is invalid")
            if scenario in SCENARIOS:
                encoded_by_backend[backend["backend_id"]][scenario] = (
                    request_bytes,
                    response_bytes,
                )
    if any(set(sizes) != SCENARIOS for sizes in encoded_by_backend.values()):
        fail(f"{label}: minimal encoded-size scenario set is incomplete")
    if len({tuple(sorted(sizes.items())) for sizes in encoded_by_backend.values()}) != 1:
        fail(f"{label}: minimal backends executed different semantic payload shapes")
    comparisons = report.get("comparisons") or {}
    rows = comparisons.get("scenarios")
    if not isinstance(rows, list):
        fail(f"{label}: minimal scenarios are absent")
    rows_by_scenario = {
        row.get("scenario"): row for row in rows if isinstance(row, dict)
    }
    if set(rows_by_scenario) != SCENARIOS or len(rows) != len(SCENARIOS):
        fail(f"{label}: minimal unary scenario set is not exact")
    if any(
        rows_by_scenario[scenario].get("last_row_count_equal") is not True
        for scenario in SCENARIOS
    ):
        fail(f"{label}: minimal correctness differs")
    for scenario in SCENARIO_ORDER:
        verify_correctness(
            rows_by_scenario[scenario],
            {
                "postgres": timed_rows_by_backend["postgres_minimal"][scenario],
                "riffdb": timed_rows_by_backend["riffdb_public_grpc"][scenario],
            },
            f"{label}.{scenario}",
        )
    if report.get("board_page_live_crosscheck") != {
        "limit_mode": "static_compiled",
        "limits": [50, 200, 450],
        "order_sensitive": True,
        "status": "ok",
    }:
        fail(f"{label}: minimal board cross-check is absent")
    summaries = comparisons.get("unary_rep_summaries")
    if not isinstance(summaries, dict) or set(summaries) != SCENARIOS:
        fail(f"{label}: minimal unary disclosures are not exact")
    result: dict[str, Any] = {}
    all_postgres_disclosures: list[str] = []
    all_riffdb_disclosures: list[str] = []
    for scenario in sorted(SCENARIOS):
        entry = summaries[scenario]
        if not isinstance(entry, dict) or set(entry) != {
            "postgres",
            "riffdb",
            "ratios_riffdb_over_postgres",
        }:
            fail(f"{label}.{scenario}: minimal unary summary shape drifted")
        metrics = {"postgres": {}, "riffdb": {}, "ratios_riffdb_over_postgres": {}}
        comparator_spreads: dict[str, float] = {}
        riffdb_spreads: dict[str, float] = {}
        for backend in ("postgres", "riffdb"):
            for statistic in ("p50_ns", "p95_ns"):
                summary = (entry.get(backend) or {}).get(statistic)
                # ADR-0171 Amendment 2: the minimal cell binds five positive
                # generations for both backends; RiffDB's central-three rule is
                # proven by each scenario's dedicated cell and disclosed here.
                metrics[backend][statistic] = summary_value(
                    summary,
                    f"{label}.{scenario}.{backend}.{statistic}",
                    require_stable=False,
                )
                spread = summary_spread(
                    summary, f"{label}.{scenario}.{backend}.{statistic}"
                )
                if backend == "postgres":
                    comparator_spreads[statistic] = spread
                else:
                    riffdb_spreads[statistic] = spread
            verify_selected_p50(
                timed_rows_by_backend[
                    "postgres_minimal" if backend == "postgres" else "riffdb_public_grpc"
                ][scenario],
                (entry.get(backend) or {}).get("p50_ns"),
                f"{label}.{scenario}.{backend}.p50_ns",
            )
        metrics["postgres_central_three_spread"] = comparator_spreads
        metrics["postgres_stability_disclosure"] = sorted(
            statistic
            for statistic, spread in comparator_spreads.items()
            if spread > MAX_SPREAD
        )
        all_postgres_disclosures.extend(
            f"{scenario}.{statistic}"
            for statistic in metrics["postgres_stability_disclosure"]
        )
        metrics["riffdb_central_three_spread"] = riffdb_spreads
        metrics["riffdb_stability_disclosure"] = sorted(
            statistic for statistic, spread in riffdb_spreads.items() if spread > MAX_SPREAD
        )
        all_riffdb_disclosures.extend(
            f"{scenario}.{statistic}" for statistic in metrics["riffdb_stability_disclosure"]
        )
        for statistic in ("p50", "p95"):
            ratio_summary = (entry.get("ratios_riffdb_over_postgres") or {}).get(statistic)
            summary_value(
                ratio_summary,
                f"{label}.{scenario}.ratio.{statistic}",
                require_stable=False,
            )
            calculated = (
                metrics["riffdb"][f"{statistic}_ns"]
                / metrics["postgres"][f"{statistic}_ns"]
            )
            reported = require_number(
                ratio_summary.get("qualified_ratio_of_backend_medians")
                if isinstance(ratio_summary, dict) else None,
                f"{label}.{scenario}.ratio.{statistic}.qualified_ratio_of_backend_medians",
            )
            if not math.isclose(calculated, reported, rel_tol=1e-9, abs_tol=1e-9):
                fail(f"{label}.{scenario}: ratio is not derived from backend medians")
            metrics["ratios_riffdb_over_postgres"][statistic] = reported
        result[scenario] = metrics
    verify_evidence_eligibility(
        report,
        all_postgres_disclosures,
        True,
        label,
        host_invalid=host_invalid,
        riffdb_disclosures=all_riffdb_disclosures,
    )
    return result, binaries, host_digest, hardware_digest


def validate_terminal_host_invalid_report(
    path: Path,
    profile_id: str,
    comparator: str,
    scenario: str | None,
) -> None:
    is_postflight = validate_host_invalid_receipt(
        path, profile_id, comparator, scenario
    )
    if not is_postflight:
        return
    report, _ = load_json(path, MAX_REPORT_BYTES)
    if comparator == "safe-app":
        if scenario is None:
            fail("safe-app host-invalid report has no expected scenario")
        verify_report(
            report,
            {},
            profile_id,
            scenario,
            "host-invalid safe-app report",
            host_invalid=True,
            require_stable=False,
        )
    elif comparator == "minimal":
        if scenario is not None:
            fail("minimal host-invalid report unexpectedly has a scenario selector")
        verify_minimal_report(
            report,
            {},
            profile_id,
            "host-invalid minimal report",
            host_invalid=True,
            require_stable=False,
        )
    else:
        fail("host-invalid comparator is not frozen")


def validate_manifest(manifest: dict[str, Any]) -> None:
    required_keys = {
        "schema",
        "source_revision",
        "cargo_lock_sha256",
        "harness_sha256",
        "runner_sha256",
        "riffdbd_sha256",
        "governance_predecessor_sha256",
        "requirements",
        "profiles",
    }
    # ADR-0183 banks carry the ADR-0171 rule the campaigns ran under.
    optional_keys = {"stability_rule_binds"}
    if not required_keys <= set(manifest) <= required_keys | optional_keys or (
        manifest.get("schema") != MANIFEST_SCHEMA
    ):
        fail("manifest shape or schema is invalid")
    if "stability_rule_binds" in manifest and manifest["stability_rule_binds"] != "gated_backend":
        fail("manifest stability rule is not bound to the gated backend")
    revision = manifest.get("source_revision")
    if not isinstance(revision, str) or REVISION.fullmatch(revision) is None:
        fail("manifest source revision is invalid")
    require_sha(manifest.get("cargo_lock_sha256"), "manifest.cargo_lock_sha256")
    require_sha(manifest.get("harness_sha256"), "manifest.harness_sha256")
    require_sha(manifest.get("runner_sha256"), "manifest.runner_sha256")
    require_sha(manifest.get("riffdbd_sha256"), "manifest.riffdbd_sha256")
    predecessor = require_sha(
        manifest.get("governance_predecessor_sha256"),
        "manifest.governance_predecessor_sha256",
    )
    if hashlib.sha256(
        bounded_read(GOVERNANCE_PREDECESSOR, MAX_GOVERNANCE_BYTES, "governance predecessor")
    ).hexdigest() != predecessor:
        fail("governance predecessor receipt is absent, linked, or differs")
    exact_strings(manifest.get("requirements"), REQUIREMENTS, "manifest.requirements")
    profiles = manifest.get("profiles")
    # Both inventoried cloud profiles are mandatory (ADR-0142 gates them); the
    # workstation column is optional under an ADR-0183 bank.
    if not isinstance(profiles, list) or not profiles:
        fail("manifest must contain N1 and E2, and may contain the workstation")
    observed = [p.get("id") for p in profiles if isinstance(p, dict)]
    if len(observed) != len(set(observed)) or not set(observed) <= set(PROFILE_CLASSES):
        fail("manifest profile identities are not exact")
    if not {"n1", "e2"} <= set(observed):
        fail("manifest must contain N1 and E2, and may contain the workstation")


def validate_campaign_identity(
    manifest_path: Path,
    reference: Any,
    profile_id: str,
    manifest: dict[str, Any],
) -> None:
    if not isinstance(reference, dict) or set(reference) != {"path", "sha256"}:
        fail(f"{profile_id}: campaign identity reference is invalid")
    relative = reference.get("path")
    if not isinstance(relative, str):
        fail(f"{profile_id}: campaign identity path is invalid")
    campaign, digest = load_json(
        manifest_path.parent / relative, MAX_CAMPAIGN_BYTES
    )
    if digest != require_sha(reference.get("sha256"), f"{profile_id}.campaign"):
        fail(f"{profile_id}: campaign identity digest differs")
    validate_campaign_identity_value(
        campaign,
        profile_id,
        {
            key: manifest[key]
            for key in (
                "source_revision",
                "cargo_lock_sha256",
                "harness_sha256",
                "runner_sha256",
                "riffdbd_sha256",
            )
        },
    )


def load_reports(
    manifest_path: Path, manifest: dict[str, Any]
) -> dict[str, dict[str, tuple[dict[str, Any], str]]]:
    result: dict[str, dict[str, tuple[dict[str, Any], str]]] = {}
    for profile in manifest["profiles"]:
        if set(profile) != {
            "id",
            "hardware_class",
            "reports",
            "minimal_report",
            "host_attempts",
            "campaign_identity",
        }:
            fail("profile shape is invalid")
        profile_id = profile["id"]
        if profile.get("hardware_class") != PROFILE_CLASSES[profile_id]:
            fail(f"{profile_id}: hardware class drifted")
        validate_campaign_identity(
            manifest_path, profile.get("campaign_identity"), profile_id, manifest
        )
        reports = profile.get("reports")
        if not isinstance(reports, list) or len(reports) != len(SCENARIOS):
            fail(f"{profile_id}: report inventory is incomplete")
        names = [item.get("scenario") for item in reports if isinstance(item, dict)]
        if names != list(SCENARIO_ORDER):
            fail(f"{profile_id}: scenario inventory order drifted")
        result[profile_id] = {}
        for reference in reports:
            if set(reference) != {"scenario", "path", "sha256"}:
                fail(f"{profile_id}: report reference shape is invalid")
            relative = reference["path"]
            if not isinstance(relative, str):
                fail(f"{profile_id}: report path is invalid")
            path = manifest_path.parent / relative
            report, digest = load_json(path, MAX_REPORT_BYTES)
            if digest != require_sha(reference["sha256"], f"{profile_id}.{reference['scenario']}"):
                fail(f"{profile_id}.{reference['scenario']}: report digest differs")
            result[profile_id][reference["scenario"]] = (report, digest)
        reference = profile["minimal_report"]
        if not isinstance(reference, dict) or set(reference) != {"path", "sha256"}:
            fail(f"{profile_id}: minimal report reference is invalid")
        relative = reference.get("path")
        if not isinstance(relative, str):
            fail(f"{profile_id}: minimal report path is invalid")
        path = manifest_path.parent / relative
        report, digest = load_json(path, MAX_REPORT_BYTES)
        if digest != require_sha(reference["sha256"], f"{profile_id}.minimal"):
            fail(f"{profile_id}: minimal report digest differs")
        result[profile_id]["minimal"] = (report, digest)
        attempts = profile.get("host_attempts")
        if (
            not isinstance(attempts, list)
            or not 1 <= len(attempts) <= MAX_HOST_ATTEMPTS
        ):
            fail(f"{profile_id}: bounded host-attempt inventory is invalid")
        canonical_reports = {
            row["scenario"]: row["sha256"] for row in profile["reports"]
        }
        for index, attempt in enumerate(attempts, 1):
            if not isinstance(attempt, dict) or set(attempt) != {
                "attempt", "status", "reports", "minimal_report"
            }:
                fail(f"{profile_id}: host-attempt shape is invalid")
            if attempt.get("attempt") != index:
                fail(f"{profile_id}: host attempts are not contiguous")
            expected_status = "accepted" if index == len(attempts) else "host_invalid"
            if attempt.get("status") != expected_status:
                fail(f"{profile_id}: performance-selected host retry was retained")
            references = attempt.get("reports")
            if not isinstance(references, list):
                fail(f"{profile_id}: host-attempt reports are invalid")
            observed: dict[str, tuple[dict[str, Any], str, Path]] = {}
            observed_order: list[str] = []
            for reference in references:
                if not isinstance(reference, dict) or set(reference) != {
                    "scenario", "path", "sha256"
                }:
                    fail(f"{profile_id}: host-attempt report reference is invalid")
                scenario = reference.get("scenario")
                relative = reference.get("path")
                if scenario not in SCENARIOS or scenario in observed or not isinstance(relative, str):
                    fail(f"{profile_id}: host-attempt scenario inventory is invalid")
                attempt_path = manifest_path.parent / relative
                report, actual = load_json(attempt_path, MAX_REPORT_BYTES)
                if actual != require_sha(reference.get("sha256"), f"{profile_id}.host_attempt"):
                    fail(f"{profile_id}.{scenario}: host-attempt digest differs")
                observed[scenario] = (report, actual, attempt_path)
                observed_order.append(scenario)
            minimal_reference = attempt.get("minimal_report")
            minimal_observed: tuple[dict[str, Any], str, Path] | None = None
            if minimal_reference is not None:
                if not isinstance(minimal_reference, dict) or set(minimal_reference) != {
                    "path", "sha256"
                }:
                    fail(f"{profile_id}: host-attempt minimal reference is invalid")
                relative = minimal_reference.get("path")
                if not isinstance(relative, str):
                    fail(f"{profile_id}: host-attempt minimal path is invalid")
                minimal_path = manifest_path.parent / relative
                minimal_report, actual = load_json(minimal_path, MAX_REPORT_BYTES)
                if actual != require_sha(
                    minimal_reference.get("sha256"), f"{profile_id}.host_attempt.minimal"
                ):
                    fail(f"{profile_id}: host-attempt minimal digest differs")
                minimal_observed = (minimal_report, actual, minimal_path)
            if expected_status == "accepted":
                if set(observed) != SCENARIOS or minimal_observed is None:
                    fail(f"{profile_id}: accepted host attempt is incomplete")
                if {
                    scenario: digest for scenario, (_, digest, _) in observed.items()
                } != canonical_reports:
                    fail(f"{profile_id}: accepted host attempt is not canonical")
                if minimal_observed[1] != profile["minimal_report"]["sha256"]:
                    fail(f"{profile_id}: accepted minimal attempt is not canonical")
            else:
                canonical_order = list(SCENARIO_ORDER)
                if observed_order != canonical_order[: len(observed_order)]:
                    fail(f"{profile_id}: invalid attempt is not a scenario prefix")
                completed_scenarios = (
                    observed_order
                    if minimal_observed is not None
                    else observed_order[:-1]
                )
                for completed_scenario in completed_scenarios:
                    completed_report = observed[completed_scenario][0]
                    verify_report(
                        completed_report,
                        manifest,
                        profile_id,
                        completed_scenario,
                        f"{profile_id}.host_attempt.{completed_scenario}",
                    )
                if minimal_observed is not None:
                    if observed_order != canonical_order:
                        fail(f"{profile_id}: minimal ran before every safe-app scenario")
                    terminal_path = minimal_observed[2]
                    terminal_comparator = "minimal"
                    terminal_scenario = None
                elif observed_order:
                    terminal_scenario = observed_order[-1]
                    terminal_path = observed[terminal_scenario][2]
                    terminal_comparator = "safe-app"
                else:
                    fail(f"{profile_id}: invalid attempt has no terminal report")
                validate_terminal_host_invalid_report(
                    terminal_path,
                    profile_id,
                    terminal_comparator,
                    terminal_scenario,
                )
    return result


def verify_corpus(
    manifest_path: Path, manifest: dict[str, Any]
) -> dict[str, Any]:
    validate_manifest(manifest)
    reports = load_reports(manifest_path, manifest)
    profiles = []
    runner_digests: set[str] = set()
    daemon_digests: set[str] = set()
    present_profiles = {profile["id"] for profile in manifest["profiles"]}
    for profile_id in [pid for pid in PROFILE_CLASSES if pid in present_profiles]:
        manifest_profile = next(
            profile for profile in manifest["profiles"] if profile["id"] == profile_id
        )
        scenarios: dict[str, Any] = {}
        report_digests: dict[str, str] = {}
        host_digests: dict[str, str] = {}
        hardware_digests: set[str] = set()
        for scenario in SCENARIO_ORDER:
            report, digest = reports[profile_id][scenario]
            metrics, binaries = verify_report(
                report,
                manifest,
                profile_id,
                scenario,
                f"{profile_id}.{scenario}",
            )
            if profile_id in {"n1", "e2"}:
                ceilings = ABSOLUTE_CEILINGS_NS[metrics["class"]]
                for statistic, ceiling in ceilings.items():
                    if metrics["riffdb"][statistic] > ceiling:
                        miss = (
                            f"{profile_id}.{scenario}: {statistic} "
                            f"{metrics['riffdb'][statistic]:.0f} exceeds {ceiling:.0f}"
                        )
                        # An ADR-0183 bank records the low-water values as
                        # they were measured; an ADR-0142 absolute service
                        # level miss is disclosed in the baseline rather than
                        # refusing the bank, and the release gate keeps its
                        # own refusal.
                        if ABSOLUTE_CEILING_POLICY == "disclose":
                            ABSOLUTE_CEILING_MISSES.append(miss)
                            continue
                        fail(miss)
            host_digests[scenario] = metrics.pop("host_observation_sha256")
            hardware_digests.add(metrics.pop("hardware_identity_sha256"))
            runner_digests.add(binaries["runner_sha256"])
            daemon_digests.add(binaries["riffdbd_sha256"])
            scenarios[scenario] = metrics
            report_digests[scenario] = digest
        minimal_report, minimal_digest = reports[profile_id]["minimal"]
        minimal, minimal_binaries, minimal_host, minimal_hardware = verify_minimal_report(
            minimal_report,
            manifest,
            profile_id,
            f"{profile_id}.minimal",
        )
        runner_digests.add(minimal_binaries["runner_sha256"])
        daemon_digests.add(minimal_binaries["riffdbd_sha256"])
        host_digests["minimal"] = minimal_host
        hardware_digests.add(minimal_hardware)
        report_digests["minimal"] = minimal_digest
        if len(hardware_digests) != 1:
            fail(f"{profile_id}: hardware identity drifted between scenario cells")
        profiles.append(
            {
                "id": profile_id,
                "hardware_class": PROFILE_CLASSES[profile_id],
                "hardware_identity_sha256": next(iter(hardware_digests)),
                "host_inventory_sha256": host_digests,
                "report_sha256": report_digests,
                "host_attempts": [
                    {
                        "attempt": attempt["attempt"],
                        "status": attempt["status"],
                        "report_sha256": {
                            row["scenario"]: row["sha256"]
                            for row in attempt["reports"]
                        },
                        "minimal_report_sha256": (
                            None
                            if attempt["minimal_report"] is None
                            else attempt["minimal_report"]["sha256"]
                        ),
                    }
                    for attempt in manifest_profile["host_attempts"]
                ],
                "minimal_postgres": minimal,
                "scenarios": scenarios,
            }
        )
    if len(runner_digests) != 1 or len(daemon_digests) != 1:
        fail("profiles did not measure one exact runner and daemon artifact")
    return {
        "schema": BASELINE_SCHEMA,
        "source_revision": manifest["source_revision"],
        "cargo_lock_sha256": manifest["cargo_lock_sha256"],
        "harness_sha256": manifest["harness_sha256"],
        "governance_predecessor_sha256": manifest[
            "governance_predecessor_sha256"
        ],
        "runner_sha256": next(iter(runner_digests)),
        "riffdbd_sha256": next(iter(daemon_digests)),
        "requirements": sorted(REQUIREMENTS),
        "method": {
            "process_generations": REPETITIONS,
            "warmups_per_generation": WARMUPS,
            "measurements_per_generation": MEASUREMENTS,
            "maximum_spread_ratio": MAX_SPREAD,
            "maximum_riffdb_regression_ratio": MAX_REGRESSION,
            "maximum_whole_cell_steal_percent": 1.0,
            "host_validity_schema": "riffdb.app-baseline-host-validity/v2",
            "qualified_statistic": "median_of_five_with_central_three_stability",
            # ADR-0171. Named in the method block because it is part of what a
            # baseline receipt means, so a candidate measured under the old
            # both-backends rule fails the method-drift check rather than being
            # silently comparable.
            "stability_rule_binds": "gated_backend",
            "comparator_spread_treatment": "published_disclosure",
        },
        "scenario_classes": {
            class_name: {
                "scenarios": sorted(members),
                **ABSOLUTE_CEILINGS_NS[class_name],
            }
            for class_name, members in SCENARIO_CLASSES.items()
        },
        "profiles": profiles,
        **(
            {"absolute_ceiling_misses": sorted(ABSOLUTE_CEILING_MISSES)}
            if ABSOLUTE_CEILING_MISSES
            else {}
        ),
    }


def verify_against_baseline(candidate: dict[str, Any], baseline: dict[str, Any]) -> dict[str, Any]:
    if baseline.get("schema") != BASELINE_SCHEMA:
        fail("baseline schema is invalid")
    if candidate.get("method") != baseline.get("method"):
        fail("candidate measurement or host-validity method drifted")
    if candidate.get("governance_predecessor_sha256") != baseline.get(
        "governance_predecessor_sha256"
    ):
        fail("governance predecessor receipt drifted")
    if candidate.get("scenario_classes") != baseline.get("scenario_classes"):
        fail("scenario classes or absolute ceilings drifted")
    baseline_profiles = {profile["id"]: profile for profile in baseline.get("profiles") or []}
    candidate_profiles = {profile["id"]: profile for profile in candidate.get("profiles") or []}
    if (
        set(baseline_profiles) != set(candidate_profiles)
        or not {"n1", "e2"} <= set(baseline_profiles)
        or not set(baseline_profiles) <= set(PROFILE_CLASSES)
    ):
        fail("baseline or candidate profiles are incomplete")
    regressions = []
    for profile_id in [pid for pid in PROFILE_CLASSES if pid in baseline_profiles]:
        if candidate_profiles[profile_id].get(
            "hardware_identity_sha256"
        ) != baseline_profiles[profile_id].get("hardware_identity_sha256"):
            fail(f"{profile_id}: candidate hardware differs from frozen baseline")
        old = baseline_profiles[profile_id]["scenarios"]
        new = candidate_profiles[profile_id]["scenarios"]
        if set(old) != SCENARIOS or set(new) != SCENARIOS:
            fail(f"{profile_id}: baseline scenario registry drifted")
        for scenario in sorted(SCENARIOS):
            for statistic in ("p50_ns", "p95_ns"):
                prior = require_number(old[scenario]["riffdb"][statistic], "baseline metric")
                current = require_number(new[scenario]["riffdb"][statistic], "candidate metric")
                ratio = math.inf if prior == 0 else current / prior
                if ratio > MAX_REGRESSION:
                    fail(
                        f"{profile_id}.{scenario}.{statistic} regression "
                        f"{ratio:.4f} exceeds {MAX_REGRESSION:.2f}"
                    )
                regressions.append(
                    {
                        "profile": profile_id,
                        "scenario": scenario,
                        "statistic": statistic,
                        "candidate_over_baseline": ratio,
                    }
                )
    return {
        "schema": QUALIFICATION_SCHEMA,
        "qualified": True,
        "candidate_source_revision": candidate["source_revision"],
        "baseline_source_revision": baseline["source_revision"],
        "maximum_riffdb_regression_ratio": MAX_REGRESSION,
        "regressions": regressions,
        "candidate": candidate,
    }


def fake_summary(value: float, spread: float = 1.0) -> dict[str, Any]:
    return {
        "values": [value, value, value, value, value * spread],
        "median": value,
        "min": value,
        "max": value * spread,
        "reps": REPETITIONS,
        "spread_ratio": spread,
        "stability": "stable",
    }


def fake_ratio_summary(value: float) -> dict[str, Any]:
    summary = fake_summary(value)
    summary["qualified_ratio_of_backend_medians"] = value
    return summary


def fake_timing(value: int) -> dict[str, Any]:
    return {
        "samples_ns": [value for _ in range(MEASUREMENTS)],
        "sample_count": MEASUREMENTS,
        "min_ns": value,
        "max_ns": value,
        "mean_ns": value,
        "p50_ns": value,
        "p95_ns": value,
        "p99_ns": value,
    }


def fake_process_evidence(
    *, scenario_class_name: str | None, generation_index: int = 0
) -> dict[str, Any]:
    if scenario_class_name == "compiled_command":
        read_counts = [0] * len(READ_PIPELINE_STAGES)
        write_counts = [MEASUREMENTS] * len(WRITE_SERVICE_STAGES)
        command_counts = [MEASUREMENTS] * len(COMMAND_PIPELINE_STAGES)
        physical_commits = logical_commands = MEASUREMENTS
    elif scenario_class_name is not None:
        read_counts = [MEASUREMENTS + WARMUPS] * len(READ_PIPELINE_STAGES)
        write_counts = [0] * len(WRITE_SERVICE_STAGES)
        command_counts = [0] * len(COMMAND_PIPELINE_STAGES)
        physical_commits = logical_commands = 0
    else:
        # Generation zero also serves the three board-page crosscheck reads.
        read_counts = [10_206 if generation_index == 0 else 10_203] * len(READ_PIPELINE_STAGES)
        write_counts = [4_000, 23_220, 23_220, 23_220, 4_000]
        physical_commits = 4_321
        command_counts = [physical_commits] * len(COMMAND_PIPELINE_STAGES)
        logical_commands = 23_220
    return {
        "graph_shutdown_elapsed_us": 1,
        "harness_shutdown_elapsed_us": 1,
        "shutdown_stages_us": [1] * 8,
        "authoritative_table_inventory": [{"table": "meta", "rows_after": 1}],
        "table_inventory_scope": (
            "after_seed_before_measured_process_to_after_clean_shutdown_and_structural_reopen"
            if scenario_class_name is not None
            else "post_shutdown_structural_reopen_inventory_only"
        ),
        "post_shutdown_structural_reopen": True,
        "read_pipeline_stages": [
            {"stage": stage, "count": count}
            for stage, count in zip(READ_PIPELINE_STAGES, read_counts)
        ],
        "write_service_stages": [
            {"stage": stage, "count": count}
            for stage, count in zip(WRITE_SERVICE_STAGES, write_counts)
        ],
        "command_pipeline_stages": [
            {"stage": stage, "count": count}
            for stage, count in zip(COMMAND_PIPELINE_STAGES, command_counts)
        ],
        "writer": {
            "physical_commits": physical_commits,
            "logical_commands_committed": logical_commands,
            "frontier_equivalence_failures": 0,
            "prepared_epoch_proof_mismatches": 0,
        },
        "writer_frame_census": {"frames": 1},
        "writer_flush_census": {"physical_flushes": 1},
        "writer_journal_stages": {"physical_flushes": 1},
        "writer_publication_stages": {"publications": 1},
        "completion_lane": {"max_depth": 1},
        "labels": "closed_fixed_cardinality",
    }


def fake_report(manifest: dict[str, Any], profile: str, scenario: str) -> dict[str, Any]:
    host = {
        "schema": "riffdb.app-baseline-host-validity/v2",
        "valid": True,
        "reason": None,
        "sample_interval_ms": 3_000,
        "load_average_before": [0.0, 0.0, 0.0],
        "load_average_after": [0.0, 0.0, 0.0],
        "memory_available_bytes": 1_073_741_824,
        "active_processes": [],
        "interfering_processes": [],
        "inventory_bounds": {
            "maximum_scanned_processes": 4096,
            "maximum_reported_processes": 32,
            "process_arguments_included": False,
        },
        "process_interval": {
            "stable_identity_required": True,
            "kernel_thread_events_excluded": 0,
            "started_processes": 0,
            "exited_processes": 0,
            "pid_reuses": 0,
        },
        "thresholds": {
            "cpu_percent_of_one_logical_cpu": 5.0,
            "io_bytes_per_sec": 8 * 1024 * 1024,
            "maximum_whole_cell_steal_percent": 1.0,
        },
        "logical_cpus": PROFILE_HARDWARE_RULES[profile]["logical_cpus"],
        "hardware_identity": {
            "cpu_model": PROFILE_HARDWARE_RULES[profile]["cpu_contains"],
            "system_product": "Google Compute Engine" if profile != "workstation" else "test",
            "system_vendor": "Google" if profile != "workstation" else "test",
            "operating_system": {"id": "test", "version_id": "1"},
        },
        "boot_identity_sha256": "6" * 64,
        "cpu_accounting": {"total_ticks": 10_000, "steal_ticks": 0},
        "whole_cell": None,
        "baseline_report_sha256": None,
    }
    postflight = copy.deepcopy(host)
    postflight["cpu_accounting"] = {"total_ticks": 20_000, "steal_ticks": 50}
    postflight["whole_cell"] = {
        "valid": True,
        "reason": None,
        "elapsed_total_ticks": 10_000,
        "elapsed_steal_ticks": 50,
        "steal_percent": 0.5,
        "maximum_steal_percent": 1.0,
    }
    postflight["baseline_report_sha256"] = hashlib.sha256(
        (json.dumps(host, sort_keys=True) + "\n").encode()
    ).hexdigest()
    class_name = scenario_class(scenario)
    pg = 1_000_000.0
    rd = min(2_000_000.0, ABSOLUTE_CEILINGS_NS[class_name]["p50_ns"])
    return {
        "schema": REPORT_SCHEMA,
        "report_id": "ticketdesk-app-baseline",
        "domain": "TicketDesk",
        "tables": copy.deepcopy(FROZEN_TABLES),
        "reps": REPETITIONS,
        "scale": copy.deepcopy(FROZEN_FULL_SCALE),
        "scale_shape": copy.deepcopy(FROZEN_FULL_SCALE_SHAPE),
        "configuration": {
            "warmup_iterations": WARMUPS,
            "measured_samples": MEASUREMENTS,
            **copy.deepcopy(FROZEN_CONFIGURATION_PINS),
        },
        "unary_qualification": {
            "schema": SELECTION_SCHEMA,
            "scenario": scenario,
            "class": class_name,
            "daemon_restart_after_common_setup": True,
            "same_scenario_warmups_after_restart": WARMUPS,
            "measured_operations_per_generation": MEASUREMENTS,
            "process_generations": REPETITIONS,
        },
        "same_device": True,
        "postgres_durability": {
            "data_directory": "/var/lib/postgresql/18/docker",
            "synchronous_commit": "on",
            "fsync": "on",
            "full_page_writes": "on",
            "server_version_num": "180004",
            "wal_sync_method": "fdatasync",
        },
        "environment": {
            "profile": profile,
            "medium": {"kind": "disk", "fstype": "ext4", "device_model": "test"},
        },
        "riffdb_storage_medium": {
            "kind": "disk",
            "fstype": "ext4",
            "device_model": "test",
        },
        "postgres_storage_medium": {
            "kind": "disk",
            "fstype": "ext4",
            "device_model": "test",
        },
        "device_baseline": {"fdatasync_p50_us": 100},
        "evidence_eligibility": {
            "eligible": True,
            "host_idle": True,
            "reason_codes": [],
            "postgres_central_three_spread_disclosed": [],
            "stable": True,
            "correctness_clean": True,
            "same_device_comparable": True,
            "comparison_complete": True,
            "missing_required_fields": [],
            "non_evidentiary_window": False,
        },
        "riffdb_process_evidence": [
            fake_process_evidence(scenario_class_name=class_name)
            for _ in range(REPETITIONS)
        ],
        "host_validity": {"preflight": host, "postflight": postflight},
        "qualification_candidate": {
            "schema": CANDIDATE_SCHEMA,
            "source_revision": manifest["source_revision"],
            "source_tree_clean": True,
            "cargo_lock_sha256": manifest["cargo_lock_sha256"],
            "harness_sha256": manifest["harness_sha256"],
            "runner_sha256": "4" * 64,
            "riffdbd_sha256": "5" * 64,
            "method": {"stability_rule_binds": "gated_backend"},
        },
        "backend_execution_order": [
            "postgres_safe_app",
            "riffdb_public_grpc",
            "riffdb_public_grpc",
            "postgres_safe_app",
            "postgres_safe_app",
            "riffdb_public_grpc",
            "riffdb_public_grpc",
            "postgres_safe_app",
            "postgres_safe_app",
            "riffdb_public_grpc",
        ],
        "backends": [
            {
                "backend_id": "postgres_safe_app",
                "scenarios": [{
                    "scenario": scenario,
                    "last_row_count": 1,
                    "timing": fake_timing(int(pg)),
                    "encoded_size": {
                        "schema": "riffdb.app-baseline-canonical-semantic-frame/v1",
                        "request_bytes": 64,
                        "response_bytes": 128,
                        "transport_framing_included": False,
                    },
                }],
            },
            {
                "backend_id": "riffdb_public_grpc",
                "scenarios": [{
                    "scenario": scenario,
                    "last_row_count": 1,
                    "timing": fake_timing(int(rd)),
                    "encoded_size": {
                        "schema": "riffdb.app-baseline-canonical-semantic-frame/v1",
                        "request_bytes": 64,
                        "response_bytes": 128,
                        "transport_framing_included": False,
                    },
                }],
            },
        ],
        "comparisons": {
            "available": True,
            "scenarios": [{
                "scenario": scenario,
                "last_row_count_equal": True,
                "postgres_last_row_count": 1,
                "riffdb_last_row_count": 1,
            }],
            "unary_rep_summaries": {
                scenario: {
                    "postgres": {
                        "p50_ns": fake_summary(pg),
                        "p95_ns": fake_summary(pg * 2),
                    },
                    "riffdb": {
                        "p50_ns": fake_summary(rd),
                        "p95_ns": fake_summary(rd * 2),
                    },
                    "ratios_riffdb_over_postgres": {
                        "p50": fake_ratio_summary(rd / pg),
                        "p95": fake_ratio_summary(rd / pg),
                    },
                }
            },
        },
    }


def fake_minimal_report(manifest: dict[str, Any], profile: str) -> dict[str, Any]:
    first = SCENARIO_ORDER[0]
    report = fake_report(manifest, profile, first)
    report.pop("unary_qualification")
    report["riffdb_process_evidence"] = [
        fake_process_evidence(scenario_class_name=None, generation_index=index)
        for index in range(REPETITIONS)
    ]
    report["backend_execution_order"] = [
        "postgres_minimal",
        "riffdb_public_grpc",
        "riffdb_public_grpc",
        "postgres_minimal",
        "postgres_minimal",
        "riffdb_public_grpc",
        "riffdb_public_grpc",
        "postgres_minimal",
        "postgres_minimal",
        "riffdb_public_grpc",
    ]
    rows = [
        {
            "scenario": scenario,
            "last_row_count_equal": True,
            "postgres_last_row_count": 1,
            "riffdb_last_row_count": 1,
        }
        for scenario in SCENARIO_ORDER
    ]
    summaries = {}
    for scenario in SCENARIO_ORDER:
        one = fake_report(manifest, profile, scenario)
        summaries[scenario] = one["comparisons"]["unary_rep_summaries"][scenario]
    report["backends"] = [
        {
            "backend_id": "postgres_minimal",
            "scenarios": [
                {
                    "scenario": scenario,
                    "last_row_count": 1,
                    "timing": fake_timing(1_000_000),
                    "encoded_size": {
                        "schema": "riffdb.app-baseline-canonical-semantic-frame/v1",
                        "request_bytes": 64,
                        "response_bytes": 128,
                        "transport_framing_included": False,
                    },
                }
                for scenario in SCENARIO_ORDER
            ],
        },
        {
            "backend_id": "riffdb_public_grpc",
            "scenarios": [
                {
                    "scenario": scenario,
                    "last_row_count": 1,
                    "timing": fake_timing(
                        int(min(2_000_000.0, ABSOLUTE_CEILINGS_NS[scenario_class(scenario)]["p50_ns"]))
                        if scenario in SCENARIOS
                        else 100
                    ),
                    "encoded_size": {
                        "schema": "riffdb.app-baseline-canonical-semantic-frame/v1",
                        "request_bytes": 64,
                        "response_bytes": 128,
                        "transport_framing_included": False,
                    },
                }
                for scenario in RIFFDB_MINIMAL_SCENARIO_ORDER
            ],
        },
    ]
    report["board_page_live_crosscheck"] = {
        "limit_mode": "static_compiled",
        "limits": [50, 200, 450],
        "order_sensitive": True,
        "status": "ok",
    }
    report["comparisons"] = {
        "available": True,
        "scenarios": rows,
        "unary_rep_summaries": summaries,
    }
    # ADR-0171 Amendment 2: the minimal cell publishes RiffDB's spreads as
    # disclosure; the harness emits the key for every minimal-cell report.
    report["evidence_eligibility"]["riffdb_central_three_spread_disclosed"] = []
    return report


def fake_host_invalid_postflight(report: dict[str, Any]) -> dict[str, Any]:
    report = copy.deepcopy(report)
    report.pop("qualification_candidate")
    preflight = report["host_validity"]["preflight"]
    postflight = report["host_validity"]["postflight"]
    before_total = preflight["cpu_accounting"]["total_ticks"]
    before_steal = preflight["cpu_accounting"]["steal_ticks"]
    after_total = postflight["cpu_accounting"]["total_ticks"]
    elapsed_total = after_total - before_total
    elapsed_steal = elapsed_total // 50
    postflight["cpu_accounting"]["steal_ticks"] = before_steal + elapsed_steal
    postflight["valid"] = False
    postflight["reason"] = "host_interference"
    postflight["whole_cell"] = {
        "valid": False,
        "reason": "cpu_steal_exceeded",
        "elapsed_total_ticks": elapsed_total,
        "elapsed_steal_ticks": elapsed_steal,
        "steal_percent": round(elapsed_steal / elapsed_total * 100.0, 6),
        "maximum_steal_percent": 1.0,
    }
    minimal_cell = "riffdb_central_three_spread_disclosed" in (
        report.get("evidence_eligibility") or {}
    )
    report["evidence_eligibility"] = {
        "eligible": False,
        "host_idle": False,
        "reason_codes": ["host_interference"],
        "postgres_central_three_spread_disclosed": [],
        "stable": True,
        "correctness_clean": True,
        "same_device_comparable": True,
        "comparison_complete": True,
        "missing_required_fields": [],
        "non_evidentiary_window": False,
    }
    if minimal_cell:
        report["evidence_eligibility"]["riffdb_central_three_spread_disclosed"] = []
    return report


# req: PERF-018
def run_self_test(root: Path) -> None:
    scratch = root / "self-test"
    scratch.mkdir(parents=True, exist_ok=True)
    manifest: dict[str, Any] = {
        "schema": MANIFEST_SCHEMA,
        "source_revision": "1" * 40,
        "cargo_lock_sha256": "2" * 64,
        "harness_sha256": "3" * 64,
        "runner_sha256": "4" * 64,
        "riffdbd_sha256": "5" * 64,
        "governance_predecessor_sha256": hashlib.sha256(
            bounded_read(GOVERNANCE_PREDECESSOR, MAX_GOVERNANCE_BYTES, "governance predecessor")
        ).hexdigest(),
        "requirements": sorted(REQUIREMENTS),
        "profiles": [],
    }
    for profile_id, hardware_class in PROFILE_CLASSES.items():
        references = []
        for scenario in SCENARIO_ORDER:
            path = scratch / f"{profile_id}-{scenario}.json"
            encoded = json.dumps(fake_report(manifest, profile_id, scenario), indent=2) + "\n"
            path.write_text(encoded, encoding="utf-8")
            references.append(
                {
                    "scenario": scenario,
                    "path": path.name,
                    "sha256": hashlib.sha256(encoded.encode()).hexdigest(),
                }
            )
        minimal_path = scratch / f"{profile_id}-minimal.json"
        minimal_encoded = json.dumps(fake_minimal_report(manifest, profile_id), indent=2) + "\n"
        minimal_path.write_text(minimal_encoded, encoding="utf-8")
        campaign_path = scratch / f"{profile_id}-campaign-identity.json"
        campaign_encoded = json.dumps(
            {
                "schema": CAMPAIGN_SCHEMA,
                "profile": profile_id,
                "source_revision": manifest["source_revision"],
                "cargo_lock_sha256": manifest["cargo_lock_sha256"],
                "harness_sha256": manifest["harness_sha256"],
                "runner_sha256": manifest["runner_sha256"],
                "riffdbd_sha256": manifest["riffdbd_sha256"],
                "method": {
                    "samples": MEASUREMENTS,
                    "warmups": WARMUPS,
                    "reps": REPETITIONS,
                    "comparators": ["safe-app", "minimal"],
                    "scenarios": list(SCENARIO_ORDER),
                    "stability_rule_binds": "gated_backend",
                },
            },
            indent=2,
        ) + "\n"
        campaign_path.write_text(campaign_encoded, encoding="utf-8")
        manifest["profiles"].append(
            {
                "id": profile_id,
                "hardware_class": hardware_class,
                "reports": references,
                "minimal_report": {
                    "path": minimal_path.name,
                    "sha256": hashlib.sha256(minimal_encoded.encode()).hexdigest(),
                },
                "host_attempts": [
                    {
                        "attempt": 1,
                        "status": "accepted",
                        "reports": copy.deepcopy(references),
                        "minimal_report": {
                            "path": minimal_path.name,
                            "sha256": hashlib.sha256(minimal_encoded.encode()).hexdigest(),
                        },
                    }
                ],
                "campaign_identity": {
                    "path": campaign_path.name,
                    "sha256": hashlib.sha256(campaign_encoded.encode()).hexdigest(),
                },
            }
        )
    manifest_path = scratch / "manifest.json"
    manifest_path.write_text(json.dumps(manifest), encoding="utf-8")
    baseline = verify_corpus(manifest_path, manifest)
    if baseline.get("method", {}).get("stability_rule_binds") != "gated_backend":
        fail("the V2 baseline did not emit ADR-0183's exact stability-rule identity")
    verify_against_baseline(baseline, baseline)

    legacy_literal = copy.deepcopy(baseline)
    legacy_literal["method"]["stability_rule_binds"] = "gated_backend_only"
    try:
        verify_against_baseline(legacy_literal, baseline)
    except ValueError:
        pass
    else:
        fail("the superseded V2 stability-rule literal passed as current evidence")

    campaign_type_drift = copy.deepcopy(manifest)
    campaign_value, _ = load_json(
        scratch / "workstation-campaign-identity.json", MAX_CAMPAIGN_BYTES
    )
    campaign_value["method"]["reps"] = 5.0
    campaign_drift_path = scratch / "workstation-campaign-type-drift.json"
    campaign_drift_encoded = json.dumps(campaign_value, indent=2) + "\n"
    campaign_drift_path.write_text(campaign_drift_encoded, encoding="utf-8")
    campaign_type_drift["profiles"][0]["campaign_identity"] = {
        "path": campaign_drift_path.name,
        "sha256": hashlib.sha256(campaign_drift_encoded.encode()).hexdigest(),
    }
    try:
        verify_corpus(manifest_path, campaign_type_drift)
    except ValueError:
        pass
    else:
        fail("a type-drifted campaign identity passed")

    safe_invalid_path = scratch / "host-invalid-safe-app.json"
    safe_invalid_path.write_text(
        json.dumps(
            fake_host_invalid_postflight(
                fake_report(manifest, "n1", SCENARIO_ORDER[0])
            )
        )
        + "\n",
        encoding="utf-8",
    )
    validate_terminal_host_invalid_report(
        safe_invalid_path, "n1", "safe-app", SCENARIO_ORDER[0]
    )
    minimal_invalid_path = scratch / "host-invalid-minimal.json"
    minimal_invalid_path.write_text(
        json.dumps(fake_host_invalid_postflight(fake_minimal_report(manifest, "n1")))
        + "\n",
        encoding="utf-8",
    )
    validate_terminal_host_invalid_report(
        minimal_invalid_path, "n1", "minimal", None
    )

    replaced = copy.deepcopy(manifest)
    replaced_profile = replaced["profiles"][0]
    accepted_attempt = replaced_profile["host_attempts"][0]
    accepted_attempt["attempt"] = 2
    terminal_scenario = replaced_profile["reports"][0]["scenario"]
    rules = PROFILE_HARDWARE_RULES[replaced_profile["id"]]
    process = {
        "pid": 7,
        "comm": "fixture-load",
        "cpu_percent_of_one_logical_cpu": 6.0,
        "read_bytes_per_sec": 0,
        "write_bytes_per_sec": 0,
        "rss_bytes": 4096,
    }
    invalid_preflight = {
        "active_processes": [process],
        "baseline_report_sha256": None,
        "boot_identity_sha256": "a" * 64,
        "cpu_accounting": {"steal_ticks": 0, "total_ticks": 1000},
        "hardware_identity": {
            "cpu_model": rules["cpu_contains"],
            "operating_system": {"id": "fixture", "version_id": "1"},
            "system_product": "fixture",
            "system_vendor": "fixture",
        },
        "interfering_processes": [process],
        "inventory_bounds": {
            "maximum_scanned_processes": 4096,
            "maximum_reported_processes": 32,
            "process_arguments_included": False,
        },
        "process_interval": {
            "stable_identity_required": True,
            "kernel_thread_events_excluded": 0,
            "started_processes": 0,
            "exited_processes": 0,
            "pid_reuses": 0,
        },
        "load_average_after": [0.0, 0.0, 0.0],
        "load_average_before": [0.0, 0.0, 0.0],
        "logical_cpus": rules["logical_cpus"],
        "memory_available_bytes": 1_073_741_824,
        "reason": "host_interference",
        "sample_interval_ms": 3000,
        "schema": "riffdb.app-baseline-host-validity/v2",
        "thresholds": {
            "cpu_percent_of_one_logical_cpu": 5.0,
            "io_bytes_per_sec": 8 * 1024 * 1024,
            "maximum_whole_cell_steal_percent": 1.0,
        },
        "valid": False,
        "whole_cell": None,
    }
    invalid_receipt = {
        "schema": "riffdb.app-baseline-non-evidentiary/v1",
        "status": "non_evidentiary",
        "reason": {
            "code": "host_interference",
            "retry": "rerun_on_idle_host",
        },
        "requested": {
            "mode": "full",
            "profile": "parity",
            "duration_secs": 90,
            "reps": 5,
            "postgres_comparator": "safe-app",
            "concurrency_sweep": False,
            "scenario": terminal_scenario,
        },
        "partial_phase_evidence": None,
        "host_validity": {"preflight": invalid_preflight, "postflight": None},
        "evidence_eligibility": {
            "eligible": False,
            "host_idle": False,
            "reason_codes": ["host_interference"],
        },
    }
    invalid_path = scratch / "workstation-invalid-preflight.json"
    invalid_encoded = json.dumps(invalid_receipt, indent=2) + "\n"
    invalid_path.write_text(invalid_encoded, encoding="utf-8")
    replaced_profile["host_attempts"].insert(
        0,
        {
            "attempt": 1,
            "status": "host_invalid",
            "reports": [
                {
                    "scenario": terminal_scenario,
                    "path": invalid_path.name,
                    "sha256": hashlib.sha256(invalid_encoded.encode()).hexdigest(),
                }
            ],
            "minimal_report": None,
        },
    )
    verify_corpus(manifest_path, replaced)

    drifted_prefix = copy.deepcopy(replaced)
    drifted_prefix_profile = drifted_prefix["profiles"][0]
    first_scenario = SCENARIO_ORDER[0]
    second_scenario = SCENARIO_ORDER[1]
    prior_report = fake_report(manifest, "workstation", first_scenario)
    prior_report["qualification_candidate"]["runner_sha256"] = "9" * 64
    prior_path = scratch / "workstation-drifted-prior.json"
    prior_encoded = json.dumps(prior_report, indent=2) + "\n"
    prior_path.write_text(prior_encoded, encoding="utf-8")
    drifted_prefix_profile["host_attempts"][0]["reports"] = [
        {
            "scenario": first_scenario,
            "path": prior_path.name,
            "sha256": hashlib.sha256(prior_encoded.encode()).hexdigest(),
        },
        {
            "scenario": second_scenario,
            "path": invalid_path.name,
            "sha256": hashlib.sha256(invalid_encoded.encode()).hexdigest(),
        },
    ]
    try:
        verify_corpus(manifest_path, drifted_prefix)
    except ValueError:
        pass
    else:
        fail("a host-invalid attempt with prior artifact drift passed")

    permuted = copy.deepcopy(manifest)
    permuted["profiles"][0]["reports"][0], permuted["profiles"][0]["reports"][1] = (
        permuted["profiles"][0]["reports"][1],
        permuted["profiles"][0]["reports"][0],
    )
    try:
        verify_corpus(manifest_path, permuted)
    except ValueError:
        pass
    else:
        fail("permuted canonical scenario order passed")

    invalid = copy.deepcopy(manifest)
    invalid["profiles"][1]["reports"].pop()
    try:
        verify_corpus(manifest_path, invalid)
    except ValueError:
        pass
    else:
        fail("missing scenario passed")

    invalid_attempt = copy.deepcopy(manifest)
    invalid_attempt["profiles"][0]["host_attempts"][0]["status"] = "host_invalid"
    try:
        verify_corpus(manifest_path, invalid_attempt)
    except ValueError:
        pass
    else:
        fail("attempt inventory without one accepted terminal attempt passed")

    performance_selected = copy.deepcopy(manifest)
    accepted = performance_selected["profiles"][0]["host_attempts"][0]
    accepted["attempt"] = 2
    performance_selected["profiles"][0]["host_attempts"].insert(
        0,
        {
            "attempt": 1,
            "status": "host_invalid",
            "reports": [copy.deepcopy(performance_selected["profiles"][0]["reports"][0])],
            "minimal_report": None,
        },
    )
    try:
        verify_corpus(manifest_path, performance_selected)
    except ValueError:
        pass
    else:
        fail("performance-selected replacement passed as host-invalid")

    too_many_attempts = copy.deepcopy(manifest)
    attempt = too_many_attempts["profiles"][0]["host_attempts"][0]
    too_many_attempts["profiles"][0]["host_attempts"] = [
        {**copy.deepcopy(attempt), "attempt": number}
        for number in (1, 2, 3)
    ]
    try:
        verify_corpus(manifest_path, too_many_attempts)
    except ValueError:
        pass
    else:
        fail("a third host attempt passed")

    extreme_report = fake_report(manifest, "n1", sorted(SCENARIOS)[0])
    extreme = extreme_report["comparisons"]["unary_rep_summaries"][
        sorted(SCENARIOS)[0]
    ]["riffdb"]["p50_ns"]
    extreme.update({
        "values": [1_000_000.0, 2_000_000.0, 2_000_000.0, 2_000_000.0, 4_000_000.0],
        "min": 1_000_000.0,
        "median": 2_000_000.0,
        "max": 4_000_000.0,
        "spread_ratio": 4.0,
    })
    verify_report(extreme_report, manifest, "n1", sorted(SCENARIOS)[0], "extremes")

    report, _ = load_json(scratch / f"n1-{sorted(SCENARIOS)[0]}.json", MAX_REPORT_BYTES)
    entry = report["comparisons"]["unary_rep_summaries"][sorted(SCENARIOS)[0]]
    entry["riffdb"]["p50_ns"].update({
        "values": [1.0, 1.0, 1.21, 1.21, 1.21],
        "min": 1.0,
        "median": 1.21,
        "max": 1.21,
        "spread_ratio": 1.21,
    })
    try:
        verify_report(report, manifest, "n1", sorted(SCENARIOS)[0], "spread")
    except ValueError:
        pass
    else:
        fail("unstable unary summary passed")

    # ADR-0171, both directions. The rule binds the gated backend, so an
    # unstable comparator must pass WITH a disclosure while the identical
    # instability in RiffDB must fail. Asserting only the failing direction
    # would let a verifier that rejects everything look correct.
    unstable_comparator = fake_report(manifest, "n1", sorted(SCENARIOS)[0])
    comparator_entry = unstable_comparator["comparisons"]["unary_rep_summaries"][
        sorted(SCENARIOS)[0]
    ]["postgres"]["p95_ns"]
    comparator_entry.update({
        "values": [1.0, 1.0, 1.459, 1.459, 1.459],
        "min": 1.0,
        "median": 1.459,
        "max": 1.459,
        "spread_ratio": 1.459,
    })
    # The published ratio is derived from backend medians, so moving the
    # comparator's median moves it; keep the receipt self-consistent.
    ratio_entry = unstable_comparator["comparisons"]["unary_rep_summaries"][
        sorted(SCENARIOS)[0]
    ]["ratios_riffdb_over_postgres"]["p95"]
    riffdb_median = unstable_comparator["comparisons"]["unary_rep_summaries"][
        sorted(SCENARIOS)[0]
    ]["riffdb"]["p95_ns"]["median"]
    ratio_entry["qualified_ratio_of_backend_medians"] = riffdb_median / 1.459
    unstable_comparator["evidence_eligibility"][
        "postgres_central_three_spread_disclosed"
    ] = [f"{sorted(SCENARIOS)[0]}.p95_ns"]
    disclosed, _ = verify_report(
        unstable_comparator, manifest, "n1", sorted(SCENARIOS)[0], "comparator_spread"
    )
    if "p95_ns" not in disclosed.get("postgres_stability_disclosure", []):
        fail("an unstable comparator passed without a published disclosure")
    if not math.isclose(
        disclosed.get("postgres_central_three_spread", {}).get("p95_ns", 0.0),
        1.459,
        rel_tol=1e-9,
    ):
        fail("the comparator's spread was not retained beside its ratio")

    stable_comparator = fake_report(manifest, "n1", sorted(SCENARIOS)[0])
    quiet, _ = verify_report(
        stable_comparator, manifest, "n1", sorted(SCENARIOS)[0], "comparator_stable"
    )
    if quiet.get("postgres_stability_disclosure"):
        fail("a stable comparator was marked as disclosed")

    unstable_minimal_comparator = fake_minimal_report(manifest, "n1")
    minimal_scenario = sorted(SCENARIOS)[0]
    minimal_entry = unstable_minimal_comparator["comparisons"][
        "unary_rep_summaries"
    ][minimal_scenario]
    minimal_pg = minimal_entry["postgres"]["p95_ns"]
    minimal_pg.update({
        "values": [1.0, 1.0, 1.459, 1.459, 1.459],
        "min": 1.0,
        "median": 1.459,
        "max": 1.459,
        "spread_ratio": 1.459,
    })
    minimal_entry["ratios_riffdb_over_postgres"]["p95"][
        "qualified_ratio_of_backend_medians"
    ] = minimal_entry["riffdb"]["p95_ns"]["median"] / 1.459
    unstable_minimal_comparator["evidence_eligibility"][
        "postgres_central_three_spread_disclosed"
    ] = [f"{minimal_scenario}.p95_ns"]
    minimal_disclosed, _, _, _ = verify_minimal_report(
        unstable_minimal_comparator,
        manifest,
        "n1",
        "minimal_comparator_spread",
    )
    if "p95_ns" not in minimal_disclosed[minimal_scenario].get(
        "postgres_stability_disclosure", []
    ):
        fail("an unstable minimal comparator passed without disclosure")

    unstable_minimal_riffdb = fake_minimal_report(manifest, "n1")
    riffdb_entry = unstable_minimal_riffdb["comparisons"]["unary_rep_summaries"][
        minimal_scenario
    ]
    riffdb_p95 = riffdb_entry["riffdb"]["p95_ns"]
    riffdb_values = sorted(riffdb_p95["values"])
    riffdb_values[3] = riffdb_values[1] * 1.36
    riffdb_values[4] = max(riffdb_values[4], riffdb_values[3])
    riffdb_p95.update({
        "values": riffdb_values,
        "median": riffdb_values[2],
        "min": riffdb_values[0],
        "max": riffdb_values[4],
        "spread_ratio": riffdb_values[3] / riffdb_values[1],
    })
    unstable_minimal_riffdb["evidence_eligibility"][
        "riffdb_central_three_spread_disclosed"
    ] = [f"{minimal_scenario}.p95_ns"]
    riffdb_disclosed, _, _, _ = verify_minimal_report(
        unstable_minimal_riffdb,
        manifest,
        "n1",
        "minimal_riffdb_spread",
    )
    if "p95_ns" not in riffdb_disclosed[minimal_scenario].get(
        "riffdb_stability_disclosure", []
    ):
        fail("an unstable minimal-cell RiffDB spread passed without disclosure")
    selected_minimal = fake_minimal_report(manifest, "n1")
    selected_minimal["unary_qualification"] = fake_report(
        manifest, "n1", minimal_scenario
    )["unary_qualification"]
    try:
        verify_minimal_report(selected_minimal, manifest, "n1", "selected_minimal")
    except ValueError:
        pass
    else:
        fail("a minimal report with a unary selector passed")

    workload_drifts = [
        ("report identity", ("report_id",), "other-workload"),
        ("full cardinality", ("scale", "organizations"), 11),
        ("scale shape", ("scale_shape", "tickets_per_project"), 21),
        (
            "distribution method",
            ("configuration", "distribution_method"),
            "arithmetic mean",
        ),
        ("report repetition type", ("reps",), 5.0),
        ("warmup type", ("configuration", "warmup_iterations"), 20.0),
        (
            "selection generation type",
            ("unary_qualification", "process_generations"),
            5.0,
        ),
        (
            "summary repetition type",
            (
                "comparisons",
                "unary_rep_summaries",
                SCENARIO_ORDER[0],
                "riffdb",
                "p95_ns",
                "reps",
            ),
            5.0,
        ),
        (
            "timing percentile arithmetic",
            ("backends", 0, "scenarios", 0, "timing", "p95_ns"),
            101,
        ),
        (
            "storage device mismatch",
            ("postgres_storage_medium", "device_model"),
            "other-device",
        ),
        (
            "PostgreSQL major version drift",
            ("postgres_durability", "server_version_num"),
            "170006",
        ),
        (
            "PostgreSQL WAL sync method drift",
            ("postgres_durability", "wal_sync_method"),
            "open_datasync",
        ),
        (
            "backend row-count mismatch",
            ("backends", 0, "scenarios", 0, "last_row_count"),
            2,
        ),
        (
            "eligibility correctness drift",
            ("evidence_eligibility", "correctness_clean"),
            False,
        ),
        (
            "selected p50 summary mismatch",
            ("backends", 0, "scenarios", 0, "timing"),
            fake_timing(999),
        ),
        (
            "missing clean shutdown",
            ("riffdb_process_evidence", 0, "post_shutdown_structural_reopen"),
            False,
        ),
        (
            "read process cardinality drift",
            ("riffdb_process_evidence", 0, "read_pipeline_stages", 0, "count"),
            0,
        ),
        (
            "whole-cell counter mismatch",
            ("host_validity", "postflight", "cpu_accounting", "total_ticks"),
            20_001,
        ),
    ]
    for drift_label, path, replacement in workload_drifts:
        drifted = fake_report(manifest, "n1", SCENARIO_ORDER[0])
        target = drifted
        for key in path[:-1]:
            target = target[key]
        target[path[-1]] = replacement
        try:
            verify_report(drifted, manifest, "n1", SCENARIO_ORDER[0], drift_label)
        except ValueError:
            pass
        else:
            fail(f"{drift_label} passed the frozen workload verifier")

    extra_minimal_row = fake_minimal_report(manifest, "n1")
    extra_minimal_row["backends"][0]["scenarios"].append(
        copy.deepcopy(extra_minimal_row["backends"][0]["scenarios"][0])
    )
    try:
        verify_minimal_report(extra_minimal_row, manifest, "n1", "extra_minimal_row")
    except ValueError:
        pass
    else:
        fail("an extra minimal backend scenario row passed")

    drifted_minimal = fake_minimal_report(manifest, "n1")
    drifted_minimal["backends"][0]["scenarios"][0]["timing"]["sample_count"] = 1_000.0
    try:
        verify_minimal_report(drifted_minimal, manifest, "n1", "minimal_timing_type")
    except ValueError:
        pass
    else:
        fail("a type-drifted minimal timing cardinality passed")

    minimal_drifts = [
        (
            "minimal backend row-count mismatch",
            ("backends", 0, "scenarios", 0, "last_row_count"),
            2,
        ),
        (
            "minimal selected p50 mismatch",
            ("backends", 0, "scenarios", 0, "timing"),
            fake_timing(999),
        ),
        (
            "minimal clean-shutdown drift",
            ("riffdb_process_evidence", 0, "post_shutdown_structural_reopen"),
            False,
        ),
        (
            "minimal committed-operation drift",
            ("riffdb_process_evidence", 0, "writer", "logical_commands_committed"),
            23_219,
        ),
        (
            "minimal eligibility drift",
            ("evidence_eligibility", "comparison_complete"),
            False,
        ),
    ]
    for drift_label, path, replacement in minimal_drifts:
        drifted = fake_minimal_report(manifest, "n1")
        target = drifted
        for key in path[:-1]:
            target = target[key]
        target[path[-1]] = replacement
        try:
            verify_minimal_report(drifted, manifest, "n1", drift_label)
        except ValueError:
            pass
        else:
            fail(f"{drift_label} passed the frozen minimal verifier")

    # The same instability in the gated backend, in an otherwise self-consistent
    # receipt. The pre-existing "spread" arm above mutates only the summary and
    # so can also fail on the ratio-derivation check; this one keeps the whole
    # receipt coherent, so the ONLY thing left to reject it is the RiffDB
    # stability rule.
    unstable_riffdb = fake_report(manifest, "n1", sorted(SCENARIOS)[0])
    riffdb_entry = unstable_riffdb["comparisons"]["unary_rep_summaries"][
        sorted(SCENARIOS)[0]
    ]["riffdb"]["p95_ns"]
    riffdb_entry.update({
        "values": [1.0, 1.0, 1.459, 1.459, 1.459],
        "min": 1.0,
        "median": 1.459,
        "max": 1.459,
        "spread_ratio": 1.459,
    })
    postgres_median = unstable_riffdb["comparisons"]["unary_rep_summaries"][
        sorted(SCENARIOS)[0]
    ]["postgres"]["p95_ns"]["median"]
    unstable_riffdb["comparisons"]["unary_rep_summaries"][sorted(SCENARIOS)[0]][
        "ratios_riffdb_over_postgres"
    ]["p95"]["qualified_ratio_of_backend_medians"] = 1.459 / postgres_median
    try:
        verify_report(
            unstable_riffdb, manifest, "n1", sorted(SCENARIOS)[0], "riffdb_spread"
        )
    except ValueError:
        pass
    else:
        fail("an unstable gated backend passed")

    short_sample = fake_report(manifest, "n1", sorted(SCENARIOS)[0])
    short_sample["configuration"]["measured_samples"] = 100
    short_sample["unary_qualification"]["measured_operations_per_generation"] = 100
    try:
        verify_report(
            short_sample,
            manifest,
            "n1",
            sorted(SCENARIOS)[0],
            "short_sample",
        )
    except ValueError:
        pass
    else:
        fail("historical 100-operation qualification passed as V2")

    v1_host = fake_report(manifest, "n1", sorted(SCENARIOS)[0])
    v1_host["host_validity"]["preflight"]["schema"] = (
        "riffdb.app-baseline-host-validity/v1"
    )
    try:
        verify_report(v1_host, manifest, "n1", sorted(SCENARIOS)[0], "v1_host")
    except ValueError:
        pass
    else:
        fail("historical V1 host evidence passed as V2")

    stolen = fake_report(manifest, "n1", sorted(SCENARIOS)[0])
    stolen_whole = stolen["host_validity"]["postflight"]["whole_cell"]
    stolen_whole.update(
        elapsed_steal_ticks=101,
        steal_percent=1.01,
        valid=False,
        reason="cpu_steal_exceeded",
    )
    try:
        verify_report(stolen, manifest, "n1", sorted(SCENARIOS)[0], "stolen")
    except ValueError:
        pass
    else:
        fail("whole-cell CPU steal above 1 percent passed")

    slower = copy.deepcopy(baseline)
    slower["profiles"][0]["scenarios"][sorted(SCENARIOS)[0]]["riffdb"]["p50_ns"] *= 1.101
    try:
        verify_against_baseline(slower, baseline)
    except ValueError:
        pass
    else:
        fail("regressed candidate passed")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("--manifest", type=Path)
    parser.add_argument("--baseline", type=Path)
    parser.add_argument("--output", type=Path)
    parser.add_argument("--self-test", action="store_true")
    parser.add_argument("--validate-host-invalid-receipt", type=Path)
    parser.add_argument("--profile", choices=sorted(PROFILE_HARDWARE_RULES))
    parser.add_argument("--comparator", choices=("safe-app", "minimal"))
    parser.add_argument("--scenario", choices=sorted(SCENARIOS))
    parser.add_argument(
        "--absolute-ceilings",
        choices=("gate", "disclose"),
        default="gate",
        help="gate: an ADR-0142 absolute service-level miss refuses the corpus (default); "
        "disclose: the miss is recorded in the baseline as absolute_ceiling_misses "
        "(ADR-0183 bank)",
    )
    args = parser.parse_args()
    global ABSOLUTE_CEILING_POLICY
    ABSOLUTE_CEILING_POLICY = args.absolute_ceilings
    if args.self_test and any(
        (
            args.manifest,
            args.baseline,
            args.output,
            args.validate_host_invalid_receipt,
            args.profile,
            args.comparator,
            args.scenario,
        )
    ):
        parser.error("--self-test is exclusive")
    if args.validate_host_invalid_receipt is not None:
        if (
            any((args.manifest, args.baseline, args.output))
            or args.profile is None
            or args.comparator is None
            or (args.comparator == "safe-app") != (args.scenario is not None)
        ):
            parser.error(
                "--validate-host-invalid-receipt requires --profile, --comparator, "
                "and exactly one --scenario for safe-app"
            )
    elif any((args.profile, args.comparator, args.scenario)):
        parser.error(
            "--profile, --comparator, and --scenario are only valid with "
            "--validate-host-invalid-receipt"
        )
    elif not args.self_test and args.manifest is None:
        parser.error("--manifest is required")
    return args


def main() -> int:
    args = parse_args()
    if args.self_test:
        task_tmp = Path.home() / "tmp"
        task_tmp.mkdir(mode=0o700, parents=True, exist_ok=True)
        with tempfile.TemporaryDirectory(prefix="riffdb-wp674-verifier-", dir=task_tmp) as root:
            isolated = Path(root)
            bounded_io_self_test(isolated / "bounded-io")
            run_self_test(isolated / "verifier")
        print("WP-674 unary verifier self-test: passed")
        return 0
    if args.validate_host_invalid_receipt is not None:
        validate_terminal_host_invalid_report(
            args.validate_host_invalid_receipt,
            args.profile,
            args.comparator,
            args.scenario,
        )
        print("WP-674 host-invalid receipt: valid")
        return 0
    manifest_path = args.manifest
    manifest, _ = load_json(manifest_path, MAX_MANIFEST_BYTES)
    candidate = verify_corpus(manifest_path, manifest)
    output = candidate
    if args.baseline is not None:
        baseline, _ = load_json(args.baseline, MAX_BASELINE_BYTES)
        output = verify_against_baseline(candidate, baseline)
    for miss in ABSOLUTE_CEILING_MISSES:
        print(f"absolute service-level miss disclosed: {miss}", file=sys.stderr)
    encoded = json.dumps(output, indent=2, sort_keys=True) + "\n"
    if args.output is None:
        print(encoded, end="")
    else:
        exclusive_write(
            args.output,
            encoded.encode(),
            MAX_BASELINE_BYTES,
            "WP-674 verifier output",
        )
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, UnicodeError, json.JSONDecodeError, ValueError) as error:
        print(f"wp674_unary_baseline_invalid: {error}", file=sys.stderr)
        raise SystemExit(3) from error
