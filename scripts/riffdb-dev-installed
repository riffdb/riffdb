#!/usr/bin/env bash
set -euo pipefail
umask 077

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
installation_root="$(cd "$script_dir/.." && pwd)"
application_root=
role=application
watch=0
run=0
acceptance=0
seed_dir=
seed_builtin=0
seed_concurrency=8
while (($#)); do
    case "$1" in
        --role) role="${2:-}"; shift 2 ;;
        --application-root) application_root="${2:-}"; shift 2 ;;
        --watch) watch=1; shift ;;
        --run) run=1; shift ;;
        --acceptance) acceptance=1; shift ;;
        --seed-dir) seed_dir="${2:-}"; shift 2 ;;
        --seed) seed_builtin=1; shift ;;
        --seed-concurrency) seed_concurrency="${2:-}"; shift 2 ;;
        *)
            echo "usage: riffdb-dev [--application-root DIR] [--role application|ROLE] [--watch|--run] [--seed] [--seed-dir DIR] [--seed-concurrency 1..8] [--acceptance]" >&2
            exit 2
            ;;
    esac
done

if ((run && (watch || acceptance))); then
    echo "--run cannot be combined with --watch or --acceptance" >&2
    exit 2
fi

[[ -n "$application_root" ]] || {
    echo "installed riffdb dev requires an application root" >&2
    exit 2
}
application_root="$(cd "$application_root" && pwd)"
application_source="$application_root/riffdb.application.json"
[[ -f "$application_source" ]] || {
    echo "application root has no riffdb.application.json" >&2
    exit 2
}
[[ "$seed_concurrency" =~ ^[1-8]$ ]] || {
    echo "seed concurrency must be in 1..8" >&2
    exit 2
}
if [[ -n "$seed_dir" ]]; then
    [[ -d "$seed_dir" ]] || {
        echo "seed directory is unavailable" >&2
        exit 2
    }
    seed_dir="$(cd "$seed_dir" && pwd)"
fi

riffdb="$script_dir/riffdb"
riffdbd="$script_dir/riffdbd"
driverd="$script_dir/riffdb-driverd"
boundary_check="$installation_root/libexec/check-application-boundary"
bootstrap_request="$installation_root/share/riffdb/bootstrap-dev.json"
dev_tls_root="$installation_root/share/riffdb/dev-tls"
if [[ -d "$installation_root/public/rust-sdk/vendor/riffdb-client-rust-0.1.0" ]]; then
    default_rust_sdk="$installation_root/public/rust-sdk/vendor/riffdb-client-rust-0.1.0"
else
    default_rust_sdk="$installation_root/public/rust-sdk/crates/riffdb-client-rust"
fi
rust_sdk="${RIFFDB_RUST_SDK:-$default_rust_sdk}"
rust_cargo_config=(--config "$installation_root/.cargo/config.toml")
rust_source_sdk=false
if [[ "$rust_sdk" != "$installation_root/public/rust-sdk/vendor/"* ]]; then
    rust_source_sdk=true
    rust_cargo_config+=(
        --config "patch.crates-io.riffdb-client-rust.path=\"$rust_sdk\""
    )
fi
prepare_rust_dependency_lock() {
    # The predecessor source-SDK bundle embeds the public registry-shaped
    # scaffold lock, but executes against its bundled source SDK. Reconcile
    # that private dependency lock once, offline, before insisting on
    # `--locked`; package-first bundles retain their registry-shaped lock and
    # never enter this branch.
    if [[ "$rust_source_sdk" == true ]] && ! cargo metadata --quiet --offline \
        --locked --format-version 1 \
        "${rust_cargo_config[@]}" \
        --manifest-path "$application_root/Cargo.toml" >/dev/null 2>&1; then
        CARGO_NET_OFFLINE=true cargo generate-lockfile --quiet \
            "${rust_cargo_config[@]}" \
            --manifest-path "$application_root/Cargo.toml"
    fi
}
for executable in "$riffdb" "$riffdbd" "$boundary_check"; do
    [[ -x "$executable" ]] || {
        echo "installed development component is unavailable" >&2
        exit 1
    }
done
[[ -f "$bootstrap_request" ]] || {
    echo "installed development data is unavailable" >&2
    exit 1
}
for tool in cargo date find jq mkfifo mktemp od rg sort stat timeout tr; do
    command -v "$tool" >/dev/null 2>&1 || {
        echo "required development tool is missing: $tool" >&2
        exit 1
    }
done

driver_runner=0
if ((run)) && [[ -f "$application_root/package.json" || -f "$application_root/go.mod" ]]; then
    driver_runner=1
    [[ -x "$driverd" \
        && -f "$dev_tls_root/server.pem" \
        && -f "$dev_tls_root/server.key" \
        && -f "$dev_tls_root/ca.pem" ]] || {
        echo "installed application driver components are unavailable" >&2
        exit 1
    }
    command -v sha256sum >/dev/null 2>&1 || {
        echo "required development tool is missing: sha256sum" >&2
        exit 1
    }
fi

"$riffdb" application lock "$application_source" --write
"$riffdb" application generate "$application_source" --locked
application_manifest="$application_root/generated/riffdb.application.exact.json"
"$boundary_check" "$application_root"
contract="$application_root/$(jq -er '.contract.source' "$application_manifest")"
module_name="$(jq -er '.query_modules[0].name' "$application_manifest")"
module_version="$(jq -er '.query_modules[0].version' "$application_manifest")"
contract_lineage="$(jq -er '.contract.lineage' "$application_manifest")"
contract_version="$(jq -er '.contract.version' "$application_manifest")"
if [[ "$role" == application ]]; then
    role_symbol="$(jq -er '.roles[0].name' "$application_manifest")"
else
    role_symbol="$role"
    jq -e --arg role "$role_symbol" '.roles | any(.name == $role)' \
        "$application_manifest" >/dev/null || {
        echo "application manifest does not declare role: $role_symbol" >&2
        exit 2
    }
fi
role_scope="$(jq -er --arg role "$role_symbol" \
    '.roles[] | select(.name == $role) | .tenant_scope' \
    "$application_manifest")"
[[ "$role_scope" == global ]] || {
    echo "application role $role_symbol is tenant-scoped, but current application plans have no reviewed tenant mapping; riffdb dev requires an explicit global development role" >&2
    exit 2
}

task_tmp_root="${TMPDIR:-$HOME/tmp}"
mkdir -p "$task_tmp_root"
work_root="$(mktemp -d "$task_tmp_root/riffdb-dev.XXXXXX")"
server_pid=
driver_pid=
cleanup() {
    if [[ -n "$driver_pid" ]] && kill -0 "$driver_pid" 2>/dev/null; then
        kill -TERM "$driver_pid" 2>/dev/null || true
        timeout 15s tail --pid="$driver_pid" -f /dev/null 2>/dev/null || {
            kill -KILL "$driver_pid" 2>/dev/null || true
        }
        wait "$driver_pid" 2>/dev/null || true
    fi
    if [[ -n "$server_pid" ]] && kill -0 "$server_pid" 2>/dev/null; then
        kill -TERM "$server_pid" 2>/dev/null || true
        timeout 15s tail --pid="$server_pid" -f /dev/null 2>/dev/null || {
            kill -KILL "$server_pid" 2>/dev/null || true
        }
        wait "$server_pid" 2>/dev/null || true
    fi
    rm -rf "$work_root"
}
trap cleanup EXIT INT TERM

random_hex_32() {
    od -An -tx1 -N32 /dev/urandom | tr -d ' \n'
}

application_query_stamp() {
    while IFS= read -r relative; do
        stat -c '%n:%Y:%s' "$application_root/$relative"
    done < <(jq -er '.query_modules[0].queries[].source' "$application_manifest")
}

stage_application_queries() {
    local staged="$work_root/query-module"
    mkdir -p "$staged"
    find "$staged" -maxdepth 1 -type f -name '*.riffq' -delete
    local index=0
    while IFS= read -r relative; do
        cp -- "$application_root/$relative" \
            "$staged/$(printf '%04d.riffq' "$index")"
        ((index += 1))
    done < <(jq -er '.query_modules[0].queries[].source' "$application_manifest")
    ((index > 0)) || {
        echo "application query module is empty" >&2
        exit 1
    }
    queries="$staged"
}

stage_application_queries

mkdir -p "$work_root/backups"
mkfifo "$work_root/ready.fifo"
(
    capability_key="$(random_hex_32)"
    idempotency_key="$(random_hex_32)"
    while [[ "$idempotency_key" == "$capability_key" ]]; do
        idempotency_key="$(random_hex_32)"
    done
    printf 'riffdb-capability-digest-keys-v1\n1:%s\n' "$capability_key" \
        >"$work_root/capability.keys"
    printf 'riffdb-idempotency-digest-keys-v1\n1:%s\n' "$idempotency_key" \
        >"$work_root/idempotency.keys"
)

if ((driver_runner)); then
    dev_port_hex="$(od -An -tx2 -N2 /dev/urandom | tr -d ' \n')"
    dev_port=$((49152 + 0x$dev_port_hex % 16384))
    cat >"$work_root/riffdbd.toml" <<EOF
[server]
database = "$work_root/riffdb.redb"
environment = "local-dev"
audience = "riffdb-grpc-loopback"
capability_keys = "$work_root/capability.keys"
idempotency_keys = "$work_root/idempotency.keys"

[server.application_listener]
mode = "direct_tls"
listen = "127.0.0.1:$dev_port"
public_endpoint = "https://127.0.0.1:$dev_port"
certificate_chain = "$dev_tls_root/server.pem"
private_key = "$dev_tls_root/server.key"

[maintenance]
backup_root = "$work_root/backups"
EOF
    "$riffdbd" --config "$work_root/riffdbd.toml" \
        </dev/null >"$work_root/ready.fifo" 2>"$work_root/riffdbd.stderr" &
else
    "$riffdbd" \
        --database "$work_root/riffdb.redb" \
        --listen 127.0.0.1:0 \
        --environment local-dev \
        --audience riffdb-grpc-loopback \
        --backup-root "$work_root/backups" \
        --capability-keys "$work_root/capability.keys" \
        --idempotency-keys "$work_root/idempotency.keys" \
        </dev/null >"$work_root/ready.fifo" 2>"$work_root/riffdbd.stderr" &
fi
server_pid=$!

exec {ready_fd}<"$work_root/ready.fifo"
IFS= read -r -t 30 ready_line <&"$ready_fd" || {
    cat "$work_root/riffdbd.stderr" >&2
    echo "development server did not become ready" >&2
    exit 1
}
exec {ready_fd}<&-
case "$ready_line" in
    riffdbd-ready-v1$'\t'*) address="${ready_line#*$'\t'}" ;;
    *)
        echo "development server returned invalid readiness" >&2
        exit 1
        ;;
esac
if ((driver_runner)); then
    endpoint="https://$address"
    export RIFFDB_TLS_TRUST_ROOT="$dev_tls_root/ca.pem"
    export RIFFDB_TLS_SERVER_NAME=127.0.0.1
else
    endpoint="http://$address"
fi

"$riffdb" --endpoint "$endpoint" --output json \
    capability bootstrap \
    --request "$bootstrap_request" \
    --generate "$work_root/bootstrap.credential" \
    --bearer-output "$work_root/operator.credential" \
    >"$work_root/bootstrap.json"
jq -e '.ok == true and .command == "capability.bootstrap"' \
    "$work_root/bootstrap.json" >/dev/null

operator=("$riffdb" --endpoint "$endpoint" --output json --credential-file "$work_root/operator.credential")
"${operator[@]}" contract deploy "$contract" >"$work_root/contract.json"
jq -e '.ok == true and .command == "contract.deploy"' \
    "$work_root/contract.json" >/dev/null
if ! "${operator[@]}" query deploy "$queries" \
    --module-name "$module_name" \
    --module-version "$module_version" \
    --expected-active any \
    --contract-lineage "$contract_lineage" \
    --contract-version "$contract_version" >"$work_root/module.json"; then
    cat "$work_root/module.json" >&2
    cat "$work_root/riffdbd.stderr" >&2
    exit 1
fi
jq -e '.ok == true and .command == "query.deploy"' \
    "$work_root/module.json" >/dev/null

if jq -e '(.reactive_modules | length) > 0' "$application_manifest" >/dev/null; then
    (
        cd "$application_root"
        "${operator[@]}" application deploy \
            riffdb.application.json \
            --lock riffdb.application.lock.json
    ) >"$work_root/application.json"
    jq -e '.ok == true and .command == "application.deploy"' \
        "$work_root/application.json" >/dev/null
fi

if ! "${operator[@]}" role bind "$application_manifest" \
    --role "$role_symbol" \
    --principal "app:$(jq -er '.application' "$application_manifest")" \
    --actor-kind service \
    --lifetime-seconds 86400 \
    --audience riffdb-grpc-loopback \
    --credential-output "$work_root/profile.credential" >"$work_root/role.json"; then
    cat "$work_root/role.json" >&2
    exit 1
fi
jq -e '.ok == true and .command == "role.bind"' "$work_root/role.json" >/dev/null

driver_socket=
if ((driver_runner)); then
    driver_socket="$work_root/riffdb-driver.sock"
    cat >"$work_root/driver.toml" <<EOF
[driver]
socket = "$driver_socket"

[application]
lock_file = "$application_root/riffdb.application.lock.json"
manifest_file = "$application_manifest"
operation_catalog_file = "$application_root/generated/mcp/tools.json"
database = "default"
role = "$role_symbol"

[remote]
endpoint = "$endpoint"
tls_trust_root = "$dev_tls_root/ca.pem"
tls_server_name = "127.0.0.1"
credential_file = "$work_root/profile.credential"
pool_connections = 2
streams_per_connection = 64
EOF
    chmod 0600 "$work_root/driver.toml"
    "$driverd" "$work_root/driver.toml" \
        >"$work_root/driver.stdout" 2>"$work_root/driver.stderr" &
    driver_pid=$!
    driver_deadline=$((SECONDS + 30))
    while [[ ! -S "$driver_socket" && "$SECONDS" -lt "$driver_deadline" ]]; do
        kill -0 "$driver_pid" 2>/dev/null || break
    done
    [[ -S "$driver_socket" ]] || {
        cat "$work_root/driver.stderr" >&2
        echo "development application driver host did not become ready" >&2
        exit 1
    }
fi

profile_client=("$riffdb" --endpoint "$endpoint" --output json --credential-file "$work_root/profile.credential")
"${operator[@]}" query module \
    --contract-lineage "$contract_lineage" \
    --contract-version "$contract_version" >"$work_root/inspect.json"
jq -e --arg module "$module_name" '
  .ok == true
  and .command == "query.module"
  and .result.module.module_name == $module
  and (.result.queries | length) > 0
' "$work_root/inspect.json" >/dev/null

run_seed_file() {
    local seed_file="$1"
    local namespace="$2"
    local command_name seed_result
    [[ -f "$seed_file" ]] || {
        echo "seed input is unavailable" >&2
        return 1
    }
    command_name="$(basename "$seed_file" .jsonl)"
    command_name="${command_name#*-}"
    [[ -n "$command_name" ]] || {
        echo "seed input must be named NN-CommandName.jsonl" >&2
        return 1
    }
    seed_result="$work_root/seed-$namespace-$(basename "$seed_file").result"
    if ! "${profile_client[@]}" command batch "$command_name" "$seed_file" \
        --application "$application_source" \
        --concurrency "$seed_concurrency" \
        --checkpoint "$work_root/seed-$namespace-$(basename "$seed_file").checkpoint.json" \
        >"$seed_result"; then
        cat "$seed_result" >&2
        cat "$work_root/riffdbd.stderr" >&2
        return 1
    fi
    jq -e '
      .ok == true
      and .command == "command.batch"
      and .result.pending == 0
      and .result.rejected == 0
      and .result.total == .result.succeeded
    ' "$seed_result" >/dev/null
}

run_seed_directory() {
    local source_dir="$1"
    local namespace="$2"
    local seed_file files=0
    while IFS= read -r -d '' seed_file; do
        ((files += 1))
        run_seed_file "$seed_file" "$namespace-$files"
    done < <(find "$source_dir" -maxdepth 1 -type f -name '*.jsonl' -print0 | sort -z)
    ((files > 0)) || {
        echo "seed directory contains no JSONL command batches" >&2
        return 1
    }
}

report_missing_manifest_seed_inputs() {
    local seed_file discovered=0 shown=0
    echo "application manifest contains no seed inputs" >&2
    echo "fix: add ordered JSONL paths to \`seed_inputs\` in riffdb.application.json, or rerun without \`--seed\` as \`riffdb dev --run\`" >&2
    if [[ -d "$application_root/riffdb/seed" ]]; then
        while IFS= read -r -d '' seed_file; do
            ((discovered += 1))
            if ((shown < 8)); then
                printf 'unreferenced seed file: %s\n' "${seed_file#"$application_root/"}" >&2
                ((shown += 1))
            fi
        done < <(find "$application_root/riffdb/seed" -maxdepth 1 -type f -name '*.jsonl' -print0 | sort -z)
    fi
    if ((discovered > shown)); then
        printf 'unreferenced seed files omitted: %s\n' "$((discovered - shown))" >&2
    fi
}

seed_count=0
if [[ -n "$seed_dir" ]]; then
    run_seed_directory "$seed_dir" external
fi
if ((seed_builtin || acceptance)); then
    while IFS= read -r seed_relative; do
        ((seed_count += 1))
        run_seed_file "$application_root/$seed_relative" "manifest-$seed_count"
    done < <(jq -er '.seed_inputs[]' "$application_manifest")
    ((seed_count > 0)) || {
        report_missing_manifest_seed_inputs
        exit 1
    }
    printf 'riffdb-dev-seed-v1\t%s\tapplication-manifest\n' "$seed_count" >&2
fi

printf 'riffdb-dev-context-v1\tdatabase=%s\trole=%s\n' \
    "default" "$role_symbol"
printf 'riffdb-dev-ready-v1\t%s\t%s\t%s\n' \
    "$endpoint" "$work_root/profile.credential" "$role_symbol"

if ((run)); then
    runner_count=0
    for runner_manifest in Cargo.toml go.mod package.json pyproject.toml; do
        [[ -f "$application_root/$runner_manifest" ]] && ((runner_count += 1))
    done
    if ((runner_count != 1)); then
        echo "application root must contain exactly one supported runner manifest" >&2
        exit 2
    fi
    driver_arguments=()
    if ((driver_runner)); then
        manifest_hash="$(jq -er '.exact_manifest_hash' "$application_root/riffdb.application.lock.json")"
        catalog_hash="$(jq -er '.artifacts[] | select(.kind == "mcp") | .content_hash' "$application_root/riffdb.application.lock.json")"
        role_hash="$(jq -er --arg role "$role_symbol" '.roles[] | select(.definition.name == $role) | .definition_hash' "$application_root/riffdb.application.lock.json")"
        bundle_hash="$(jq -er '.contract.bundle_hash' "$application_root/riffdb.application.lock.json")"
        remote_hash="$(printf '%s' "$endpoint|127.0.0.1" | sha256sum | cut -d' ' -f1)"
        driver_arguments=(
            "$driver_socket" "$manifest_hash" "$catalog_hash" default
            "$role_symbol" "$role_hash" "$remote_hash" "$contract_lineage"
            "$contract_version" "$bundle_hash"
        )
    fi
    if [[ -f "$application_root/Cargo.toml" ]]; then
        [[ -f "$rust_sdk/Cargo.toml" ]] || {
            echo "installed Rust package is unavailable" >&2
            exit 1
        }
        prepare_rust_dependency_lock
        RIFFDB_ENDPOINT="$endpoint" \
            RIFFDB_CREDENTIAL_FILE="$work_root/profile.credential" \
            RIFFDB_DATABASE=default \
            CARGO_TARGET_DIR="$work_root/application-target" \
            cargo run --quiet --offline --locked \
            "${rust_cargo_config[@]}" \
            --manifest-path "$application_root/Cargo.toml" \
            -- "$endpoint" "$work_root/profile.credential" default
    elif [[ -f "$application_root/go.mod" ]]; then
        command -v go >/dev/null 2>&1 || {
            echo "required Go runner tool is missing: go" >&2
            exit 1
        }
        (
            cd "$application_root"
            GOTOOLCHAIN=local go run . "${driver_arguments[@]}"
        )
    elif [[ -f "$application_root/package.json" ]]; then
        for tool in node npm; do
            command -v "$tool" >/dev/null 2>&1 || {
                echo "required TypeScript runner tool is missing: $tool" >&2
                exit 1
            }
        done
        (
            cd "$application_root"
            unset RIFFDB_TLS_TRUST_ROOT RIFFDB_TLS_SERVER_NAME
            PATH="$installation_root/tooling/typescript/bin:$PATH" \
                NODE_PATH="$installation_root/tooling/typescript/node_modules" \
                npm run --silent build
            PATH="$installation_root/tooling/typescript/bin:$PATH" \
                NODE_PATH="$installation_root/tooling/typescript/node_modules" \
                npm run --silent start -- "${driver_arguments[@]}"
        )
    elif [[ -f "$application_root/pyproject.toml" ]]; then
        command -v uv >/dev/null 2>&1 || {
            echo "required Python runner tool is missing: uv" >&2
            exit 1
        }
        python_package="$(jq -er '.application | gsub("-"; "_")' "$application_manifest")"
        (
            cd "$application_root"
            uv sync --locked >/dev/null
            RIFFDB_ENDPOINT="$endpoint" \
                RIFFDB_CREDENTIAL_FILE="$work_root/profile.credential" \
                RIFFDB_DATABASE=default \
                PYTHONPATH=src uv run --locked python -m "$python_package" \
                "$endpoint" "$work_root/profile.credential" default
        )
    else
        echo "application root has no supported runner" >&2
        exit 2
    fi
    exit 0
fi

if ((acceptance)); then
    if [[ -f "$application_root/Cargo.toml" ]]; then
        [[ -f "$rust_sdk/Cargo.toml" ]] || {
            echo "installed Rust package is unavailable" >&2
            exit 1
        }
        prepare_rust_dependency_lock
        RIFFDB_ENDPOINT="$endpoint" \
            RIFFDB_CREDENTIAL_FILE="$work_root/profile.credential" \
            RIFFDB_DATABASE=default \
            CARGO_TARGET_DIR="$work_root/application-target" \
            cargo run --quiet --offline --locked \
            "${rust_cargo_config[@]}" \
            --manifest-path "$application_root/Cargo.toml" \
            -- "$endpoint" "$work_root/profile.credential" default \
            >"$work_root/generated-application-client.stdout"
        [[ -s "$work_root/generated-application-client.stdout" ]] || {
            echo "generated Rust application client returned no typed page result" >&2
            exit 1
        }
    fi
    exit 0
fi

if ((watch == 0)); then
    wait "$server_pid"
    server_pid=
    exit 0
fi

contract_stamp="$(stat -c '%Y:%s' "$contract")"
query_stamp="$(application_query_stamp)"
while kill -0 "$server_pid" 2>/dev/null; do
    sleep 0.25
    next_contract_stamp="$(stat -c '%Y:%s' "$contract")"
    next_query_stamp="$(application_query_stamp)"
    if [[ "$next_contract_stamp" != "$contract_stamp" ]]; then
        "$riffdb" application lock "$application_source" --write
        "$riffdb" application generate "$application_source" --locked
        "$boundary_check" "$application_root"
        "${operator[@]}" contract deploy "$contract" >/dev/null
        contract_stamp="$next_contract_stamp"
    fi
    if [[ "$next_query_stamp" != "$query_stamp" ]]; then
        ((module_version += 1))
        "$riffdb" application lock "$application_source" --write
        "$riffdb" application generate "$application_source" --locked
        "$boundary_check" "$application_root"
        stage_application_queries
        "${operator[@]}" query deploy "$queries" \
            --module-name "$module_name" \
            --module-version "$module_version" \
            --expected-active any \
            --contract-lineage "$contract_lineage" \
            --contract-version "$contract_version" >/dev/null
        query_stamp="$next_query_stamp"
    fi
done
wait "$server_pid"
server_pid=
