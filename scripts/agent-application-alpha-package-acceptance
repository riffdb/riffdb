#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
work_root="$(mktemp -d "${TMPDIR:-/tmp}/riffdb-agent-alpha-package.XXXXXX")"
cleanup() {
    rm -rf "$work_root"
}
trap cleanup EXIT INT TERM

cargo tree -p riffdb-api-mcp --no-default-features --features stdio \
    --edges normal >"$work_root/builder-dependencies.txt"
if rg -q 'riffdb-(auth|catalog|client|commit|policy|proto|runtime|server|service|storage)' \
    "$work_root/builder-dependencies.txt"; then
    echo "builder MCP feature graph contains runtime authority" >&2
    exit 1
fi

bundle="$work_root/bundle"
"$repo_root/scripts/agent-application-alpha-package" "$bundle" >/dev/null
[[ -x "$bundle/bin/riffdb-builder-mcp" ]] || {
    echo "sealed bundle is missing the credential-less builder MCP" >&2
    exit 1
}

for required in \
    docs/contracts/LANGUAGE.md \
    docs/contracts/COMMAND-INVARIANT-COOKBOOK.md \
    docs/contracts/examples/museum/contract.riff \
    docs/contracts/examples/museum/collection_page.riffq \
    docs/contracts/examples/museum/riffdb.application.json \
    docs/contracts/examples/NEGATIVE-EXAMPLES.md \
    docs/getting-started/application-source-v1.schema.json \
    docs/getting-started/AUTHORING-DIAGNOSTICS.md \
    docs/getting-started/INSPECTION.md \
    docs/riffql/LANGUAGE.md; do
    [[ -s "$bundle/$required" ]] || {
        echo "sealed bundle is missing authoring resource: $required" >&2
        exit 1
    }
done

cmp "$repo_root/crates/riffdb-contract-syntax/LANGUAGE.md" \
    "$bundle/docs/contracts/LANGUAGE.md"

mkdir "$work_root/existing-empty"
(
    cd "$work_root/existing-empty"
    "$bundle/bin/riffdb" new museum --directory .
)
cp "$bundle/docs/contracts/examples/museum/contract.riff" \
    "$work_root/existing-empty/riffdb/contract.riff"
cp "$bundle/docs/contracts/examples/museum/collection_page.riffq" \
    "$work_root/existing-empty/riffdb/queries/collection_page.riffq"
cp "$bundle/docs/contracts/examples/museum/riffdb.application.json" \
    "$work_root/existing-empty/riffdb.application.json"
(
    cd "$work_root/existing-empty"
    "$bundle/bin/riffdb" application check
    "$bundle/bin/riffdb" application lock --write
    "$bundle/bin/riffdb" application lock --check
)

"$repo_root/scripts/check-application-boundary" "$work_root/existing-empty"

builder_responses="$work_root/builder-responses.jsonl"
{
    printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-11-25","capabilities":{},"clientInfo":{"name":"acceptance","version":"1"}}}'
    printf '%s\n' '{"jsonrpc":"2.0","method":"notifications/initialized"}'
    printf '%s\n' '{"jsonrpc":"2.0","id":2,"method":"tools/list","params":{}}'
    printf '%s\n' '{"jsonrpc":"2.0","id":3,"method":"resources/list","params":{}}'
    printf '%s\n' '{"jsonrpc":"2.0","id":4,"method":"tools/call","params":{"name":"riffdb.builder.application_check","arguments":{}}}'
    printf '%s\n' '{"jsonrpc":"2.0","id":5,"method":"tools/call","params":{"name":"riffdb.builder.lock_preview","arguments":{}}}'
    printf '%s\n' '{"jsonrpc":"2.0","id":6,"method":"tools/call","params":{"name":"riffdb.builder.lock_write","arguments":{}}}'
    printf '%s\n' '{"jsonrpc":"2.0","id":7,"method":"tools/call","params":{"name":"riffdb.builder.generate","arguments":{}}}'
    printf '%s\n' '{"jsonrpc":"2.0","id":8,"method":"resources/read","params":{"uri":"riffdb-builder://reference/contract-language"}}'
} | "$bundle/bin/riffdb-builder-mcp" \
    --workspace "$work_root/existing-empty" >"$builder_responses"

jq -se '
  (map(select(.id == 2))[0].result.tools | map(.name)) == [
    "riffdb.builder.describe",
    "riffdb.builder.application_check",
    "riffdb.builder.diagnostic_explain",
    "riffdb.builder.lock_preview",
    "riffdb.builder.lock_write",
    "riffdb.builder.generate"
  ]
  and (map(select(.id == 3))[0].result.resources | length) == 5
  and map(select(.id == 4))[0].result.structuredContent.status == "checked"
  and map(select(.id == 5))[0].result.structuredContent.status == "previewed"
  and map(select(.id == 5))[0].result.structuredContent.changed == false
  and map(select(.id == 6))[0].result.structuredContent.status == "written"
  and map(select(.id == 7))[0].result.structuredContent.status == "generated"
  and (
    map(select(.id == 8))[0].result.contents[0].text
    | startswith("# RiffDB Contract Language Reference v1")
  )
' "$builder_responses" >/dev/null

cp "$work_root/existing-empty/riffdb/contract.riff" \
    "$work_root/valid-contract.riff"
printf '%s\n' 'contract Museum version 1 { SECRET_VALUE }' \
    >"$work_root/existing-empty/riffdb/contract.riff"
if (
    cd "$work_root/existing-empty"
    "$bundle/bin/riffdb" --output json application check
) 2>"$work_root/cli-diagnostic.json"; then
    echo "invalid authoring source unexpectedly passed CLI check" >&2
    exit 1
fi
{
    printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-11-25","capabilities":{},"clientInfo":{"name":"acceptance","version":"1"}}}'
    printf '%s\n' '{"jsonrpc":"2.0","method":"notifications/initialized"}'
    printf '%s\n' '{"jsonrpc":"2.0","id":9,"method":"tools/call","params":{"name":"riffdb.builder.application_check","arguments":{}}}'
} | "$bundle/bin/riffdb-builder-mcp" \
    --workspace "$work_root/existing-empty" >"$work_root/builder-diagnostic.jsonl"
jq -se --slurpfile cli "$work_root/cli-diagnostic.json" '
  map(select(.id == 9))[0].result.isError == true
  and map(select(.id == 9))[0].result.structuredContent == $cli[0]
' "$work_root/builder-diagnostic.jsonl" >/dev/null
cp "$work_root/valid-contract.riff" \
    "$work_root/existing-empty/riffdb/contract.riff"

echo "agent application alpha package acceptance passed"
