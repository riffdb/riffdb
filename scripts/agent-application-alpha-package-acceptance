#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
work_root="$(mktemp -d "${TMPDIR:-/tmp}/riffdb-agent-alpha-package.XXXXXX")"
typescript_run_pid=
cleanup() {
    if [[ -n "$typescript_run_pid" ]] && kill -0 "$typescript_run_pid" 2>/dev/null; then
        kill -TERM "$typescript_run_pid" 2>/dev/null || true
        wait "$typescript_run_pid" 2>/dev/null || true
    fi
    if [[ "${RIFFDB_AGENT_ALPHA_PACKAGE_ACCEPTANCE_KEEP_WORKSPACE:-false}" == true ]]; then
        echo "retained package-acceptance workspace: $work_root" >&2
    else
        rm -rf "$work_root"
    fi
}
trap cleanup EXIT INT TERM

cargo tree -p riffdb-api-mcp --no-default-features --features stdio \
    --edges normal >"$work_root/builder-dependencies.txt"
if rg -q 'riffdb-(auth|catalog|client|commit|policy|proto|runtime|server|service|storage)' \
    "$work_root/builder-dependencies.txt"; then
    echo "builder MCP feature graph contains runtime authority" >&2
    exit 1
fi

bundle="$work_root/bundle"
bundle_hash="$("$repo_root/scripts/agent-application-alpha-package" "$bundle")"
reproduced_bundle="$work_root/bundle-reproduced"
reproduced_hash="$(
    "$repo_root/scripts/agent-application-alpha-package" "$reproduced_bundle"
)"
[[ "$reproduced_hash" == "$bundle_hash" ]] || {
    echo "sealed bundle is not reproducible from identical source" >&2
    exit 1
}
cmp "$bundle/checksums.sha256" "$reproduced_bundle/checksums.sha256" || {
    echo "sealed bundle file inventory is not reproducible from identical source" >&2
    exit 1
}
rm -rf "$reproduced_bundle"
[[ -x "$bundle/bin/riffdb-builder-mcp" ]] || {
    echo "sealed bundle is missing the credential-less builder MCP" >&2
    exit 1
}
[[ -x "$bundle/bin/riffdb-driverd" ]] || {
    echo "sealed bundle is missing the first-party application driver host" >&2
    exit 1
}
for tls_asset in server.pem server.key ca.pem; do
    [[ -s "$bundle/share/riffdb/dev-tls/$tls_asset" ]] || {
        echo "sealed bundle is missing its loopback development TLS asset: $tls_asset" >&2
        exit 1
    }
done
[[ "$(stat -c '%a' "$bundle/share/riffdb/dev-tls/server.key")" == 600 ]] || {
    echo "sealed bundle development TLS private key is not owner-only" >&2
    exit 1
}

for required in \
    docs/contracts/LANGUAGE.md \
    docs/contracts/COMMAND-INVARIANT-COOKBOOK.md \
    docs/contracts/examples/museum/contract.riff \
    docs/contracts/examples/museum/collection_page.riffq \
    docs/contracts/examples/museum/riffdb.application.json \
    docs/contracts/examples/NEGATIVE-EXAMPLES.md \
    docs/getting-started/application-source-v1.schema.json \
    docs/getting-started/AUTHORING-DIAGNOSTICS.md \
    docs/getting-started/INSPECTION.md \
    evaluation/CANARY-PROTOCOL.md \
    evaluation/briefs/orders-python.md \
    evaluation/qualified-event-schema.json \
    docs/riffql/LANGUAGE.md; do
    [[ -s "$bundle/$required" ]] || {
        echo "sealed bundle is missing authoring resource: $required" >&2
        exit 1
    }
done

cmp "$repo_root/crates/riffdb-contract-syntax/LANGUAGE.md" \
    "$bundle/docs/contracts/LANGUAGE.md"

rust_run_root="$work_root/rust-run"
"$bundle/bin/riffdb" new run-rust --language rust --directory "$rust_run_root" >/dev/null
[[ -s "$rust_run_root/AUTHORING.md" ]] || {
    echo "fresh application omitted its repository-local authoring guide" >&2
    exit 1
}
rg -Fq 'Design transaction routes before writing entities' "$rust_run_root/AUTHORING.md"
rg -Fq 'complete set of records it must change atomically' \
    "$rust_run_root/AUTHORING.md"
rg -Fq 'model_one_mutation_aggregate' "$rust_run_root/AUTHORING.md"
rg -Fq 'set post.author_id = author_id' "$rust_run_root/AUTHORING.md"
rg -Fq 'prove_relationship_target' "$rust_run_root/AUTHORING.md"
rg -Fq 'transport or RPC wrappers, parameter/result maps' \
    "$bundle/evaluation/CANARY-PROTOCOL.md"
jq -e '
  .properties.handwritten_glue_lines.description
  | contains("Ordinary domain logic")
' "$bundle/evaluation/report-schema.json" >/dev/null
jq -e '.properties.language.enum == ["python", "rust", "typescript"]' \
    "$bundle/evaluation/report-schema.json" >/dev/null
boundary_help="$($bundle/libexec/check-application-boundary --help)"
grep -Fq 'Usage: check-application-boundary [APPLICATION_ROOT ...]' \
    <<<"$boundary_help"
grep -Fq 'Checks generated-operation-only application boundary compliance.' \
    <<<"$boundary_help"
rust_source_check="$(
    cd "$rust_run_root"
    "$bundle/bin/riffdb" application check --source-only
)"
rg -Fq 'application seed plan: 1 manifest input(s); run `riffdb dev --seed --run`' \
    <<<"$rust_source_check"
rust_run_output="$(
    cd "$rust_run_root"
    "$bundle/bin/riffdb" dev --seed --run
)"
rg -q '^riffdb-dev-ready-v1' <<<"$rust_run_output"
rg -q '^Welcome to run-rust$' <<<"$rust_run_output"

python_run_root="$work_root/python-run"
"$bundle/bin/riffdb" new run-python --language python \
    --directory "$python_run_root" >/dev/null
python_run_output="$(
    cd "$python_run_root"
    UV_CACHE_DIR="$work_root/uv-cache" \
        "$bundle/bin/riffdb" dev --seed --run
)"
rg -q '^riffdb-dev-ready-v1' <<<"$python_run_output"
rg -Fq '"schema":"riffdb.application-parity/v1"' <<<"$python_run_output"

typescript_run_root="$work_root/typescript-run"
"$bundle/bin/riffdb" new run-typescript --language typescript \
    --directory "$typescript_run_root" >/dev/null
# Exact development deployment must ignore sources that are not named by the
# locked application manifest. Directory-wide deployment would reject this
# duplicate declaration before the generated application starts.
cp "$typescript_run_root/riffdb/queries/item_page.riffq" \
    "$typescript_run_root/riffdb/queries/unreferenced-duplicate.riffq"
typescript_run_log="$work_root/typescript-run.stdout"
typescript_run_error="$work_root/typescript-run.stderr"
(
    cd "$typescript_run_root"
    "$bundle/bin/riffdb" dev --seed --run
) >"$typescript_run_log" 2>"$typescript_run_error" &
typescript_run_pid=$!
set +e
typescript_ready="$(
    set +o pipefail
    timeout 60s tail -n +1 -F "$typescript_run_log" \
        | rg --line-buffered -m1 '^riffdb-app-ready-v1'
)"
typescript_ready_status=$?
set -e
if [[ "$typescript_ready_status" != 0 ]]; then
    cat "$typescript_run_log" >&2
    cat "$typescript_run_error" >&2
    echo "installed TypeScript application did not become ready within 60 seconds" >&2
    exit 1
fi
typescript_port="${typescript_ready#*$'\t'}"
[[ "$typescript_port" =~ ^[0-9]+$ ]] || {
    cat "$typescript_run_log" >&2
    cat "$typescript_run_error" >&2
    echo "installed TypeScript application returned invalid readiness" >&2
    exit 1
}
typescript_response="$(
    curl --fail --silent --show-error "http://127.0.0.1:$typescript_port/item"
)"
jq -e '
  .outcome == "Created"
  and .title == "TypeScript generated web application"
  and (.applicationHead | test("^[1-9][0-9]*$"))
  and (.readAfterCommit | test("^[1-9][0-9]*$"))
' <<<"$typescript_response" >/dev/null || {
    printf '%s\n' "$typescript_response" >&2
    exit 1
}
kill -TERM "$typescript_run_pid"
wait "$typescript_run_pid" 2>/dev/null || true
typescript_run_pid=

seedless_root="$work_root/seedless-run"
cp -R "$typescript_run_root" "$seedless_root"
jq -c '.seed_inputs = []' "$seedless_root/riffdb.application.json" \
    >"$seedless_root/riffdb.application.json.next"
printf '\n' >>"$seedless_root/riffdb.application.json.next"
mv "$seedless_root/riffdb.application.json.next" \
    "$seedless_root/riffdb.application.json"
(
    cd "$seedless_root"
    "$bundle/bin/riffdb" application lock --write >/dev/null
)
seedless_check="$(
    cd "$seedless_root"
    "$bundle/bin/riffdb" application check --source-only
)"
rg -Fq 'application seed plan: none; run `riffdb dev --run`' \
    <<<"$seedless_check"
if (
    cd "$seedless_root"
    "$bundle/bin/riffdb" dev --seed --run
) >"$work_root/seedless.stdout" 2>"$work_root/seedless.stderr"; then
    echo "seedless application unexpectedly accepted --seed" >&2
    exit 1
fi
rg -Fq 'fix: add ordered JSONL paths to `seed_inputs` in riffdb.application.json, or rerun without `--seed` as `riffdb dev --run`' \
    "$work_root/seedless.stderr"
rg -Fq 'unreferenced seed file: riffdb/seed/01-CreateItem.jsonl' \
    "$work_root/seedless.stderr"

mkdir "$work_root/existing-empty"
(
    cd "$work_root/existing-empty"
    "$bundle/bin/riffdb" new museum --directory .
)
cp "$bundle/docs/contracts/examples/museum/contract.riff" \
    "$work_root/existing-empty/riffdb/contract.riff"
cp "$bundle/docs/contracts/examples/museum/collection_page.riffq" \
    "$work_root/existing-empty/riffdb/queries/collection_page.riffq"
cp "$bundle/docs/contracts/examples/museum/riffdb.application.json" \
    "$work_root/existing-empty/riffdb.application.json"
(
    cd "$work_root/existing-empty"
    if "$bundle/bin/riffdb" application check \
        >"$work_root/pre-lock-check.stdout" \
        2>"$work_root/pre-lock-check.stderr"; then
        echo "changed application sources unexpectedly matched the scaffold lock" >&2
        exit 1
    fi
    rg -q 'RDB-AL008.*application lock contains stale or substituted identities' \
        "$work_root/pre-lock-check.stderr"
    "$bundle/bin/riffdb" application lock --write
    "$bundle/bin/riffdb" application check
    "$bundle/bin/riffdb" application lock --check
)

"$repo_root/scripts/check-application-boundary" "$work_root/existing-empty"

builder_responses="$work_root/builder-responses.jsonl"
{
    printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-11-25","capabilities":{},"clientInfo":{"name":"acceptance","version":"1"}}}'
    printf '%s\n' '{"jsonrpc":"2.0","method":"notifications/initialized"}'
    printf '%s\n' '{"jsonrpc":"2.0","id":2,"method":"tools/list","params":{}}'
    printf '%s\n' '{"jsonrpc":"2.0","id":3,"method":"resources/list","params":{}}'
    printf '%s\n' '{"jsonrpc":"2.0","id":4,"method":"tools/call","params":{"name":"riffdb_builder_application_check","arguments":{}}}'
    printf '%s\n' '{"jsonrpc":"2.0","id":5,"method":"tools/call","params":{"name":"riffdb_builder_lock_preview","arguments":{}}}'
    printf '%s\n' '{"jsonrpc":"2.0","id":6,"method":"tools/call","params":{"name":"riffdb_builder_lock_write","arguments":{}}}'
    printf '%s\n' '{"jsonrpc":"2.0","id":7,"method":"tools/call","params":{"name":"riffdb_builder_generate","arguments":{}}}'
    printf '%s\n' '{"jsonrpc":"2.0","id":8,"method":"resources/read","params":{"uri":"riffdb-builder://reference/contract-language"}}'
} | "$bundle/bin/riffdb-builder-mcp" \
    --workspace "$work_root/existing-empty" >"$builder_responses"

jq -se '
  (map(select(.id == 2))[0].result.tools | map(.name)) == [
    "riffdb_builder_describe",
    "riffdb_builder_application_check",
    "riffdb_builder_diagnostic_explain",
    "riffdb_builder_lock_preview",
    "riffdb_builder_lock_write",
    "riffdb_builder_generate"
  ]
  and (map(select(.id == 3))[0].result.resources | length) == 5
  and map(select(.id == 4))[0].result.structuredContent.status == "checked"
  and map(select(.id == 5))[0].result.structuredContent.status == "previewed"
  and map(select(.id == 5))[0].result.structuredContent.changed == false
  and map(select(.id == 6))[0].result.structuredContent.status == "written"
  and map(select(.id == 7))[0].result.structuredContent.status == "generated"
  and (
    map(select(.id == 8))[0].result.contents[0].text
    | startswith("# RiffDB Contract Language Reference v1")
  )
' "$builder_responses" >/dev/null

cp "$work_root/existing-empty/riffdb/contract.riff" \
    "$work_root/valid-contract.riff"
printf '%s\n' 'contract Museum version 1 { SECRET_VALUE }' \
    >"$work_root/existing-empty/riffdb/contract.riff"
if (
    cd "$work_root/existing-empty"
    "$bundle/bin/riffdb" --output json application check
) 2>"$work_root/cli-diagnostic.json"; then
    echo "invalid authoring source unexpectedly passed CLI check" >&2
    exit 1
fi
{
    printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-11-25","capabilities":{},"clientInfo":{"name":"acceptance","version":"1"}}}'
    printf '%s\n' '{"jsonrpc":"2.0","method":"notifications/initialized"}'
    printf '%s\n' '{"jsonrpc":"2.0","id":9,"method":"tools/call","params":{"name":"riffdb_builder_application_check","arguments":{}}}'
} | "$bundle/bin/riffdb-builder-mcp" \
    --workspace "$work_root/existing-empty" >"$work_root/builder-diagnostic.jsonl"
jq -se --slurpfile cli "$work_root/cli-diagnostic.json" '
  map(select(.id == 9))[0].result.isError == true
  and map(select(.id == 9))[0].result.structuredContent == $cli[0]
' "$work_root/builder-diagnostic.jsonl" >/dev/null
cp "$work_root/valid-contract.riff" \
    "$work_root/existing-empty/riffdb/contract.riff"

echo "agent application alpha package acceptance passed"
