#!/usr/bin/env bash
set -euo pipefail
umask 077

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
expected_runs=
sealed=false
assert_gate=false
campaign=campaign-02
while (($#)); do
    case "$1" in
        --campaign) campaign="${2:-}"; shift 2 ;;
        --runs) expected_runs="${2:-}"; shift 2 ;;
        --sealed) sealed=true; shift ;;
        --assert-gate) assert_gate=true; shift ;;
        *)
            echo "usage: scripts/agent-application-alpha-acceptance [--campaign ID] --runs 4 --sealed --assert-gate" >&2
            exit 2
            ;;
    esac
done
[[ "$expected_runs" == "4" && "$sealed" == true && "$assert_gate" == true ]] || {
    echo "the alpha gate requires exactly four sealed asserted runs" >&2
    exit 2
}
[[ "$campaign" =~ ^[a-z0-9-]{1,64}$ ]] || {
    echo "alpha campaign identifier is invalid" >&2
    exit 2
}

for tool in jq sha256sum; do
    command -v "$tool" >/dev/null 2>&1 || {
        echo "required alpha-gate tool is missing: $tool" >&2
        exit 1
    }
done

"$repo_root/scripts/agent-application-alpha-canary-acceptance" \
    --campaign "$campaign" --runs 4 --sealed --assert-gate

manifest="evaluations/agent-application-alpha/campaigns/$campaign.json"
manifest_hash="$(sha256sum "$repo_root/$manifest" | cut -d' ' -f1)"
gate="$repo_root/release/evidence/agent-application-alpha-gate-v2.json"
jq -e \
    --arg campaign "$campaign" \
    --arg manifest "$manifest" \
    --arg manifest_hash "$manifest_hash" \
    --slurpfile selected "$repo_root/$manifest" '
  (keys | sort) == ([
    "bundle_hash", "campaign_id", "campaign_manifest", "decision",
    "independent_runs_completed", "independent_runs_required", "reason",
    "requirement", "schema", "sealed_bundle_self_test", "thresholds",
    "work_package"
  ] | sort)
  and .schema == "riffdb-agent-application-alpha-gate/v2"
  and .work_package == "WP-370"
  and .requirement == "AAA-012"
  and .campaign_id == $campaign
  and .campaign_manifest == {path: $manifest, sha256: $manifest_hash}
  and .bundle_hash == $selected[0].bundle_hash
  and .decision == "eligible"
  and .sealed_bundle_self_test == "passed"
  and .independent_runs_completed == 4
  and .independent_runs_required == 4
  and .thresholds == {
    handwritten_glue_lines: 0,
    human_interventions: 0,
    kernel_successes: 0,
    maximum_first_page_read_seconds: 3600,
    maximum_first_write_seconds: 1800,
    minimum_rating: 8.5,
    prohibited_source_access: true,
    unresolved_required_shapes: 0
  }
  and (.reason | type) == "string"
  and (.reason | length) >= 1
  and (.reason | length) <= 4096
' "$gate" >/dev/null || {
    echo "published eligible alpha decision is missing or does not match the selected campaign" >&2
    exit 1
}

echo "Agent Application Alpha campaign $campaign passed"
