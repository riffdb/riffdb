#!/usr/bin/env bash
# req: GEN-005
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
"$repo_root/scripts/generate-operation-adapters" --check
cargo +1.98.1 test --quiet -p riffdb-driver-host \
    --test registry_drift_corpus --all-features
if [[ "$#" -eq 2 && "$1" == "--all-languages" && "$2" == "--row-policy" ]]; then
    exec "$repo_root/scripts/adapter-row-policy-acceptance" \
        --all-languages --domains better-auth,mlflow
fi
if [[ "$#" -ne 2 || "$1" != "--all-languages" || "$2" != "--remote" ]]; then
    echo "usage: ./scripts/driver-conformance --all-languages <--remote|--row-policy>" >&2
    exit 2
fi

task_tmp_root="${RIFFDB_TMP_ROOT:-$HOME/tmp}"
mkdir -p "$task_tmp_root"
export TMPDIR="$task_tmp_root"
export GOCACHE="${RIFFDB_GO_CACHE:-$task_tmp_root/riffdb-go-cache}"
export GOPATH="${RIFFDB_GO_PATH:-$task_tmp_root/riffdb-go-path}"
export GOPROXY=off
export UV_CACHE_DIR="${UV_CACHE_DIR:-$task_tmp_root/riffdb-uv-cache}"
mkdir -p "$GOCACHE" "$GOPATH" "$UV_CACHE_DIR"

cli_bin="${RIFFDB_CONFORMANCE_CLI_BIN:-$repo_root/target/debug/riffdb}"
application_source="${RIFFDB_CONFORMANCE_APPLICATION_SOURCE:-$repo_root/fixtures/driver/conformance-app}"
rust_runner="${RIFFDB_CONFORMANCE_RUST_RUNNER:-}"
typescript_runtime="${RIFFDB_CONFORMANCE_TYPESCRIPT_RUNTIME_PACKAGE:-}"
typescript_tsc="${RIFFDB_CONFORMANCE_TYPESCRIPT_TSC:-$repo_root/clients/typescript/runtime/node_modules/.bin/tsc}"
python_bin="${RIFFDB_CONFORMANCE_PYTHON_BIN:-}"
for path in "$cli_bin" "$application_source"; do
    [[ "$path" == /* ]] || {
        echo "driver-conformance injected paths must be absolute" >&2
        exit 1
    }
done

for tool in cargo go jq mkfifo mktemp node npm python3 sha256sum uv; do
    command -v "$tool" >/dev/null 2>&1 || {
        echo "required driver-conformance tool is missing: $tool" >&2
        exit 1
    }
done

work_root="$(mktemp -d "$task_tmp_root/riffdb-driver-conformance.XXXXXX")"
server_pid=
driver_pid=
cleanup() {
    if [[ -n "$driver_pid" ]] && kill -0 "$driver_pid" 2>/dev/null; then
        kill -TERM "$driver_pid" 2>/dev/null || true
        wait "$driver_pid" 2>/dev/null || true
    fi
    if [[ -n "$server_pid" ]] && kill -0 "$server_pid" 2>/dev/null; then
        printf 'shutdown\n' >&"$server_input_fd" 2>/dev/null || true
        wait "$server_pid" 2>/dev/null || true
    fi
    if [[ "${RIFFDB_KEEP_CONFORMANCE:-0}" == "1" ]]; then
        echo "retained driver-conformance work root: $work_root" >&2
    else
        rm -rf "$work_root"
    fi
}
trap cleanup EXIT INT TERM

cd "$repo_root"
cargo +1.98.1 build --quiet \
    -p riffdb-server --bin riffdbd \
    -p riffdb-driver-host --bin riffdb-driverd
if [[ "$cli_bin" == "$repo_root/target/debug/riffdb" ]]; then
    cargo +1.98.1 build --quiet -p riffdb-cli --bin riffdb
fi
if [[ -z "$typescript_runtime" ]]; then
    npm --prefix clients/typescript/runtime run build >/dev/null
    typescript_runtime="$repo_root/clients/typescript/runtime/dist/index.js"
fi

if [[ -z "$python_bin" ]]; then
    (
        cd clients/python/runtime
        python3 -m maturin build --quiet --interpreter python3 \
            --compatibility linux --out "$work_root/dist"
    )
    python_wheel="$(find "$work_root/dist" -maxdepth 1 -type f -name '*.whl' -print -quit)"
    [[ -n "$python_wheel" ]] || { echo "Python conformance wheel was not built" >&2; exit 1; }
    uv venv "$work_root/python-venv" >/dev/null
    uv pip install --offline --python "$work_root/python-venv/bin/python" "$python_wheel" >/dev/null
    python_bin="$work_root/python-venv/bin/python"
fi
[[ -x "$cli_bin" && -x "$python_bin" && -f "$typescript_runtime" && -x "$typescript_tsc" ]] || {
    echo "driver-conformance runtime injection is incomplete" >&2
    exit 1
}

port="$($python_bin - <<'PY'
import socket
with socket.socket() as listener:
    listener.bind(("127.0.0.1", 0))
    print(listener.getsockname()[1])
PY
)"
cp crates/riffdb-server/tests/fixtures/localhost-cert.pem "$work_root/server.pem"
cp crates/riffdb-server/tests/fixtures/localhost-key.pem "$work_root/server.key"
cp crates/riffdb-server/tests/fixtures/test-ca.pem "$work_root/ca.pem"
chmod 0444 "$work_root/server.pem" "$work_root/ca.pem"
chmod 0600 "$work_root/server.key"
printf '%s' 'riffdb-capability-digest-keys-v1
1:000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
' >"$work_root/capability.keys"
printf '%s' 'riffdb-idempotency-digest-keys-v1
1:202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f
' >"$work_root/idempotency.keys"
chmod 0600 "$work_root/capability.keys" "$work_root/idempotency.keys"
mkdir -m 0700 "$work_root/backups"

cat >"$work_root/riffdbd.toml" <<EOF
[server]
database = "$work_root/riffdb.redb"
environment = "development"
audience = "riffdb-driver-conformance"
capability_keys = "$work_root/capability.keys"
idempotency_keys = "$work_root/idempotency.keys"

[server.application_listener]
mode = "direct_tls"
listen = "127.0.0.1:$port"
public_endpoint = "https://127.0.0.1:$port"
certificate_chain = "$work_root/server.pem"
private_key = "$work_root/server.key"

[server.application_listener.bounds]
max_connections = 64
max_streams_per_connection = 128
handshake_timeout_seconds = 5
drain_timeout_seconds = 5

[maintenance]
backup_root = "$work_root/backups"
projections_root = "$work_root/projections"
EOF

mkfifo "$work_root/server.input" "$work_root/server.output"
exec {server_input_fd}<>"$work_root/server.input"
exec {server_output_fd}<>"$work_root/server.output"
target/debug/riffdbd --config "$work_root/riffdbd.toml" \
    <&"$server_input_fd" >"$work_root/server.output" 2>"$work_root/server.stderr" &
server_pid=$!
ready=
while IFS= read -r -t 60 line <&"$server_output_fd"; do
    if [[ "$line" == riffdbd-ready-v1$'\t'* ]]; then ready="$line"; break; fi
done
[[ "$ready" == "riffdbd-ready-v1"$'\t'"127.0.0.1:$port" ]] || {
    sed -n '1,200p' "$work_root/server.stderr" >&2
    echo "shared remote RiffDB did not become ready" >&2
    exit 1
}

cat >"$work_root/bootstrap.json" <<'EOF'
{"principal_id":"driver-conformance-operator","actor_kind":"human","requested_lifetime_seconds":86400,"audiences":["riffdb-driver-conformance"],"grant":{"tenant_scope":{"type":"global"},"partition_scope":{"type":"all"},"permissions":[{"type":"validate_contract"},{"type":"read_contract"},{"type":"deploy_contract"},{"type":"read_health"},{"type":"create_capability"},{"type":"revoke_capability"},{"type":"administer_capabilities"}],"field_visibility":[],"max_scan_rows":50,"approval_required":[]}}
EOF
cat >"$work_root/bootstrap-client.toml" <<EOF
[client]
endpoint = "https://127.0.0.1:$port"
database = "default"
output = "json"
max_attempts = 3
tls_trust_root = "$work_root/ca.pem"
tls_server_name = "127.0.0.1"
EOF
"$cli_bin" --config "$work_root/bootstrap-client.toml" capability bootstrap \
    --request "$work_root/bootstrap.json" --generate "$work_root/bootstrap.credential" \
    --bearer-output "$work_root/operator.credential" >/dev/null
cat >"$work_root/operator-client.toml" <<EOF
[client]
endpoint = "https://127.0.0.1:$port"
database = "default"
output = "json"
max_attempts = 3
credential_file = "$work_root/operator.credential"
tls_trust_root = "$work_root/ca.pem"
tls_server_name = "127.0.0.1"
EOF

cp -R "$application_source" "$work_root/application"
(
    cd "$work_root/application"
    "$cli_bin" --config "$work_root/operator-client.toml" application deploy \
        riffdb.application.json --lock riffdb.application.lock.json \
        --provision-role DriverConformanceApplication --lifetime-seconds 3600 >/dev/null
)
deployment_root="$work_root/application/.riffdb/deployments/default"
credential_file="$(jq -r 'if (.role.credential_file // "") == "" then "application.credential" else .role.credential_file end' "$deployment_root/deployment-state.json")"
if [[ "$credential_file" == /* ]]; then
    credential="$credential_file"
else
    credential="$deployment_root/$credential_file"
fi
[[ -f "$credential" ]] || { echo "application credential was not provisioned" >&2; exit 1; }

export RIFFDB_CONFORMANCE_ENDPOINT="https://127.0.0.1:$port"
export RIFFDB_CONFORMANCE_TRUST_ROOT="$work_root/ca.pem"
export RIFFDB_CONFORMANCE_CREDENTIAL="$credential"
if [[ -n "$rust_runner" ]]; then
    "$rust_runner" >"$work_root/rust.json"
else
    cargo +1.98.1 run --quiet -p riffdb-testkit-server --example driver_conformance_remote_client -- \
        >"$work_root/rust.json"
fi

socket="$work_root/riffdb-driver.sock"
cat >"$work_root/driver.toml" <<EOF
[driver]
socket = "$socket"

[application]
lock_file = "$work_root/application/riffdb.application.lock.json"
manifest_file = "$work_root/application/generated/riffdb.application.exact.json"
operation_catalog_file = "$work_root/application/generated/mcp/tools.json"
database = "default"
role = "DriverConformanceApplication"

[remote]
endpoint = "https://127.0.0.1:$port"
tls_trust_root = "$work_root/ca.pem"
tls_server_name = "127.0.0.1"
credential_file = "$credential"
pool_connections = 4
streams_per_connection = 64
EOF
chmod 0600 "$work_root/driver.toml"
target/debug/riffdb-driverd "$work_root/driver.toml" >"$work_root/driver.stdout" 2>"$work_root/driver.stderr" &
driver_pid=$!
deadline=$((SECONDS + 30))
while [[ ! -S "$socket" && "$SECONDS" -lt "$deadline" ]]; do
    kill -0 "$driver_pid" 2>/dev/null || break
done
[[ -S "$socket" ]] || {
    sed -n '1,200p' "$work_root/driver.stderr" >&2
    echo "shared Rust driver host did not become ready" >&2
    exit 1
}

manifest_hash="$(jq -r '.exact_manifest_hash' "$work_root/application/riffdb.application.lock.json")"
catalog_hash="$(jq -r '.artifacts[] | select(.kind == "mcp") | .content_hash' "$work_root/application/riffdb.application.lock.json")"
bundle_hash="$(jq -r '.contract.bundle_hash' "$work_root/application/riffdb.application.lock.json")"
role_hash="$(jq -r '.roles[] | select(.definition.name == "DriverConformanceApplication") | .definition_hash' "$work_root/application/riffdb.application.lock.json")"
remote_hash="$(printf 'https://127.0.0.1:%s|127.0.0.1' "$port" | sha256sum | cut -d' ' -f1)"
jq -n \
    --arg applicationManifestHash "$manifest_hash" \
    --arg operationCatalogHash "$catalog_hash" \
    --arg contractLineage DriverConformance \
    --argjson contractVersion 1 \
    --arg contractBundleHash "$bundle_hash" \
    --arg database default \
    --arg role DriverConformanceApplication \
    --arg roleDefinitionHash "$role_hash" \
    --arg remoteIdentityHash "$remote_hash" \
    '{applicationManifestHash:$applicationManifestHash,operationCatalogHash:$operationCatalogHash,contractLineage:$contractLineage,contractVersion:$contractVersion,contractBundleHash:$contractBundleHash,database:$database,role:$role,roleDefinitionHash:$roleDefinitionHash,remoteIdentityHash:$remoteIdentityHash}' \
    >"$work_root/identity.json"

export RIFFDB_CONFORMANCE_SOCKET="$socket"
export RIFFDB_CONFORMANCE_IDENTITY="$work_root/identity.json"

go_proxy="${RIFFDB_CONFORMANCE_GO_PROXY:-off}"
GOCACHE="$GOCACHE" GOPATH="$GOPATH" GOPROXY="$go_proxy" \
    go -C "$application_source" run ./runner/go >"$work_root/go.json"

"$typescript_tsc" \
    "$work_root/application/generated/typescript/client.ts" \
    --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --skipLibCheck \
    --outDir "$work_root/typescript"
export RIFFDB_CONFORMANCE_TYPESCRIPT_RUNTIME="$typescript_runtime"
export RIFFDB_CONFORMANCE_TYPESCRIPT_GENERATED="$work_root/typescript/client.js"
node "$application_source/runner/typescript.mjs" >"$work_root/typescript.json"

PYTHONPATH="$work_root/application/generated/python" \
    "$python_bin" "$application_source/runner/python.py" \
    >"$work_root/python.json"

expected='{"consume":"TokenConsumed","consume_missing":true,"consume_replayed":true,"created":"Created","delete_preimage_redacted":true,"exact_query":"Found","exact_total":1,"query":"Found","read_after_commit":true,"replayed":true,"reuse_error":"RDB-COMMAND-0101","schema":"riffdb.driver-conformance-observation/v1","secret_query":"Found","secret_redacted":true}'
for language in rust go typescript python; do
    observed="$(jq -cS 'del(.language)' "$work_root/$language.json")"
    [[ "$observed" == "$expected" ]] || {
        echo "$language produced a divergent shared-remote observation: $observed" >&2
        exit 1
    }
done

./scripts/generate-unary-delete-preimage-capability --check

capability_id="$(jq -r '.role.capability_id' "$deployment_root/deployment-state.json")"
"$cli_bin" --config "$work_root/operator-client.toml" role revoke \
    "$capability_id" --reason policy_change >/dev/null
RIFFDB_CONFORMANCE_EXPECT_REVOKED=1 \
    GOCACHE="$GOCACHE" GOPATH="$GOPATH" GOPROXY="$go_proxy" \
    go -C "$application_source" run ./runner/go >"$work_root/go-revoked.json"
if [[ -n "$rust_runner" ]]; then
    RIFFDB_CONFORMANCE_EXPECT_REVOKED=1 \
        "$rust_runner" >"$work_root/rust-revoked.json"
else
    RIFFDB_CONFORMANCE_EXPECT_REVOKED=1 \
        cargo +1.98.1 run --quiet -p riffdb-testkit-server --example driver_conformance_remote_client -- \
        >"$work_root/rust-revoked.json"
fi
RIFFDB_CONFORMANCE_EXPECT_REVOKED=1 \
    node "$application_source/runner/typescript.mjs" \
    >"$work_root/typescript-revoked.json"
RIFFDB_CONFORMANCE_EXPECT_REVOKED=1 \
    PYTHONPATH="$work_root/application/generated/python" \
    "$python_bin" "$application_source/runner/python.py" \
    >"$work_root/python-revoked.json"
for language in rust go typescript python; do
    jq -e '.schema == "riffdb.driver-conformance-fault/v1"
           and .fault == "revocation" and .code == "RDB-AUTH-0215"' \
        "$work_root/$language-revoked.json" >/dev/null
done

./scripts/check-driver-conformance-manifests

kill -TERM "$driver_pid"
wait "$driver_pid"
driver_pid=
printf 'shutdown\n' >&"$server_input_fd"
wait "$server_pid"
server_pid=

# Installed/local fault cells exercise the transport lifecycle that cannot be
# induced safely through the shared business workload: malformed framing,
# queue bounds, cancellation/uncertainty, cursor/reactive resumption, and
# clean host shutdown. They use the same frozen corpus digest and generated
# value/error registries as the shared remote cells above.
if [[ "${RIFFDB_CONFORMANCE_PACKAGE_MODE:-0}" != 1 ]]; then
    cargo +1.98.1 test --quiet -p riffdb-driver-host --all-features
    GOCACHE="$GOCACHE" GOPATH="$GOPATH" GOPROXY=off go -C clients/go/runtime test ./...
    GOCACHE="$GOCACHE" GOPATH="$GOPATH" GOPROXY=off go -C clients/go/operator test ./...
    npm --prefix clients/typescript/runtime test >/dev/null
    "$python_bin" -m unittest discover \
        -s clients/python/runtime/tests -q
    cargo +1.98.1 test --quiet -p riffdb-testkit-server --test reactive_ticketdesk_acceptance --all-features
fi

echo "Rust, Go, TypeScript, and Python passed the shared remote driver corpus."
