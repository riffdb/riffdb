#!/usr/bin/env bash
# req: REP-002, REP-004, REP-005, DX-014
set -euo pipefail

# Renders the RiffDB chart against pinned values and compares the result with a
# committed golden manifest, plus verifies follower-mode rendering and
# fail-closed validation.
#
# A chart is a program whose output an operator runs. Reviewing a values or
# template change by reading the template is reviewing the source of that
# program rather than its output; this makes the output reviewable. A change
# that alters what gets deployed shows up as a manifest diff.

usage() {
    echo "usage: ./scripts/check-helm-render [--write]" >&2
    exit 2
}

write=0
case "${1:-}" in
    "") ;;
    --write) write=1 ;;
    *) usage ;;
esac

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

command -v helm >/dev/null 2>&1 || {
    echo "check-helm-render requires helm" >&2
    exit 1
}

chart="release/helm/riffdb"
golden="release/helm/rendered/riffdb-default-v1.yaml"

# Pinned so the golden is a function of the chart alone: a newer local helm or
# cluster must not change the recorded output.
render() {
    helm template riffdb "$chart" \
        --namespace riffdb-alpha \
        --kube-version 1.29.0 \
        --api-versions v1 \
        --api-versions apps/v1 \
        --api-versions batch/v1 \
        "$@"
}

helm lint "$chart" >/dev/null

follower_manifest="$(
    render \
        --set server.mode=follower \
        --set server.replicationSource.endpoint=https://riffdb-primary.riffdb-alpha.svc:7443 \
        --set server.replicationSource.serverName=riffdb-primary.riffdb-alpha.svc \
        --set server.replicationSource.databaseId=018f0f8b-7c6d-7e31-8a4f-2c2d37a52b10 \
        --set server.replicationSource.historyIncarnation=2 \
        --set server.replicationSource.leadershipEpoch=3 \
        --set server.replicationSource.holdId=0102030405060708090a0b0c0d0e0f10
)"
grep -Fq 'mode = "follower"' <<<"$follower_manifest" || {
    echo "follower render omitted mode = \"follower\"" >&2
    exit 1
}
grep -Fq '[server.replication_source]' <<<"$follower_manifest" || {
    echo "follower render omitted [server.replication_source]" >&2
    exit 1
}
grep -Fq 'credential_file = "/run/riffdb-protected/replication-source.credential"' <<<"$follower_manifest" || {
    echo "follower render omitted protected replication_source credential_file" >&2
    exit 1
}
grep -Fq 'key: replication-source.credential' <<<"$follower_manifest" || {
    echo "follower render omitted Secret key mount for replication-source.credential" >&2
    exit 1
}
if render --set server.mode=follower >/dev/null 2>&1; then
    echo "follower render unexpectedly succeeded without required replicationSource fields" >&2
    exit 1
fi

if ((write)); then
    mkdir -p "$(dirname "$golden")"
    render >"$golden"
    echo "check-helm-render-v1	wrote	$golden"
    exit 0
fi

if [[ ! -f "$golden" ]]; then
    echo "rendered golden is absent: $golden" >&2
    echo "run ./scripts/check-helm-render --write after reviewing the chart" >&2
    exit 1
fi

if diff -u "$golden" <(render); then
    echo "check-helm-render-v1	rendered manifest matches the committed golden"
else
    echo "the chart renders differently than the committed golden" >&2
    echo "review the diff above, then run ./scripts/check-helm-render --write" >&2
    exit 1
fi
