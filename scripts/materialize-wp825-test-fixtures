def unpack_sparsehex(text: str, dest_root: Path) -> None:
    lines = [
        line.strip()
        for line in text.splitlines()
        if line.strip() and not line.strip().startswith("#")
    ]
    if not lines or lines[0] != "riffdb-test-sparse-v1":
        raise RuntimeError("invalid sparsehex header")
    current_path = None
    current_buf = None
    expected_sha = None
    for line in lines[1:]:
        parts = line.split()
        if parts[0] == "file":
            if current_path is not None:
                actual_sha = hashlib.sha256(current_buf).hexdigest()
                if actual_sha != expected_sha:
                    raise RuntimeError(f"sha256 mismatch for {current_path}")
                current_path.parent.mkdir(parents=True, exist_ok=True)
                current_path.write_bytes(current_buf)
            rel = parts[1]
            size = int(parts[2])
            expected_sha = parts[3]
            current_path = dest_root / rel
            current_buf = bytearray(size)
        elif parts[0] == "span":
            if current_buf is None:
                continue
            offset = int(parts[1])
            chunk = bytes.fromhex(parts[2])
            current_buf[offset : offset + len(chunk)] = chunk
        elif parts[0] == "end":
            continue
        else:
            raise RuntimeError(f"unknown sparsehex directive: {parts[0]}")
    if current_path is not None:
        actual_sha = hashlib.sha256(current_buf).hexdigest()
        if actual_sha != expected_sha:
            raise RuntimeError(f"sha256 mismatch for {current_path}")
        current_path.parent.mkdir(parents=True, exist_ok=True)
        current_path.write_bytes(current_buf)


def main() -> int:
    if len(sys.argv) != 2:
        print("usage: materialize-wp825-test-fixtures <dest-dir>", file=sys.stderr)
        return 2
    dest = Path(sys.argv[1]).resolve()
    dest.mkdir(parents=True, exist_ok=True)
    lock_path = dest / ".lock"
    stamp_path = dest / ".stamp"
    with lock_path.open("w") as lock_file:
        fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
        if stamp_path.is_file() and stamp_path.read_text().strip() == STAMP:
            return 0
        embedded_sparse = lzma.decompress(base64.b64decode(ARCHIVE_XZ_B64)).decode("utf-8")
        unpack_sparsehex(embedded_sparse, dest)
        stamp_path.write_text(STAMP + "\n", encoding="utf-8")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
