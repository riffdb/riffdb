#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

mode="${1:-}"
case "$mode" in
    "")
        output_root="$repo_root"
        ;;
    --check)
        output_root="$(mktemp -d)"
        trap 'rm -rf "$output_root"' EXIT
        ;;
    *)
        printf 'usage: %s [--check]\n' "$0" >&2
        exit 2
        ;;
esac

generate() {
    LC_ALL=C TZ=UTC cargo run --quiet --locked -p riffdb-proto --example generate_proto -- \
        --output-root "$output_root"
}

generate_durable_vectors() {
    LC_ALL=C TZ=UTC \
        RIFFDB_DURABLE_VECTOR_OUTPUT="$output_root/fixtures/proto/durable-wire-vectors.txt" \
        RIFFDB_DURABLE_V2_VECTOR_OUTPUT="$output_root/fixtures/proto/durable-wire-vectors-v2.txt" \
        RIFFDB_DURABLE_INDEX_V2_VECTOR_OUTPUT="$output_root/fixtures/proto/durable-index-v2-wire-vector.txt" \
        RIFFDB_EVENT_REFERENCE_V2_VECTOR_OUTPUT="$output_root/fixtures/proto/durable-event-reference-v2-wire-vectors.txt" \
        cargo test --quiet --locked -p riffdb-storage-api --lib \
            proto_codec::tests::emit_semantic_wire_vectors_for_fixture_regeneration -- --exact
}

generate_durable_relationship_vectors() {
    LC_ALL=C TZ=UTC \
        RIFFDB_DURABLE_RELATIONSHIP_VECTOR_OUTPUT="$output_root/fixtures/proto/durable-relationship-vectors.txt" \
        cargo test --quiet --locked -p riffdb-storage-api --lib \
            proto_codec::tests::relationships::emit_relationship_vectors_for_fixture_regeneration -- --exact
}

generate
if [[ "$mode" == "" ]]; then
    # The checked-in Prost types are inputs to public wire-vector generation.
    # A second pass reaches a fixed point after a schema edit changes those types.
    generate
fi
generate_durable_vectors
generate_durable_relationship_vectors

artifacts=(
    crates/riffdb-proto/src/generated/riffdb.app.v1.rs
    crates/riffdb-proto/src/generated/riffdb.storage.v1.rs
    crates/riffdb-proto/src/generated/riffdb.v1.rs
    fixtures/proto/compatibility-probe-envelope.bin
    fixtures/proto/compatibility-probe-payload.bin
    fixtures/proto/descriptors/compatibility-probe-descriptor-set.bin
    fixtures/proto/descriptors/riffdb-storage-v1-descriptor-set.bin
    fixtures/proto/descriptors/riffdb-v1-descriptor-set.bin
    fixtures/proto/durable-record-bounds.bin
    fixtures/proto/durable-index-v2-record-bound.bin
    fixtures/proto/durable-index-v2-schema-hash.bin
    fixtures/proto/durable-index-generation-v2-record-bound.bin
    fixtures/proto/durable-index-generation-v2-schema-hash.bin
    fixtures/proto/durable-history-incarnation-v1-record-bound.bin
    fixtures/proto/durable-history-incarnation-v1-schema-hash.bin
    fixtures/proto/durable-entity-reference-v3-schema-hash.bin
    fixtures/proto/durable-entity-reference-v3-record-bound.bin
    fixtures/proto/durable-migration-v1-record-bounds.bin
    fixtures/proto/durable-migration-v1-schema-hashes.bin
    fixtures/proto/durable-capability-v2-record-bound.bin
    fixtures/proto/durable-capability-v2-schema-hash.bin
    fixtures/proto/durable-capability-v5-record-bound.bin
    fixtures/proto/durable-capability-v5-schema-hash.bin
    fixtures/proto/durable-capability-v7-record-bound.bin
    fixtures/proto/durable-capability-v7-schema-hash.bin
    fixtures/proto/durable-validated-prefix-checkpoint-v1-record-bound.bin
    fixtures/proto/durable-validated-prefix-checkpoint-v1-schema-hash.bin
    fixtures/proto/durable-retention-watermark-v1-record-bound.bin
    fixtures/proto/durable-retention-watermark-v1-schema-hash.bin
    fixtures/proto/durable-retention-holds-v1-record-bound.bin
    fixtures/proto/durable-retention-holds-v1-schema-hash.bin
    fixtures/proto/durable-history-tombstone-v1-record-bound.bin
    fixtures/proto/durable-history-tombstone-v1-schema-hash.bin
    fixtures/proto/durable-reactive-consumer-v1-record-bounds.bin
    fixtures/proto/durable-reactive-consumer-v1-schema-hashes.bin
    fixtures/proto/durable-service-audit-v2-record-bound.bin
    fixtures/proto/durable-service-audit-v2-schema-hash.bin
    fixtures/proto/durable-contextual-causation-v2-record-bounds.bin
    fixtures/proto/durable-contextual-causation-v2-schema-hashes.bin
    fixtures/proto/durable-command-capsule-v1-record-bounds.bin
    fixtures/proto/durable-command-capsule-v1-schema-hashes.bin
    fixtures/proto/durable-command-segment-v1-record-bounds.bin
    fixtures/proto/durable-command-segment-v1-schema-hashes.bin
    fixtures/proto/durable-workflow-service-values-v3-record-bounds.bin
    fixtures/proto/durable-workflow-service-values-v3-schema-hashes.bin
    fixtures/proto/durable-event-reference-v2-record-bounds.bin
    fixtures/proto/durable-event-reference-v2-schema-hashes.bin
    fixtures/proto/durable-event-reference-v2-wire-vectors.txt
    fixtures/proto/durable-registry-v2-record-bound.bin
    fixtures/proto/durable-registry-v2-schema-hash.bin
    fixtures/proto/durable-index-v2-wire-vector.txt
    fixtures/proto/durable-readable-registry.txt
    fixtures/proto/durable-relationship-vectors.txt
    fixtures/proto/durable-registry.txt
    fixtures/proto/durable-schema-hashes.bin
    fixtures/proto/durable-writable-registry.txt
    fixtures/proto/durable-wire-vectors.txt
    fixtures/proto/durable-wire-vectors-v2.txt
    fixtures/proto/operation-schema-catalog-full-v1.bin
    fixtures/proto/operation-schema-catalog-identity-v1.bin
    fixtures/proto/operation-schema-catalog-v1.txt
    fixtures/proto/operation-schema-composition-allocate-budget-v1.schema.json
    fixtures/proto/public-client-vectors.txt
    fixtures/proto/public-key-envelope-vectors.txt
    fixtures/proto/public-response-charge-v1.tsv
    fixtures/proto/public-schema-hashes.txt
    fixtures/proto/schema-inventory.txt
    fixtures/proto/wire-vectors.txt
)

expected_generated=$'crates/riffdb-proto/src/generated/riffdb.app.v1.rs\ncrates/riffdb-proto/src/generated/riffdb.storage.v1.rs\ncrates/riffdb-proto/src/generated/riffdb.v1.rs'

check_generated_inventory() {
    local root="$1"
    local actual_generated
    actual_generated="$(
        cd "$root"
        find crates/riffdb-proto/src/generated -maxdepth 1 -type f -print | LC_ALL=C sort
    )"
    if [[ "$actual_generated" != "$expected_generated" ]]; then
        printf 'generated Rust source inventory differs from the accepted package baseline: %s\n' \
            "$root" >&2
        return 1
    fi
}

check_generated_inventory "$repo_root"
check_generated_inventory "$output_root"

if [[ "$mode" == "--check" ]]; then
    failed=0
    for artifact in "${artifacts[@]}"; do
        if ! cmp --silent -- "$artifact" "$output_root/$artifact"; then
            printf 'generated artifact is stale or missing: %s\n' "$artifact" >&2
            failed=1
        fi
    done
    if (( failed != 0 )); then
        exit 1
    fi
    printf 'Protobuf artifacts are current.\n'
else
    printf 'Generated %d Protobuf artifacts.\n' "${#artifacts[@]}"
fi
