#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"
# shellcheck source=scripts/tool-versions
source scripts/tool-versions

usage() {
    printf 'usage: %s {build|check|serve}\n' "$0" >&2
    exit 2
}

require_version() {
    local command_name="$1"
    local expected="$2"
    local actual
    command -v "$command_name" >/dev/null || {
        printf '%s %s is required\n' "$command_name" "$expected" >&2
        exit 1
    }
    actual="$($command_name --version | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n 1)"
    if [[ "$actual" != "$expected" ]]; then
        printf '%s %s is required (found %s)\n' "$command_name" "$expected" "$actual" >&2
        exit 1
    fi
}

build_handbook() {
    require_version mdbook "$RIFFDB_MDBOOK_VERSION"
    mdbook build
    RUSTDOCFLAGS="-D warnings" cargo doc --locked -p riffdb-client-rust --no-deps \
        --target-dir target/handbook-rustdoc
    rm -rf target/handbook/api/rust
    mkdir -p target/handbook/api
    cp -R target/handbook-rustdoc/doc target/handbook/api/rust
    test -f target/handbook/api/rust/riffdb_client_rust/index.html || {
        printf 'public riffdb-client-rust Rustdoc entry point is missing\n' >&2
        exit 1
    }
    grep -Fxq 'docs.riffdb.com' target/handbook/CNAME || {
        printf 'handbook CNAME (docs.riffdb.com) is missing from target/handbook/CNAME\n' >&2
        exit 1
    }
}

check_first_application_tutorial() {
    local riffdb_bin="target/release/riffdb"
    if [[ ! -x "$riffdb_bin" ]]; then
        riffdb_bin="target/debug/riffdb"
    fi
    if [[ ! -x "$riffdb_bin" ]]; then
        cargo build --locked --bin riffdb >/dev/null
        riffdb_bin="target/debug/riffdb"
    fi
    python3 - "$riffdb_bin" <<'PY'
import pathlib
import re
import subprocess
import sys
import tempfile

riffdb_bin = pathlib.Path(sys.argv[1]).resolve()
doc = pathlib.Path("docs/getting-started/FIRST-APPLICATION.md").read_text()

riff_match = re.search(r"```riff\n(contract TaskTracker version 1 \{.*?\n\})\n```", doc, re.S)
riffq_match = re.search(r"```riffql\n(query ListTasks\(.*?\n\})\n```", doc, re.S)
json_match = re.search(r"```json\n(\{\n  \"application\": \"task-tracker\".*?\n\})\n```", doc, re.S)

if not (riff_match and riffq_match and json_match):
    raise SystemExit("FIRST-APPLICATION.md is missing expected riff, riffql, or json code blocks")

with tempfile.TemporaryDirectory() as tmp:
    root = pathlib.Path(tmp) / "task-tracker"
    root.mkdir()
    subprocess.run(
        [str(riffdb_bin), "init", "task-tracker", "--generator", "typescript", "--starter"],
        cwd=root,
        check=True,
        stdout=subprocess.DEVNULL,
    )
    (root / "riffdb" / "contract.riff").write_text(riff_match.group(1) + "\n")
    (root / "riffdb" / "queries" / "list_tasks.riffq").write_text(riffq_match.group(1) + "\n")
    item_page = root / "riffdb" / "queries" / "item_page.riffq"
    if item_page.exists():
        item_page.unlink()
    (root / "riffdb.application.json").write_text(json_match.group(1) + "\n")
    subprocess.run(
        [str(riffdb_bin), "generate"],
        cwd=root,
        check=True,
        stdout=subprocess.DEVNULL,
    )
    client_ts = (root / "generated" / "typescript" / "client.ts").read_text()
    for required in ("export class TaskTrackerClient", "createTask(", "completeTask(", "listTasks("):
        if required not in client_ts:
            raise SystemExit(f"generated TypeScript client missing {required!r}")
PY
}

command="${1:-}"
case "$command" in
    build)
        ./scripts/check-handbook-source
        ./scripts/generate-handbook-diagrams --check
        ./scripts/generate-cli-reference --check
        build_handbook
        ;;
    check)
        require_version lychee "$RIFFDB_LYCHEE_VERSION"
        ./scripts/check-handbook-source
        ./scripts/check-handbook-audience --self-test
        ./scripts/check-handbook-audience
        ./scripts/generate-handbook-diagrams --check
        ./scripts/generate-cli-reference --check
        check_first_application_tutorial
        require_version mdbook "$RIFFDB_MDBOOK_VERSION"
        mdbook test
        build_handbook
        lychee --offline --include-fragments --root-dir target/handbook \
            --exclude-path '/api/rust/' target/handbook
        if grep -rnE --include='*.html' '<(script|link|img)[^>]+(src|href)="https?://' target/handbook; then
            printf 'handbook contains an external runtime asset\n' >&2
            exit 1
        fi
        ;;
    serve)
        require_version mdbook "$RIFFDB_MDBOOK_VERSION"
        ./scripts/check-handbook-source
        ./scripts/generate-handbook-diagrams --check
        ./scripts/generate-cli-reference --check
        mdbook serve --hostname 127.0.0.1
        ;;
    *) usage ;;
esac
