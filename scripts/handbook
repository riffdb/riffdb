#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"
# shellcheck source=scripts/tool-versions
source scripts/tool-versions

usage() {
    printf 'usage: %s {build|check|serve}\n' "$0" >&2
    exit 2
}

require_version() {
    local command_name="$1"
    local expected="$2"
    local actual
    command -v "$command_name" >/dev/null || {
        printf '%s %s is required\n' "$command_name" "$expected" >&2
        exit 1
    }
    actual="$($command_name --version | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n 1)"
    if [[ "$actual" != "$expected" ]]; then
        printf '%s %s is required (found %s)\n' "$command_name" "$expected" "$actual" >&2
        exit 1
    fi
}

build_handbook() {
    require_version mdbook "$RIFFDB_MDBOOK_VERSION"
    mdbook build
    RUSTDOCFLAGS="-D warnings" cargo doc --locked -p riffdb-client-rust --no-deps \
        --target-dir target/handbook-rustdoc
    rm -rf target/handbook/api/rust
    mkdir -p target/handbook/api
    cp -R target/handbook-rustdoc/doc target/handbook/api/rust
    test -f target/handbook/api/rust/riffdb_client_rust/index.html || {
        printf 'public riffdb-client-rust Rustdoc entry point is missing\n' >&2
        exit 1
    }
}

command="${1:-}"
case "$command" in
    build)
        ./scripts/check-handbook-source
        ./scripts/generate-handbook-diagrams --check
        ./scripts/generate-cli-reference --check
        build_handbook
        ;;
    check)
        require_version lychee "$RIFFDB_LYCHEE_VERSION"
        ./scripts/check-handbook-source
        ./scripts/generate-handbook-diagrams --check
        ./scripts/generate-cli-reference --check
        require_version mdbook "$RIFFDB_MDBOOK_VERSION"
        mdbook test
        build_handbook
        lychee --offline --include-fragments --root-dir target/handbook \
            --exclude-path '/api/rust/' target/handbook
        if rg -n '<(script|link|img)[^>]+(src|href)="https?://' target/handbook --glob '*.html'; then
            printf 'handbook contains an external runtime asset\n' >&2
            exit 1
        fi
        ;;
    serve)
        require_version mdbook "$RIFFDB_MDBOOK_VERSION"
        ./scripts/check-handbook-source
        ./scripts/generate-handbook-diagrams --check
        ./scripts/generate-cli-reference --check
        mdbook serve --hostname 127.0.0.1
        ;;
    *) usage ;;
esac
