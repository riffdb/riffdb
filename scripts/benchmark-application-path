#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

assert_wp270=0
live=0
while (($#)); do
    case "$1" in
        --assert-wp270) assert_wp270=1; shift ;;
        --live) live=1; shift ;;
        *)
            echo "usage: scripts/benchmark-application-path [--assert-wp270] [--live]" >&2
            exit 2
            ;;
    esac
done

if ((live)); then
    ./benchmarks/run-app-baseline --smoke --skip-postgres
    report="target/app-baseline/report-v1.json"
else
    report="benchmarks/application-path/latest-v1.json"
fi

jq -e '.schema == "riffdb.application-path-wp205/v1"' "$report" >/dev/null

point_limit=5000000
page_limit=15000000
command_limit=20000000
seed_limit=3000000000
transport_limit=1000000

scenario_p50() {
    local name="$1"
    jq -er --arg name "$name" \
        '.backend.scenarios[] | select(.scenario == $name) | .timing.p50_ns' "$report"
}

assert_at_most() {
    local label="$1"
    local actual="$2"
    local limit="$3"
    if ((actual > limit)); then
        echo "$label missed: ${actual}ns > ${limit}ns" >&2
        exit 1
    fi
    printf '%-38s %10dns <= %10dns\n' "$label" "$actual" "$limit"
}

point_ticket="$(scenario_p50 point_get_ticket)"
point_user="$(scenario_p50 point_get_user)"
list_project="$(scenario_p50 list_tickets_by_project_status)"
list_assignee="$(scenario_p50 list_open_tickets_for_assignee)"
list_comments="$(scenario_p50 list_comments_for_ticket)"
list_members="$(scenario_p50 list_project_members)"
detail="$(scenario_p50 ticket_detail_page)"
command="$(scenario_p50 create_comment)"
seed="$(jq -er '.backend.seed_ns' "$report")"
transport_upper="$point_ticket"
if ((point_user < transport_upper)); then
    transport_upper="$point_user"
fi

assert_at_most point_get_ticket "$point_ticket" "$point_limit"
assert_at_most point_get_user "$point_user" "$point_limit"
assert_at_most list_tickets_by_project_status "$list_project" "$page_limit"
assert_at_most list_open_tickets_for_assignee "$list_assignee" "$page_limit"
assert_at_most list_comments_for_ticket "$list_comments" "$page_limit"
assert_at_most list_project_members "$list_members" "$page_limit"
assert_at_most ticket_detail_page "$detail" "$page_limit"
assert_at_most create_comment "$command" "$command_limit"
assert_at_most seed_276_rows "$seed" "$seed_limit"
assert_at_most unary_transport_complete_request_upper_bound "$transport_upper" "$transport_limit"

if ((assert_wp270)); then
    riffql_report="benchmarks/application-path/wp270-riffql-v1.json"
    jq -e '
      .schema == "riffdb.application-path-wp270-riffql/v1"
      and .transport.connection == "one reused HTTP/2 channel"
      and (.scenarios | length) == 2
      and all(.scenarios[];
        .public_rpc_count == 1
        and .authoritative_snapshot_count == 1
        and .p50_ns <= 15000000)
      and .seed_ns <= 3000000000
    ' "$riffql_report" >/dev/null
    cargo test --quiet -p riffdb-storage-redb \
        query::tests::point_query_executes_inside_one_redb_read_transaction
    cargo test --quiet -p riffdb-storage-redb \
        query::tests::index_page_batches_entity_reads_inside_the_same_redb_transaction
    ./scripts/check-ticketdesk-symbolic-boundary
fi

echo "Application performance gates pass using a reused public HTTP/2 connection."
